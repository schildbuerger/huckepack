# Secrets and local environment
.env
.env.*

# Build output (built from data/trails/ and src/)
dist/
.astro/

# Dependencies and build caches
node_modules/
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Editor, OS and personal tool files
.DS_Store
Thumbs.db
*.code-workspace
.vscode/
.idea/
*.swp
.claude/settings.local.json
.claude/.cc-writes/

# Logs
*.log

# Official GPX tracks: copyrighted, kept local only (the pipeline re-downloads them with --refresh)
data/raw/*/*.gpx

# Terrain model tiles (Copernicus DEM GLO-30, 30-45 MB each): downloaded by pipeline/elevation.py
data/dem/
