---
// One page of the trail list (the search): /trails/ is page 1, /trails/page/<n>/ the others
// (src/pages/trails/page/[page].astro). Each page's HTML carries its PER_PAGE trails by name, a pager
// with plain links to the other pages, its own title and its own canonical address, so search engines
// read every trail through the pages; TrailList.svelte then filters, sorts and pages in the browser.
import { ogPageAlt } from "../lib/og-pages";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrailList from "../components/TrailList.svelte";
import TrailCards from "../components/TrailCards.astro";
import { PER_PAGE, allSearchTrails, eleRangeOf, pageCount } from "../lib/search-all";

interface Props {
  page: number;
}
const { page } = Astro.props;
// the trails' summaries reach the list from /trails/search.json; the page carries only its own cards,
// the rest come with /trails/cards.html (issue #93)
const trails = await allSearchTrails();
const eleRange = eleRangeOf(trails);
const pages = pageCount(trails.length);
const mine = trails.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const onPage = page > 1 ? ` · page ${page} of ${pages}` : "";
---


<Base
  image={{ path: "/og/page/trails.png", alt: await ogPageAlt("trails") }}
  title={`Find a long-distance hiking trail${onPage} · huckepack`}
  description={page > 1
    ? `Long-distance hiking trails, page ${page} of ${pages}: ${mine[0].name} to ${mine.at(-1)!.name}. ${trails.length} official trails to filter by month, region, days, difficulty and more.`
    : `${trails.length} official long-distance hiking trails, to filter by month, region, walking days, difficulty, landscape, ground underfoot, where to sleep and water on the way.`}
>
  {page > 1 ? <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current={`Page ${page}`} /> : <Breadcrumbs current="Trails" />}
  <!-- the title band (2026-11-06, of eleven previews, K "Footpath under clouds"; the clouds gone
       2026-11-07): low, so the results start high; a dotted footpath winding from the title to the
       count, and a walker on it. Path and walker are one SVG: the walker follows the very same path
       (animateMotion + mpath), so it stays on the line at every width. The drawing stretches
       sideways only (preserveAspectRatio="none", height in px), and non-scaling strokes keep the
       dots and the walker round. The count follows the filters (TrailList.svelte sets it) -->
  <header class="band">
    <h1>Trails</h1>
    <div class="path" aria-hidden="true">
      <svg viewBox="0 0 1000 48" preserveAspectRatio="none" focusable="false">
        <path id="trail-line" class="line" d="M0 24C20 24 20 8 40 8C68 8 67 40 95 40C113 40 112 10 130 10C148 10 147 38 165 38C248 38 247 16 330 16C375 16 375 30 420 30C445 30 445 5 470 5C488 5 487 43 505 43C523 43 522 12 540 12C630 12 630 40 720 40C760 40 760 20 800 20C823 20 822 42 845 42C865 42 865 6 885 6C943 6 942 24 1000 24" />
        <g class="walker moving" opacity="0">
          <path class="halo" d="M0 0h.01" />
          <path class="dot" d="M0 0h.01" />
          <animateMotion dur="24s" repeatCount="indefinite" calcMode="linear"><mpath href="#trail-line" /></animateMotion>
          <animate attributeName="opacity" dur="24s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.04;0.94;1" />
        </g>
        <!-- reduced motion: the walker rests a third of the way along, on the same path -->
        <g class="walker resting">
          <path class="halo" d="M0 0h.01" />
          <path class="dot" d="M0 0h.01" />
          <animateMotion dur="1s" fill="freeze" keyPoints="0.33;0.33" keyTimes="0;1" calcMode="linear"><mpath href="#trail-line" /></animateMotion>
        </g>
      </svg>
    </div>
    <p class="count"><strong data-trail-count>{trails.length}</strong> <span data-trail-word>{trails.length === 1 ? "trail" : "trails"}</span> to walk</p>
    <p class="lede">Filter by when, how long and how hard, then compare the trails side by side.</p>
  </header>
  <TrailList client:load total={trails.length} more={trails.length > mine.length} {page}>
    <TrailCards trails={mine} eleRange={eleRange} />
  </TrailList>
</Base>

<style>
  .band {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 4px 18px;
    margin: 0 0 26px;
    padding-top: 26px;
  }
  .band h1,
  .path,
  .count,
  .lede {
    position: relative;
  }
  h1 {
    margin: 0;
  }
  .lede {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  /* the footpath (round dots of 3 px, 6 px apart, as the dotted border it replaces), and the walker
     who sets off at the title, walks to the count and starts again (24 s). The SVG is 48 px tall, within
     the 53 px title row, centred on the 3 px row the old border took, so the layout stays as it
     was; the path winds irregularly, tight switchbacks between long sweeps, over its full height */
  .path {
    height: 3px;
  }
  .path svg {
    position: absolute;
    left: 0;
    top: calc(50% - 24px);
    width: 100%;
    height: 48px;
    overflow: visible;
  }
  .line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 0 6;
    opacity: 0.85;
    vector-effect: non-scaling-stroke;
  }
  .walker path {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .walker .dot {
    stroke: var(--poor);
    stroke-width: 12;
  }
  .walker .halo {
    stroke: var(--bg);
    stroke-width: 18;
  }
  .resting {
    display: none;
  }
  .count {
    margin: 0;
    font: 15px var(--sans);
  }
  .count strong {
    font: 600 1.6rem var(--serif);
    color: var(--accent-text);
  }
  /* phones: the title and the count share a line, the path gives way */
  @media (max-width: 759px) {
    .band {
      grid-template-columns: auto 1fr;
    }
    .path {
      display: none;
    }
    .count {
      justify-self: end;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .moving {
      display: none;
    }
    .resting {
      display: inline;
    }
  }
</style>
