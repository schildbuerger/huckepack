---
// One page of the trail list (the search): /trails/ is page 1, /trails/page/<n>/ the others
// (src/pages/trails/page/[page].astro). Each page's HTML carries its PER_PAGE trails by name, a pager
// with plain links to the other pages, its own title and its own canonical address, so search engines
// read every trail through the pages; TrailList.svelte then filters, sorts and pages in the browser.
import { ogPageAlt } from "../lib/og-pages";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrailList from "../components/TrailList.svelte";
import TrailCards from "../components/TrailCards.astro";
import { PER_PAGE, allSearchTrails, eleRangeOf, pageCount } from "../lib/search-all";

interface Props {
  page: number;
}
const { page } = Astro.props;
// the trails' summaries reach the list from /trails/search.json; the page carries only its own cards,
// the rest come with /trails/cards.html (issue #93)
const trails = await allSearchTrails();
const eleRange = eleRangeOf(trails);
const pages = pageCount(trails.length);
const mine = trails.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const onPage = page > 1 ? ` · page ${page} of ${pages}` : "";
---


<Base
  image={{ path: "/og/page/trails.png", alt: await ogPageAlt("trails") }}
  title={`Find a long-distance hiking trail${onPage} · huckepack`}
  description={page > 1
    ? `Long-distance hiking trails, page ${page} of ${pages}: ${mine[0].name} to ${mine.at(-1)!.name}. ${trails.length} official trails to filter by month, region, days, difficulty and more.`
    : `${trails.length} official long-distance hiking trails, to filter by month, region, walking days, difficulty, landscape, ground underfoot, where to sleep and water on the way.`}
>
  {page > 1 ? <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current={`Page ${page}`} /> : <Breadcrumbs current="Trails" />}
  <!-- the title band (2026-11-06, of eleven previews, K "Footpath under clouds"): low, so the results
       start high; a dotted footpath from the title to the count, a walker heading along it while
       clouds drift the same way above -->
  <header class="band">
    <div class="sky" aria-hidden="true"><span class="cloud c1"></span><span class="cloud c2"></span><span class="cloud c3"></span></div>
    <h1>Trails</h1>
    <div class="path" aria-hidden="true"><span class="walker"></span></div>
    <p class="count"><strong>{trails.length}</strong> trails to walk</p>
    <p class="lede">Filter by when, how long and how hard, then compare the trails side by side.</p>
  </header>
  <TrailList client:load total={trails.length} more={trails.length > mine.length} {page}>
    <TrailCards trails={mine} eleRange={eleRange} />
  </TrailList>
</Base>

<style>
  .band {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 4px 18px;
    margin: 0 0 26px;
    padding-top: 26px;
  }
  .band h1,
  .path,
  .count,
  .lede {
    position: relative;
  }
  h1 {
    margin: 0;
  }
  .lede {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  /* a strip of sky above the path: flat clouds drifting left to right across the band */
  .sky {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 52px;
    overflow: hidden;
  }
  .cloud {
    position: absolute;
    left: 0;
    width: 70px;
    height: 18px;
    border-radius: 999px;
    background: var(--line);
    animation: drift 60s linear infinite;
  }
  .cloud::before {
    content: "";
    position: absolute;
    left: 16px;
    top: -11px;
    width: 32px;
    height: 26px;
    border-radius: 50%;
    background: inherit;
  }
  .c1 {
    top: 14px;
    animation-delay: -12s;
  }
  .c2 {
    top: 6px;
    scale: 0.7;
    animation-duration: 85s;
    animation-delay: -55s;
  }
  .c3 {
    top: 22px;
    scale: 0.85;
    animation-duration: 70s;
    animation-delay: -38s;
  }
  @keyframes drift {
    from {
      transform: translateX(-90px);
    }
    to {
      transform: translateX(min(1240px, 100vw));
    }
  }
  /* the footpath, and the walker who sets off at the title, walks to the count and starts again */
  .path {
    height: 2px;
    border-top: 3px dotted var(--accent);
    opacity: 0.85;
  }
  .walker {
    position: absolute;
    top: -8px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--poor);
    box-shadow: 0 0 0 3px var(--bg);
    animation: walk 24s linear infinite;
  }
  @keyframes walk {
    0% {
      left: 0;
      opacity: 0;
    }
    4%,
    94% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 12px);
      opacity: 0;
    }
  }
  .count {
    margin: 0;
    font: 15px var(--sans);
  }
  .count strong {
    font: 600 1.6rem var(--serif);
    color: var(--accent-text);
  }
  /* phones: the title and the count share a line, the path gives way */
  @media (max-width: 759px) {
    .band {
      grid-template-columns: auto 1fr;
    }
    .path {
      display: none;
    }
    .count {
      justify-self: end;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cloud,
    .walker {
      animation: none;
    }
  }
</style>
