---
import ThemeToggle from "../components/ThemeToggle.astro";
import logo from "../assets/logo.svg?raw"; // written by design/logos/make.py
import { inlineScript } from "../lib/inline-script";

interface Props {
  title: string;
  description?: string;
  personal?: boolean; // a page with the operator's personal details (legal notice, privacy policy)
  full?: boolean; // the page fills the window between header and footer, without the width cap (the trail map)
  // the link-preview image (a trail's /og/<slug>.png, 1200 × 630) with its words; else the logo
  image?: { path: string; alt: string };
}
const { title, description, personal = false, full = false, image } = Astro.props;
// apply a saved light/dark choice before the first paint; no choice means auto (system setting);
// and mark the page as having JavaScript (html.js), for content that waits for a script to settle
const themeScript = inlineScript(
  Astro,
  `document.documentElement.classList.add("js");
try {
  const theme = localStorage.getItem("theme");
  if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
} catch {}`,
);
// the address search engines and link previews should use (no query string, always with a slash)
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
// the site's name for search results (schema.org WebSite), on the home page
const siteLd =
  Astro.url.pathname === "/" &&
  JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", name: "huckepack", url: new URL("/", Astro.site).href });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <!-- link previews (Open Graph, also read by Mastodon, Signal, Slack and others) -->
    <meta property="og:site_name" content="huckepack" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {
      image ? (
        <>
          <meta property="og:image" content={new URL(image.path, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={image.alt} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <>
          <meta property="og:image" content={new URL("/icon-512.png", Astro.site)} />
          <meta property="og:image:alt" content="The huckepack logo, a cairn of pixel stones" />
          <meta name="twitter:card" content="summary" />
        </>
      )
    }
    {siteLd && <script type="application/ld+json" set:html={siteLd} />}
    {
      personal && (
        <>
          <!-- personal details: not in search results, caches or snippets; text and data mining
               reserved (EU DSM Directive Art. 4, TDMRep), against AI training -->
          <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
          <meta name="tdm-reservation" content="1" />
        </>
      )
    }
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeScript} />
  </head>
  <body class:list={{ full }}>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true" set:html={logo} />
          huckepack
        </a>
        <div class="header-end">
          <slot name="header" />
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main class:list={["wrap", { full }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          huckepack collects facts about official long-distance trails. Every figure names its source.
        </p>
        <p>Maps and trail lines © OpenStreetMap contributors (ODbL), basemap by OpenFreeMap.</p>
        <p class="legal-links"><a href="/legal-notice/" rel="nofollow">Legal notice</a><a href="/privacy/" rel="nofollow">Privacy</a></p>
      </div>
    </footer>
    <script>
      // links to other websites open in a new tab (with a note for screen readers); links within
      // huckepack stay in the same tab, so back and the breadcrumbs work as usual
      for (const a of document.querySelectorAll<HTMLAnchorElement>("a[href]")) {
        if (!a.protocol.startsWith("http") || a.host === location.host || a.target) continue;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.insertAdjacentHTML("beforeend", '<span class="sr-only"> (opens in a new tab)</span>');
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbf7f1;
    --surface: #f4ece1;
    --text: #2a221d;
    --muted: #75685d;
    --line: #e6dccf;
    --accent: #b0502a;
    --accent-soft: #f3e2d5;
    /* status: good / caution / restrictive, each a strong colour and a card tint */
    --good: #4a6534;
    --good-soft: #e9eedd;
    --fair: #7f5410;
    --fair-soft: #f7edd5;
    --poor: #9c3626;
    --poor-soft: #f8e7e0;
    /* water points in charts: the one cool colour, kept to water */
    --water: #2f6690;
    /* surface categories in charts, in natural colours (issue #15): earth, sand, asphalt. Checked with
       the dataviz validator in both modes: they stay apart for normal and colour-blind vision; paved
       is an asphalt grey on purpose (no hue), so it differs by lightness; every category is named */
    --surface-natural: #b26232;
    --surface-gravel: #c9a64d;
    --surface-paved: #50565c;
    --surface-unknown: #d6ccbf;
    /* climate (validated with the dataviz validator): the trail's low and high ground; wet days in
       water blue with snow days as its light step. The high ground is a deep navy (a lavender in
       dark mode), apart from the wet-days blue by lightness: they share a legend row (issue #24) */
    --clim-low: #c46a1f;
    --clim-high: #2a2f6e;
    --wet: #2f6690;
    --snow: #86afd0;
    --daylight: #e8a800; /* strong yellow; below 3:1 on cream, so every pill carries its value */
    /* landscape groups (pipeline/landcover.py), in this fixed order; checked with the dataviz
       validator: neighbours apart in both modes, every group named in text */
    --land-forest: #1f6e3a;
    --land-open: #b9b62c;
    --land-moss: #22b2a6;
    --land-bare: #9264ac;
    --land-water: #2c5cc2;
    --land-farm: #e06a4f;
    /* gradients, diverging: climbs warm, descents violet, each a moderate and a steep (≥ 15 %) step */
    --grade-up: #e0956a;
    --grade-up-steep: #a8432a;
    --grade-down: #9d95d6;
    --grade-down-steep: #4d4498;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
    color-scheme: light;
  }
  /* dark: chosen in the theme switch, or the system setting when the switch is on auto */
  :root[data-theme="dark"] {
    --bg: #1b1714;
    --surface: #241f1a;
    --text: #efe6da;
    --muted: #a99b8d;
    --line: #3a322b;
    --accent: #e3916a;
    --accent-soft: #3b2a20;
    --good: #a9c48a;
    --good-soft: #283020;
    --fair: #e2b866;
    --fair-soft: #382d18;
    --poor: #ee9c87;
    --poor-soft: #3b231e;
    --water: #86b6db;
    --surface-natural: #a74f21;
    --surface-gravel: #ad8f2a;
    --surface-paved: #babec3;
    --surface-unknown: #4a4038;
    --clim-low: #c97a37;
    --clim-high: #a99be8;
    --wet: #4a7aa1;
    --snow: #c4dcef;
    --daylight: #f5c518;
    --land-forest: #4ba22a;
    --land-open: #656a08;
    --land-moss: #0a9b94;
    --land-bare: #8e3da5;
    --land-water: #298afe;
    --land-farm: #a84900;
    --grade-up: #8f4a2e;
    --grade-up-steep: #ee9f76;
    --grade-down: #5a529e;
    --grade-down-steep: #b3acf0;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1b1714;
      --surface: #241f1a;
      --text: #efe6da;
      --muted: #a99b8d;
      --line: #3a322b;
      --accent: #e3916a;
      --accent-soft: #3b2a20;
      --good: #a9c48a;
      --good-soft: #283020;
      --fair: #e2b866;
      --fair-soft: #382d18;
      --poor: #ee9c87;
      --poor-soft: #3b231e;
      --water: #86b6db;
      --surface-natural: #a74f21;
      --surface-gravel: #ad8f2a;
      --surface-paved: #babec3;
      --surface-unknown: #4a4038;
      --clim-low: #c97a37;
      --clim-high: #a99be8;
      --wet: #4a7aa1;
      --snow: #c4dcef;
      --daylight: #f5c518;
      --land-forest: #4ba22a;
      --land-open: #656a08;
      --land-moss: #0a9b94;
      --land-bare: #8e3da5;
      --land-water: #298afe;
      --land-farm: #a84900;
      --grade-up: #8f4a2e;
      --grade-up-steep: #ee9f76;
      --grade-down: #5a529e;
      --grade-down-steep: #b3acf0;
      color-scheme: dark;
    }
  }
  * {
    box-sizing: border-box;
  }
  /* always keep the scrollbar's space, so pages don't shift sideways when content grows past the
     window or shrinks back (e.g. stepping through the guide's questions, filtering the search) */
  html {
    scrollbar-gutter: stable;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 var(--sans);
  }
  /* 1200 px of content (plus the 16 px gutters), centred: the 2026 desktop standard for 1280–1440 px
     screens; at 1280 px with a scrollbar it still keeps the gutters */
  .wrap {
    max-width: 1232px;
    margin: 0 auto;
    padding: 0 16px;
  }
  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 32px 0 8px;
  }
  h2 {
    font-size: 1.3rem;
    margin: 0 0 12px;
  }
  a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  /* read by screen readers, not shown */
  /* the maps' credits (MapLibre's attribution): links underlined, not told apart by colour alone;
     one class more than MapLibre's own rule, whose stylesheet loads later */
  .maplibregl-ctrl.maplibregl-ctrl-attrib a {
    text-decoration: underline;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .muted {
    color: var(--muted);
  }
  .button {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }
  .button:hover {
    filter: brightness(1.08);
  }
  select,
  input {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 6px 10px;
  }
  select:focus,
  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .site-header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  /* the header's right side: a page's own header items (the home page's search), then the theme switch */
  .header-end {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  /* the cairn: an 8 × 8 pixel logo at 24 px, three screen pixels per logo pixel */
  .brand-mark {
    display: block;
    width: 24px;
    height: 24px;
    color: var(--accent);
  }
  .brand-mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* a full page (the trail map): header, page and footer fill the window exactly; only the page's
     own panels scroll, and the footer is one slim row */
  body.full {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow: hidden;
  }
  .wrap.full {
    overflow: clip;
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: none;
    padding: 0;
  }
  body.full .site-footer {
    margin-top: 0;
    padding: 8px 0;
    font-size: 0.78rem;
  }
  body.full .site-footer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
  }
  body.full .site-footer p {
    margin: 0;
  }
  body.full .site-footer p:first-child,
  body.full .legal-links {
    margin-top: 0 !important;
  }
  /* phones: the footer keeps its links and the attribution, not the tagline */
  @media (max-width: 639px) {
    body.full .site-footer p:first-child {
      display: none;
    }
  }
  .site-footer {
    margin-top: 56px;
    padding: 24px 0 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer p {
    margin: 0 0 4px;
  }
  .legal-links {
    display: flex;
    gap: 20px;
    margin-top: 12px !important;
  }
  .legal-links a {
    color: var(--muted);
  }
  .legal-links a:hover {
    color: var(--text);
  }
</style>
