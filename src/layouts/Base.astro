---
import HeaderSearch from "../components/HeaderSearch.astro";
import logo from "../assets/logo.svg?raw"; // written by design/logos/make.py
import { inlineScript } from "../lib/inline-script";
import { ogPageAlt } from "../lib/og-pages";

interface Props {
  title: string;
  description?: string;
  personal?: boolean; // a page with the operator's personal details (legal notice, privacy policy)
  noindex?: boolean; // a page that isn't one (the 404 page): no canonical address, not indexed
  full?: boolean; // the page fills the window between header and footer, without the width cap (the trail map)
  // the link-preview image (a trail's /og/<slug>.png or a page's /og/page/<page>.png, 1200 × 630)
  // with its words; else the site's own (/og/page/site.png: the legal notice, privacy, 404)
  image?: { path: string; alt: string };
}
const { title, description, personal = false, noindex = false, full = false } = Astro.props;
const image = Astro.props.image ?? { path: "/og/page/site.png", alt: await ogPageAlt("site") };
// the theme before the first paint (issue #155): light, unless the visitor switched to dark (the
// sun or moon in a drawing, the easter egg below); the system setting doesn't count;
// and mark the page as having JavaScript (html.js), for content that waits for a script to settle
const themeScript = inlineScript(
  Astro,
  `document.documentElement.classList.add("js");
try {
  document.documentElement.dataset.theme = localStorage.getItem("theme") === "dark" ? "dark" : "light";
  // design previews (working rule 1, PreviewSwitch.astro): the approach picked per topic, so a local
  // preview shows it from the first paint; no visitor of the live site has these keys
  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i);
    if (key && key.startsWith("preview:")) document.documentElement.setAttribute("data-preview-" + key.slice(8), localStorage.getItem(key));
  }
} catch {}`,
);
// the address search engines and link previews should use (no query string, always with a slash)
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
// the site's name for search results (schema.org WebSite), on the home page, published by huckepack
// itself as an Organization with its logo (issue #187: the logo search engines show for the brand;
// the cairn on cream, 512 px). No person is named: the operator's details stay out of the repository
const home = new URL("/", Astro.site).href;
const siteLd =
  Astro.url.pathname === "/" &&
  JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": `${home}#organization`, name: "huckepack", url: home, logo: new URL("/icon-512.png", Astro.site).href },
      { "@type": "WebSite", "@id": `${home}#website`, name: "huckepack", url: home, publisher: { "@id": `${home}#organization` } },
    ],
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <!-- link previews (Open Graph, also read by Mastodon, Signal, Slack and others) -->
    <meta property="og:site_name" content="huckepack" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={new URL(image.path, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {siteLd && <script type="application/ld+json" set:html={siteLd} />}
    {
      personal && (
        <>
          <!-- personal details: not in search results, caches or snippets; text and data mining
               reserved (EU DSM Directive Art. 4, TDMRep), against AI training -->
          <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
          <meta name="tdm-reservation" content="1" />
        </>
      )
    }
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeScript} />
  </head>
  <body class:list={{ full }}>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true" set:html={logo} />
          huckepack
        </a>
        <!-- the same on every page (issues #154, #155): the search as an icon -->
        <div class="header-end">
          <HeaderSearch />
        </div>
      </div>
    </header>
    <main class:list={["wrap", { full }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          huckepack collects facts about official long-distance trails. Every figure names its source.
        </p>
        <p>Maps and trail lines © OpenStreetMap contributors (ODbL), basemap by OpenFreeMap.</p>
        <p class="legal-links"><a href="/trails/all/">All trails A–Z</a><a href="/trails/seasons/">Season planner</a><a href="/legal-notice/" rel="nofollow">Legal notice</a><a href="/privacy/" rel="nofollow">Privacy</a></p>
      </div>
    </footer>
    <script>
      // the easter egg (issue #155): a click on the sun, or the moon at night, in a drawing (the home
      // page's hero, a trail page's skyline) switches between light and dark and remembers it; the sky
      // goes with it, night in dark mode and the clock's again in light mode (src/lib/sky.ts)
      // When the sky changes with it, the sun sets behind the drawing's hills and the moon rises (or the
      // other way round) while the sky's colours fade over; at once with reduced motion
      document.addEventListener("click", (e) => {
        if (!(e.target as Element).closest?.("[data-theme-sun]")) return;
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        const sky = root.dataset.skyClock ? (next === "dark" ? "night" : root.dataset.skyClock) : root.dataset.sky;
        const apply = () => {
          root.dataset.theme = next;
          if (sky) root.dataset.sky = sky;
          try {
            localStorage.setItem("theme", next);
          } catch {}
        };
        const suns = [...document.querySelectorAll<HTMLElement>("[data-theme-sun]")];
        if (sky === root.dataset.sky || matchMedia("(prefers-reduced-motion: reduce)").matches || !suns.length) return apply();
        // down past its band's foot, behind the hills drawn over it, cut off a little above the foot so it
        // never shows in the band below, nor in the hairline a stretched drawing can leave at its lower edge
        // (the hero's ridges; on a trail page, the top of the ground strip under the drawing); ten steps,
        // each clipping what has passed that line
        const path = (el: HTMLElement) => {
          const band = (el.closest(".hero-band, .skyline") ?? el.offsetParent ?? el) as HTMLElement;
          const sun = el.getBoundingClientRect();
          const floor = band.querySelector(".sk-svg") ?? band;
          const foot = floor.getBoundingClientRect().bottom - 6;
          const total = foot - sun.top + 10;
          return Array.from({ length: 11 }, (_, k) => {
            const d = (total * k) / 10;
            const below = Math.min(sun.height, Math.max(0, sun.bottom + d - foot));
            return { transform: `translateY(${d.toFixed(1)}px)`, clipPath: `inset(0 0 ${below.toFixed(1)}px 0)` };
          });
        };
        const sets = suns.map((el) => el.animate(path(el), { duration: 450, easing: "ease-in", fill: "forwards" }));
        Promise.all(sets.map((a) => a.finished)).then(() => {
          apply();
          suns.forEach((el, i) => {
            sets[i].cancel();
            // the new sun or moon, measured where it now stands, rises the same way back
            el.animate(path(el).reverse(), { duration: 650, easing: "cubic-bezier(0.2, 0.8, 0.3, 1)" });
          });
        });
      });
    </script>
    <script>
      // links to other websites open in a new tab (with a note for screen readers); links within
      // huckepack stay in the same tab, so back and the breadcrumbs work as usual
      for (const a of document.querySelectorAll<HTMLAnchorElement>("a[href]")) {
        if (!a.protocol.startsWith("http") || a.host === location.host || a.target) continue;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.insertAdjacentHTML("beforeend", '<span class="sr-only"> (opens in a new tab)</span>');
      }
    </script>
    <script>
      // months picked in the search (the URL's `months`: its When filter, the home page's trip
      // search, issues #114 and #128) re-rate every difficulty on the page (src/lib/months.ts
      // rerate(), elements with data-rate; the trail page's climate card listens for "monthpick");
      // the search, the trail map and the guide write their filters with replaceState: follow them
      import { readPick, rerate } from "../lib/months";

      const show = () => {
        const pick = readPick(location.search);
        rerate(document, pick);
        document.dispatchEvent(new CustomEvent("monthpick", { detail: pick }));
      };
      // a pick goes along to a trail page (issue #211): links to /trails/<slug>/ get the URL's months
      // as they are followed (also cards added later and links opened in a new tab); nothing stored
      const carry = (e: Event) => {
        const a = (e.target as Element).closest?.<HTMLAnchorElement>("a[href]");
        const pick = new URLSearchParams(location.search).get("months");
        if (!a || !pick || a.host !== location.host || !/^\/trails\/(?!map\/|guide\/)[^/]+\/$/.test(a.pathname)) return;
        const url = new URL(a.href);
        url.searchParams.set("months", pick);
        a.href = url.href;
      };
      for (const type of ["pointerdown", "focusin", "click"]) document.addEventListener(type, carry, true);
      const replace = history.replaceState.bind(history);
      history.replaceState = (...args: Parameters<History["replaceState"]>) => {
        replace(...args);
        show();
      };
      show();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f9f8f0;
    --surface: #efeee0;
    --text: #25261c;
    --muted: #61624c; /* 5.2:1 on the guide's tinted answers (at least 4.5:1, issue #86) */
    --line: #e0dfcc;
    --accent: #5a7526;
    /* the accent as text colour: a little darker in light mode, so it keeps 4.5:1 on the cream
       surfaces (#efeee0, the guide's tint), which the accent itself misses (4.49:1, issue #86) */
    --accent-text: #4f6820;
    --accent-soft: #e6ecd3;
    /* status: good / caution / restrictive, each a strong colour and a card tint */
    --good: #4a6534;
    --good-soft: #e9eedd;
    --fair: #7f5410;
    --fair-soft: #f7edd5;
    --poor: #9c3626;
    --poor-soft: #f8e7e0;
    /* water points in charts: the one cool colour, kept to water */
    --water: #2f6690;
    /* surface categories in charts, in natural colours (issue #15): earth, sand, asphalt. Checked with
       the dataviz validator in both modes: they stay apart for normal and colour-blind vision; paved
       is an asphalt grey on purpose (no hue), so it differs by lightness; every category is named */
    --surface-natural: #b26232;
    --surface-gravel: #c9a64d;
    --surface-paved: #50565c;
    --surface-unknown: #d6ccbf;
    /* climate (validated with the dataviz validator): the trail's low and high ground; wet days in
       water blue with snow days as its light step. The high ground is a deep navy (a lavender in
       dark mode), apart from the wet-days blue by lightness: they share a legend row (issue #24) */
    --clim-low: #c46a1f;
    --clim-high: #2a2f6e;
    --wet: #2f6690;
    --snow: #86afd0;
    --daylight: #e8a800; /* strong yellow; below 3:1 on cream, so every pill carries its value */
    /* landscape groups (pipeline/landcover.py), in this fixed order; checked with the dataviz
       validator: neighbours apart in both modes, every group named in text */
    --land-forest: #1f6e3a;
    --land-open: #b9b62c;
    --land-moss: #22b2a6;
    --land-bare: #9264ac;
    --land-water: #2c5cc2;
    --land-farm: #e06a4f;
    /* gradients, diverging: climbs warm, descents violet, each a moderate and a steep (≥ 15 %) step */
    --grade-up: #e0956a;
    --grade-up-steep: #a8432a;
    --grade-down: #9d95d6;
    --grade-down-steep: #4d4498;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
    color-scheme: light;
  }
  /* dark: after the easter egg (a click on a drawing's sun or moon, issue #155) */
  :root[data-theme="dark"] {
    --bg: #18190f;
    --surface: #202217;
    --text: #ecebdb;
    --muted: #a7a78f;
    --line: #36382a;
    --accent: #b4cb76;
    --accent-text: var(--accent);
    --accent-soft: #2d3320;
    --good: #a9c48a;
    --good-soft: #283020;
    --fair: #e2b866;
    --fair-soft: #382d18;
    --poor: #ee9c87;
    --poor-soft: #3b231e;
    --water: #86b6db;
    --surface-natural: #a74f21;
    --surface-gravel: #ad8f2a;
    --surface-paved: #babec3;
    --surface-unknown: #4a4038;
    --clim-low: #c97a37;
    --clim-high: #a99be8;
    --wet: #4a7aa1;
    --snow: #c4dcef;
    --daylight: #f5c518;
    --land-forest: #4ba22a;
    --land-open: #656a08;
    --land-moss: #0a9b94;
    --land-bare: #8e3da5;
    --land-water: #298afe;
    --land-farm: #a84900;
    --grade-up: #8f4a2e;
    --grade-up-steep: #ee9f76;
    --grade-down: #5a529e;
    --grade-down-steep: #b3acf0;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  /* always keep the scrollbar's space, so pages don't shift sideways when content grows past the
     window or shrinks back (e.g. stepping through the guide's questions, filtering the search) */
  html {
    scrollbar-gutter: stable;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 var(--sans);
  }
  /* 1200 px of content (plus the 16 px gutters), centred: the 2026 desktop standard for 1280–1440 px
     screens; at 1280 px with a scrollbar it still keeps the gutters */
  .wrap {
    max-width: 1232px;
    margin: 0 auto;
    padding: 0 16px;
  }
  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 32px 0 8px;
  }
  h2 {
    font-size: 1.3rem;
    margin: 0 0 12px;
  }
  a {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }
  /* read by screen readers, not shown */
  /* the maps' credits (MapLibre's attribution): links underlined, not told apart by colour alone;
     one class more than MapLibre's own rule, whose stylesheet loads later */
  .maplibregl-ctrl.maplibregl-ctrl-attrib a {
    text-decoration: underline;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .muted {
    color: var(--muted);
  }
  .button {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }
  .button:hover {
    filter: brightness(1.08);
  }
  select,
  input {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 6px 10px;
  }
  select:focus,
  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .site-header {
    position: relative; /* the header search's band (issue #154) hangs from it */
    border-bottom: 1px solid var(--line);
  }
  .site-header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  /* the header's right side, the same on every page: the search icon */
  .header-end {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  /* phones: a little closer together */
  @media (max-width: 559px) {
    .header-end {
      flex: 1 1 auto;
      justify-content: flex-end;
      min-width: 0;
      margin-left: 12px;
      gap: 8px;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  /* the cairn: an 8 × 8 pixel logo at 24 px, three screen pixels per logo pixel */
  .brand-mark {
    display: block;
    width: 24px;
    height: 24px;
    color: var(--accent);
  }
  .brand-mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* a full page (the trail map): header, page and footer fill the window exactly; only the page's
     own panels scroll, and the footer is one slim row */
  body.full {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow: hidden;
  }
  .wrap.full {
    overflow: clip;
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: none;
    padding: 0;
  }
  body.full .site-footer {
    margin-top: 0;
    padding: 8px 0;
    font-size: 0.78rem;
  }
  body.full .site-footer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
  }
  body.full .site-footer p {
    margin: 0;
  }
  body.full .site-footer p:first-child,
  body.full .legal-links {
    margin-top: 0 !important;
  }
  /* phones: the footer keeps its links and the attribution, not the tagline */
  @media (max-width: 639px) {
    body.full .site-footer p:first-child {
      display: none;
    }
  }
  .site-footer {
    margin-top: 56px;
    padding: 24px 0 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer p {
    margin: 0 0 4px;
  }
  .legal-links {
    display: flex;
    gap: 20px;
    margin-top: 12px !important;
  }
  .legal-links a {
    color: var(--muted);
  }
  .legal-links a:hover {
    color: var(--text);
  }
</style>
