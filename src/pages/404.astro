---
// The page GitHub Pages serves (as 404.html, with status 404) for an address that doesn't exist:
// the ways back into the site. Left out of the sitemap (src/pages/sitemap.xml.ts).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const count = (await getCollection("trails")).length;
---

<Base title="Page not found · huckepack" description="This page doesn't exist on huckepack.">
  <section class="lost">
    <h1>Page not found</h1>
    <p>This page doesn't exist, or it has moved. The trails are all still here:</p>
    <ul>
      <li><a href="/trails/">Search all {count} trails</a></li>
      <li><a href="/trails/map/">See them on the map</a></li>
      <li><a href="/trails/guide/">Let a few questions choose one</a></li>
      <li><a href="/">Go to the start page</a></li>
    </ul>
  </section>
</Base>

<style>
  .lost {
    max-width: 560px;
    margin: 64px auto;
  }
  .lost ul {
    display: grid;
    gap: 8px;
    padding-left: 20px;
  }
  .lost a {
    color: var(--accent-text);
  }
</style>
