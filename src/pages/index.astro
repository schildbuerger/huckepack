  /* totals and sources: grouped by space alone, no rules or hairlines; label first in the markup (dt
     before dd), value first on screen. Totals: two columns on phones, four from 720 px, one row from
     1080 px; sources: two columns on phones, three from 1080 px */
  .strip {
    display: grid;
    gap: 18px 40px;
    margin: 0;
  }
  .totals,
  .sources {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .totals {
    justify-items: center;
    gap: 20px 12px;
  }
  /* the band under the hero, in the front ridge's colour (#4c6420 by day, #18211a at night, as
     .hb-ridge.r2), so the ridges run on into it without a seam; fixed colours like the sky's, not the
     theme's. Stamps in cream: numbers and rings 6.0:1 on the day green, labels 5.2:1; at night 13.7:1
     and 9.2:1 */
  .totals-band {
    --stamp: #f6f3e4;
    --stamp-label: #dfe6c4;
    margin: 0 calc(50% - 50vw);
    padding: 48px 16px 96px;
    background: #4c6420;
  }
  :global(html[data-sky="night"]) .totals-band {
    --stamp: #ecebdb;
    --stamp-label: #c3c2b0;
    background: #18211a;
  }
  .totals-band .totals {
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (min-width: 720px) {
    .totals {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .totals {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .sources {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .totals div {
    display: flex;
    flex-direction: column;
  }
  .totals .count {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }
  .totals dd {
    order: 1;
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.15;
  }
  /* the totals as park stamps (2026-11-02; of five previews, approach C): round, a solid ring and a
     dashed one inside, in the accent's text colour, each turned a little, so the row reads like the
     stamps a trail passport collects: a nod to the hero's landscape without being part of it */
  .totals div {
    position: relative;
    justify-content: center;
    align-items: center;
