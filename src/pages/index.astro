---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import { mainStages, summarize } from "../lib/trails";

const entries = (await getCollection("trails")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const trails = entries.map(({ id, data }) => summarize(id, data));
const fmt = (n: number) => n.toLocaleString("en");
const days = (d: [number, number] | null) => (d === null ? null : d[0] === d[1] ? `${d[0]}` : `${d[0]}–${d[1]}`);

// what sets huckepack apart, as bullets under the headline
const usps = [
  "Everything on one page: stages, climbs, ground underfoot, beds and water",
  "Every figure names its source",
  "Compare and filter trails, or let the guide help you choose",
];

// totals for the strip under the hero
const totals = {
  trails: trails.length,
  countries: new Set(trails.flatMap((t) => t.countries)).size,
  km: Math.round(trails.reduce((sum, t) => sum + (t.lengthKm ?? 0), 0)),
  stages: entries.reduce((sum, e) => sum + mainStages(e.data).length, 0),
};

// the featured trail: the first one for now; its elevation profile and surfaces as previews
const featured = trails[0];
const featuredDerived = featured && (await getEntry("derived", featured.slug))?.data;
const elevation = featuredDerived?.elevation;
const surface = featuredDerived?.surface;
const W = 1000;
const H = 110;
const spark = (() => {
  if (!elevation) return null;
  const step = Math.max(1, Math.floor(elevation.points.length / 200));
  const pts = elevation.points.filter((_, i) => i % step === 0);
  const lo = elevation.lowest.m - 80;
  const hi = elevation.highest.m + 40;
  const x = (km: number) => (km / elevation.routeKm) * W;
  const y = (m: number) => H - ((m - lo) / (hi - lo)) * (H - 8);
  const line = pts.map(([km, m], i) => `${i ? "L" : "M"}${x(km).toFixed(1)},${y(m).toFixed(1)}`).join("");
  return { line, area: `${line}L${W},${H}L0,${H}Z`, peak: elevation.highest.m };
})();

const features: { icon: IconName; title: string; text: string }[] = [
  { icon: "chart-column", title: "Key figures", text: "Length, ascent and descent, difficulty on the SAC scale, days, distance per day and the season." },
  { icon: "map", title: "Map", text: "The route on an OpenStreetMap map, stage by stage, with approaches and variants." },
  { icon: "footprints", title: "Surfaces", text: "How much is natural ground, gravel or paved, and where along the trail." },
  { icon: "mountain", title: "Elevation", text: "The full profile with the highest and lowest points, on the same kilometres as everything else." },
  { icon: "list-ordered", title: "Stages", text: "Every official stage with distance, ascent, descent, elevation and walking time." },
  { icon: "tent", title: "Sleeping", text: "Huts, campsites, hostels and rooms along the way, and whether wild camping is allowed." },
  { icon: "droplet", title: "Water", text: "Drinking water and springs along the route, and the longest stretch without." },
  { icon: "train-front", title: "Getting there", text: "The nearest main station and airports, with the road distance to the start." },
];

const sources = [
  { name: "Trail operators", what: "Official stages, distances, times and rules" },
  { name: "OpenStreetMap", what: "Route, surfaces, water points and the map" },
  { name: "Copernicus DEM", what: "Elevation profile and steepness, 30 m terrain model" },
  { name: "OSRM", what: "Road distances from travel hubs" },
];
---

<Base
  title="huckepack · find your next outdoor adventure"
  description="Official long-distance hiking trails, compared: length, ascent, stages, surfaces, elevation, where to sleep, water and maps, each with its source."
>
  <section class="hero">
    <p class="eyebrow">Long-distance hiking trails</p>
    <h1>Find your next outdoor adventure.</h1>
    <ul class="usps">
      {usps.map((u) => (
        <li>
          <Icon name="check" size={18} class="usp-mark" />
          {u}
        </li>
      ))}
    </ul>
    <div class="ctas">
      <a class="button cta" href="/trails/">Explore the trails <span aria-hidden="true">→</span></a>
      <a class="cta-secondary" href="/trails/guide/">Help me choose</a>
    </div>
  </section>

  <!-- each figure twice: the final value for screen readers, and a copy the script below counts up -->
  <dl class="strip totals">
    {[
      ["Trails", totals.trails],
      [totals.countries === 1 ? "Country" : "Countries", totals.countries],
      ["Kilometres documented", totals.km],
      ["Official stages", totals.stages],
    ].map(([label, n]) => (
      <div>
        <dt>{label}</dt>
        <dd><span class="sr-only">{fmt(n as number)}</span><span class="count" aria-hidden="true" data-count={n}>{fmt(n as number)}</span></dd>
      </div>
    ))}
  </dl>
  <script is:inline>
    // The totals count up from 0 the first time the strip is on screen (1.2 s, ease-out, all
    // together). Runs right after the strip, before the first paint, so the final numbers never
    // flash first; without JavaScript or with reduced motion they simply stand.
    (() => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
      const strip = document.currentScript.previousElementSibling;
      const counts = [...strip.querySelectorAll("[data-count]")];
      // keep each number's final width, so nothing shifts while it counts
      for (const el of counts) {
        el.style.minWidth = `${el.getBoundingClientRect().width}px`;
        el.textContent = "0";
      }
      const run = () => {
        const start = performance.now();
        const frame = (now) => {
          const t = Math.min((now - start) / 1200, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          for (const el of counts) el.textContent = Math.round(Number(el.dataset.count) * eased).toLocaleString("en");
          if (t < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      };
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        run();
      }, { threshold: 0.5 });
      io.observe(strip);
    })();
  </script>

  {featured && (
    <section class="block">
      <h2>Featured trail</h2>
      <a class="featured" href={`/trails/${featured.slug}/`}>
        <div class="featured-head">
          <p class="place">{featured.countries.join(" · ")}</p>
          <p class="name">{featured.name}</p>
          {featured.localName && <p class="local">{featured.localName}</p>}
        </div>
        <dl class="featured-figures">
          {featured.lengthKm !== null && <div><dt>Length</dt><dd>{fmt(featured.lengthKm)}<span>km</span></dd></div>}
          {featured.ascentM !== null && <div><dt>Ascent</dt><dd>{fmt(featured.ascentM)}<span>m ↑</span></dd></div>}
          {featured.days && <div><dt>Suggested</dt><dd>{days(featured.days)}<span>days</span></dd></div>}
          {featured.sac && <div><dt>Difficulty</dt><dd>{featured.sac}<span>SAC</span></dd></div>}
        </dl>
        {spark && (
          <div class="preview" aria-hidden="true">
            <svg class="spark" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
              <path class="spark-area" d={spark.area} />
              <path class="spark-line" d={spark.line} vector-effect="non-scaling-stroke" />
            </svg>
            {surface && (
              <svg class="surf" viewBox={`0 0 ${W} 8`} preserveAspectRatio="none">
                {surface.runs.map((r) => (
                  <rect
                    x={(r.fromKm / surface.routeKm) * W}
                    width={Math.max(((r.toKm - r.fromKm) / surface.routeKm) * W, 0.6)}
                    height="8"
                    style={`fill: var(--surface-${r.category})`}
                  />
                ))}
              </svg>
            )}
            <p class="preview-caption">Elevation profile (highest point {fmt(spark.peak)} m) and surfaces along the trail</p>
          </div>
        )}
        <span class="open">Open the trail →</span>
      </a>
    </section>
  )}

  <section class="block">
    <h2>On every trail page</h2>
    <ul class="features">
      {features.map((f) => (
        <li>
          <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
          <div>
            <p class="feature-title">{f.title}</p>
            <p class="feature-text">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="block">
    <h2>Built on open data</h2>
    <p class="intro muted">
      Sources disagree about trails, so we don't pick a number quietly: every figure names where it comes from, and each
      trail page lists its sources with their licences.
    </p>
    <dl class="strip sources">
      {sources.map((s) => (
        <div>
          <dt>{s.name}</dt>
          <dd>{s.what}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="block">
    <h2>All trails</h2>
    <ul class="cards">
      {trails.map((t) => (
        <li>
          <a class="card" href={`/trails/${t.slug}/`}>
            <span class="card-place">{t.countries.join(", ")}</span>
            <span class="card-name">{t.name}</span>
            <span class="card-figures">
              {[t.lengthKm !== null && `${fmt(t.lengthKm)} km`, t.days && `${days(t.days)} days`, t.sac && `SAC ${t.sac}`]
                .filter(Boolean)
                .join(" · ")}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/trails/">Search and compare all trails →</a></p>
  </section>
</Base>

<style>
  .hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 0 48px;
    text-align: center;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero h1 {
    margin: 12px 0 0;
    font-size: clamp(2.3rem, 6.5vw, 3.6rem);
  }
  /* the list is centred as a block, its items left-aligned so the check marks line up */
  .usps {
    display: grid;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    margin: 20px auto 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 1.1rem;
    text-align: left;
  }
  .usps li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .usps :global(.usp-mark) {
    flex: none;
    position: relative;
    top: 3px;
    color: var(--accent);
  }
  /* the main call to action, and beside it the guided questions as a quieter outlined button */
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 16px;
    margin-top: 32px;
  }
  .cta-secondary {
    padding: 15px 30px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .cta-secondary:hover {
    background: var(--accent-soft);
  }
  .cta-secondary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .cta {
    padding: 16px 36px;
    font-size: 1.15rem;
    box-shadow: 0 6px 20px -8px var(--accent);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px -8px var(--accent);
  }
  .cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cta-secondary {
      transition: none;
    }
  }

  /* strips: a rule on top, hairlines between items, like the trail pages; label first in the
     markup (dt before dd), value first on screen */
  .strip {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--line);
  }
  .strip > div {
    padding: 14px 16px;
    border-left: 1px solid var(--line);
  }
  .strip > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .totals,
  .sources {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 720px) {
    .totals,
    .sources {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 719px) {
    .totals > div:nth-child(3),
    .sources > div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .totals > div:nth-child(n + 3),
    .sources > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  .totals div,
  .featured-figures div {
    display: flex;
    flex-direction: column;
  }
  .totals .count {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }
  .totals dd,
  .featured-figures dd {
    order: 1;
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.15;
  }
  .totals dd {
    font-size: 1.9rem;
  }
  .totals dt,
  .featured-figures dt {
    order: 2;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .block {
    margin-top: 56px;
  }
  .block h2 {
    margin-bottom: 14px;
  }

  /* featured trail */
  .featured {
    display: grid;
    gap: 20px;
    padding: 24px;
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .featured:hover .open {
    text-decoration: underline;
  }
  .featured-head p {
    margin: 0;
  }
  .place {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .name {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .local {
    color: var(--muted);
    font-style: italic;
  }
  .featured-figures {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 0;
  }
  .featured-figures dd {
    font-size: 1.5rem;
  }
  .featured-figures dd span {
    margin-left: 4px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .preview svg {
    display: block;
    width: 100%;
  }
  .spark {
    height: 90px;
  }
  .spark-area {
    fill: var(--accent);
    opacity: 0.14;
  }
  .spark-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .surf {
    height: 8px;
    margin-top: 4px;
    border-radius: 2px;
  }
  .preview-caption {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .open {
    color: var(--accent);
    font-weight: 600;
  }

  /* features */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .feature-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .features p {
    margin: 0;
  }
  .feature-title {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .feature-text {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  /* sources */
  .intro {
    max-width: 66ch;
    margin: 0 0 16px;
  }
  .sources dt {
    font-weight: 600;
  }
  .sources dd {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* all trails */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-place {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .card-name {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .card-figures {
    margin-top: 8px;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
