---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TrailList from "../components/TrailList.svelte";
import { countryName, sacGrade, stageTotals } from "../lib/trails";

const trails = (await getCollection("trails"))
  .map(({ id, data: t }) => {
    const totals = stageTotals(t);
    return {
      slug: id,
      name: t.name,
      continents: t.continents,
      countries: t.countries.map(countryName),
      // lists show the stage total when there are stages, else the first stated length;
      // trail pages show every figure with its source
      lengthKm: totals?.km.value ?? t.length[0]?.km ?? null,
      ascentM: totals?.ascentM.value ?? t.ascent[0]?.m ?? null,
      days: t.days ? ([t.days.min, t.days.max] as [number, number]) : null,
      sac: sacGrade(t)?.value ?? null,
      wildCamping: t.wildCamping?.status ?? null,
      sleeping: t.sleeping?.types ?? [],
      tags: t.tags,
      draft: t.status === "draft",
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Base title="huckepack" description="Official long-distance hiking trails around the world.">
  <h1>Long-distance trails</h1>
  <TrailList client:load trails={trails} />
</Base>
