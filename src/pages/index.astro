    }
  }
  /* the guided questions, a quiet link under the trip search */
  .guide {
    margin: 20px 0 0;
    color: var(--muted);
  }
  .guide a {
    color: var(--accent-text);
    font-weight: 600;
  }

  /* the sticky call to action (issue #81): a slim bar along the bottom, sliding in */
  .cta-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--line);
    visibility: hidden;
    opacity: 0;
    transform: translateY(100%);
    transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s;
  }
  .cta-bar.shown {
    visibility: visible;
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-bar {
      transition: none;
    }
  }
  .cta-bar-text {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .cta-bar-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .cta-bar-secondary {
    color: var(--accent-text);
