---
import { ogPageAlt } from "../lib/og-pages";
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import Explain from "../components/Explain.astro";
import TripSearch from "../components/TripSearch.astro";
import { mainStages, stageEstimates, trailClimb } from "../lib/trails";
import { LEVELS } from "../lib/difficulty";
import { climateLevel } from "../lib/filters";
import { rateData } from "../lib/months";
import { searchSummary } from "../lib/search";
import zones from "../lib/timezones.json";
import { worldOutline } from "../lib/world-outline";
import { inlineScript } from "../lib/inline-script";
import { SKY_SCRIPT } from "../lib/sky";
import { readFileSync, existsSync } from "node:fs";

const entries = (await getCollection("trails")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const derivedAll = await Promise.all(entries.map(async (e) => (await getEntry("derived", e.id))?.data));
const trails = entries.map(({ id, data }, i) => searchSummary(id, data, derivedAll[i]));
// the most recently added trails (issue #80), newest first, by the record's `added` date
const RECENT = 6;
const addedOf = new Map(entries.map((e) => [e.id, e.data.added]));
const recent = [...trails]
  .sort((a, b) => addedOf.get(b.slug)!.getTime() - addedOf.get(a.slug)!.getTime() || a.name.localeCompare(b.name))
  .slice(0, RECENT);
const addedShort = (slug: string) =>
  addedOf.get(slug)!.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
// a trail's difficulty in one word: the hardest of its three ratings, climate for its best run of
// season months, as the trail page's key figure shows it; months picked in the search re-rate it in
// the browser (data-rate, src/lib/months.ts rerate())
const difficultyWord = (t: (typeof trails)[number]) => {
  const xs = [t.terrainLevel, t.effortLevel, climateLevel(t, [])].filter((x) => x !== null) as number[];
  return xs.length ? LEVELS[Math.max(...xs) - 1] : null;
};
const fmt = (n: number) => n.toLocaleString("en");
const days = (d: [number, number] | null) => (d === null ? null : d[0] === d[1] ? `${d[0]}` : `${d[0]}–${d[1]}`);

// the three promises under the headline (of three previews, approach A: icon columns), each a short
// title and one plain line; the mission's find, plan and sources, joined by a trail from one to the next
const usps: { icon: IconName; title: string; text: string }[] = [
  { icon: "map", title: "Trails that fit you", text: "By season, days, difficulty and landscape" },
  { icon: "route", title: "Know what to expect", text: "Stages, terrain, climate, water and beds" },
  { icon: "badge-check", title: "Every figure checked", text: "Official sources, named and double-checked" },
];

// the totals on the hero's summit flags (issue #212): trails, countries, kilometres, the climbs as
// times Everest and the drinking water points, each summed from the same figures the trail pages show
const EVEREST_M = 8849;
const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
const perTrail = entries.map((e, i) => {
  const d = derivedAll[i];
  const est = stageEstimates(e.data, d);
  const main = mainStages(e.data);
  // climbs as the key figures have them: the stated total or stage sums, else the terrain model's estimate
  const stated = trailClimb(e.data)?.up;
  const climbed = stated ?? sum(main.map((s) => est.get(s.number)?.ascentM ?? 0));
  const taps = d?.water?.points.filter((p) => p.kind === "drinking").length ?? 0;
  return { climbed, climbedEst: stated === undefined, taps };
});
const totals = {
  trails: trails.length,
  countries: new Set(trails.flatMap((t) => t.countries)).size,
  km: Math.round(trails.reduce((sum, t) => sum + (t.compareKm ?? 0), 0)), // measured where the match is good
  climbed: Math.round(sum(perTrail.map((t) => t.climbed)) / 10) * 10,
  taps: sum(perTrail.map((t) => t.taps)),
};
const everests = (totals.climbed / EVEREST_M).toFixed(1);

// the featured trail: every trail is rendered, and a script picks one at random on each page load
// (without JavaScript, the first shows); each with its elevation profile and surfaces as previews
// the box the profiles are drawn in (src/components/TrailSpark.astro draws them)
const W = 1000;
const H = 110;
const featuredAll = trails.map((t, i) => {
  const d = derivedAll[i];
  const elevation = d?.elevation;
  const spark = (() => {
    if (!elevation) return null;
    const step = Math.max(1, Math.floor(elevation.points.length / 200));
    const pts = elevation.points.filter((_, i) => i % step === 0);
    const lo = elevation.lowest.m - 80;
    const hi = elevation.highest.m + 40;
    const x = (km: number) => (km / elevation.routeKm) * W;
    const y = (m: number) => H - ((m - lo) / (hi - lo)) * (H - 8);
    const line = pts.map(([km, m], i) => `${i ? "L" : "M"}${x(km).toFixed(1)},${y(m).toFixed(1)}`).join("");
    return { line, area: `${line}L${W},${H}L0,${H}Z`, peak: elevation.highest.m };
  })();
  return { t, spark, surface: d?.surface, climb: perTrail[i], level: difficultyWord(t) };
});
// the featured trail's candidates (issue #93): seven, chosen at build time in an order that changes
// with the build's day, so the page carries the same seven cards (with their drawings) however many
// trails there are; the script below shows one of them at random
const FEATURED = 7;
const buildDay = Math.floor(Date.now() / 86_400_000);
const shuffleKey = (slug: string) => [...`${slug}:${buildDay}`].reduce((h, c) => (Math.imul(h, 31) + c.charCodeAt(0)) >>> 0, 7);
const featuredSet = [...featuredAll].sort((a, b) => shuffleKey(a.t.slug) - shuffleKey(b.t.slug)).slice(0, FEATURED);

// the featured trail's route shape: the main stages from public/routes/ (the map line), equirectangular,
// fitted into a 200 × 140 box, about 240 points, with its start and finish
const routeShape = (slug: string) => {
  const file = `public/routes/${slug}.geojson`;
  if (!existsSync(file)) return null;
  const fc = JSON.parse(readFileSync(file, "utf8"));
  const pts: [number, number][] = fc.features.filter((f: any) => f.properties.kind === "main").flatMap((f: any) => f.geometry.coordinates);
  if (pts.length < 2) return null;
  const k = Math.cos(((pts.reduce((a, p) => a + p[1], 0) / pts.length) * Math.PI) / 180);
  const xs = pts.map((p) => p[0] * k), ys = pts.map((p) => -p[1]);
  const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
  const sc = Math.min(180 / (x1 - x0 || 1), 120 / (y1 - y0 || 1));
  const ox = (200 - (x1 - x0) * sc) / 2, oy = (140 - (y1 - y0) * sc) / 2;
  const step = Math.max(1, Math.floor(pts.length / 240));
  const xy = pts.filter((_, i) => i % step === 0 || i === pts.length - 1).map((_, i, a) => a[i]).map((p) => [+(ox + (p[0] * k - x0) * sc).toFixed(1), +(oy + (-p[1] - y0) * sc).toFixed(1)]);
  return { d: `M${xy.map((p) => p.join(",")).join("L")}`, start: xy[0], end: xy[xy.length - 1] };
};


// popular trails (issue #84): the three whose Wikipedia articles people viewed most in twelve months,
// all languages summed (pipeline/popularity.py, Wikimedia); trails without an article aren't ranked
const POPULAR = 3;
const popular = featuredAll
  .map((f, i) => ({ ...f, views: derivedAll[i]?.popularity?.views ?? null }))
  .filter((f) => f.views !== null)
  .sort((a, b) => b.views! - a.views!)
  .slice(0, POPULAR);
const viewsWindow = derivedAll.find((d) => d?.popularity)?.popularity;
const monthYear = (ym: string) => new Date(`${ym}-01T00:00:00Z`).toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
// trails near you (issue #85): a script finds the six whose start or finish is nearest to the place the
// browser's time zone stands for (src/lib/timezones.json), from /trails/search.json (issue #93)
const figureLine = (t: (typeof trails)[number]) =>
  [t.lengthKm !== null && `${fmt(t.lengthKm)} km`, t.days && `${days(t.days)} days`].filter(Boolean).join(" · ");
const rateOf = (t: (typeof trails)[number]) => rateData(t.terrainLevel, t.effortLevel, t.climateByMonth, t.season);
// the logbook's stamps: each recent trail's profile (80 × 28, on its own height range), the day it was
// added, its length; a name too long for the rim is cut short there (the full name is under the stamp)
const logEntries = recent.map((t, n) => {
  const prof = t.profile ?? [];
  const lo = prof.length ? Math.min(...prof.map((p) => p[1])) : 0;
  const hi = prof.length ? Math.max(...prof.map((p) => p[1]), lo + 300) : 1;
  const total = prof.at(-1)?.[0] || 1;
  const spark = prof.length ? `M0,28L${prof.map(([k, m]) => `${((k / total) * 80).toFixed(1)},${(28 - ((m - lo) / (hi - lo)) * 26).toFixed(1)}`).join("L")}L80,28Z` : "";
  const added = addedOf.get(t.slug)!;
  return {
    t,
    n,
    spark,
    rim: t.name.length > 22 ? `${t.name.slice(0, 21)}…` : t.name,
    stamp: added.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).toUpperCase(),
    date: addedShort(t.slug),
    km: t.lengthKm !== null ? `${fmt(t.lengthKm)} KM` : "",
  };
});
// the stamps' inks, by day and (lighter, for the dark band) at night; a slight tilt each, as stamped by hand
const INKS = ["#4f6820", "#a63d24", "#2f5d7c", "#6b4e8a", "#3f4a2c", "#8a5a1f"];
const INKS_DARK = ["#b4cb76", "#e08a6e", "#86b4d4", "#b9a2d6", "#a9bf80", "#d9a45e"];
const TILTS = [-6, 4, -3, 7, -5, 2];

// the map section (issue #33): the whole world with a flag at each trail's start, drawn at build time
// (src/lib/world-outline.ts), so the home page loads no map library; it links to /trails/map/
// the hero's landscape: three ridges from real trails' profiles (the highest, a middle one, the lowest),
// back to front, each on its own height range and stretched to the band's width; and the night sky's
// stars at fixed places (x in tenths of a percent of the width, y in a 380-high sky, radius in pixels)
const ridgeTrails = featuredAll.filter((f) => f.spark).sort((a, b) => b.spark!.peak - a.spark!.peak);
const heroRidges = [ridgeTrails[0], ridgeTrails[Math.floor(ridgeTrails.length / 2)], ridgeTrails[ridgeTrails.length - 1]].filter(Boolean).map((f) => f!.spark!.area);
const stars = (() => {
  let seed = 7;
  const rand = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
  return Array.from({ length: 70 }, () => [Math.round(rand() * 1000), Math.round(rand() * 380), +(0.8 + rand() * 1.6).toFixed(1)]);
})();
const countryCount = new Set(entries.flatMap((e) => e.data.countries)).size;
// the clouds drifting over the map section, each with its birds ([x, y] from the cloud's left foot)
const clouds = [
  { x: 60, y: 40, k: 1, birds: [[38, -14], [46, -9]] },
  { x: 250, y: 18, k: 0.8, birds: [[-12, 4], [-6, 9], [-16, 11]] },
  { x: 410, y: 52, k: 1.2, birds: [[44, -6], [50, 0]] },
  { x: 520, y: 26, k: 0.9, birds: [[-10, -6], [-4, -1]] },
];
const world = worldOutline(entries.map((e) => [e.data.termini.start.lon, e.data.termini.start.lat] as [number, number]), { world: true });

// what a trail page shows, in its order (src/pages/trails/[slug].astro)
const features: { icon: IconName; title: string; text: string }[] = [
  { icon: "chart-column", title: "Key figures", text: "Length, ascent and descent, difficulty, days, distance per day, the season and the main landscape." },
  { icon: "train-front", title: "Location", text: "Start and finish, the nearest main station and airports with the road distance, and the trail's waymark." },
  { icon: "map", title: "Map", text: "The route on an OpenStreetMap map, stage by stage, with approaches and variants." },
  { icon: "gauge", title: "Difficulty", text: "Terrain, climate and the length of the days, each rated Easy to Hard by the same rule on every trail." },
  { icon: "cloud-sun", title: "Climate", text: "Day and night temperatures, wet days, snow and daylight by month, low down and up high." },
  { icon: "list-ordered", title: "Stages", text: "Every official stage with distance, ascent, descent, elevation and walking time; our estimates marked where a source gives none." },
  { icon: "mountain", title: "Terrain", text: "The elevation profile coloured by its steepness, the ground underfoot beneath it, and the tree line where the trail climbs above it." },
  { icon: "trees", title: "Landscape", text: "Forest, open hills, moss, rock or snow: what the trail passes through, and where." },
  { icon: "tent", title: "Sleeping", text: "Huts, campsites, hostels and rooms along the way, and whether wild camping is allowed." },
  { icon: "droplet", title: "Water", text: "Drinking water, refills and springs along the route, and the longest stretch without." },
];

const sources = [
  { name: "Trail operators", what: "Official stages, distances, times, seasons, waymarks and rules" },
  { name: "Second sources", what: "Wikipedia, regions, tourism boards and trail portals: every trail checked against one" },
  { name: "OpenStreetMap", what: "Route, surfaces, water points, travel hubs and the map, its relief from AWS Terrain Tiles" },
  { name: "Copernicus DEM", what: "Elevation profile and steepness, 30 m terrain model" },
  { name: "ESA WorldCover", what: "Landscape along the route, 10 m satellite land cover" },
  { name: "ERA5 (Open-Meteo)", what: "Climate and wind by month, 30 years of weather" },
  { name: "OSRM", what: "Road distances from the travel hubs to the start" },
  { name: "Wikimedia", what: "Wikipedia page views, which rank the popular trails" },
  { name: "tz database (IANA)", what: "Each time zone's main city, to find the trails near you in your browser" },
];
// inline scripts that must run before the first paint, hashed for the Content Security Policy
const countScript = inlineScript(Astro, `// The totals on the summit flags count up from 0 the first time they are on screen (1.2 s,
// ease-out, all together). Runs right after them, before the first paint, so the final numbers
// never flash first; without JavaScript or with reduced motion they simply stand.
(() => {
  if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
  const strip = document.currentScript.previousElementSibling;
  if (!strip) return;
  const counts = [...strip.querySelectorAll("[data-count]")];
  // keep each number's final width, so nothing shifts while it counts
  for (const el of counts) {
    el.style.minWidth = \`\${el.getBoundingClientRect().width}px\`;
    el.textContent = "0";
  }
  const run = () => {
    const start = performance.now();
    const frame = (now) => {
      const t = Math.min((now - start) / 1200, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      for (const el of counts) {
        const dec = Number(el.dataset.dec ?? 0);
        el.textContent = (Number(el.dataset.count) * eased).toLocaleString("en", { minimumFractionDigits: dec, maximumFractionDigits: dec });
      }
      if (t < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  };
  const io = new IntersectionObserver((entries) => {
    if (!entries.some((e) => e.isIntersecting)) return;
    io.disconnect();
    run();
  }, { threshold: 0.5 });
  io.observe(strip);
})();`);
// the hero's sky follows the visitor's clock: dawn, day, dusk or night, and the sun (or the moon) on
// its arc across the band; before the first paint, so the sky never changes in front of the visitor
const skyScript = inlineScript(Astro, SKY_SCRIPT);
const featuredScript = inlineScript(Astro, `// A random featured trail on each page load. Runs right after the cards, before the first
// paint, so the first trail never flashes; without JavaScript the first one stays.
(() => {
  const cards = [...document.currentScript.parentElement.querySelectorAll(".featured")];
  const pick = Math.floor(Math.random() * cards.length);
  cards.forEach((c, i) => (c.hidden = i !== pick));
})();`);
import AboutBand from "../components/AboutBand.astro";
import HeroStats from "../components/HeroStats.astro";
import SummitPoles from "../components/SummitPoles.astro";
import { summitFlags } from "../lib/summit-flags";
import Explainer from "../components/Explainer.astro";
---

<Base
  image={{ path: "/og/page/home.png", alt: await ogPageAlt("home") }}
  title="huckepack: find a long-distance hiking trail and go prepared"
  description={`Compare ${totals.trails} official long-distance hiking trails in ${totals.countries} countries: stages, terrain, climate, water and beds, every figure from official and open sources.`}
>
  <!-- issue #83 (of three previews, approach B): search with suggestions, in the header -->

  <script is:inline set:html={skyScript} />
  <!-- the hero on a band wall to wall: a sky by the hour, the sun or the moon, stars at night, and three
       ridges of real trails in front, drifting with the pointer -->
  <div class="hero-band">
    <!-- no viewBox: each star's place is a share of the sky (percentages), its radius in pixels, so the
         stars stay round dots whatever the band's shape (a stretched viewBox drew them as ellipses) -->
    <svg class="hb-stars" aria-hidden="true">
      {stars.map(([x, y, r]) => <circle cx={`${x / 10}%`} cy={`${+(y / 3.8).toFixed(1)}%`} r={r} />)}
    </svg>
    <span class="hb-sun" aria-hidden="true" data-theme-sun></span>
    <div class="hb-ridges" aria-hidden="true">
      {heroRidges.map((d, i) => (
        <>
          <!-- the summit flags' poles on this ridge, just behind it, so it hides their feet (issue #212) -->
          <SummitPoles ridge={i} flags={summitFlags(heroRidges)} />
          <svg class={`hb-ridge r${i}`} viewBox="0 0 1000 110" preserveAspectRatio="none"><path d={d} /></svg>
        </>
      ))}
    </div>
    <!-- the totals as small flags on the ridges' summits (issue #212), drifting with their ridges -->
    <HeroStats totals={{ trails: totals.trails, countries: totals.countries, km: totals.km, everests: Number(everests), taps: totals.taps }} ridges={heroRidges} />
    <script is:inline set:html={countScript} />
    <section class="hero">
      <p class="label eyebrow">Long-distance trails, in data</p>
      <!-- the second sentence never splits, so the headline wraps between the two -->
      <h1>Find your trail. <span class="nowrap">Go prepared.</span></h1>
      <!-- the three promises, as three waypoints on a little trail -->
      <ol class="usps">
        {usps.map((u) => (
          <li>
            <span class="usp-icon"><Icon name={u.icon} size={22} /></span>
            <strong>{u.title}</strong>
            <span class="usp-text">{u.text}</span>
          </li>
        ))}
      </ol>
      <!-- issue #128 (of three previews, approach A): a trip search, when first, into the results -->
      <TripSearch trails={trails} />
      <p class="guide">Not sure yet? <a href="/trails/guide/">Help me choose <span aria-hidden="true">→</span></a></p>
    </section>

  </div>
  <!-- what huckepack is and why it exists (issue #210): for a first visit, after how much there is and
       before the featured trail; unnumbered, so the sections below keep 01–07 -->
  <AboutBand />

  <!-- the explainer film (2026-11-04; of three places, approach A): right after the words on what
       huckepack is, the film shows it on one trail -->
  <Explainer />

  <!-- the featured trail (2026-11-02; of five previews after public designs, approach D, like a route
       app's): a band wall to wall with soft wave edges, the trail's real route drawn when the band comes into
       view and a walker travelling it, the name, start and finish, big figures and the ground underfoot; the
       length as a giant number behind (decorative). The most read trails follow under it -->
  <div class="pair">
    {featuredSet.length > 0 && (
      <section class="featured-box" aria-labelledby="featured-h">
        <div class="block-head"><h2 id="featured-h">Featured trail</h2></div>
        {featuredSet.map(({ t: featured, surface: _surface, climb, level }, i) => {
          const route = routeShape(featured.slug);
          return (
            <a class="featured" href={`/trails/${featured.slug}/`} hidden={i > 0} data-draw>
              <p class="rs-giant" aria-hidden="true">{featured.lengthKm !== null ? fmt(featured.lengthKm) : ""}</p>
              <div class="rs-shape" aria-hidden="true">
                {route && (
                  <svg viewBox="0 0 200 140">
                    <path class="rs-under" d={route.d} />
                    <path class="rs-line" d={route.d} pathLength="1" />
                    <circle class="rs-start" cx={route.start[0]} cy={route.start[1]} r="5" />
                    <circle class="rs-end" cx={route.end[0]} cy={route.end[1]} r="5" />
                    <circle class="rs-walker" r="4">
                      <animateMotion dur="9s" repeatCount="indefinite" path={route.d} begin="2s" />
                    </circle>
                  </svg>
                )}
              </div>
              <div class="rs-info">
                <p class="rs-where">{featured.countries.join(" · ")}</p>
                <p class="rs-name">{featured.name}</p>
                {featured.localName && <p class="rs-local">{featured.localName}</p>}
                <p class="rs-route">
                  <span class="rs-dot start" aria-hidden="true"></span>{featured.start} <span class="rs-arrow" aria-hidden="true">→</span>
                  <span class="sr-only">to</span> <span class="rs-dot end" aria-hidden="true"></span>{featured.end}
                </p>
                <dl class="rs-stats">
                  {featured.lengthKm !== null && <div><dt>Distance</dt><dd>{fmt(featured.lengthKm)}<span>km</span></dd></div>}
                  {climb.climbed > 0 && <div><dt>Ascent{climb.climbedEst && ", estimate"}</dt><dd>{climb.climbedEst && "≈"}{fmt(climb.climbed)}<span>m</span></dd></div>}
                  {featured.days && <div><dt>Days</dt><dd>{days(featured.days)}</dd></div>}
                  {level && <div><dt>Difficulty</dt><dd data-rate={rateOf(featured)}><span class="rate-word">{level}</span></dd></div>}
                </dl>
                {featured.surface && (
                  <div class="rs-ground">
                    <span class="rs-bar" aria-hidden="true">
                      <span style={`flex: ${featured.surface.natural}; background: var(--surface-natural)`}></span>
                      <span style={`flex: ${featured.surface.gravel}; background: var(--surface-gravel)`}></span>
                      <span style={`flex: ${featured.surface.paved}; background: var(--surface-paved)`}></span>
                    </span>
                    <span class="rs-ground-text">{Math.round(featured.surface.natural * 100)} % natural · {Math.round(featured.surface.gravel * 100)} % gravel · {Math.round(featured.surface.paved * 100)} % paved</span>
                  </div>
                )}
                <span class="rs-open">Open the trail →</span>
              </div>
            </a>
          );
        })}
        <script is:inline set:html={featuredScript} />
        <script>
          // the featured trail draws its route when it comes into view
          for (const el of document.querySelectorAll<HTMLElement>("[data-draw]")) {
            if (!("IntersectionObserver" in window)) el.classList.add("drawn");
            else {
              const io = new IntersectionObserver((es) => {
                if (es.some((e) => e.isIntersecting)) {
                  el.classList.add("drawn");
                  io.disconnect();
                }
              }, { threshold: 0.3 });
              io.observe(el);
            }
          }
        </script>
      </section>
    )}
    {popular.length > 0 && (
      <section aria-labelledby="popular-h">
        <div class="block-head">
          <h2 id="popular-h">Popular trails</h2>
          {viewsWindow && (
            <Explain id="popular-info" icon term="About this list" title="Popular trails">
              <dl class="pop-facts">
                <dt>Ranked by</dt><dd>Reads of the trail's Wikipedia articles, in every language, {monthYear(viewsWindow.from)} to {monthYear(viewsWindow.to)} (Wikimedia's page view data)</dd>
                <dt>Keep in mind</dt><dd>It measures interest in a trail, not how many hike it; a trail without an article isn't ranked</dd>
              </dl>
            </Explain>
          )}
        </div>
        <!-- the three most read as a podium of routes (2026-11-02), in the featured band's style: a small card
             each with the route drawn as it comes into view, the rank as a giant number behind, the figures
             and the article's reads; on wide screens the first in the middle -->
        <ol class="podium">
          {popular.map(({ t, views }, rank) => {
            const route = routeShape(t.slug);
            return (
              <li class={`pd-${rank + 1}`}>
                <a href={`/trails/${t.slug}/`} data-draw>
                  <span class="pd-giant" aria-hidden="true">{rank + 1}</span>
                  {route && (
                    <svg class="pd-route" viewBox="0 0 200 140" aria-hidden="true">
                      <path class="rs-under" d={route.d} />
                      <path class="rs-line" d={route.d} pathLength="1" />
                      <circle class="rs-start" cx={route.start[0]} cy={route.start[1]} r="6" />
                      <circle class="rs-end" cx={route.end[0]} cy={route.end[1]} r="6" />
                    </svg>
                  )}
                  <span class="pd-text">
                    <span class="pd-place">{t.countries.join(" · ")}</span>
                    <span class="pd-name">{t.name}</span>
                    <span class="pd-fig">{figureLine(t)}{difficultyWord(t) && <> · <span data-rate={rateOf(t)}><span class="rate-word">{difficultyWord(t)}</span></span></>}</span>
                    <span class="pd-views">{fmt(views!)} article reads</span>
                  </span>
                </a>
                <span class="sr-only">Rank {rank + 1}</span>
              </li>
            );
          })}
        </ol>
      </section>
    )}
  </div>


  <!-- the map as its own section (2026-11-02; of three previews, approach A, refined): a band wall to wall
       in the hero's flat style, the whole world in its light green on a calm sea, a small terracotta
       flag at each trail's start; the heading and text on the open sea of the South Pacific, in line
       with the content column; the whole band opens the trail map -->
  <section class="atlas" aria-labelledby="atlas-h">
    <a class="atlas-link" href="/trails/map/">
      <svg class="atlas-map" viewBox={`0 0 ${world.width} ${world.height}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <path class="atlas-land" d={world.landPath} />
        <g class="atlas-pins">
          {world.dots.map(([x, y]) => (
            <g transform={`translate(${x} ${y})`}>
              <path class="pole" d="M0 0 V-9" />
              <path class="flag" d="M0 -9 L5.6 -7.1 L0 -5.2 Z" />
              <circle class="dot" r="1.3" />
            </g>
          ))}
        </g>
        <!-- a few flat clouds drifting across, each with two or three birds flying along -->
        <g class="clouds">
          {clouds.map(({ x, y, k, birds }, i) => (
            <g class="cloud" style={`--c: ${i}`}>
              <path
                class="puff"
                d={`M${x} ${y} h${30 * k} a${6 * k} ${6 * k} 0 0 0 -${6 * k} -${8 * k} a${9 * k} ${9 * k} 0 0 0 -${16 * k} -${2 * k} a${7 * k} ${7 * k} 0 0 0 -${8 * k} ${10 * k} z`}
              />
              {birds.map(([bx, by], j) => (
                <path class="bird" style={`--b: ${i * 3 + j}`} d={`M${x + bx - 3.6} ${y + by} q1.8 -2.3 3.6 0 q1.8 -2.3 3.6 0`} />
              ))}
            </g>
          ))}
        </g>
      </svg>
      <span class="atlas-text">
        <span class="block-head"><h2 id="atlas-h">Explore on the map</h2></span>
        <span class="atlas-sub">All {entries.length} trails in {countryCount} countries on one map. Zoom into a region and see its trails.</span>
        <span class="atlas-open">Open the map <span aria-hidden="true">→</span></span>
      </span>
    </a>
  </section>



  <!-- the trails near you (issue #85): the trails nearest the visitor with their direction and distance;
       shown by the script below only where the time zone gives a place -->
  <div class="map-band">
    <div class="map-band-inner">
      <section class="near" hidden>
        <!-- the panorama, wall to wall, its heading in the sky: drawn by the script below for the ten
             nearest, the drawings and the names linking to their trails (on phones the list under it does) -->
        <div class="near-pano" data-near-pano>
        <div class="near-head" data-near-head>
        <div class="block-head">
          <h2>Trails near you</h2>
          <Explain id="near-info" icon term="About this list" title="Trails near you">
            <dl class="pop-facts">
              <dt>Nearest to</dt><dd><span data-near-city></span>, the main city of your browser's time zone, by each trail's start or finish</dd>
              <dt>Distance</dt><dd>Direction and straight-line distance from there, rounded</dd>
              <dt>Privacy</dt><dd>Worked out on your device: nothing is sent or stored, and no location permission is asked</dd>
            </dl>
          </Explain>
        </div>
        <p class="label near-from">From <span data-near-from></span></p>
        </div>
        <div class="near-draw" data-near-draw></div>
        </div>
        <!-- one row as a template, filled for the ten nearest from /trails/search.json (issue #93), so the
             page doesn't list every trail; shown on phones, where the panorama's names would be too small -->
        <ol class="trail-list near-list" data-near-list>
          <li data-near-row hidden>
            <a href="/trails/">
              <span class="tl-mark"><span class="tl-arrow" data-arrow>↑</span></span>
              <span class="tl-name"></span>
              <span class="tl-place"></span>
              <span class="tl-fig"><span data-dir></span> · <span data-dist></span></span>
            </a>
          </li>
        </ol>
      </section>
    </div>
  </div>
  <script type="application/json" id="zones" set:html={JSON.stringify(zones)}></script>
  <script>
    // Trails near you (issue #85): the browser's time zone (Europe/Berlin) stands for its main
    // city (the tz database's coordinates); the six trails whose start or finish is nearest, by
    // great-circle distance, with the compass direction to it. Worked out here; nothing is sent or stored.
    import { kmBetween, roundDistance } from "../lib/geo";
    import { loadTrails } from "../lib/search-data";
    const NEARBY = 10;
    const section = document.querySelector<HTMLElement>(".near")!;
    const zones: Record<string, [number, number]> = JSON.parse(document.getElementById("zones")!.textContent!);
    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const here = zones[zone];
    if (here) {
      const city = zone.split("/").pop()!.replace(/_/g, " ");
      const rad = Math.PI / 180;
      // both points are [lat, lon] here (the tz table's and the list's order)
      const km = (a: [number, number], b: [number, number]) => kmBetween([a[1], a[0]], [b[1], b[0]]);
      const bearing = ([la1, lo1]: [number, number], [la2, lo2]: [number, number]) => {
        const y = Math.sin((lo2 - lo1) * rad) * Math.cos(la2 * rad);
        const x = Math.cos(la1 * rad) * Math.sin(la2 * rad) - Math.sin(la1 * rad) * Math.cos(la2 * rad) * Math.cos((lo2 - lo1) * rad);
        return (Math.atan2(y, x) / rad + 360) % 360;
      };
      const POINTS = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"];
      const WORDS = ["north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west"];
      const list = section.querySelector<HTMLElement>("[data-near-list]")!;
      const template = list.querySelector<HTMLElement>("[data-near-row]")!;
      const trails = await loadTrails();
      const near = trails
        .map((t) => {
          const best = t.ends.map((e) => ({ e, d: km(here, e) })).sort((a, b) => a.d - b.d)[0];
          return { t, d: best.d, b: bearing(here, best.e) };
        })
        .sort((a, b) => a.d - b.d)
        .slice(0, NEARBY);
      template.remove();
      for (const { t, d, b } of near) {
        const row = template.cloneNode(true) as HTMLElement;
        row.removeAttribute("data-near-row");
        row.querySelector<HTMLAnchorElement>("a")!.href = `/trails/${t.slug}/`;
        row.querySelector<HTMLElement>(".tl-name")!.textContent = t.name;
        row.querySelector<HTMLElement>(".tl-place")!.textContent = t.countries.join(" · ");
        const point = Math.round(b / 45) % 8;
        const dist = roundDistance(d).toLocaleString("en");
        row.querySelector<HTMLElement>("[data-arrow]")!.style.transform = `rotate(${Math.round(b)}deg)`;
        row.querySelector<HTMLElement>("[data-dir]")!.textContent = POINTS[point];
        row.querySelector<HTMLElement>("[data-dist]")!.textContent = `≈ ${dist} km`;
        const a = row.querySelector<HTMLAnchorElement>("a")!;
        a.setAttribute("aria-label", `${a.querySelector(".tl-name")!.textContent}: about ${dist} km to the ${WORDS[point]}`);
        row.hidden = false;
        list.append(row); // nearest first
      }

      // The panorama (2026-11-05; of rounds of previews, approach D of the panoramas, like a printed summit
      // panorama): the horizon seen from the city, turned so the trails' directions run across the band
      // from left to right, each trail drawn at its bearing as its own skyline (/trails/skylines/<slug>.json,
      // as on its page), the nearer the bigger and the lower, in blue-grey tones by distance; its name in
      // slanted type on a leader line links to it and, pointed at, shows the drawing in its own colours.
      // Drawn at the band's width in pixels (redrawn when it changes), so the type keeps its size.
      const pano = section.querySelector<HTMLElement>("[data-near-pano]")!;
      const drawEl = pano.querySelector<HTMLElement>("[data-near-draw]")!;
      const head = pano.querySelector<HTMLElement>("[data-near-head]")!;
      type Art = { shapes: { d: string; c: string }[]; top: number };
      const arts = new Map<string, Art>();
      await Promise.all(
        near.map(({ t }) =>
          fetch(`/trails/skylines/${t.slug}.json`)
            .then((r) => (r.ok ? r.json() : null))
            .then((a: Art | null) => a && arts.set(t.slug, a))
            .catch(() => {}),
        ),
      );
      const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
      const f1 = (n: number) => n.toFixed(1);
      // the stretch of horizon the trails lie in: their bearings round the middle one, with room either side
      const sx = near.reduce((a, x) => a + Math.sin(x.b * rad), 0), cx = near.reduce((a, x) => a + Math.cos(x.b * rad), 0);
      const mid = Math.atan2(sx, cx) / rad;
      const rel = near.map((x) => ((x.b - mid + 540) % 360) - 180);
      const lo = Math.min(...rel), hi = Math.max(...rel);
      const pad = Math.max(14, (100 - (hi - lo)) / 2);
      const [from, to] = [lo - pad, hi + pad];
      const maxD = Math.max(...near.map((x) => x.d)) * 1.12;
      const nearness = (d: number) => 1 - Math.sqrt(d / maxD);
      const n0 = Math.min(...near.map((x) => nearness(x.d))), n1 = Math.max(...near.map((x) => nearness(x.d)));
      const TONES = ["--pano-t0", "--pano-t1", "--pano-t2", "--pano-t3", "--pano-t4"];
      // a fixed sequence of "random" numbers, so the far hills look the same on every visit
      const rndOf = (seed: number) => () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

      const draw = () => {
        const W = Math.round(pano.clientWidth);
        if (!W) return;
        const f = Math.min(1, Math.max(0.45, W / 1400)); // drawings' scale on narrower screens
        // the heading in the sky (its box in the band), kept clear of the names
        const pr = pano.getBoundingClientRect(), hr = head.getBoundingClientRect();
        const hb = { x0: hr.left - pr.left - 10, x1: hr.right - pr.left + 10, y1: hr.bottom - pr.top + 10 };
        // phones show no names over the drawing (the list under it links the trails), so less sky
        let HZ = W < 760 ? Math.round(hb.y1 + 30 + 60 * f) : Math.round(150 + 140 * f);
        const x0 = Math.round(150 * f), xw = W - 2 * x0;
        const items = near.map((x, i) => {
          const s = n1 > n0 ? (nearness(x.d) - n0) / (n1 - n0) : 1;
          return { ...x, i, s, x: x0 + ((rel[i] - from) / (to - from)) * xw, base: (6 + 40 * s) * f };
        });
        // trails in nearly the same direction step aside a little, so each drawing stays visible
        const byX = [...items].sort((a, b) => a.x - b.x);
        const gap = 70 * f;
        for (let k = 1; k < byX.length; k++) if (byX[k].x - byX[k - 1].x < gap) byX[k].x = byX[k - 1].x + gap;
        const shift = Math.min(0, W - x0 - byX[byX.length - 1].x);
        for (const it of items) it.x += shift;
        // a drawing's top above the horizon, and its name's length; where a name would rise under the
        // heading, the horizon moves down until it fits below it
        const SIN = Math.sin(28 * rad), COS = Math.cos(28 * rad);
        const rise = (it: (typeof items)[number]) => {
          const w = (260 + 320 * it.s) * f;
          return it.base - (320 - (arts.get(it.t.slug)?.top ?? 220)) * (w / 1600) * 2.1;
        };
        const lenOf = (it: (typeof items)[number]) => (it.t.name.length + 9) * 6.4;
        if (W >= 760)
          for (const it of items)
            if (it.x < hb.x1 && it.x + lenOf(it) * COS > hb.x0) HZ = Math.max(HZ, Math.round(hb.y1 + 14 + lenOf(it) * SIN + 10 - rise(it)));
        const H = HZ + Math.round(84 * f);
        for (const it of items) it.base += HZ;

        const far = ["--pano-f0", "--pano-f1"].map((v, l) => {
          const r = rndOf(11 + l * 7), y0 = HZ - 26 * f + l * 12 * f, step = (46 + l * 20) * f;
          let d = `M0,${H}V${f1(y0)}`;
          for (let x = 0; x <= W + step; x += step) d += `Q${f1(x + step / 2)},${f1(y0 - (8 + r() * 26) * 0.6 * f * (1 - l * 0.2))} ${f1(x + step)},${f1(y0 - r() * 8 * f)}`;
          return `<path d="${d}V${H}Z" style="fill:var(${v})"/>`;
        }).join("");
        const tops = new Map<number, number>();
        const art = [...items].sort((a, b) => a.s - b.s).map((it) => {
          const a = arts.get(it.t.slug);
          const w = (260 + 320 * it.s) * f, k = w / 1600, ky = k * 2.1;
          tops.set(it.i, it.base - (320 - (a?.top ?? 220)) * ky);
          const tone = `var(${TONES[Math.min(4, Math.round(it.s * 4))]})`;
          const shapes = a?.shapes ?? [{ d: `M0,320L800,${a?.top ?? 220}L1600,320Z`, c: "#7f9a54" }];
          return `<a href="/trails/${it.t.slug}/" class="pano-art-link" data-i="${it.i}" tabindex="-1" aria-hidden="true"><g class="pano-art" data-i="${it.i}" transform="translate(${f1(it.x - w / 2)},${f1(it.base - 320 * ky)}) scale(${k.toFixed(4)},${ky.toFixed(4)})">${shapes.map((p) => `<path d="${p.d}" style="--o:${p.c};--t:color-mix(in oklab, ${p.c} 22%, ${tone})"/>`).join("")}</g></a>`;
        }).join("");

        // the names, slanted: each starts above its summit, moved up or down until its line clears every
        // name to its left by 22 px across the slant and stays inside the band
        const placed: { x: number; y: number; len: number }[] = [];
        const tyOf = new Map<number, number>();
        for (const it of [...items].sort((a, b) => a.x - b.x)) {
          const len = lenOf(it), top = tops.get(it.i)!;
          const lowest = top - 10, base = Math.min(top - 24, HZ + 10);
          const clash = (y: number) => placed.some((q) => {
            const dx = it.x - q.x, dy = y - q.y, across = Math.abs(dx * SIN + dy * COS), along = dx * COS - dy * SIN;
            return across < 22 && along > -len && along < q.len;
          });
          const underHead = (y: number) => it.x < hb.x1 && it.x + len * COS > hb.x0 && y - len * SIN < hb.y1;
          const bad = (y: number) => clash(y) || underHead(y) || y - len * SIN < 6 || y > lowest || it.x + len * COS > W - 4;
          let y = base;
          for (let k = 1; bad(y) && k < 60; k++) y = base + (k % 2 ? -1 : 1) * Math.ceil(k / 2) * 8;
          tyOf.set(it.i, y);
          placed.push({ x: it.x, y, len });
        }
        const POINT = (b: number) => WORDS[Math.round(b / 45) % 8];
        // the leader lines first, then the names over them (with a halo in the sky's colour, so a line
        // passing behind a neighbour's name doesn't cross it out)
        const leads = items.map((it) => `<path class="pano-lead" data-i="${it.i}" d="M${f1(it.x)},${f1(tops.get(it.i)! - 3)}V${f1(tyOf.get(it.i)!)}"/><circle class="pano-dot" cx="${f1(it.x)}" cy="${f1(tops.get(it.i)! - 3)}" r="2.4"/>`).join("");
        const names = items.map((it) => {
          const ty = tyOf.get(it.i)!;
          const dist = roundDistance(it.d).toLocaleString("en");
          return `<a href="/trails/${it.t.slug}/" class="pano-name" data-i="${it.i}" aria-label="${esc(it.t.name)} ≈ ${dist} km, to the ${POINT(it.b)}"><text transform="translate(${f1(it.x + 3)},${f1(ty - 4)}) rotate(-28)">${esc(it.t.name)} <tspan class="pano-km">≈ ${dist} km</tspan></text></a>`;
        }).join("");
        drawEl.innerHTML = `<svg class="pano-svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="group" aria-label="The ten trails nearest ${esc(city)}, drawn on the horizon in their direction"><rect width="${W}" height="${H}" class="pano-sky"/>${far}${art}<rect y="${f1(HZ + 50 * f)}" width="${W}" height="${f1(H - HZ - 50 * f)}" class="pano-ground"/><g class="pano-labels">${leads}${names}</g></svg>`;
        // a name or a drawing pointed at marks both, and the leader between them
        for (const a of drawEl.querySelectorAll<SVGAElement>(".pano-name, .pano-art-link")) {
          const on = (v: boolean) => drawEl.querySelectorAll(`[data-i="${a.dataset.i}"]`).forEach((el) => el.classList.toggle("on", v));
          a.addEventListener("pointerenter", () => on(true));
          a.addEventListener("pointerleave", () => on(false));
          a.addEventListener("focus", () => on(true));
          a.addEventListener("blur", () => on(false));
        }
      };
      let drawnW = 0;
      new ResizeObserver(() => {
        if (Math.abs(pano.clientWidth - drawnW) < 2) return;
        drawnW = pano.clientWidth;
        draw();
      }).observe(pano);
      section.querySelector<HTMLElement>("[data-near-city]")!.textContent = city;
      section.querySelector<HTMLElement>("[data-near-from]")!.textContent = city;
      section.hidden = false;
    }
  </script>

  <section class="block after-near">
    <div class="block-head"><h2>On every trail page</h2></div>
    <ul class="features">
      {features.map((f) => (
        <li>
          <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
          <div>
            <p class="feature-title">{f.title}</p>
            <p class="feature-text">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- recent trails (issue #80) as a logbook of hut stamps (2026-11-05; of five previews, approach B): one
       band wall to wall with its heading and the link to all trails; each new trail a round stamp, its name
       round the rim, its countries at the foot, its profile in the middle and the day it was added across
       it, grey until pointed at, then in its own ink -->
  <section class="block logbook" aria-labelledby="log-h">
    <div class="lb-inner">
      <div class="block-head"><h2 id="log-h">Logbook · recently added</h2></div>
      <ol class="lb-grid">
        {logEntries.map((x) => (
          <li>
            <a href={`/trails/${x.t.slug}/`} style={`--ink:${INKS[x.n % INKS.length]};--ink-dark:${INKS_DARK[x.n % INKS_DARK.length]};--tilt:${TILTS[x.n % TILTS.length]}deg`}>
              <svg class="lb-stamp" viewBox="0 0 180 180" aria-hidden="true">
                <defs>
                  <path id={`lb-top-${x.n}`} d="M22,90 A68,68 0 0 1 158,90" />
                  <path id={`lb-bot-${x.n}`} d="M14,90 A76,76 0 0 0 166,90" />
                </defs>
                <circle cx="90" cy="90" r="84" class="lb-ring" />
                <circle cx="90" cy="90" r="56" class="lb-ring2" />
                <text class="lb-rim"><textPath href={`#lb-top-${x.n}`} startOffset="50%">{x.rim}</textPath></text>
                <text class="lb-place"><textPath href={`#lb-bot-${x.n}`} startOffset="50%">★ {x.t.countries.join(" · ")} ★</textPath></text>
                <path transform="translate(50,58)" d={x.spark} class="lb-ink" />
                <rect x="34" y="88" width="112" height="22" class="lb-ink" />
                <text x="90" y="104" class="lb-date">{x.stamp}</text>
                <text x="90" y="128" class="lb-km">{x.km}</text>
              </svg>
              <span class="lb-name">{x.t.name}</span>
              <span class="sr-only">, added {x.date}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="log-all"><a href="/trails/?sort=newest">All {trails.length} trails, newest first →</a></p>
    </div>
  </section>

  <section class="block">
    <div class="block-head"><h2>Built on open data</h2></div>
    <p class="intro muted">
      Trail figures often differ from one source to the next. We never pick one quietly: every number names its source,
      our own estimates are marked ≈, and every trail's figures are checked against a second, independent source. Each
      trail page lists its sources with their licences.
    </p>
    <dl class="strip sources">
      {sources.map((s) => (
        <div>
          <dt>{s.name}</dt>
          <dd>{s.what}</dd>
        </div>
      ))}
    </dl>
  </section>
  <!-- issue #81 (of three previews, approach A): the two calls to action again, in a slim bar along the
       bottom, once the hero's trip search has scrolled away and until the footer comes into view; hidden
       from screen readers and keyboard while it is away -->
  <div class="cta-bar" aria-hidden="true" inert>
    <span class="cta-bar-text">Find your long-distance trail</span>
    <span class="cta-bar-actions">
      <a class="cta-bar-secondary" href="/trails/guide/">Help me choose</a>
      <a class="button" href="/trails/">Explore the trails <span aria-hidden="true">→</span></a>
    </span>
  </div>
  <script>
    // the hero's ridges drift with the pointer, the nearer ones more (none with reduced motion)
    const band = document.querySelector<HTMLElement>(".hero-band")!;
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
      band.addEventListener("pointermove", (e) => {
        const r = band.getBoundingClientRect();
        band.style.setProperty("--px", (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(3));
      });
  </script>
  <script>
    const bar = document.querySelector<HTMLElement>(".cta-bar")!;
    const hero = document.querySelector<HTMLElement>(".hero .trip");
    const footer = document.querySelector<HTMLElement>(".site-footer");
    if (hero && "IntersectionObserver" in window) {
      let heroGone = false;
      let footerIn = false;
      const update = () => {
        const show = heroGone && !footerIn;
        bar.classList.toggle("shown", show);
        bar.toggleAttribute("inert", !show);
        bar.setAttribute("aria-hidden", String(!show));
      };
      // gone means scrolled past (above the screen), not merely below it
      new IntersectionObserver(([e]) => {
        heroGone = !e.isIntersecting && e.boundingClientRect.top < 0;
        update();
      }).observe(hero);
      if (footer)
        new IntersectionObserver(([e]) => {
          footerIn = e.isIntersecting;
          update();
        }).observe(footer);
    }
  </script>
</Base>

