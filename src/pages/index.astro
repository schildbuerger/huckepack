---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import TrailSpark from "../components/TrailSpark.astro";
import Explain from "../components/Explain.astro";
import TrailSearch from "../components/TrailSearch.astro";
import { mainStages, stageEstimates, trailClimb, walkingMinutes } from "../lib/trails";
import { LEVELS } from "../lib/difficulty";
import { climateLevel } from "../lib/filters";
import { searchSummary } from "../lib/search";
import zones from "../lib/timezones.json";
import { readFileSync } from "node:fs";

const entries = (await getCollection("trails")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const derivedAll = await Promise.all(entries.map(async (e) => (await getEntry("derived", e.id))?.data));
const trails = entries.map(({ id, data }, i) => searchSummary(id, data, derivedAll[i]));
// the most recently added trails (issue #80), newest first, by the record's `added` date
const RECENT = 6;
const addedOf = new Map(entries.map((e) => [e.id, e.data.added]));
const recent = [...trails]
  .sort((a, b) => addedOf.get(b.slug)!.getTime() - addedOf.get(a.slug)!.getTime() || a.name.localeCompare(b.name))
  .slice(0, RECENT);
const addedText = (slug: string) =>
  addedOf.get(slug)!.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
// a trail's difficulty in one word: the hardest of its three ratings over its season, as the
// trail page's key figure shows it
const difficultyWord = (t: (typeof trails)[number]) => {
  const xs = [t.terrainLevel, t.effortLevel, climateLevel(t, [])].filter((x) => x !== null) as number[];
  return xs.length ? LEVELS[Math.max(...xs) - 1] : null;
};
const fmt = (n: number) => n.toLocaleString("en");
const days = (d: [number, number] | null) => (d === null ? null : d[0] === d[1] ? `${d[0]}` : `${d[0]}–${d[1]}`);

// the mission (docs/mission.md) as bullets under the headline: find, plan, sources
// the three promises under the headline (of three previews, approach A: icon columns), each a short
// title and one plain line; the mission's find, plan and sources
const usps: { icon: IconName; title: string; text: string }[] = [
  { icon: "map", title: "Trails that fit you", text: "By season, days, difficulty and landscape" },
  { icon: "route", title: "Know what to expect", text: "Stages, terrain, climate, water and beds" },
  { icon: "badge-check", title: "Every figure checked", text: "Official sources, named and double-checked" },
];

// totals for the strip under the hero: the plain counts, then a few for fun, each summed from
// the same figures the trail pages show
const EVEREST_M = 8849;
const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
const perTrail = entries.map((e, i) => {
  const d = derivedAll[i];
  const est = stageEstimates(e.data, d);
  const main = mainStages(e.data);
  // climbs as the key figures have them: the stated total or stage sums, else the terrain model's estimate
  const stated = trailClimb(e.data)?.up;
  const climbed = stated ?? sum(main.map((s) => est.get(s.number)?.ascentM ?? 0));
  // walking time: each main stage's stated time, else DIN 33466 from its climbs (stated or estimated)
  const minutes = sum(
    main.map((s) => {
      const up = s.ascentM ?? est.get(s.number)?.ascentM;
      const down = s.descentM ?? est.get(s.number)?.descentM;
      return s.minutes ?? (up !== undefined && down !== undefined ? walkingMinutes(s.km, up, down) : 0);
    }),
  );
  const taps = d?.water?.points.filter((p) => p.kind === "drinking").length ?? 0;
  return { climbed, climbedEst: stated === undefined, minutes, taps };
});
const totals = {
  trails: trails.length,
  countries: new Set(trails.flatMap((t) => t.countries)).size,
  km: Math.round(trails.reduce((sum, t) => sum + (t.compareKm ?? 0), 0)), // measured where the match is good
  stages: entries.reduce((sum, e) => sum + mainStages(e.data).length, 0),
  climbed: Math.round(sum(perTrail.map((t) => t.climbed)) / 10) * 10,
  hours: Math.round(sum(perTrail.map((t) => t.minutes)) / 60),
  taps: sum(perTrail.map((t) => t.taps)),
};
const everests = (totals.climbed / EVEREST_M).toFixed(1);

// the featured trail: every trail is rendered, and a script picks one at random on each page load
// (without JavaScript, the first shows); each with its elevation profile and surfaces as previews
// the box the profiles are drawn in (src/components/TrailSpark.astro draws them)
const W = 1000;
const H = 110;
const featuredAll = trails.map((t, i) => {
  const d = derivedAll[i];
  const elevation = d?.elevation;
  const spark = (() => {
    if (!elevation) return null;
    const step = Math.max(1, Math.floor(elevation.points.length / 200));
    const pts = elevation.points.filter((_, i) => i % step === 0);
    const lo = elevation.lowest.m - 80;
    const hi = elevation.highest.m + 40;
    const x = (km: number) => (km / elevation.routeKm) * W;
    const y = (m: number) => H - ((m - lo) / (hi - lo)) * (H - 8);
    const line = pts.map(([km, m], i) => `${i ? "L" : "M"}${x(km).toFixed(1)},${y(m).toFixed(1)}`).join("");
    return { line, area: `${line}L${W},${H}L0,${H}Z`, peak: elevation.highest.m };
  })();
  return { t, spark, surface: d?.surface, climb: perTrail[i], level: difficultyWord(t) };
});

// popular trails (issue #84): the three whose Wikipedia articles people viewed most in twelve months,
// all languages summed (pipeline/popularity.py, Wikimedia); trails without an article aren't ranked
const POPULAR = 3;
const popular = featuredAll
  .map((f, i) => ({ ...f, views: derivedAll[i]?.popularity?.views ?? null }))
  .filter((f) => f.views !== null)
  .sort((a, b) => b.views! - a.views!)
  .slice(0, POPULAR);
const viewsWindow = derivedAll.find((d) => d?.popularity)?.popularity;
const monthYear = (ym: string) => new Date(`${ym}-01T00:00:00Z`).toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
// trails near you (issue #85): every trail's card is rendered with its start and finish; a script
// finds the three nearest to the place the browser's time zone stands for (src/lib/timezones.json)
const ends = entries.map((e) => [
  [e.data.termini.start.lat, e.data.termini.start.lon],
  [e.data.termini.end.lat, e.data.termini.end.lon],
]);
const figureLine = (t: (typeof trails)[number]) =>
  [t.lengthKm !== null && `${fmt(t.lengthKm)} km`, t.days && `${days(t.days)} days`, difficultyWord(t)].filter(Boolean).join(" · ");

// the map teaser (issue #33): the land (Natural Earth 1:110m, public domain) around the trails with a
// dot at each start, drawn at build time, so the home page loads no map library; it links to
// /trails/map/. Equirectangular, longitudes scaled by the cosine of the middle latitude.
const MAP_W = 600;
const starts = entries.map((e) => [e.data.termini.start.lon, e.data.termini.start.lat] as [number, number]);
const lon0 = Math.min(...starts.map((p) => p[0])) - 14;
const lon1 = Math.max(...starts.map((p) => p[0])) + 14;
const lat0 = Math.min(...starts.map((p) => p[1])) - 6;
const lat1 = Math.max(...starts.map((p) => p[1])) + 5;
const kx = Math.cos((((lat0 + lat1) / 2) * Math.PI) / 180);
const scale = MAP_W / ((lon1 - lon0) * kx);
const MAP_H = Math.round((lat1 - lat0) * scale);
const project = ([lon, lat]: number[]) => [((lon - lon0) * kx * scale).toFixed(1), ((lat1 - lat) * scale).toFixed(1)];
const land = JSON.parse(readFileSync("data/reference/ne_110m_land.geojson", "utf8"));
const landPath = land.features
  .flatMap((f: any) => (f.geometry.type === "Polygon" ? [f.geometry.coordinates] : f.geometry.coordinates))
  .filter((poly: number[][][]) => poly[0].some(([lon, lat]) => lon > lon0 - 30 && lon < lon1 + 30 && lat > lat0 - 20 && lat < lat1 + 20))
  .flatMap((poly: number[][][]) => poly.map((ring) => `M${ring.map((pt) => project(pt).join(",")).join("L")}Z`))
  .join("");
const mapDots = starts.map((pt) => project(pt));
const countryCount = new Set(entries.flatMap((e) => e.data.countries)).size;

// what a trail page shows, in its order (src/pages/trails/[slug].astro)
const features: { icon: IconName; title: string; text: string }[] = [
  { icon: "chart-column", title: "Key figures", text: "Length, ascent and descent, difficulty, days, distance per day, the season and the main landscape." },
  { icon: "train-front", title: "Location", text: "Start and finish, the nearest main station and airports with the road distance, and the trail's waymark." },
  { icon: "map", title: "Map", text: "The route on an OpenStreetMap map, stage by stage, with approaches and variants." },
  { icon: "gauge", title: "Difficulty", text: "Terrain, climate and the length of the days, each rated Easy to Hard by the same rule on every trail." },
  { icon: "cloud-sun", title: "Climate", text: "Day and night temperatures, wet days, snow and daylight by month, low down and up high." },
  { icon: "list-ordered", title: "Stages", text: "Every official stage with distance, ascent, descent, elevation and walking time; our estimates marked where a source gives none." },
  { icon: "mountain", title: "Terrain", text: "The elevation profile coloured by its steepness, the ground underfoot beneath it, and the tree line where the trail climbs above it." },
  { icon: "trees", title: "Landscape", text: "Forest, open hills, moss, rock or snow: what the trail passes through, and where." },
  { icon: "tent", title: "Sleeping", text: "Huts, campsites, hostels and rooms along the way, and whether wild camping is allowed." },
  { icon: "droplet", title: "Water", text: "Drinking water and springs along the route, and the longest stretch without." },
];

const sources = [
  { name: "Trail operators", what: "Official stages, distances, times, seasons, waymarks and rules" },
  { name: "Second sources", what: "Wikipedia, regions, tourism boards and trail portals: every trail checked against one" },
  { name: "OpenStreetMap", what: "Route, surfaces, water points, travel hubs and the map, its relief from AWS Terrain Tiles" },
  { name: "Copernicus DEM", what: "Elevation profile and steepness, 30 m terrain model" },
  { name: "ESA WorldCover", what: "Landscape along the route, 10 m satellite land cover" },
  { name: "ERA5 (Open-Meteo)", what: "Climate and wind by month, 30 years of weather" },
  { name: "OSRM", what: "Road distances from the travel hubs to the start" },
  { name: "Wikimedia", what: "Wikipedia page views, which rank the popular trails" },
  { name: "tz database (IANA)", what: "Each time zone's main city, to find the trails near you in your browser" },
];
---

<Base
  title="huckepack: find a long-distance hiking trail and go prepared"
  description="Find the long-distance hiking trail that suits you and go prepared: stages, terrain, climate, water and beds for every trail, from official and open sources, checked against a second source."
>
  <!-- issue #83 (of three previews, approach B): search with suggestions, in the header -->
  <div slot="header" class="header-search"><TrailSearch id="search-header" size="compact" placeholder="Search trails" /></div>

  <section class="hero">
    <p class="eyebrow">Long-distance trails, in data</p>
    <!-- the second sentence never splits, so the headline wraps between the two -->
    <h1>Find your trail. <span class="nowrap">Go prepared.</span></h1>
    <ul class="usps">
      {usps.map((u) => (
        <li>
          <span class="usp-icon"><Icon name={u.icon} size={22} /></span>
          <strong>{u.title}</strong>
          <span class="usp-text">{u.text}</span>
        </li>
      ))}
    </ul>
    <div class="ctas">
      <a class="button cta" href="/trails/">Explore the trails <span aria-hidden="true">→</span></a>
      <a class="cta-secondary" href="/trails/guide/">Help me choose</a>
    </div>
  </section>

  <!-- each figure twice: the final value for screen readers, and a copy the script below counts up -->
  <dl class="strip totals">
    {[
      ["Trails", totals.trails],
      [totals.countries === 1 ? "Country" : "Countries", totals.countries],
      ["Kilometres documented", totals.km],
      ["Official stages", totals.stages],
      [`Metres climbed, ${everests} × Everest`, totals.climbed],
      ["Hours of walking", totals.hours],
      ["Drinking water points", totals.taps],
    ].map(([label, n]) => (
      <div>
        <dt>{label}</dt>
        <dd><span class="sr-only">{fmt(n as number)}</span><span class="count" aria-hidden="true" data-count={n}>{fmt(n as number)}</span></dd>
      </div>
    ))}
  </dl>
  <script is:inline>
    // The totals count up from 0 the first time the strip is on screen (1.2 s, ease-out, all
    // together). Runs right after the strip, before the first paint, so the final numbers never
    // flash first; without JavaScript or with reduced motion they simply stand.
    (() => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
      const strip = document.currentScript.previousElementSibling;
      const counts = [...strip.querySelectorAll("[data-count]")];
      // keep each number's final width, so nothing shifts while it counts
      for (const el of counts) {
        el.style.minWidth = `${el.getBoundingClientRect().width}px`;
        el.textContent = "0";
      }
      const run = () => {
        const start = performance.now();
        const frame = (now) => {
          const t = Math.min((now - start) / 1200, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          for (const el of counts) el.textContent = Math.round(Number(el.dataset.count) * eased).toLocaleString("en");
          if (t < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      };
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        run();
      }, { threshold: 0.5 });
      io.observe(strip);
    })();
  </script>

  {featuredAll.length > 0 && (
    <section class="block">
      <h2>Featured trail</h2>
      {featuredAll.map(({ t: featured, spark, surface, climb, level }, i) => (
        <a class="featured" href={`/trails/${featured.slug}/`} hidden={i > 0}>
          <div class="featured-head">
            <p class="place">{featured.countries.join(" · ")}</p>
            <p class="name">{featured.name}</p>
            {featured.localName && <p class="local">{featured.localName}</p>}
          </div>
          <dl class="featured-figures">
            {featured.lengthKm !== null && <div><dt>Length</dt><dd>{fmt(featured.lengthKm)}<span>km</span></dd></div>}
            {climb.climbed > 0 && (
              <div>
                <dt>Ascent{climb.climbedEst && " (estimate)"}</dt>
                <dd>{climb.climbedEst && <span class="approx">≈</span>}{fmt(climb.climbed)}<span>m ↑</span></dd>
              </div>
            )}
            {featured.days && <div><dt>Suggested</dt><dd>{days(featured.days)}<span>days</span></dd></div>}
            {level && <div><dt>Difficulty</dt><dd>{level}</dd></div>}
            {spark && <div><dt>Highest point</dt><dd>{fmt(spark.peak)}<span>m</span></dd></div>}
          </dl>
          {spark && <TrailSpark spark={spark} surface={surface} />}
          <span class="open">Open the trail →</span>
        </a>
      ))}
      <script is:inline>
        // A random featured trail on each page load. Runs right after the cards, before the first
        // paint, so the first trail never flashes; without JavaScript the first one stays.
        (() => {
          const cards = [...document.currentScript.parentElement.querySelectorAll(".featured")];
          const pick = Math.floor(Math.random() * cards.length);
          cards.forEach((c, i) => (c.hidden = i !== pick));
        })();
      </script>
    </section>
  )}

  {popular.length > 0 && (
    <section class="block">
      <div class="block-head">
        <h2>Popular trails</h2>
        {viewsWindow && (
          <Explain id="popular-info" icon term="About this list" title="Popular trails">
            <p>
              The trails whose Wikipedia articles people read most, in every language, {monthYear(viewsWindow.from)} to{" "}
              {monthYear(viewsWindow.to)} (Wikimedia's page view data). It measures interest in a trail, not how many
              hike it; a trail without an article isn't ranked.
            </p>
          </Explain>
        )}
      </div>
      <div class="feats">
        {popular.map(({ t, spark, surface }) => (
          <a class="feat" href={`/trails/${t.slug}/`}>
            <span class="feat-place">{t.countries.join(" · ")}</span>
            <span class="feat-name">{t.name}</span>
            <span class="feat-figures">{figureLine(t)}</span>
            {spark && <TrailSpark spark={spark} surface={surface} height={70} />}
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="block">
    <!-- the map as an entry point of its own (issue #33), quieter than the hero's buttons: a static
         teaser drawn at build time, the interactive map one click away -->
    <a class="map-teaser" href="/trails/map/">
      <span class="map-teaser-text">
        <h2>Explore on the map</h2>
        <span class="muted">All {entries.length} trails in {countryCount} countries on one map. Zoom into a region and see its trails.</span>
        <span class="map-teaser-open">Open the map <span aria-hidden="true">→</span></span>
      </span>
      <svg class="map-teaser-svg" viewBox={`0 0 ${MAP_W} ${MAP_H}`} aria-hidden="true">
        <path class="map-land" d={landPath} />
        {mapDots.map(([x, y]) => <circle cx={x} cy={y} r="6" />)}
      </svg>
    </a>
  </section>

  <!-- shown by the script below only where the time zone gives a place; without JavaScript it stays hidden -->
  <section class="block near" hidden>
    <div class="block-head">
      <h2>Trails near you</h2>
      <Explain id="near-info" icon term="About this list" title="Trails near you">
        <p>
          The trails whose start or finish is nearest to <span data-near-city></span>,
          the main city of your browser's time zone; distances in a straight line, rounded. Worked out on your device:
          nothing is sent or stored, and no location permission is asked.
        </p>
      </Explain>
    </div>
    <div class="feats" data-near-list>
      {featuredAll.map(({ t, spark, surface }, i) => (
        <a class="feat" href={`/trails/${t.slug}/`} data-slug={t.slug} data-ends={JSON.stringify(ends[i])} hidden>
          <span class="feat-place">{t.countries.join(" · ")}</span>
          <span class="feat-name">{t.name}</span>
          <span class="feat-figures">{figureLine(t)}</span>
          {spark && <TrailSpark spark={spark} surface={surface} height={70} />}
          <span class="feat-why" data-dist></span>
        </a>
      ))}
    </div>
  </section>
  <script type="application/json" id="zones" set:html={JSON.stringify(zones)}></script>
  <script>
    // Trails near you (issue #85): the browser's time zone (Europe/Berlin) stands for its main
    // city (the tz database's coordinates); the three trails whose start or finish is nearest, by
    // great-circle distance. Worked out here; nothing is sent or stored.
    import { kmBetween, roundDistance } from "../lib/geo";
    const NEARBY = 3;
    const section = document.querySelector<HTMLElement>(".near")!;
    const zones: Record<string, [number, number]> = JSON.parse(document.getElementById("zones")!.textContent!);
    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const here = zones[zone];
    if (here) {
      // both points are [lat, lon] here (the tz table's and the cards' order)
      const km = (a: [number, number], b: [number, number]) => kmBetween([a[1], a[0]], [b[1], b[0]]);
      const list = section.querySelector<HTMLElement>("[data-near-list]")!;
      const cards = [...list.querySelectorAll<HTMLElement>("[data-slug]")];
      const near = cards
        .map((card) => ({ card, d: Math.min(...(JSON.parse(card.dataset.ends!) as [number, number][]).map((e) => km(here, e))) }))
        .sort((a, b) => a.d - b.d)
        .slice(0, NEARBY);
      for (const { card, d } of near) {
        card.querySelector<HTMLElement>("[data-dist]")!.textContent = `≈ ${roundDistance(d).toLocaleString("en")} km from you`;
        card.hidden = false;
        list.append(card); // nearest first
      }
      section.querySelector<HTMLElement>("[data-near-city]")!.textContent = zone.split("/").pop()!.replace(/_/g, " ");
      section.hidden = false;
    }
  </script>

  <section class="block">
    <h2>On every trail page</h2>
    <ul class="features">
      {features.map((f) => (
        <li>
          <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
          <div>
            <p class="feature-title">{f.title}</p>
            <p class="feature-text">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="block">
    <h2>Recent trails</h2>
    <ul class="cards recent">
      {recent.map((t) => (
        <li>
          <a class="card" href={`/trails/${t.slug}/`}>
            <span class="card-place">{t.countries.join(", ")}</span>
            <span class="card-name">{t.name}</span>
            <span class="card-figures">
              {[t.lengthKm !== null && `${fmt(t.lengthKm)} km`, t.days && `${days(t.days)} days`, difficultyWord(t)]
                .filter(Boolean)
                .join(" · ")}
            </span>
            <span class="card-added">Added {addedText(t.slug)}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/trails/">Search all {trails.length} trails →</a></p>
  </section>

  <section class="block">
    <h2>Built on open data</h2>
    <p class="intro muted">
      Trail figures often differ from one source to the next. We never pick one quietly: every number names its source,
      our own estimates are marked ≈, and every trail's figures are checked against a second, independent source. Each
      trail page lists its sources with their licences.
    </p>
    <dl class="strip sources">
      {sources.map((s) => (
        <div>
          <dt>{s.name}</dt>
          <dd>{s.what}</dd>
        </div>
      ))}
    </dl>
  </section>
  <!-- issue #81 (of three previews, approach A): the two calls to action again, in a slim bar along the
       bottom, once the hero's buttons have scrolled away and until the footer comes into view; hidden
       from screen readers and keyboard while it is away -->
  <div class="cta-bar" aria-hidden="true" inert>
    <span class="cta-bar-text">Find your long-distance trail</span>
    <span class="cta-bar-actions">
      <a class="cta-bar-secondary" href="/trails/guide/">Help me choose</a>
      <a class="button" href="/trails/">Explore the trails <span aria-hidden="true">→</span></a>
    </span>
  </div>
  <script>
    const bar = document.querySelector<HTMLElement>(".cta-bar")!;
    const hero = document.querySelector<HTMLElement>(".hero .ctas");
    const footer = document.querySelector<HTMLElement>(".site-footer");
    if (hero && "IntersectionObserver" in window) {
      let heroGone = false;
      let footerIn = false;
      const update = () => {
        const show = heroGone && !footerIn;
        bar.classList.toggle("shown", show);
        bar.toggleAttribute("inert", !show);
        bar.setAttribute("aria-hidden", String(!show));
      };
      // gone means scrolled past (above the screen), not merely below it
      new IntersectionObserver(([e]) => {
        heroGone = !e.isIntersecting && e.boundingClientRect.top < 0;
        update();
      }).observe(hero);
      if (footer)
        new IntersectionObserver(([e]) => {
          footerIn = e.isIntersecting;
          update();
        }).observe(footer);
    }
  </script>
</Base>

<style>
  .hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 0 48px;
    text-align: center;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
