---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import { mainStages, stageEstimates, stageTotals, walkingMinutes } from "../lib/trails";
import { LEVELS } from "../lib/difficulty";
import { climateLevel } from "../lib/filters";
import { searchSummary } from "../lib/search";

const entries = (await getCollection("trails")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const derivedAll = await Promise.all(entries.map(async (e) => (await getEntry("derived", e.id))?.data));
const trails = entries.map(({ id, data }, i) => searchSummary(id, data, derivedAll[i]));
// a trail's difficulty in one word: the hardest of its three ratings over its season, as the
// trail page's key figure shows it
const difficultyWord = (t: (typeof trails)[number]) => {
  const xs = [t.terrainLevel, t.effortLevel, climateLevel(t, [])].filter((x) => x !== null) as number[];
  return xs.length ? LEVELS[Math.max(...xs) - 1] : null;
};
const fmt = (n: number) => n.toLocaleString("en");
const days = (d: [number, number] | null) => (d === null ? null : d[0] === d[1] ? `${d[0]}` : `${d[0]}–${d[1]}`);

// the mission (docs/mission.md) as bullets under the headline: find, plan, sources
const usps = [
  "Find trails that fit: by season, region, length, difficulty, landscape, ground, beds and water",
  "Plan with the data that matters: difficulty, stages, terrain, landscape, climate, water, beds and getting there",
  "Every figure from official and open sources, named on the page",
];

// totals for the strip under the hero: the plain counts, then a few for fun, each summed from
// the same figures the trail pages show
const EVEREST_M = 8849;
const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
const perTrail = entries.map((e, i) => {
  const d = derivedAll[i];
  const est = stageEstimates(e.data, d);
  const main = mainStages(e.data);
  // climbs as the key figures have them: the stated stage sums, else the terrain model's estimate
  const stated = stageTotals(e.data)?.ascentM?.value;
  const climbed = stated ?? sum(main.map((s) => est.get(s.number)?.ascentM ?? 0));
  // walking time: each main stage's stated time, else DIN 33466 from its climbs (stated or estimated)
  const minutes = sum(
    main.map((s) => {
      const up = s.ascentM ?? est.get(s.number)?.ascentM;
      const down = s.descentM ?? est.get(s.number)?.descentM;
      return s.minutes ?? (up !== undefined && down !== undefined ? walkingMinutes(s.km, up, down) : 0);
    }),
  );
  const taps = d?.water?.points.filter((p) => p.kind === "drinking").length ?? 0;
  return { climbed, climbedEst: stated === undefined, minutes, taps };
});
const totals = {
  trails: trails.length,
  countries: new Set(trails.flatMap((t) => t.countries)).size,
  km: Math.round(trails.reduce((sum, t) => sum + (t.lengthKm ?? 0), 0)),
  stages: entries.reduce((sum, e) => sum + mainStages(e.data).length, 0),
  climbed: Math.round(sum(perTrail.map((t) => t.climbed)) / 10) * 10,
  hours: Math.round(sum(perTrail.map((t) => t.minutes)) / 60),
  taps: sum(perTrail.map((t) => t.taps)),
};
const everests = (totals.climbed / EVEREST_M).toFixed(1);

// the featured trail: every trail is rendered, and a script picks one at random on each page load
// (without JavaScript, the first shows); each with its elevation profile and surfaces as previews
const W = 1000;
const H = 110;
const featuredAll = trails.map((t, i) => {
  const d = derivedAll[i];
  const elevation = d?.elevation;
  const spark = (() => {
    if (!elevation) return null;
    const step = Math.max(1, Math.floor(elevation.points.length / 200));
    const pts = elevation.points.filter((_, i) => i % step === 0);
    const lo = elevation.lowest.m - 80;
    const hi = elevation.highest.m + 40;
    const x = (km: number) => (km / elevation.routeKm) * W;
    const y = (m: number) => H - ((m - lo) / (hi - lo)) * (H - 8);
    const line = pts.map(([km, m], i) => `${i ? "L" : "M"}${x(km).toFixed(1)},${y(m).toFixed(1)}`).join("");
    return { line, area: `${line}L${W},${H}L0,${H}Z`, peak: elevation.highest.m };
  })();
  return { t, spark, surface: d?.surface, climb: perTrail[i], level: difficultyWord(t) };
});

// what a trail page shows, in its order (src/pages/trails/[slug].astro)
const features: { icon: IconName; title: string; text: string }[] = [
  { icon: "chart-column", title: "Key figures", text: "Length, ascent and descent, difficulty, days, distance per day, the season and the main landscape." },
  { icon: "train-front", title: "Location", text: "Start and finish, the nearest main station and airports with the road distance, and the trail's waymark." },
  { icon: "map", title: "Map", text: "The route on an OpenStreetMap map, stage by stage, with approaches and variants." },
  { icon: "gauge", title: "Difficulty", text: "Terrain, climate and the length of the days, each rated Easy to Hard by the same rule on every trail." },
  { icon: "cloud-sun", title: "Climate", text: "Day and night temperatures, wet days, snow and daylight by month, low down and up high." },
  { icon: "list-ordered", title: "Stages", text: "Every official stage with distance, ascent, descent, elevation and walking time." },
  { icon: "mountain", title: "Terrain", text: "The elevation profile coloured by its steepness, or by the surfaces underfoot: earth, gravel or tarmac." },
  { icon: "trees", title: "Landscape", text: "Forest, open hills, moss, rock or snow: what the trail passes through, and where." },
  { icon: "tent", title: "Sleeping", text: "Huts, campsites, hostels and rooms along the way, and whether wild camping is allowed." },
  { icon: "droplet", title: "Water", text: "Drinking water and springs along the route, and the longest stretch without." },
];

const sources = [
  { name: "Trail operators", what: "Official stages, distances, times, waymarks and rules" },
  { name: "OpenStreetMap", what: "Route, surfaces, water points and the map" },
  { name: "Copernicus DEM", what: "Elevation profile and steepness, 30 m terrain model" },
  { name: "ESA WorldCover", what: "Landscape along the route, 10 m satellite land cover" },
  { name: "ERA5 (Open-Meteo)", what: "Climate and wind by month, 30 years of weather" },
  { name: "OSRM", what: "Road distances from travel hubs" },
];
---

<Base
  title="huckepack: find a long-distance hiking trail, plan the journey"
  description="Find the long-distance hiking trail that suits you and plan the journey: stages, terrain, climate, water and beds for every trail, from official and open sources."
>
  <section class="hero">
    <p class="eyebrow">Long-distance trails, in data</p>
    <!-- the second sentence never splits, so the headline wraps between the two -->
    <h1>Find your trail. <span class="nowrap">Plan the journey.</span></h1>
    <ul class="usps">
      {usps.map((u) => (
        <li>
          <Icon name="check" size={18} class="usp-mark" />
          {u}
        </li>
      ))}
    </ul>
    <div class="ctas">
      <a class="button cta" href="/trails/">Explore the trails <span aria-hidden="true">→</span></a>
      <a class="cta-secondary" href="/trails/guide/">Help me choose</a>
    </div>
  </section>

  <!-- each figure twice: the final value for screen readers, and a copy the script below counts up -->
  <dl class="strip totals">
    {[
      ["Trails", totals.trails],
      [totals.countries === 1 ? "Country" : "Countries", totals.countries],
      ["Kilometres documented", totals.km],
      ["Official stages", totals.stages],
      [`Metres climbed, ${everests} × Everest`, totals.climbed],
      ["Hours of walking", totals.hours],
      ["Drinking water points", totals.taps],
    ].map(([label, n]) => (
      <div>
        <dt>{label}</dt>
        <dd><span class="sr-only">{fmt(n as number)}</span><span class="count" aria-hidden="true" data-count={n}>{fmt(n as number)}</span></dd>
      </div>
    ))}
  </dl>
  <script is:inline>
    // The totals count up from 0 the first time the strip is on screen (1.2 s, ease-out, all
    // together). Runs right after the strip, before the first paint, so the final numbers never
    // flash first; without JavaScript or with reduced motion they simply stand.
    (() => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
      const strip = document.currentScript.previousElementSibling;
      const counts = [...strip.querySelectorAll("[data-count]")];
      // keep each number's final width, so nothing shifts while it counts
      for (const el of counts) {
        el.style.minWidth = `${el.getBoundingClientRect().width}px`;
        el.textContent = "0";
      }
      const run = () => {
        const start = performance.now();
        const frame = (now) => {
          const t = Math.min((now - start) / 1200, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          for (const el of counts) el.textContent = Math.round(Number(el.dataset.count) * eased).toLocaleString("en");
          if (t < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      };
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        run();
      }, { threshold: 0.5 });
      io.observe(strip);
    })();
  </script>

  {featuredAll.length > 0 && (
    <section class="block">
      <h2>Featured trail</h2>
      {featuredAll.map(({ t: featured, spark, surface, climb, level }, i) => (
        <a class="featured" href={`/trails/${featured.slug}/`} hidden={i > 0}>
          <div class="featured-head">
            <p class="place">{featured.countries.join(" · ")}</p>
            <p class="name">{featured.name}</p>
            {featured.localName && <p class="local">{featured.localName}</p>}
          </div>
          <dl class="featured-figures">
            {featured.lengthKm !== null && <div><dt>Length</dt><dd>{fmt(featured.lengthKm)}<span>km</span></dd></div>}
            {climb.climbed > 0 && (
              <div>
                <dt>Ascent{climb.climbedEst && " (estimate)"}</dt>
                <dd>{climb.climbedEst && <span class="approx">≈</span>}{fmt(climb.climbed)}<span>m ↑</span></dd>
              </div>
            )}
            {featured.days && <div><dt>Suggested</dt><dd>{days(featured.days)}<span>days</span></dd></div>}
            {level && <div><dt>Difficulty</dt><dd>{level}</dd></div>}
            {spark && <div><dt>Highest point</dt><dd>{fmt(spark.peak)}<span>m</span></dd></div>}
          </dl>
          {spark && (
            <div class="preview" aria-hidden="true">
              <svg class="spark" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
                <path class="spark-area" d={spark.area} />
                <path class="spark-line" d={spark.line} vector-effect="non-scaling-stroke" />
              </svg>
              {surface && (
                <svg class="surf" viewBox={`0 0 ${W} 8`} preserveAspectRatio="none">
                  {surface.runs.map((r) => (
                    <rect
                      x={(r.fromKm / surface.routeKm) * W}
                      width={Math.max(((r.toKm - r.fromKm) / surface.routeKm) * W, 0.6)}
                      height="8"
                      style={`fill: var(--surface-${r.category})`}
                    />
                  ))}
                </svg>
              )}
            </div>
          )}
          <span class="open">Open the trail →</span>
        </a>
      ))}
      <script is:inline>
        // A random featured trail on each page load. Runs right after the cards, before the first
        // paint, so the first trail never flashes; without JavaScript the first one stays.
        (() => {
          const cards = [...document.currentScript.parentElement.querySelectorAll(".featured")];
          const pick = Math.floor(Math.random() * cards.length);
          cards.forEach((c, i) => (c.hidden = i !== pick));
        })();
      </script>
    </section>
  )}

  <section class="block">
    <h2>On every trail page</h2>
    <ul class="features">
      {features.map((f) => (
        <li>
          <span class="feature-icon"><Icon name={f.icon} size={18} /></span>
          <div>
            <p class="feature-title">{f.title}</p>
            <p class="feature-text">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="block">
    <h2>All trails</h2>
    <ul class="cards">
      {trails.map((t) => (
        <li>
          <a class="card" href={`/trails/${t.slug}/`}>
            <span class="card-place">{t.countries.join(", ")}</span>
            <span class="card-name">{t.name}</span>
            <span class="card-figures">
              {[t.lengthKm !== null && `${fmt(t.lengthKm)} km`, t.days && `${days(t.days)} days`, difficultyWord(t)]
                .filter(Boolean)
                .join(" · ")}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/trails/">Search and compare all trails →</a></p>
  </section>

  <section class="block">
    <h2>Built on open data</h2>
    <p class="intro muted">
      Trail figures often differ from one source to the next. We never pick one quietly: every number has its source,
      and each trail page lists them all, with their licences.
    </p>
    <dl class="strip sources">
      {sources.map((s) => (
        <div>
          <dt>{s.name}</dt>
          <dd>{s.what}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 0 48px;
    text-align: center;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero h1 {
    margin: 12px 0 0;
    font-size: clamp(2.3rem, 6.5vw, 3.6rem);
  }
  /* the list is centred as a block, its items left-aligned so the check marks line up */
  .nowrap {
    white-space: nowrap;
  }
  .usps {
    display: grid;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    margin: 20px auto 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 1.1rem;
    text-align: left;
  }
  .usps li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .usps :global(.usp-mark) {
    flex: none;
    position: relative;
    top: 3px;
    color: var(--accent);
  }
  /* the main call to action, and beside it the guided questions as a quieter outlined button */
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 16px;
    margin-top: 32px;
  }
  .cta-secondary {
    padding: 15px 30px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .cta-secondary:hover {
    background: var(--accent-soft);
  }
  .cta-secondary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .cta {
    padding: 16px 36px;
    font-size: 1.15rem;
    box-shadow: 0 6px 20px -8px var(--accent);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px -8px var(--accent);
  }
  .cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cta-secondary {
      transition: none;
    }
  }

  /* strips: a rule on top, hairlines between items, like the trail pages; label first in the
     markup (dt before dd), value first on screen */
  .strip {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--line);
  }
  .strip > div {
    padding: 14px 16px;
    border-left: 1px solid var(--line);
  }
  .strip > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  /* totals: two columns on phones, rows of four from 720 px, one row from 1080 px; sources: two columns on phones, three
     from 720 px (six sources, two full rows) */
  .totals,
  .sources {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 720px) {
    .totals {
      grid-template-columns: repeat(4, 1fr);
    }
    .totals > div:nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .totals > div:nth-child(n + 5) {
      border-top: 1px solid var(--line);
    }
  }
  @media (min-width: 1080px) {
    .totals {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(max-content, 1fr);
    }
    .totals > div:nth-child(4n + 1):not(:first-child) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
    .totals > div:nth-child(n + 5) {
      border-top: 0;
    }
    .sources {
      grid-template-columns: repeat(3, 1fr);
    }
    .sources > div:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .sources > div:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 719px) {
    .totals > div:nth-child(odd),
    .sources > div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .totals > div:nth-child(n + 3),
    .sources > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  .totals div,
  .featured-figures div {
    display: flex;
    flex-direction: column;
  }
  .totals .count {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }
  .totals dd,
  .featured-figures dd {
    order: 1;
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.15;
  }
  .totals dd {
    font-size: 1.9rem;
  }
  .totals dt,
  .featured-figures dt {
    order: 2;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .block {
    margin-top: 56px;
  }
  .block h2 {
    margin-bottom: 14px;
  }

  /* featured trail */
  .featured[hidden] {
    display: none;
  }
  .featured {
    display: grid;
    gap: 20px;
    padding: 24px;
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .featured:hover .open {
    text-decoration: underline;
  }
  .featured-head p {
    margin: 0;
  }
  .place {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .name {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .local {
    color: var(--muted);
    font-style: italic;
  }
  .featured-figures {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 0;
  }
  .featured-figures dd {
    font-size: 1.5rem;
  }
  .featured-figures dd span {
    margin-left: 4px;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 400;
  }
  /* our estimate, as on the trail pages */
  .featured-figures dd span.approx {
    margin: 0 3px 0 0;
  }
  .preview svg {
    display: block;
    width: 100%;
  }
  .spark {
    height: 90px;
  }
  .spark-area {
    fill: var(--accent);
    opacity: 0.14;
  }
  .spark-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .surf {
    height: 8px;
    margin-top: 4px;
    border-radius: 2px;
  }
  .open {
    color: var(--accent);
    font-weight: 600;
  }

  /* features */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .feature-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .features p {
    margin: 0;
  }
  .feature-title {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .feature-text {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  /* sources */
  .intro {
    margin: 0 0 16px;
  }
  .sources dt {
    font-weight: 600;
  }
  .sources dd {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* all trails */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-place {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .card-name {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .card-figures {
    margin-top: 8px;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
