            )}
            {eleGrid.map((m) => <line class="grid" x1={CHART.x0} x2={CHART.x1} y1={yAt(m)} y2={yAt(m)} />)}
            {slicePaths.map((sl) => <path class={`slice ${sl.dir}`} d={sl.d} style={sl.style} />)}
            <path class="line" d={profileLine} />
