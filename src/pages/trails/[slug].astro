---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrailMap from "../../components/TrailMap.svelte";
import Icon from "../../components/Icon.astro";
import Explain from "../../components/Explain.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { existsSync } from "node:fs";
import {
  countryName,
  monthName,
  perDay,
  sacGrade,
  stageTotals,
  SAC_SCALE,
  SLEEPING_CATEGORIES,
  SLEEPING_LABELS,
  WILD_CAMPING_LABELS,
  waterLevel,
} from "../../lib/trails";

export async function getStaticPaths() {
  const trails = await getCollection("trails");
  return trails.map((trail) => ({ params: { slug: trail.id }, props: { trail } }));
}

const { trail } = Astro.props as { trail: CollectionEntry<"trails"> };
const t = trail.data;
const derived = (await getEntry("derived", trail.id))?.data;
const water = derived?.water;
// travel hubs with their distance to the start (pipeline/access.py), stations first
const hubs = t.access.map((h) => ({ ...h, ...derived?.access?.hubs.find((d) => d.name === h.name) }));
// sleeping: each category with the types this trail has in it; camping also carries wild camping
const sleeping = SLEEPING_CATEGORIES.map((c) => ({
  ...c,
  present: c.types.filter((x) => t.sleeping?.types.includes(x)),
}));
const sources = Object.fromEntries(t.sources.map((s, i) => [s.id, { ...s, n: i + 1 }]));
const totals = stageTotals(t);
// one length: the sum of the main stages where there are stages, else the first stated total
const length = totals
  ? { ...totals.km, approx: false }
  : t.length[0]
    ? { value: t.length[0].km, source: t.length[0].source, how: "stated total", approx: t.length[0].approx }
    : null;
const daily = perDay(t);
const sac = sacGrade(t);
const fmt = (n: number) => n.toLocaleString("en");
const hours = (min: number) => `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, "0")}`;
const TRAIL_TYPES = { "point-to-point": "Point to point", loop: "Loop", network: "Network" };
const range = (min: number, max: number) => (min === max ? `${min}` : `${min}–${max}`);
// the map line, built by pipeline/routes.py; without it the map shows only the termini
const routeFile = `routes/${trail.id}.geojson`;
const routeUrl = t.route && existsSync(`public/${routeFile}`) ? `/${routeFile}` : null;
// attribution names the route's source: its title up to the first colon
const routeAttribution = routeUrl && t.route ? sources[t.route.source].title.split(":")[0] : null;

const level = water && waterLevel(water.longestGapKm.drinking.km);
// status as a shape plus a word; colour (--good/--fair/--poor) only fills the shape
type Status = { shape: "full" | "half" | "blocked" | "empty"; tone: string; word: string };
const STATUS: Record<string, Status> = {
  available: { shape: "full", tone: "good", word: "Available" },
  allowed: { shape: "full", tone: "good", word: "Allowed" },
  restricted: { shape: "half", tone: "fair", word: "Restricted" },
  prohibited: { shape: "blocked", tone: "poor", word: "Prohibited" },
  none: { shape: "empty", tone: "none", word: "None listed" },
  unknown: { shape: "empty", tone: "none", word: "Not known" },
};
const SLEEPING_ICONS = {
  "wild-camping": "tent",
  camping: "tent-tree",
  huts: "house",
  hostels: "bed-single",
  rooms: "bed-double",
} as const;
const sleepingRows = sleeping.map((c) =>
  c.id === "wild-camping"
    ? { ...c, status: STATUS[t.wildCamping?.status ?? "unknown"], detail: "" }
    : {
        ...c,
        status: STATUS[c.present.length > 0 ? "available" : "none"],
        detail: c.present.map((x) => SLEEPING_LABELS[x]).join(", "),
      },
);
const WATER_STATUS = { frequent: "available", regular: "restricted", scarce: "prohibited" } as const;
const waterStatus = level && { ...STATUS[WATER_STATUS[level.id]], word: level.label };

// surfaces along the main route (pipeline/surface.py), in a fixed order, soft to hard
const surface = derived?.surface;
const SURFACES = [
  {
    id: "natural",
    label: "Natural ground",
    hint: "Earth, grass, rock and roots: footpaths and forest trails. Can be muddy after rain.",
  },
  { id: "gravel", label: "Gravel", hint: "Gravel, compacted and stony surfaces: mostly forest roads and farm tracks." },
  { id: "paved", label: "Paved", hint: "Asphalt, concrete and cobbles: roads and village streets." },
  { id: "unknown", label: "Unknown", hint: "Stretches whose surface OpenStreetMap doesn't record." },
] as const;
const surfaceRows = surface ? SURFACES.filter((c) => surface.totals[c.id]?.km > 0) : [];
const surfaceStarts =
  surface?.runs.filter((r, i, all) => i === 0 || all[i - 1].stage !== r.stage).map((r) => ({ number: r.stage, km: r.fromKm })) ?? [];
const pct = (share: number) => `${Math.round(share * 100)}%`;

// stage ticks for the strip charts: a tick at each stage start, the label centred on its stretch
const stageTicks = (starts: { number: string; km: number }[], total: number) =>
  starts.map((st, i) => {
    const end = starts[i + 1]?.km ?? total;
    return {
      x: xAt(st.km, total),
      mid: (xAt(st.km, total) + xAt(end, total)) / 2,
      label: xAt(end, total) - xAt(st.km, total) > 70 ? `Stage ${st.number}` : st.number,
    };
  });

// water strip chart: the main route on the map line's kilometres
const CHART = { width: 1000, x0: 8, x1: 992, axis: 92, lanes: { drinking: 46, spring: 70 } };
const xAt = (km: number, total = water?.routeKm || 1) => CHART.x0 + (km / total) * (CHART.x1 - CHART.x0);
const onRoute = water?.points.filter((p) => p.km !== null) ?? [];
const chartSummary =
  water &&
  `Water along the main route, ${water.routeKm} km: ${onRoute.filter((p) => p.kind === "drinking").length} drinking water points and ${onRoute.filter((p) => p.kind === "spring").length} springs. The longest stretch without drinking water is ${water.longestGapKm.drinking.km} km, from km ${water.longestGapKm.drinking.fromKm} to ${water.longestGapKm.drinking.toKm}.`;
const waterTotals = water && {
  drinking: water.points.filter((p) => p.kind === "drinking").length,
  springs: water.points.filter((p) => p.kind === "spring").length,
};
// the stage(s) of the longest dry stretch, from the water points at either end of it
const gapStages = (() => {
  if (!water) return "";
  const g = water.longestGapKm.drinking;
  const at = (km: number) => water.points.find((p) => p.km !== null && Math.abs(p.km - km) < 0.05)?.stage;
  const [a, b] = [at(g.fromKm), at(g.toKm)];
  return a && b ? (a === b ? `, stage ${a}` : `, stages ${a}–${b}`) : "";
})();

// on-page navigation: only sections this trail has
const nav = [
  { id: "figures", label: "Key figures", show: true },
  { id: "location", label: "Location", show: true },
  { id: "map", label: "Map", show: true },
  { id: "surfaces", label: "Surfaces", show: Boolean(surface) },
  { id: "stages", label: "Stages", show: Boolean(t.stages) },
  { id: "sleeping", label: "Sleeping", show: Boolean(t.sleeping || t.wildCamping) },
  { id: "water", label: "Water", show: Boolean(water) },
  { id: "sources", label: "Sources", show: true },
].filter((n) => n.show);
---

<Base
  title={`${t.name} · huckepack`}
  description={`${t.name}${t.localName ? ` (${t.localName})` : ""}: stages, length, ascent, difficulty, where to sleep, water and a map.`}
  section="trails"
>
  <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current={t.name} />
  <h1>
    {t.name}
  </h1>
  {t.localName && <p class="subtitle muted">{t.localName}</p>}

  <nav class="onpage" aria-label="On this page">
    <ul>
      {nav.map((n) => (
        <li>
          <a href={`#${n.id}`}>{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <section id="figures" class="key">
    <h2 class="visually-hidden">Key figures</h2>
    <dl class="strip spec">
      {length && (
        <div>
          <dt>Length</dt>
          <dd>
            {length.approx && <span class="unit">about</span>}
            <span class="big">{fmt(length.value)}</span><span class="unit">km</span>
          </dd>
        </div>
      )}
      {totals && (
        <div>
          <dt>Ascent</dt>
          <dd><span class="big">{fmt(totals.ascentM.value)}</span><span class="unit">m ↑</span></dd>
        </div>
      )}
      {totals && (
        <div>
          <dt>Descent</dt>
          <dd><span class="big">{fmt(totals.descentM.value)}</span><span class="unit">m ↓</span></dd>
        </div>
      )}
      {sac && (
        <div>
          <dt>
            Difficulty
            <Explain id="sac-info" title="SAC hiking scale" label={`What does SAC ${sac.value} mean?`}>
              <p>
                The Swiss Alpine Club grades hiking routes from T1 (easy) to T6 (very hard). This trail is{" "}
                <strong>{sac.value}</strong>{sac.how !== "stated" && ` (${sac.how})`}.
              </p>
              <ol class="sac-scale">
                {Object.entries(SAC_SCALE).map(([grade, g]) => (
                  <li class:list={[{ current: grade === sac.value }]}>
                    <strong>{grade} · {g.name}</strong>
                    <span>{g.text}</span>
                  </li>
                ))}
              </ol>
              <a slot="foot" href="https://www.sac-cas.ch/en/ausbildung-und-sicherheit/tourenplanung/grading-systems/">The scale at the Swiss Alpine Club</a>
            </Explain>
          </dt>
          <dd><span class="big">{sac.value}</span><span class="unit">SAC</span></dd>
        </div>
      )}
      {t.days && (
        <div>
          <dt>Suggested</dt>
          <dd><span class="big">{range(t.days.min, t.days.max)}</span><span class="unit">days</span></dd>
        </div>
      )}
      {daily && (
        <div>
          <dt>Per day · {fmt(daily.ascentM.value)} m ↑</dt>
          <dd><span class="big">{daily.km.value}</span><span class="unit">km</span></dd>
        </div>
      )}
      {t.season && (
        <div>
          <dt>Season</dt>
          <dd><span class="word">{t.season.text ?? t.season.months.map(monthName).join(", ")}</span></dd>
        </div>
      )}
      <div>
        <dt>Route type</dt>
        <dd><span class="word">{TRAIL_TYPES[t.trailType]}</span></dd>
      </div>
    </dl>
  </section>

  <section id="location">
    <h2>Location</h2>
    <dl class="loc">
      <div>
        <dt>Start</dt>
        <dd>{t.termini.start.name}</dd>
      </div>
      <div>
        <dt>Finish</dt>
        <dd>{t.termini.end.name}</dd>
      </div>
      {hubs.length > 0 && (
        <div class="wide">
          <dt>Travel hubs</dt>
          <dd>
            <ul class="hubs">
              {hubs.map((h) => (
                <li>
                  <span class="hub-kind">
                    <Icon name={h.kind === "station" ? "train-front" : "plane"} size={15} label={h.kind === "station" ? "Train station" : "Airport"} />
                  </span>
                  <span>
                    {h.name}
                    {h.roadKm !== undefined && derived?.access && (
                      <span class="hub-dist">{h.roadKm} km by road · {h.driveMin} min</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )}
      <div>
        <dt>Country</dt>
        <dd>{t.countries.map(countryName).join(", ")}</dd>
      </div>
      {t.regions.length > 0 && (
        <div>
          <dt>Regions</dt>
          <dd>{t.regions.join(", ")}</dd>
        </div>
      )}
      {t.protectedAreas.length > 0 && (
        <div class="wide">
          <dt>Protected areas</dt>
          <dd>{t.protectedAreas.join("; ")}</dd>
        </div>
      )}
      {t.waymarking && (
        <div>
          <dt>Waymarking</dt>
          <dd>{t.waymarking.text}</dd>
        </div>
      )}
      <div class:list={[{ wide: t.managedBy.map((m) => m.name).join(", ").length > 40 }]}>
        <dt>Managed by</dt>
        <dd>
          {t.managedBy.map((m) => m.name).join(", ")}
          <a class="site-link" href={t.website}>Official website</a>
        </dd>
      </div>
    </dl>
  </section>

  <section id="map">
    <h2 class="visually-hidden">Map</h2>
    <TrailMap
      client:visible
      routeUrl={routeUrl}
      start={t.termini.start}
      end={t.termini.end}
      routeAttribution={routeAttribution}
    />
  </section>

  {surface && (
    <section id="surfaces">
      <h2>Surfaces</h2>
      <dl class="strip spec cols" style={`--cols: ${surfaceRows.length}`}>
        {surfaceRows.map((c) => (
          <div>
            <dt>
              <span class="swatch-key" style={`--c: var(--surface-${c.id})`} aria-hidden="true"></span>
              {c.label}
              <Explain id={`about-surface-${c.id}`} title={c.label}><p>{c.hint}</p></Explain>
            </dt>
            <dd>
              <span class="big">{surface.totals[c.id].km.toFixed(1)}</span><span class="unit">km · {pct(surface.totals[c.id].share)}</span>
            </dd>
          </div>
        ))}
      </dl>

      <figure class="chart surfaceline" data-runs={JSON.stringify(surface.runs)} data-total={surface.routeKm}>
        <svg
          viewBox={`0 0 ${CHART.width} 80`}
          role="img"
          aria-label={`Surfaces along the main route, ${surface.routeKm} km: ${surfaceRows.map((c) => `${c.label.toLowerCase()} ${pct(surface.totals[c.id].share)}`).join(", ")}.`}
        >
          {surface.runs.map((r) => (
            <rect
              class="run"
              x={xAt(r.fromKm, surface.routeKm)}
              y="6"
              width={Math.max(xAt(r.toKm, surface.routeKm) - xAt(r.fromKm, surface.routeKm), 0.6)}
              height="22"
              style={`fill: var(--surface-${r.category})`}
            />
          ))}
          <line class="cursor" x1="0" x2="0" y1="2" y2="32" visibility="hidden" />
          {stageTicks(surfaceStarts, surface.routeKm).map((tk) => (
            <g>
              <line class="tick" x1={tk.x} x2={tk.x} y1="32" y2="40" />
              <text class="tick-label" x={tk.mid} y="52" text-anchor="middle">{tk.label}</text>
            </g>
          ))}
          <line class="tick" x1={CHART.x1} x2={CHART.x1} y1="32" y2="40" />
          <text class="tick-label end" x={CHART.x0} y="70">0 km</text>
          <text class="tick-label end" x={CHART.x1} y="70" text-anchor="end">{surface.routeKm} km</text>
        </svg>
        <div class="tip" role="status" hidden><strong></strong><span></span></div>
        <figcaption class="muted">
          From OpenStreetMap. {pct(surface.inferredShare)} of the route has no specific surface tag; there the way type
          decides (footpaths count as natural ground, tracks and roads as gravel). Hover or tap the bar for details.
        </figcaption>
      </figure>
    </section>
  )}

  {t.stages && (
    <section id="stages">
      <h2>Stages</h2>
      <ul class="stage-legend" aria-hidden="true">
        <li><Icon name="route" size={13} />Distance</li>
        <li><Icon name="trending-up" size={13} />Ascent</li>
        <li><Icon name="trending-down" size={13} />Descent</li>
        <li><Icon name="mountain" size={13} />Elevation, start → end</li>
        <li><Icon name="clock" size={13} />Walking time</li>
      </ul>
      <ol class="timeline">
        {t.stages.list.map((s) => (
          <li class={`stage ${s.kind}`}>
            <span class="stage-no" aria-hidden="true">{s.number}</span>
            <div class="stage-body">
              <p class="stage-route">
                <span class="visually-hidden">Stage {s.number}{s.kind !== "main" && ` (${s.kind})`}: </span>
                {s.from} <span class="arrow" aria-hidden="true">→</span> {s.to}
                {s.kind !== "main" && <span class="stage-kind">{s.kind === "approach" ? "Approach" : "Variant"}</span>}
              </p>
              <ul class="stage-stats">
                <li title="Distance">
                  <Icon name="route" size={14} /><span class="visually-hidden">Distance </span>{s.km.toFixed(1)} km
                </li>
                <li title="Ascent">
                  <Icon name="trending-up" size={14} /><span class="visually-hidden">Ascent </span>{fmt(s.ascentM)} m
                </li>
                <li title="Descent">
                  <Icon name="trending-down" size={14} /><span class="visually-hidden">Descent </span>{fmt(s.descentM)} m
                </li>
                {s.startEleM !== undefined && s.endEleM !== undefined && (
                  <li title="Elevation at start and end" class="wide">
                    <Icon name="mountain" size={14} /><span class="visually-hidden">Elevation </span>{fmt(s.startEleM)} → {fmt(s.endEleM)} m
                  </li>
                )}
                {s.minutes && (
                  <li title="Walking time">
                    <Icon name="clock" size={14} /><span class="visually-hidden">Walking time </span>{hours(s.minutes)}
                  </li>
                )}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <p class="note muted">Totals and averages use the main stages only, not the approach or variant.</p>
    </section>
  )}

  {(t.sleeping || t.wildCamping) && (
    <section id="sleeping">
      <h2>Sleeping</h2>
      <ul class="strip avail">
        {sleepingRows.map((c) => (
          <li class:list={[{ off: c.status.tone === "none" }]}>
            <p class="avail-name">
              <Icon name={SLEEPING_ICONS[c.id]} size={15} />
              {c.label}
              <Explain id={`about-${c.id}`} title={c.label}><p>{c.hint}</p></Explain>
            </p>
            <p class="status">
              <span class={`mark ${c.status.shape} tone-${c.status.tone}`} aria-hidden="true"></span>
              {c.status.word}
            </p>
            {c.detail && <p class="detail">{c.detail}</p>}
          </li>
        ))}
      </ul>
      {t.wildCamping && (
        <p class="aside">
          <span class={`mark ${STATUS[t.wildCamping.status].shape} tone-${STATUS[t.wildCamping.status].tone}`} aria-hidden="true"></span>
          <span><strong>Wild camping is {WILD_CAMPING_LABELS[t.wildCamping.status].toLowerCase()}.</strong> {t.wildCamping.rule}</span>
        </p>
      )}
    </section>
  )}

  {water && waterTotals && waterStatus && (
    <section id="water">
      <h2>Water</h2>
      <dl class="strip spec three">
        <div>
          <dt>
            Drinking water
            <Explain id="about-drinking-water" title="Drinking water">
              <p>Fountains, taps and springs marked as drinkable in OpenStreetMap, within {water.withinM} m of the trail.</p>
            </Explain>
          </dt>
          <dd><span class="big">{waterTotals.drinking}</span><span class="unit">points</span></dd>
        </div>
        <div>
          <dt>
            Drinkability unknown
            <Explain id="about-springs" title="Springs">
              <p>
                Other springs within {water.withinM} m of the trail. Whether they are drinkable is unknown: treat the water,
                and expect some to run dry in late summer.
              </p>
            </Explain>
          </dt>
          <dd><span class="big">{waterTotals.springs}</span><span class="unit">springs</span></dd>
        </div>
        <div>
          <dt>
            Longest dry stretch
            <Explain id="about-dry-stretch" title="Water availability">
              <p>
                Rated by the longest stretch of the main route without drinking water: frequent up to 10 km, regular up to 20
                km, scarce beyond. Here: from km {water.longestGapKm.drinking.fromKm} to {water.longestGapKm.drinking.toKm}{gapStages}.
              </p>
            </Explain>
          </dt>
          <dd>
            <span class="big">{water.longestGapKm.drinking.km}</span><span class="unit">km</span>
            <span class="status inline">
              <span class={`mark ${waterStatus.shape} tone-${waterStatus.tone}`} aria-hidden="true"></span>
              {waterStatus.word}
            </span>
          </dd>
        </div>
      </dl>

      {water.stageStarts.length > 0 && (
        <figure class="waterline">
          <ul class="legend" aria-hidden="true">
            <li><svg width="12" height="12"><circle cx="6" cy="6" r="4.5" class="dot drinking" /></svg>Drinking water</li>
            <li><svg width="12" height="12"><circle cx="6" cy="6" r="4" class="dot spring" /></svg>Spring</li>
            <li><span class="swatch"></span>Longest dry stretch</li>
          </ul>
          <svg viewBox={`0 0 ${CHART.width} 132`} role="img" aria-label={chartSummary}>
            <rect
              class="gap"
              x={xAt(water.longestGapKm.drinking.fromKm)}
              y="28"
              width={xAt(water.longestGapKm.drinking.toKm) - xAt(water.longestGapKm.drinking.fromKm)}
              height={CHART.axis - 28}
              rx="4"
            />
            <text
              class="gap-label"
              x={(xAt(water.longestGapKm.drinking.fromKm) + xAt(water.longestGapKm.drinking.toKm)) / 2}
              y="20"
              text-anchor="middle">{water.longestGapKm.drinking.km} km without</text>
            <line class="route" x1={CHART.x0} x2={CHART.x1} y1={CHART.axis} y2={CHART.axis} />
            {stageTicks(water.stageStarts, water.routeKm).map((tk) => (
              <g>
                <line class="tick" x1={tk.x} x2={tk.x} y1={CHART.axis - 5} y2={CHART.axis + 5} />
                <text class="tick-label" x={tk.mid} y={CHART.axis + 18} text-anchor="middle">{tk.label}</text>
              </g>
            ))}
            <line class="tick" x1={CHART.x1} x2={CHART.x1} y1={CHART.axis - 5} y2={CHART.axis + 5} />
            <text class="tick-label end" x={CHART.x0} y={CHART.axis + 36}>0 km</text>
            <text class="tick-label end" x={CHART.x1} y={CHART.axis + 36} text-anchor="end">{water.routeKm} km</text>
            {onRoute.map((pt) => (
              <g
                class="pt"
                data-tip-title={pt.kind === "drinking" ? "Drinking water" : "Spring"}
                data-tip-text={`${pt.name ? `${pt.name} · ` : ""}km ${pt.km} · stage ${pt.stage}`}
              >
                <circle cx={xAt(pt.km!)} cy={CHART.lanes[pt.kind]} r="10" class="hit" />
                <circle cx={xAt(pt.km!)} cy={CHART.lanes[pt.kind]} r={pt.kind === "drinking" ? 4.5 : 4} class={`dot ${pt.kind}`} />
              </g>
            ))}
          </svg>
          <div class="tip" role="status" hidden><strong></strong><span></span></div>
          <figcaption class="muted">
            Water within {water.withinM} m of the main route, from OpenStreetMap, which may be incomplete. Hover or tap a
