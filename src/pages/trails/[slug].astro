    </ol>
  </footer>
</Base>

<script>
  // On-page navigation: marks the link of the section in view. The section counts as in view
  // once its top passes just below where a link click puts it (its scroll-margin-top); the last
  // one that did wins.
  {
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".onpage a")];
    const sections = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el) => el !== null);
    const bar = document.querySelector<HTMLElement>(".onpage")!;
    let current: HTMLAnchorElement | undefined;
    const update = () => {
      const line = Math.max(bar.getBoundingClientRect().bottom, parseFloat(getComputedStyle(sections[0]).scrollMarginTop)) + 8;
      const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const passed = sections.filter((el) => el.getBoundingClientRect().top <= line);
      const section = atEnd ? sections.at(-1) : passed.at(-1);
      const link = links.find((a) => a.hash === `#${section?.id}`);
      if (link === current) return;
      current?.removeAttribute("aria-current");
      current = link;
      if (!link) return;
      link.setAttribute("aria-current", "location");
      // keep it visible in the row that scrolls sideways on phones, without moving the page
      const row = link.closest("ul")!;
      const { left, right } = link.getBoundingClientRect();
      const box = row.getBoundingClientRect();
      if (left < box.left || right > box.right) row.scrollBy({ left: left < box.left ? left - box.left - 16 : right - box.right + 16 });
    };
    let queued = false;
    addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    }, { passive: true });
    addEventListener("resize", update);
    update();
  }

  // Water chart tooltip: one element per chart, filled from the hovered (or tapped) dot.
  for (const figure of document.querySelectorAll<HTMLElement>(".waterline")) {
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    let active: SVGGElement | null = null;
    const show = (pt: SVGGElement) => {
      active?.classList.remove("active");
      active = pt;
      pt.classList.add("active");
      tip.querySelector("strong")!.textContent = pt.dataset.tipTitle ?? "";
      tip.querySelector("span")!.textContent = pt.dataset.tipText ?? "";
      tip.hidden = false;
      const dot = pt.querySelector(".dot")!.getBoundingClientRect();
      const box = figure.getBoundingClientRect();
      const x = dot.left + dot.width / 2 - box.left;
      const half = tip.offsetWidth / 2;
      tip.style.left = `${Math.min(Math.max(x, half), box.width - half)}px`;
      tip.style.top = `${dot.top - box.top - 8}px`;
    };
    const hide = () => {
      active?.classList.remove("active");
      active = null;
      tip.hidden = true;
    };
    for (const pt of figure.querySelectorAll<SVGGElement>(".pt")) {
      pt.addEventListener("pointerenter", () => show(pt));
      pt.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
      pt.addEventListener("click", (e) => {
        e.stopPropagation();
        show(pt);
      });
    }
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }

  // Long stage tables (issue #25): the rows after the first few fold behind "Show all"; without
  // this script every row shows
  for (const box of document.querySelectorAll<HTMLElement>(".stage-table")) {
    const button = box.querySelector<HTMLButtonElement>(".show-all")!;
    if (!box.querySelector(".extra")) continue;
    const more = button.textContent!.trim();
    box.classList.add("folded");
    button.hidden = false;
    button.addEventListener("click", () => {
      const open = !box.classList.toggle("folded");
      button.setAttribute("aria-expanded", String(open));
      button.textContent = open ? "Show fewer" : more;
      // folding up from far below: bring the table's top back into view
      if (!open && box.getBoundingClientRect().top < 0) box.scrollIntoView({ block: "start" });
    });
  }

  // Terrain: a crosshair with everything at the pointer's kilometre: height, the 200 m gradient,
  // the ground, the stage.
  for (const section of document.querySelectorAll<HTMLElement>(".terrain")) {
    const figure = section.querySelector<HTMLElement>(".terrain-chart")!;
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const cursor = figure.querySelector<SVGLineElement>(".cursor")!;
    const dot = figure.querySelector<SVGCircleElement>(".cursor-dot")!;
    const line = figure.querySelector<SVGPathElement>(".line")!;
    const data: {
      total: number;
      points: [number, number][];
      bars: [number, number, number, string][]; // fromKm, toKm, grade, stage
      runs: [number, number, string][]; // fromKm, toKm, category
    } = JSON.parse(figure.querySelector(".chart-data")!.textContent!);
    const { points, total } = data;
    const bars = data.bars.map(([fromKm, toKm, grade, stage]) => ({ fromKm, toKm, grade, stage }));
    const runs = data.runs.map(([fromKm, toKm, category]) => ({ fromKm, toKm, category }));
    const GROUND: Record<string, string> = { natural: "natural ground", gravel: "gravel", paved: "paved", unknown: "unknown surface" };
    const X0 = 8;
    const X1 = 992;
    const show = (clientX: number) => {
      const box = svg.getBoundingClientRect();
      const vx = Math.min(Math.max(((clientX - box.left) / box.width) * 1000, X0), X1);
      const km = ((vx - X0) / (X1 - X0)) * total;
      const idx = points.reduce((best, p, i) => (Math.abs(p[0] - km) < Math.abs(points[best][0] - km) ? i : best), 0);
      const [pkm, m] = points[idx];
      // y of the plotted point: read it off the path at the same index
      const y = Number(line.getAttribute("d")!.split(/[ML]/).filter(Boolean)[idx].split(",")[1]);
      const bar = bars.find((b) => pkm >= b.fromKm && pkm <= b.toKm);
      const run = runs.find((r) => pkm >= r.fromKm && pkm <= r.toKm);
      cursor.setAttribute("x1", String(vx));
      cursor.setAttribute("x2", String(vx));
      cursor.setAttribute("visibility", "visible");
      dot.setAttribute("cx", String(vx));
      dot.setAttribute("cy", String(y));
      dot.setAttribute("visibility", "visible");
      tip.querySelector("strong")!.textContent = `${m.toLocaleString("en")} m${bar ? ` · ${bar.grade > 0 ? "+" : bar.grade < 0 ? "−" : ""}${Math.abs(Math.round(bar.grade))} %` : ""}`;
      tip.querySelector("span")!.textContent = `km ${pkm.toFixed(1)}${bar ? ` · stage ${bar.stage}` : ""}${run ? ` · ${GROUND[run.category] ?? run.category}` : ""}`;
      tip.hidden = false;
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const px = box.left - fbox.left + (vx / 1000) * box.width;
      tip.style.left = `${Math.min(Math.max(px, half), fbox.width - half)}px`;
      tip.style.top = `${box.top - fbox.top + (y / 222) * box.height - 10}px`;
    };
    const hide = () => {
      tip.hidden = true;
      cursor.setAttribute("visibility", "hidden");
      dot.setAttribute("visibility", "hidden");
    };
    svg.addEventListener("pointermove", (e) => show(e.clientX));
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    svg.addEventListener("click", (e) => {
      e.stopPropagation();
      show(e.clientX);
    });
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }

  // Landscape: one tooltip at the pointer (the lane's landscape, km and stage there), from the
  // chart's data, instead of a title on every run.
  for (const figure of document.querySelectorAll<HTMLElement>(".lanes")) {
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const cursor = figure.querySelector<SVGLineElement>(".cursor")!;
    const data: {
      total: number;
      x0: number;
      x1: number;
      lanes: string[];
      runs: [number, number, number][]; // fromKm, toKm, lane
      stages: [string, number][]; // number, start km
    } = JSON.parse(figure.querySelector(".chart-data")!.textContent!);
    const height = svg.viewBox.baseVal.height;
    const show = (clientX: number) => {
      const box = svg.getBoundingClientRect();
      const vx = Math.min(Math.max(((clientX - box.left) / box.width) * 1000, data.x0), data.x1);
      const km = ((vx - data.x0) / (data.x1 - data.x0)) * data.total;
      const run = data.runs.find(([from, to]) => km >= from && km <= to);
      if (!run) return;
      const stage = data.stages.filter(([, start]) => start <= km).at(-1)?.[0];
      cursor.setAttribute("x1", String(vx));
      cursor.setAttribute("x2", String(vx));
      cursor.setAttribute("visibility", "visible");
      tip.querySelector("strong")!.textContent = data.lanes[run[2]];
      tip.querySelector("span")!.textContent = `km ${km.toFixed(1)}${stage ? ` · stage ${stage}` : ""}`;
      tip.hidden = false;
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const px = box.left - fbox.left + (vx / 1000) * box.width;
      tip.style.left = `${Math.min(Math.max(px, half), fbox.width - half)}px`;
      tip.style.top = `${box.top - fbox.top + ((run[2] * 26 + 3) / height) * box.height}px`;
    };
    const hide = () => {
      tip.hidden = true;
      cursor.setAttribute("visibility", "hidden");
    };
    svg.addEventListener("pointermove", (e) => show(e.clientX));
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    svg.addEventListener("click", (e) => {
      e.stopPropagation();
      show(e.clientX);
    });
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }

  // Climate tooltip: everything about the month under the pointer.
  const MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  type Place = { tmax: number; tmin: number; wetDays: number; snowDays: number; frostNights: number };
  for (const figure of document.querySelectorAll<HTMLElement>(".climate")) {
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const months: { month: number; low: Place; high: Place; daylightH: number }[] = JSON.parse(
      figure.querySelector(".chart-data")!.textContent!,
    );
    // round first, so −0.3 °C reads 0, not −0
    const c = (v: number) => {
      const r = Math.round(v);
      return `${r < 0 ? "−" : ""}${Math.abs(r)}`;
    };
    let active: SVGRectElement | null = null;
    const show = (hit: SVGRectElement) => {
      active?.classList.remove("active");
      active = hit;
      hit.classList.add("active");
      const m = months.find((x) => x.month === Number(hit.dataset.month))!;
      tip.querySelector("strong")!.textContent = MONTH_NAMES[m.month - 1];
      tip.querySelector("span")!.textContent = [
        `Lowest point: ${c(m.low.tmax)} °C by day, ${c(m.low.tmin)} °C at night`,
        `Highest point: ${c(m.high.tmax)} °C by day, ${c(m.high.tmin)} °C at night`,
        `Highest point: ${Math.round(m.high.wetDays)} wet days, ${Math.round(m.high.snowDays)} with snow, ${Math.round(m.high.frostNights)} frost nights`,
        `${m.daylightH.toFixed(1)} h of daylight`,
      ].join("\n");
      tip.hidden = false;
      tip.style.maxWidth = `${figure.getBoundingClientRect().width}px`;
      const box = hit.getBoundingClientRect();
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      tip.style.left = `${Math.min(Math.max(box.left + box.width / 2 - fbox.left, half), fbox.width - half)}px`;
      tip.style.top = `${svg.getBoundingClientRect().top - fbox.top + 24}px`;
    };
    const hide = () => {
      tip.hidden = true;
      active?.classList.remove("active");
      active = null;
    };
    for (const hit of figure.querySelectorAll<SVGRectElement>(".col-hit")) {
      hit.addEventListener("pointerenter", () => show(hit));
      hit.addEventListener("click", (e) => {
        e.stopPropagation();
        show(hit);
      });
    }
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* title and local name get room above and below, set apart from breadcrumbs and navigation */
  h1 {
    margin: 32px 0 10px;
    text-align: center;
  }
  .subtitle {
    margin: 0 0 16px;
    font-style: italic;
    text-align: center;
  }
  .site-link {
    display: block;
    margin-top: 2px;
    font-size: 0.8rem;
  }

  .onpage {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 16px -16px 0;
    padding: 0 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .onpage ul {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  /* the underline's space is reserved by a transparent border, so marking a link shifts nothing */
  .onpage a {
    display: block;
    padding: 12px 0 10px;
    border-bottom: 2px solid transparent;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  /* centred with auto margins rather than justify-content: when the links overflow on a phone,
     the row still scrolls from its first link instead of cutting it off on the left */
  .onpage li:first-child {
    margin-left: auto;
  }
  .onpage li:last-child {
    margin-right: auto;
  }
  .onpage a:hover,
  .onpage a:focus-visible {
    border-bottom-color: var(--muted);
  }
  /* the section in view, set by the script below */
  .onpage a[aria-current] {
    border-bottom-color: var(--accent);
  }

  section {
    margin-top: 36px;
    scroll-margin-top: 64px;
  }
  /* wide screens: section headings move into a margin column, like a printed guidebook, and
     every section's content starts at the same indent beside its title. Separates the sections
     and saves the heading rows. From 1080 px only: the content column stays at least 820 px wide,
     which the stage table and the five sleeping columns need. Key figures and the
     map (hidden headings) keep the full width. */
  @media (min-width: 1080px) {
    section:has(> h2:not(.visually-hidden)) {
      display: flow-root;
    }
    section > h2:not(.visually-hidden) {
      float: left;
      width: 136px;
      margin: 0;
      padding-top: 10px;
      font-size: 1.15rem;
      line-height: 1.25;
    }
    section:has(> h2:not(.visually-hidden)) > :global(:not(h2)) {
      margin-left: 160px;
    }
  }
  .key {
    margin-top: 20px;
  }
  /* desktop: every card in one row, however many the trail has */
  @media (min-width: 900px) {
    .figures {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      grid-template-columns: none;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts dd {
      margin-bottom: 8px;
    }
  }
  .note {
    font-size: 0.8rem;
  }
  /* desktop: each section's cards in one row, headlines on one line */
  @media (min-width: 900px) {
    .cards {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      grid-template-columns: none;
    }
    .card-name > span {
      white-space: nowrap;
    }
  }
  /* icons sit on the first line of their label, however many lines it wraps to */
  .figures dt :global(.icon) {
    flex: none;
    margin-top: 1px;
  }
  .hubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hubs li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .hub-kind {
    flex: none;
    display: grid;
    place-items: center;
    height: 1.5em;
    color: var(--muted);
    align-self: flex-start;
  }
  .hubs li {
    align-items: flex-start;
  }
  .hub-dist {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .hubs li:last-child {
    margin-bottom: 0;
  }
  .arrow {
    color: var(--muted);
    font-weight: 400;
  }
  /* stages (issue #25, every trail): a compact table, one line per stage, with small bars under the
     distance and the ascent so long and hard days stand out; rows after the first few fold away */
  .stage-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .stage-table thead th {
    padding: 0 12px 6px 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
    text-align: left;
  }
  .stage-table td,
  .stage-table tbody th {
    height: 30px;
    padding: 0 12px 0 0;
    border-top: 1px solid var(--line);
    font-weight: 400;
    text-align: left;
    white-space: nowrap;
  }
  .stage-table .n {
    width: 2.2rem;
    color: var(--accent);
    font-weight: 600;
  }
  .stage-table .route {
    width: 100%;
    font-family: var(--serif);
    font-size: 0.95rem;
    font-weight: 600;
    white-space: normal;
  }
  .stage-table .variant .n,
  .stage-table .approach .n,
  .stage-table .variant .route,
  .stage-table .approach .route {
    color: var(--muted);
  }
  .stage-table .group th {
    padding-top: 16px;
    border-top: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .stage-table .bar {
    position: relative;
    min-width: 6.5rem;
  }
  .stage-table .fill {
    position: absolute;
    bottom: 4px;
    left: 0;
    width: calc(var(--w) * 5.5rem);
    height: 3px;
    border-radius: 2px;
    background: var(--muted);
    opacity: 0.45;
  }
  .stage-table .bar.up .fill {
    background: var(--grade-up-steep);
    opacity: 0.8;
  }
  .stage-table .est {
    color: var(--muted);
  }
  .stage-table.folded .extra {
    display: none;
  }
  /* relative: the hidden screen-reader words in the cells are placed absolutely and must not
     escape the scroll box (they widened the page on phones) */
  .table-scroll {
    position: relative;
    overflow-x: auto;
  }
  .show-all {
    margin-top: 10px;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .show-all:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* many stages: every other stage shaded behind the strip charts */
  .stage-band {
    fill: var(--line);
    opacity: 0.55;
  }
  /* location and map: stacked, the map beneath; from 900 px side by side, the facts in two columns
     on the left and the map filling their height on the right */
  .loc-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .map-col {
    display: flex;
    flex-direction: column;
    scroll-margin-top: 64px;
  }
  @media (min-width: 900px) {
    .loc-map {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 28px;
      align-items: stretch;
    }
    .loc-map .loc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: start;
    }
  }
  /* location: one grid of label-over-value items, so rows align whatever the content */
  .loc {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    border-top: 1px solid var(--text);
  }
  @media (min-width: 820px) {
    .loc {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .loc > div {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .loc > .wide {
    grid-column: span 2;
  }
  .loc dt {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .loc dd {
    margin: 2px 0 0;
    line-height: 1.45;
  }
  /* waymarking with its mark redrawn small, first line beside the mark */
  .loc dd.marked {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .loc dd.marked .marks {
    display: flex;
    flex: none;
    gap: 4px;
    margin-top: 3px;
  }
  /* difficulty key figure: one bar per dimension (initial beneath), as tall as its level; the
     hardest level as a word beside it. As tall as the big numbers, so the labels line up */
  .diff-fig {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }
  .diff-bars {
    display: flex;
    gap: 3px;
    height: 2rem;
    padding-bottom: 0.15rem;
  }
  .diff-col {
    position: relative;
    width: 9px;
    height: calc(100% - 11px);
    background: var(--line);
    border-radius: 2px 2px 0 0;
  }
  .diff-bar {
    position: absolute;
    inset: auto 0 0;
    background: var(--text);
    border-radius: 2px 2px 0 0;
  }
  .diff-bar.range {
    opacity: 0.4;
  }
  .diff-tag {
    position: absolute;
    inset: auto 0 -12px;
    font-size: 0.6rem;
    line-height: 1;
    text-align: center;
    color: var(--muted);
  }
  .diff-pop {
    display: grid;
    gap: 8px;
    margin: 10px 0;
    padding: 0;
    list-style: none;
  }
  .diff-pop li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 10px;
  }
  .diff-pop li > :global(.meter) {
    grid-row: span 2;
    margin-top: 0.35em;
  }
  .diff-pop span {
    color: var(--muted);
  }

  /* difficulty section: one card per dimension in a strip; its level, then every measure, the one
     that set the level in bold */
  .diff-cards {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .diff-cards {
      grid-template-columns: repeat(var(--cols), 1fr);
    }
  }
  @media (max-width: 639px) {
    .diff-fig .big {
      font-size: 1.25rem;
    }
    .strip.diff-cards > * + * {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  .diff-cards p {
    margin: 0;
  }
  .diff-label {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .diff-level {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 10px !important;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .measures {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
  }
  .measures li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px;
    align-items: baseline;
    color: var(--muted);
  }
  .measures li.set {
    color: var(--text);
    font-weight: 600;
  }
  .measures li .muted {
    font-weight: 400;
  }
  .measures .v {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* a measure's four bands in its popover, the trail's band marked */
  .bands p {
    margin: 10px 0 4px;
  }
  .bands ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85em;
  }
  .bands li {
    padding: 4px 6px;
    border-radius: 6px;
    color: var(--muted);
  }
  .bands li span {
    display: block;
    color: var(--text);
    font-weight: 600;
  }
  .bands li.current {
    background: var(--accent-soft);
    color: var(--text);
  }
  .sac-scale {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  .sac-scale {
    margin-bottom: 0;
  }
  .sac-scale li {
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--muted);
  }
  .sac-scale li.current {
    background: var(--accent-soft);
    color: var(--text);
  }
  .sac-scale strong {
    display: block;
    color: var(--text);
  }
  .sources {
    margin-top: 72px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
    scroll-margin-top: 64px;
  }
  /* a short rule, like a printed footnote's */
  .sources::before {
    content: "";
    display: block;
    width: 120px;
    margin-bottom: 12px;
    border-top: 1px solid var(--line);
  }
  .sources h2 {
    margin: 0 0 6px;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sources ol {
    margin: 0;
    padding-left: 1.6em;
  }
  .sources li {
    margin-bottom: 2px;
  }
  .sources a {
    color: inherit;
  }
  .sources li:target {
    color: var(--text);
    background: var(--accent-soft);
  }

  /* strips: the shared language of key figures, sleeping and water. A rule on top,
     hairlines between items, no filled boxes; numbers first, labels small beneath. */
  .strip {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--line);
  }
  .strip > * {
    padding: 14px 16px 14px 0;
  }
  .strip > * + * {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }

  /* key figures and water figures: 2 columns on phones, 4 on tablets, one row on desktop (key
     figures stay in rows of four: .key-figs) */
  .spec {
    grid-template-columns: repeat(2, 1fr);
  }
  .spec.three {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (min-width: 640px) {
    .spec {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 980px) {
    .spec {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: auto;
    }
    .spec.three {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row;
    }
  }
  @media (max-width: 979px) {
    .spec:not(.three) > :nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 639px) {
    .spec:not(.three) > :nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .spec:not(.three) > :nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  /* key figures: one row from 1200 px (each column as wide as its figure, the spare width shared
     out), rows of four from 640 px with a hairline between, two shrinkable columns on phones */
  @media (max-width: 639px) {
    .spec.key-figs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 640px) and (max-width: 1199px) {
    .spec.key-figs {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-flow: row;
    }
    .spec.key-figs > :nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .spec.key-figs > :nth-child(n + 5) {
      border-top: 1px solid var(--line);
    }
  }
  @media (min-width: 1200px) {
    .spec.key-figs {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(max-content, 1fr);
    }
    .spec.key-figs > * + * {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  /* ascent and descent: two lines in a smaller serif, together as tall as one big number */
  .climbs {
    display: grid;
    align-content: end;
    min-height: 1.95rem;
    line-height: 1.05;
  }
  .climb {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .climbs .unit {
    font-size: 0.78rem;
  }
  /* landscape key figure: the main landscape in words over a bar of every group's share; as tall
     as the big numbers beside it */
  .land-fig {
    display: grid;
    align-content: end;
    gap: 6px;
    min-height: 1.95rem;
    font-size: 0.9rem;
  }
  .land-fig b {
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  .land-bar {
    display: flex;
    gap: 2px;
    width: 9rem;
    max-width: 100%;
    height: 10px;
  }
  .land-bar span {
    min-width: 3px;
    border-radius: 2px;
    background: var(--c);
  }
  .land-pop {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .land-pop .swatch-key {
    display: inline-block;
  }
  /* label first in the markup (dt before dd), value first on screen */
  .spec div {
    display: flex;
    flex-direction: column;
  }
  .spec dd {
    order: 1;
  }
  .spec dt {
    order: 2;
  }
  .spec dd {
    margin: 0;
    white-space: nowrap;
  }
  .big {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.15;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .word {
    display: block;
    padding-top: 6px;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: normal;
  }
  /* a word before the number ("about 285 km") */
  .unit.before {
    margin: 0 4px 0 0;
  }
  /* "≈" before an estimated key figure */
  .unit.approx {
    margin: 0 3px 0 0;
  }
  .unit {
    margin-left: 4px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .spec dt {
    display: flex;
    align-items: center;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* season key figure: twelve month cells in two rows, season months filled (as on the search cards) */
  /* two 14 px rows: as tall as the big numbers beside it, so the labels beneath line up */
  .season-grid {
    display: grid;
    grid-template-columns: repeat(6, 1.25rem);
    grid-auto-rows: 14px;
    gap: 3px;
  }
  .season-grid .month {
    border-radius: 3px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 600;
    line-height: 14px;
    text-align: center;
  }
  .season-grid .month.in {
    background: color-mix(in srgb, var(--text) 72%, var(--bg));
    color: var(--bg);
  }

  /* sleeping: availability per category */
  .avail {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .avail {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  /* phones: wild camping across the top, the four kinds of beds in two columns beneath */
  @media (max-width: 639px) {
    .avail {
      grid-template-columns: repeat(2, 1fr);
    }
    .avail > :first-child {
      grid-column: 1 / -1;
    }
    .avail > * + * {
      border-top: 1px solid var(--line);
    }
    .avail > :nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
    .avail > :nth-child(odd):not(:first-child) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  .avail p {
    margin: 0;
  }
  .avail-name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px !important;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .status.inline {
    display: inline-flex;
    margin: 0 0 0 10px !important;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 500;
    vertical-align: 4px;
  }
  .detail {
    margin-top: 2px !important;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .off .status {
    color: var(--muted);
    font-weight: 400;
  }

  /* status marks: the shape carries the meaning (full, half, crossed, empty), colour supports it */
  .mark {
    flex: none;
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 2px solid var(--mark);
    border-radius: 50%;
  }
  .tone-good {
    --mark: var(--good);
  }
  .tone-fair {
    --mark: var(--fair);
  }
  .tone-poor {
    --mark: var(--poor);
  }
  .tone-none {
    --mark: var(--muted);
  }
  .mark.full {
    background: var(--mark);
  }
  .mark.half {
    background: linear-gradient(90deg, var(--mark) 50%, transparent 50%);
  }
  .mark.blocked {
    background: linear-gradient(135deg, transparent 43%, var(--mark) 43%, var(--mark) 57%, transparent 57%);
  }
  .aside {
    display: flex;
    gap: 10px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .aside .mark {
    margin-top: 4px;
  }
  .aside strong {
    color: var(--text);
    font-weight: 600;
  }

  /* water along the route: a strip chart on the map line's kilometres */
  .waterline {
    margin: 20px 0 0;
  }
  .run {
    shape-rendering: crispEdges;
  }
  .cursor {
    stroke: var(--text);
    stroke-width: 1.5;
  }
  /* equal columns from 640 px; phones keep the strips' two columns (four would overflow) */
  @media (min-width: 640px) {
    .spec.cols {
      grid-template-columns: repeat(var(--cols), 1fr) !important;
      grid-auto-flow: row !important;
    }
    .spec.cols > * {
      padding-left: 16px !important;
      border-left: 1px solid var(--line) !important;
    }
    .spec.cols > :first-child {
      padding-left: 0 !important;
      border-left: 0 !important;
    }
  }
  /* landscape: one lane per group along the route; the chart opens the section, so it carries the
     strips' rule in text colour on top, like every other section */
  .lanes {
    position: relative;
    margin: 0;
    padding-top: 38px;
    border-top: 1px solid var(--text);
  }
  .lanes > .chart-info {
    top: 8px;
  }
  /* 15 units in a 1000-unit chart: about 13 px at the content column's width */
  .lanes .lane-label {
    fill: var(--text);
    font: 15px var(--sans);
  }
  .lanes .lane-share {
    fill: var(--muted);
    font: 15px var(--sans);
  }
  .lanes .lane-track {
    stroke: var(--line);
    stroke-width: 1;
  }
  .lanes svg {
    cursor: crosshair;
  }
  /* colour key in the surface figures (not .key: that is the key figures section) */
  .swatch-key {
    flex: none;
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 2px;
    background: var(--c);
  }
  .waterline svg[role="img"] {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0 0 4px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .swatch {
    width: 16px;
    height: 10px;
    border-radius: 2px;
    background: var(--fair-soft);
    outline: 1px solid var(--fair);
  }
  .dot {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .dot.drinking {
    fill: var(--water);
  }
  .dot.spring {
    fill: var(--bg);
    stroke: var(--water);
  }
  .hit {
    fill: transparent;
    cursor: help;
  }
  .dot {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.12s ease;
  }
  .pt:hover .dot,
  .pt.active .dot {
    transform: scale(1.5);
  }
  /* terrain: the profile's tint, the colour of level ground */
  .terrain {
    --terrain-tint: color-mix(in srgb, var(--accent) 18%, var(--bg));
  }
  /* key figures in one row of pairs (issue #28): three narrow tiles and the wider surfaces tile;
     two columns on phones, the surfaces across both */
  .terrain-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .terrain-row .ground-fig {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .terrain-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .terrain-row.has-ground {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 2.2fr);
    }
    .terrain-row .ground-fig {
      grid-column: auto;
    }
  }
  @media (max-width: 639px) {
    .terrain-row > :nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .terrain-row .ground-fig {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  .terrain-row .shares {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    align-items: baseline;
    align-content: end;
    min-height: 1.95rem;
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .terrain-row .shares .swatch-key {
    display: inline-block;
  }
  .terrain-row .shares .climb {
    color: var(--text);
  }
  .surface-pop {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .surface-pop li {
    display: flex;
    gap: 2px;
    align-items: baseline;
    margin-top: 6px;
  }
  .surface-pop .swatch-key {
    display: inline-block;
  }
  .terrain-row div {
    display: flex;
    flex-direction: column;
  }
  .terrain-row dd {
    order: 1;
    margin: 0;
    white-space: nowrap;
  }
  .terrain-row dt {
    display: flex;
    align-items: center;
    order: 2;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .terrain-body {
    position: relative;
  }
  .terrain-chart {
    margin: 16px 0 0;
  }
  .terrain-chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    cursor: crosshair;
  }
  /* the profile: 200 m slices filled by gradient (--g) or ground (--s); an edge in their own colour
     closes the hairline seams between them */
  .slice {
    --g: color-mix(in oklab, var(--grade-up-steep) var(--p), var(--terrain-tint));
    fill: var(--g);
    stroke: var(--g);
    stroke-width: 0.8;
  }
  .slice.down {
    --g: color-mix(in oklab, var(--grade-down-steep) var(--p), var(--terrain-tint));
  }
  .terrain-chart .line {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .terrain-chart .grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .terrain-chart .grid-label {
    fill: var(--muted);
    font: 11px var(--sans);
  }
  .terrain-chart .base {
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  /* the tree line: a dashed line in the forest colour of the landscape section (over a faint band where
     the source gives a range), its label in text colour */
  .terrain-chart .tree-line rect {
    fill: var(--land-forest);
    opacity: 0.12;
  }
  .terrain-chart .tree-line line {
    stroke: var(--land-forest);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .terrain-chart .tree-line text {
    fill: var(--text);
    font: 600 11px var(--sans);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .terrain-chart .grid-label.halo {
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .terrain-chart .peak {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .terrain-chart .peak-label {
    fill: var(--text);
    font: 600 12px var(--sans);
  }
  .terrain-chart .cursor-dot {
    fill: var(--text);
    stroke: var(--bg);
    stroke-width: 2;
  }
  /* the gradient key and the surfaces key side by side, wrapping on narrow screens */
  .terrain-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    align-items: start;
    margin-top: 8px;
  }
  .terrain-keys .legend {
    margin: 0;
  }
  /* the gradient key: descent ← 0 → climb, the same ramp as the slices */
  .ramp-key {
    display: grid;
    grid-template-columns: auto 220px auto;
    column-gap: 8px;
    align-items: center;
    justify-content: start;
  }
  .ramp-bar {
    height: 10px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--grade-down-steep),
      color-mix(in oklab, var(--grade-down-steep) 50%, var(--terrain-tint)),
      var(--terrain-tint),
      color-mix(in oklab, var(--grade-up-steep) 50%, var(--terrain-tint)),
      var(--grade-up-steep)
    );
  }
  .ramp-ticks {
    display: flex;
    grid-column: 2;
    justify-content: space-between;
    font-size: 0.72rem;
  }
  .tip {
    position: absolute;
    z-index: 5;
    transform: translate(-50%, -100%);
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.15);
    font-size: 0.8rem;
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
  }
  .tip strong {
    display: block;
  }
  .tip span {
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      transition: none;
    }
  }
  .gap {
    fill: var(--fair-soft);
  }
  .gap-label {
    fill: var(--text);
    font: 600 13px var(--sans);
  }
  .route {
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .tick {
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .tick-label {
    fill: var(--muted);
    font: 12px var(--sans);
  }
  .tick-label.end {
    font-size: 11px;
  }
  figcaption {
    margin-top: 10px;
    font-size: 0.8rem;
  }
  /* a chart's explanation behind an (i) in its top-right corner, instead of a caption line: at the
     end of the legend row where the chart has one on top (water, climate), else in a slim row of
     its own above the drawing (terrain, landscape) */
  .lanes,
  .waterline,
  .terrain-chart,
  .climate {
    position: relative;
  }
  figcaption.chart-info {
    position: absolute;
    top: -2px;
    right: 0;
    margin: 0;
  }
  .terrain-chart:has(> .chart-info) {
    padding-top: 30px;
  }

  /* phones: three figures don't fit side by side; the first two share a row, the third gets its own */
  @media (max-width: 639px) {
    .spec.three {
      grid-template-columns: repeat(2, 1fr);
    }
    .spec.three > :nth-child(3) {
      grid-column: 1 / -1;
      padding-left: 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
  /* phones: charts keep a readable width and scroll sideways along the route in their own strip
     (labels a little larger); legends and captions stay put */
  @media (max-width: 639px) {
    .chart-scroll {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }
    .chart-scroll > svg {
      min-width: 800px;
    }
    .chart-scroll text {
      font-size: 13px;
    }
  }
  .climate {
    position: relative;
    margin: 16px 0 0;
  }
  .climate svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .climate .zero,
  .climate .base {
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .climate .grid-label {
    fill: var(--muted);
    font: 11px var(--sans);
  }

  /* climate: twelve month columns in three panels (temperatures, wet days, daylight), each with its
     own scale; the season from the record shaded behind them */
