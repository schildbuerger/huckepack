---
import { trailTitle } from "../../lib/page-title";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrailMap from "../../components/TrailMap.svelte";
import Icon from "../../components/Icon.astro";
import Explain from "../../components/Explain.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Meter from "../../components/Meter.astro";
import Waymark from "../../components/Waymark.astro";
import TrailAnimals from "../../components/TrailAnimals.astro";
import LeafFall from "../../components/LeafFall.astro";
import SeasonPick from "../../components/SeasonPick.astro";
import TrailSkyline from "../../components/TrailSkyline.astro";
import { SKYLINES } from "../../lib/skylines";
import { SKY_SCRIPT } from "../../lib/sky";
import { inlineScript } from "../../lib/inline-script";
import { ogAlt } from "../../lib/og-image";
import { ogTrail } from "../../lib/og-trail";
import { routePreviewSvg } from "../../lib/route-preview";
import { n1, rectsPath, simplify, stripPaths } from "../../lib/svg";
import { difficulty, levelText, DIFFICULTY_FACTS, DIMENSION_TEXT, EFFORT_NO_STAGES, NO_STAGES_SCALES, LEVELS, SCALES, type Level } from "../../lib/difficulty";
import { monthsText, rateData } from "../../lib/months";
import { existsSync } from "node:fs";
import TrailPhotos, { type Photo } from "../../components/TrailPhotos.astro";
import { linesFor, ownGpx } from "../../lib/gpx";
import {
  countryName,
  monthName,
  perStage,
  perDay,
  noStages,
  trailDays,
  sacGrade,
  mainStages,
  stageEstimates,
  CLIMB_THRESHOLD_M,
  stageTotals,
  trailLength,
  climbFacts,
  providerLength,
  measuredCover,
  SAC_FACTS,
  SAC_SCALE,
  WATER_LEVELS,
  SLEEPING_CATEGORIES,
  SLEEPING_LABELS,
  OSM_SLEEP_MIN,
  STEEP_PERCENT,
  gradients,
  barMetres,
  WILD_CAMPING_LABELS,
  waterLevel,
} from "../../lib/trails";

export async function getStaticPaths() {
  const trails = await getCollection("trails");
  return trails.map((trail) => ({ params: { slug: trail.id }, props: { trail } }));
}

const { trail } = Astro.props as { trail: CollectionEntry<"trails"> };
const t = trail.data;
const derived = (await getEntry("derived", trail.id))?.data;
// our own GPX where the operator offers none (src/lib/gpx.ts)
const own = ownGpx(trail.id, t.officialGpx);
// the trail's photos from Wikimedia Commons (pipeline/photos.py), under the key figures
const photoFiles = import.meta.glob<{ default: { category: string | null; photos: Photo[] } }>("../../../data/photos/*.json", { eager: true });
const photoData = photoFiles[`../../../data/photos/${trail.id}.json`]?.default;
const photos = photoData?.photos ?? [];
// the page's head on a handcrafted skyline in miniature (issue #142), where the trail has one and an
// elevation profile; its sky follows the visitor's clock, set before the first paint (src/lib/sky.ts)
const skyline = Boolean(SKYLINES[trail.id] && derived?.elevation);
const skyScript = inlineScript(Astro, SKY_SCRIPT);
const water = derived?.water;
// sources of water points besides OSM (the record's waterPoints), by their titles' first part
const waterExtra = (water?.extraSources ?? []).map((id) => t.sources.find((x) => x.id === id)?.title.split(":")[0] ?? id);
// travel hubs with their distance to the start (pipeline/access.py), stations first
const hubs = t.access.map((h) => ({ ...h, ...derived?.access?.hubs.find((d) => d.name === h.name) }));
// sleeping: each category with the types this trail's source lists, and how many places OSM maps
// along the route (pipeline/along.py); available when either has it (sleepingCategories())
const bedsByGroup: Partial<Record<string, number>> = derived?.along?.beds.byGroup ?? {};
const sleeping = SLEEPING_CATEGORIES.map((c) => ({
  ...c,
  present: c.types.filter((x) => t.sleeping?.types.includes(x)),
  mapped: bedsByGroup[c.id] ?? 0,
}));
const sources = Object.fromEntries(t.sources.map((s, i) => [s.id, { ...s, n: i + 1 }]));
const totals = stageTotals(t);
// one length (the user's decision, 2026-11-07): ours, measured on the map line where it covers at
// least 95 % of the route, in whole km; else the provider's (stated total, else the stage sum)
const length = trailLength(t, derived);
// the provider's figure, named in the popover as the official one (or as the fallback)
const official = providerLength(t);
const officialHow = official ? (official.how === "stated total" ? "stated length" : official.how) : "";
const officialSrc = official ? sources[official.source].title.split(":")[0] : "";
// how much of the route our map line covers, said where it falls short (measuredCover())
const cover = measuredCover(t, derived);
const osmDate = ((d) => (d ? new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : null))(linesFor(trail.id)?.osmDate);
const sideTrips = (t.stages?.list ?? []).some((s) => s.outAndBack);
const variants = (t.stages?.list ?? []).some((s) => s.kind !== "main" && !s.outAndBack);
// the provider measures differently by more than 10 %: one short row in the popover
const lengthOff = Boolean(length?.measured && official && Math.abs(length.exact - official.value) > 0.1 * official.value);
const days = trailDays(t);
const daily = perStage(t, derived);
// a trail without stages by design (issue #204): no stages section, kilometres instead of stage
// numbers, averages per day from the suggested days (perDay)
const stageless = noStages(t);
const dayAvg = perDay(t, derived);
// a stage that names itself where a stage would be named: none on a trail without stages
const onStage = (n: string | undefined) => (stageless || !n ? "" : `, stage ${n}`);
// a measure's name; Effort on a trail without stages is an average day, not the longest (issue #204)
const scaleLabel = (id: keyof typeof SCALES) => (stageless && NO_STAGES_SCALES[id]?.label) || SCALES[id].label;
const scaleFrom = (id: keyof typeof SCALES) => (stageless && NO_STAGES_SCALES[id]?.from) || SCALES[id].from;
// where places off the trail still count (pipeline/along.py): near each stage's end; on a trail
// without stages its one segment ends at the finish
const stageEnds = stageless ? (t.termini.start.lat === t.termini.end.lat && t.termini.start.lon === t.termini.end.lon ? "the start and finish" : "the finish") : "a stage's end";
const isLoop = t.termini.start.lat === t.termini.end.lat && t.termini.start.lon === t.termini.end.lon;
const sac = sacGrade(t);
// difficulty in three dimensions (src/lib/difficulty.ts); the key figure names the hardest level
const diff = difficulty(t, derived);
const diffTop = Math.max(1, ...diff.dims.map((d) => d.level)) as Level;
const climateDim = diff.dims.find((d) => d.id === "climate");
const dimLevel = (id: string) => diff.dims.find((d) => d.id === id)?.level ?? null;
// each month's climate measures, for months picked in the search (re-rated in the browser): [level,
// text] per measure, in the climate card's order
const climateMonths = climateDim ? diff.months.map((m) => climateDim.measures.map((x) => { const y = m.measures.find((z) => z.id === x.id)!; return [y.level, y.text]; })) : [];
// title and description for tabs, search results and link previews: what and where, then the
// figures a hiker decides on, as the key figures show them
const listed = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}` : xs[0]);
// countries whose English name takes "the" ("in the United Kingdom")
const WITH_THE = new Set(["GB", "US", "NL", "PH", "AE"]);
const countryList = t.countries.map((c) => (WITH_THE.has(c) ? `the ${countryName(c)}` : countryName(c)));
const where = listed(countryList);
const lengthText = length ? `${length.approx ? "about " : ""}${Math.round(length.value).toLocaleString("en")} km` : null;
// the season as one run of months, also across the new year (December to March); none if it has gaps
const months = t.season?.months ?? [];
const runStart = months.filter((m) => !months.includes(m === 1 ? 12 : m - 1));
const seasonRun =
  runStart.length === 1 ? [runStart[0], months.find((m) => !months.includes(m === 12 ? 1 : m + 1))!] : null;
// at most 60 characters, shortened step by step where it's longer (src/lib/page-title.ts, issue #181)
const pageTitle = trailTitle(t.name, length ? Math.round(length.value).toLocaleString("en") : null, Boolean(length?.approx), countryList);
const pageDescription = [
  `${t.name}, ${where}:`,
  [
    lengthText && (t.stages && !stageless ? `${lengthText} in ${mainStages(t).length} stages` : lengthText),
    t.days && `${t.days.min === t.days.max ? t.days.min : `${t.days.min}–${t.days.max}`} days`,
    diff.dims.length > 0 && `rated ${LEVELS[diffTop - 1].toLowerCase()}`,
    seasonRun && `best ${monthName(seasonRun[0])} to ${monthName(seasonRun[1])}`,
  ]
    .filter(Boolean)
    .join(", ") + ".",
  stageless ? "Terrain, climate, water and camps from official and open data." : "Stages, terrain, climate, water and beds from official and open data.",
].join(" ");
// stage heights and times: the published figure, else our estimate (marked ≈ on the page)
const estimates = stageEstimates(t, derived);
const stageView = (t.stages?.list ?? []).map((s) => {
  const est = estimates.get(s.number);
  const ele =
    s.startEleM !== undefined && s.endEleM !== undefined
      ? { from: s.startEleM, to: s.endEleM, est: false }
      : est?.startEleM !== undefined && est.endEleM !== undefined
        ? { from: est.startEleM, to: est.endEleM, est: true }
        : null;
  const time = s.minutes
    ? { min: s.minutes, max: s.maxMinutes, est: false }
    : est?.minutes
      ? { min: est.minutes, max: undefined, est: true }
      : null;
  const climb =
    s.ascentM !== undefined && s.descentM !== undefined
      ? { up: s.ascentM, down: s.descentM, est: false }
      : est?.ascentM !== undefined && est.descentM !== undefined
        ? { up: est.ascentM, down: est.descentM, est: true }
        : // a stated ascent without a descent (the Irish committees' fact files): the ascent alone,
          // never mixed with an estimated descent
          s.ascentM !== undefined
          ? { up: s.ascentM, down: undefined, est: false }
          : null;
  return { ...s, ele, time, climb };
});
// total ascent and descent (the user's decision, 2026-11-07): the terrain model's estimate along our
// map line, summed per main stage (trailClimb(), marked ≈), where the map line covers at least 95 % of
// the route; else the provider's figure (the stated pair, else the stage sums)
const mainView = stageView.filter((s) => s.kind === "main");
// the popover's facts (climbFacts()): the provider's figure named as the official one (or as the
// fallback), whether ours and theirs lie more than 10 % apart, and the map line's coverage where short
const { climb, official: officialClimb, short: climbShort, apart: climbOff } = climbFacts(t, derived);
const climbTotal = climb ? { up: climb.up, down: climb.down, est: climb.estimate } : null;
const officialClimbSrc = officialClimb ? sources[officialClimb.source].title.split(":")[0] : "";
const officialClimbHow = officialClimb?.how ?? "";
// a long trail sampled every 500 m (pipeline/elevation.py): its estimate misses more short climbs
const climbCoarse = (derived?.elevation?.spacingM ?? 100) > 100;
const estClimb = stageView.some((s) => s.climb?.est);
// trails with many stages (issue #25): from MANY_STAGES main stages the charts' stage axes label only
// every k-th stage over alternating stage bands; with more than STAGES_SHOWN, the stage table shows
// the first STAGES_SHOWN rows and folds the rest behind "Show all"
const MANY_STAGES = 12;
const STAGES_SHOWN = 10;
const foldStages = mainView.length > STAGES_SHOWN;
const maxStageKm = Math.max(...mainView.map((s) => s.km), 1);
const maxStageUp = Math.max(...mainView.map((s) => s.climb?.up ?? 0), 1);
// stage columns: only those some stage has a figure for; a stage without one keeps an empty cell,
// so the columns stay under their header
const stageEle = stageView.some((s) => s.ele);
const stageTime = stageView.some((s) => s.time);
const estEle = stageView.some((s) => s.ele?.est);
const estTime = stageView.some((s) => s.time?.est);
const fmt = (n: number) => n.toLocaleString("en");
// a source by the first part of its title ("Tourismusverband Sächsische Schweiz"), for inline mentions
const sourceShort = (id: string) => t.sources.find((s) => s.id === id)?.title.split(":")[0] ?? id;
// "National Trails'", "Tirol Werbung's"
const possessive = (name: string) => (name.endsWith("s") ? `${name}'` : `${name}'s`);
const hours = (min: number) => `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, "0")}`;
// a walking time, or a range of whole hours as "4–5 h"
const timeText = (min: number, max?: number) =>
  max === undefined ? hours(min) : min % 60 === 0 && max % 60 === 0 ? `${min / 60}–${max / 60} h` : `${hours(min)}–${hours(max)}`;
const TRAIL_TYPES = { "point-to-point": "Point to point", loop: "Loop", network: "Network" };
const range = (min: number, max: number) => (min === max ? `${min}` : `${min}–${max}`);
// the map line, built by pipeline/routes.py; without it the map shows only the termini
const routeFile = `routes/${trail.id}.geojson`;
const routeUrl = t.route && existsSync(`public/${routeFile}`) ? `/${routeFile}` : null;
// attribution names the route's source: its title up to the first colon
const routeAttribution = routeUrl && t.route ? sources[t.route.source].title.split(":")[0] : null;
// closed stages (a bridge lost) and the operator's recommended way on: a sentence under the stage
// table, and the detour's legs on the map in their own styles
const closedStages = t.stages?.list.filter((s) => s.closed) ?? [];
const detourModes = [...new Set(closedStages.flatMap((s) => s.closed!.detour.map((leg) => leg.by)))];
const LEG_TEXT = {
  foot: (to: string, km?: number) => `walking to ${to}${km ? ` (${km} km)` : ""}`,
  train: (to: string) => `the train to ${to}`,
  bus: (to: string) => `the bus to ${to}`,
};
const closedText = (s: (typeof closedStages)[number]) => {
  const c = s.closed!;
  const legs = c.detour.map((leg) => LEG_TEXT[leg.by](leg.to.name, leg.km));
  return (
    ` Stage ${s.number} can be walked only to ${c.at.name} since ${c.since}: ${c.reason}.` +
    (legs.length ? ` ${sourceShort(c.source)} recommends ${legs.join(", then ")}${routeUrl ? "; the map shows the detour" : ""}.` : "")
  );
};

// permits and fees (issue #104): the record keeps whether a permit is needed and how to get it, and
// the trail's or park's own fees (no hut or campsite prices) with currency and year; the page says
// only whether a permit is needed and whether a fee is charged, one row in Location (approach A2 of
// the preview, 2026-11-02)
const permit = t.permit;
const fees = t.fees;
const hasPermitInfo = Boolean(permit || fees.length);

// the Location facts in order of priority (issue #145, approach A of three previews, 2026-11-02):
// where it is, the route and what it takes, getting there, then the background. Two columns; a fact
// alone before a wide one (travel hubs, protected areas, a long managing body) is widened too, so
// no cell stays empty beside it
const LOC_FACTS = [
  { key: "country", show: true, wide: false },
  { key: "regions", show: t.regions.length > 0, wide: false },
  { key: "start", show: true, wide: false },
  { key: "finish", show: true, wide: false },
  { key: "route", show: true, wide: false },
  { key: "permit", show: hasPermitInfo, wide: false },
  { key: "hubs", show: hubs.length > 0, wide: true },
  { key: "protected", show: t.protectedAreas.length > 0, wide: true },
  { key: "managed", show: true, wide: t.managedBy.map((m) => m.name).join(", ").length > 40 },
  { key: "waymark", show: Boolean(t.waymarking), wide: false },
  // the GPX track, last (2026-11-05): the operator's page that offers it, else our own tracing
  { key: "gpx", show: Boolean((t.officialGpx && "url" in t.officialGpx) || own), wide: false },
].filter((f) => f.show);
let locCol = 0;
LOC_FACTS.forEach((f, i) => {
  if (f.wide) {
    if (locCol === 1) LOC_FACTS[i - 1].wide = true;
    locCol = 0;
  } else locCol = 1 - locCol;
});

// legs that aren't walked (stages.transfers: the W Trek's catamaran, the Adlerweg's cable cars inside
// stages): like a closed stage's detour by train, on the map in their own style and named in the note
// under the stages table, in no figure
const transfers = t.stages?.transfers ?? [];
const transferModes = [...new Set(transfers.map((leg) => leg.by))];
const transferText = (leg: (typeof transfers)[number]) =>
  ` ${leg.stage ? `On stage ${leg.stage}, from` : "From"} ${leg.start.name}, the way on is by ${leg.by} to ${leg.end.name}${leg.minutes ? ` (about ${leg.minutes < 60 ? `${leg.minutes} min` : hours(leg.minutes)})` : ""}, not walked and in no figure (${sourceShort(leg.source)})${routeUrl ? "; the map shows it" : ""}.`;

// water in tiers (issue #119, pipeline/along.py water_tiers()): drinking water rates; springs give
// a second rating "with treatment"; places to sleep within the water reach show as refills, unrated
const tiers = derived?.along?.water;
// the trail is rated by clean water: drinking water or a refill at a place to sleep (decided
// 2026-11-01); without tiers (no places to sleep found), by drinking water
const drinkGap = tiers?.longestGapKm.clean ?? water?.longestGapKm.drinking;
const level = drinkGap && waterLevel(drinkGap.km);
// any water (springs too) rated the same way (frequent, regular, scarce)
const anyLevel = tiers && waterLevel(tiers.longestGapKm.refill.km);
// status as a shape plus a word; colour (--good/--fair/--poor) only fills the shape
type Status = { shape: "full" | "half" | "blocked" | "empty"; tone: string; word: string };
const STATUS: Record<string, Status> = {
  available: { shape: "full", tone: "good", word: "Available" },
  allowed: { shape: "full", tone: "good", word: "Allowed" },
  restricted: { shape: "half", tone: "fair", word: "Restricted" },
  prohibited: { shape: "blocked", tone: "poor", word: "Prohibited" },
  none: { shape: "empty", tone: "none", word: "None listed" },
  unknown: { shape: "empty", tone: "none", word: "Not known" },
};
const sleepingRows = sleeping.map((c) =>
  c.id === "wild-camping"
    ? { ...c, status: STATUS[t.wildCamping?.status ?? "unknown"], detail: "" }
    : {
        ...c,
        status: STATUS[c.present.length > 0 || c.mapped >= OSM_SLEEP_MIN ? "available" : "none"],
        detail: [
          c.present.map((x) => SLEEPING_LABELS[x]).join(", "),
          (c.present.length > 0 || c.mapped >= OSM_SLEEP_MIN) && c.mapped > 0 ? `${c.mapped} in OpenStreetMap` : "",
        ]
          .filter(Boolean)
          .join(" · "),
      },
);
const WATER_STATUS = { frequent: "available", regular: "restricted", scarce: "prohibited" } as const;
const waterStatus = level && { ...STATUS[WATER_STATUS[level.id]], word: level.label };
const anyStatus = anyLevel && { ...STATUS[WATER_STATUS[anyLevel.id]], word: anyLevel.label };

// strip charts (water, surfaces, elevation) share one geometry: a 1000-unit wide viewBox, km across
const CHART = { width: 1000, x0: 8, x1: 992 };
// landscape lanes: labels on the left, the route's km across the rest
const LANE_X0 = 220;
const LANE_X1 = 940;
// (positions rounded to a tenth of a unit, finer than a pixel: keeps the long routes' charts small)
const laneX = (km: number) => n1(LANE_X0 + (km / (derived?.landcover?.routeKm || 1)) * (LANE_X1 - LANE_X0));
const xAt = (km: number, total = water?.routeKm || 1) => n1(CHART.x0 + (km / total) * (CHART.x1 - CHART.x0));

// surfaces along the main route (pipeline/surface.py), in a fixed order, soft to hard
const surface = derived?.surface;
const SURFACES = [
  {
    id: "natural",
    label: "Natural ground",
    hint: "Earth, grass, rock and roots: footpaths and forest trails. Can be muddy after rain.",
  },
  { id: "gravel", label: "Gravel", hint: "Gravel, compacted and stony surfaces: mostly forest roads and farm tracks." },
  { id: "paved", label: "Paved", hint: "Asphalt, concrete and cobbles: roads and village streets." },
  { id: "unknown", label: "Unknown", hint: "Stretches whose surface OpenStreetMap doesn't record." },
] as const;
const surfaceRows = surface ? SURFACES.filter((c) => surface.totals[c.id]?.km > 0) : [];
const pct = (share: number) => `${Math.round(share * 100)}%`;

// landscape (pipeline/landcover.py): ESA WorldCover groups along the main route, on the elevation
// profile's kilometres; colours --land-* in this fixed order
const landcover = derived?.landcover;
const LAND = [
  { id: "forest", label: "Forest", short: "Forest" },
  { id: "open", label: "Grassland and shrubs", short: "Grassland" },
  { id: "moss", label: "Moss and lichen", short: "Moss" },
  { id: "bare", label: "Bare rock and sand", short: "Rock" },
  { id: "water", label: "Water, snow and ice", short: "Water" },
  { id: "farm", label: "Farmland and villages", short: "Farmland" },
];
const landRows = landcover ? LAND.filter((g) => (landcover.shares[g.id] ?? 0) > 0) : [];
// the key figure: the main landscape by its short name, and every group's share as a bar
const landMain = landcover ? [...landRows].sort((a, b) => landcover.shares[b.id] - landcover.shares[a.id])[0] : undefined;
// the chart's accessible name in one sentence: the main landscape, then the rest from 2 % up,
// smaller ones as "patches of"
const landSummary = (() => {
  if (!landcover) return "";
  const rows = [...landRows].sort((a, b) => landcover.shares[b.id] - landcover.shares[a.id]);
  const say = (g: (typeof LAND)[number]) => `${g.label.toLowerCase()} (${pct(landcover.shares[g.id])})`;
  const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);
  const [first, ...rest] = rows;
  const more = rest.filter((g) => landcover.shares[g.id] >= 0.02);
  const bits = rest.filter((g) => landcover.shares[g.id] < 0.02).map((g) => g.label.toLowerCase());
  const head = landcover.shares[first.id] >= 0.5 ? `Mostly ${say(first)}` : `A mix of ${say(first)}`;
  return `${head}${more.length ? `, with ${list(more.map(say))}` : ""}${bits.length ? `${more.length ? "; " : ", "}patches of ${list(bits)}` : ""}.`;
})();

// terrain (issues #15, #28): one elevation profile (pipeline/elevation.py) on the same kilometres as
// the other charts, coloured by its gradient (gradients() in src/lib/trails.ts), over a strip of the
// ground under it (pipeline/surface.py)
const elevation = derived?.elevation;
const grad = elevation && gradients(elevation.points, elevation.stageStarts, elevation.spacingM);
// the profile's sampling (100 m; 500 m on trails over 1,000 km) and the gradient bars' length, for the texts
const sampleM = elevation?.spacingM ?? 100;
const barM = barMetres(sampleM);
const TERRAIN = { top: 26, bottom: 170 };
// the ground strip under the baseline: its height, and how far it pushes the stage ticks down
const GROUND_H = 10;
const groundOff = surface ? GROUND_H + 4 : 0;
const eleRange = elevation && {
  min: Math.floor((elevation.lowest.m - 50) / 200) * 200,
  max: Math.ceil((elevation.highest.m + 50) / 200) * 200,
};
const yAt = (m: number) =>
  eleRange ? n1(TERRAIN.bottom - ((m - eleRange.min) / (eleRange.max - eleRange.min)) * (TERRAIN.bottom - TERRAIN.top)) : 0;
const eleGrid = eleRange
  ? Array.from({ length: 10 }, (_, i) => eleRange.min + i * (eleRange.max - eleRange.min > 1000 ? 400 : 200)).filter(
      (m) => m > eleRange.min && m < eleRange.max,
    )
  : [];
// the height where trees stop growing in the trail's region (the record's treeLine), drawn across
// the profile only where the route climbs above it (issue #20)
const treeLine = t.treeLine && elevation && elevation.highest.m > t.treeLine.m ? t.treeLine : null;
const treeLineText = treeLine && (treeLine.fromM ? `${fmt(treeLine.fromM)}–${fmt(treeLine.m)} m` : `≈ ${fmt(treeLine.m)} m`);
// the peak label: centred over the peak, or starting at it near the chart's left edge (where it
// would hide the height labels, which then give way) and ending at it near the right edge
const peak = (() => {
  const x = elevation ? xAt(elevation.highest.km, elevation.routeKm) : 0;
  const left = x < CHART.x0 + 60;
  return { x, left, anchor: left ? "start" : x > CHART.x1 - 40 ? "end" : "middle" };
})();
// the profile thinned to what shows at the chart's scale (a long trail has thousands of samples on
// about 1000 units): the line, and the same outline closed along the baseline, which clips the slices
const profilePts = elevation ? simplify(elevation.points.map(([km, m]) => [xAt(km, elevation.routeKm), yAt(m)] as [number, number])) : [];
const profileLine = profilePts.length ? `M${profilePts.map(([x, y]) => `${n1(x)},${n1(y)}`).join(" ").replace(" ", "L")}` : "";
// the outline is drawn once: closed well below the baseline and outward, it clips the slices, and the
// line is the same outline clipped to the profile's own width and height, where only its top shows
const profileArea = profilePts.length
  ? `M${n1(profilePts[0][0] - 30)},${TERRAIN.bottom + 60}L${profileLine.slice(1)}L${n1(profilePts.at(-1)![0] + 30)},${TERRAIN.bottom + 60}z`
  : "";
const profileBox = profilePts.length ? { x: profilePts[0][0], width: n1(profilePts.at(-1)![0] - profilePts[0][0]) } : null;
// the area under the profile in the gradient bars' slices, filled by gradient on a smooth diverging
// ramp (the profile's tint at 0 %, the steep colour at ±RAMP_MAX %; climbs warm, descents violet)
const RAMP_MAX = 30;
// a slice's colour: up or down (the class) and how far along the ramp (`--p`, in steps of RAMP_STEP
// %, so neighbours of one colour join); the colour mix itself is in the CSS (.slice)
const RAMP_STEP = 10;
// bars narrower than half a unit (long trails: 3,000 bars on 1000 units) are drawn per half-unit
// column: up or down by the column's balance, as steep as its bars on average
const COL = 0.5;
const sliceRuns: { x0: number; x1: number; dir: string; p: number }[] = [];
if (elevation && grad) {
  const total = elevation.routeKm;
  const xs = (km: number) => xAt(km, total);
  const add = (x0: number, x1: number, signed: number, steep: number) => {
    const dir = signed >= 0 ? "up" : "down";
    const p = Math.round((Math.min(steep, RAMP_MAX) / RAMP_MAX) * (100 / RAMP_STEP)) * RAMP_STEP;
    const last = sliceRuns.at(-1);
    if (last && last.dir === dir && last.p === p && x0 - last.x1 < 0.05) last.x1 = x1;
    else sliceRuns.push({ x0, x1, dir, p });
  };
  let col: { i: number; x0: number; x1: number; signed: number; steep: number; w: number } | null = null;
  const flush = () => col && add(col.x0, col.x1, col.signed, col.steep / col.w);
  for (const b of grad.bars) {
    const x0 = xs(b.fromKm);
    const x1 = xs(b.toKm);
    const w = Math.max(x1 - x0, 1e-6);
    if (w >= COL) {
      flush();
      col = null;
      add(x0, x1, b.grade, Math.abs(b.grade));
      continue;
    }
    const i = Math.floor((x0 + x1) / 2 / COL);
    if (!col || col.i !== i || x0 - col.x1 > 0.05) {
      flush();
      col = { i, x0, x1, signed: 0, steep: 0, w: 0 };
    }
    col.x1 = x1;
    col.signed += b.grade * w;
    col.steep += Math.abs(b.grade) * w;
    col.w += w;
  }
  flush();
}
// the slices of one colour as one path of rectangles, clipped to the area under the profile
const slicePaths = [
  ...sliceRuns
    .reduce((m, r) => {
      const key = `${r.dir} ${r.p}`;
      m.set(key, [...(m.get(key) ?? []), [r.x0, Math.max(r.x1 - r.x0, 0.1)]]);
      return m;
    }, new Map<string, [number, number][]>())
    .entries(),
].map(([key, rects]) => {
  const [dir, p] = key.split(" ");
  return { dir, style: `--p: ${p}%`, d: rectsPath(rects, TERRAIN.top - 8, TERRAIN.bottom - TERRAIN.top + 8) };
});
const degrees = (g: number) => Math.round((Math.atan(Math.abs(g) / 100) * 180) / Math.PI);

// climate (pipeline/climate.py): twelve month columns; the season from the record is shaded
const climate = derived?.climate;
// chart data for the hover scripts: one JSON block per chart (issue #12 of the 2026-10-30 review),
// compact tuples instead of HTML-escaped attributes; "<" escaped so the data can't close the script
const jsonBlock = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");
// the profile's samples, bars and runs are large on long trails: they go in a "chart-heavy" block,
// which the build moves into the trail's charts.json (src/integrations/chart-files.mjs)
const terrainMeta =
  elevation && grad && eleRange
    ? jsonBlock({ total: elevation.routeKm, ey: [eleRange.min, eleRange.max, TERRAIN.top, TERRAIN.bottom] })
    : null;
const terrainData =
  elevation && grad
    ? jsonBlock({
        points: elevation.points,
        bars: grad.bars.map((b) => [b.fromKm, b.toKm, b.grade, stageless ? "" : b.stage]),
        runs: (surface?.runs ?? []).map((r) => [r.fromKm, r.toKm, r.category]),
      })
    : null;
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
// a climate panel's label sits on a chip of the page's background, so it reads over the season's
// shading (the label rows lie inside the band when the season starts early in the year)
const chipW = (text: string) => text.length * 6.3 + 12;
const CLIM = { x0: 52, x1: 992, tTop: 30, tBottom: 210, wTop: 252, wBottom: 312, dTop: 348, months: 398, height: 406 };
const colW = (CLIM.x1 - CLIM.x0) / 12;
const colX = (m: number) => CLIM.x0 + (m - 1) * colW;
const tRange = climate && {
  min: Math.floor((Math.min(...climate.months.map((m) => m.high.tmin)) - 2) / 10) * 10,
  max: Math.ceil((Math.max(...climate.months.map((m) => m.low.tmax)) + 2) / 10) * 10,
};
const yTemp = (c: number) =>
  tRange ? CLIM.tBottom - ((c - tRange.min) / (tRange.max - tRange.min)) * (CLIM.tBottom - CLIM.tTop) : 0;
const tempGrid = tRange ? Array.from({ length: (tRange.max - tRange.min) / 10 + 1 }, (_, i) => tRange.min + i * 10) : [];
const wetMax = climate ? Math.ceil(Math.max(...climate.months.map((m) => m.high.wetDays)) / 5) * 5 : 15;
const yWet = (d: number) => CLIM.wBottom - (d / wetMax) * (CLIM.wBottom - CLIM.wTop);
const seasonMonths = t.season?.months ?? [];
// contiguous runs of season months, each shaded as one band
const seasonRuns = seasonMonths
  .slice()
  .sort((a, b) => a - b)
  .reduce<number[][]>((runs, m) => {
    const last = runs.at(-1);
    if (last && m === last.at(-1)! + 1) last.push(m);
    else runs.push([m]);
    return runs;
  }, []);
const signed = (c: number) => `${c < 0 ? "−" : ""}${Math.abs(Math.round(c))}`;
const between = (values: number[], unit: string, digits = 0) => {
  const [lo, hi] = [Math.min(...values), Math.max(...values)];
  const f = (v: number) => (digits ? v.toFixed(digits) : signed(v));
  return `${f(lo)}${lo < 0 ? " to " : "–"}${f(hi)}${unit ? ` ${unit}` : ""}`;
};
const inSeason = climate ? climate.months.filter((m) => seasonMonths.length === 0 || seasonMonths.includes(m.month)) : [];

// stage ticks for the strip charts: a tick at each stage start, the label centred on its stretch.
// With many stages (issue #25) every other stage gets a shaded band, and only every k-th stage a
// label (k = 1, 2, 5 or 10, the smallest that keeps labels 34 units apart; first and last always)
const stageTicks = (starts: { number: string; km: number }[], total: number, at = (km: number) => xAt(km, total)) => {
  if (stageless) return kmTicks(total, at);
  const many = starts.length >= MANY_STAGES;
  const span = at(total) - at(0);
  const k = many ? ([1, 2, 5, 10].find((n) => (span / starts.length) * n >= 34) ?? 10) : 1;
  return starts.map((st, i) => {
    const x = at(st.km);
    const end = at(starts[i + 1]?.km ?? total);
    const labelled = !many || i === 0 || i === starts.length - 1 || (i + 1) % k === 0;
    return {
      x,
      end,
      mid: n1((x + end) / 2),
      band: many && i % 2 === 1,
      label: labelled ? (end - x > 70 ? `Stage ${st.number}` : st.number) : null,
    };
  });
};

// a trail without stages (issue #204): kilometre marks instead of stage ticks, at a round step that
// gives at most 8 marks, none crowding the end's own label
function kmTicks(total: number, at: (km: number) => number) {
  const step = [5, 10, 20, 25, 50, 100, 200].find((k) => total / k <= 8) ?? 500;
  const out = [];
  for (let k = step; k <= total - step * 0.4; k += step) {
    const x = at(k);
    out.push({ x, end: x, mid: n1(x), band: false, label: `${k}` as string | null });
  }
  return out;
}

// water strip chart: the main route on the map line's kilometres
const onRoute = water?.points.filter((p) => p.km !== null) ?? [];
const chartSummary =
  water &&
  `Water along the main route, ${water.routeKm} km: ${onRoute.filter((p) => p.kind === "drinking").length} drinking water points and ${onRoute.filter((p) => p.kind === "spring").length} springs. The longest stretch without drinking water is ${water.longestGapKm.drinking.km} km, from km ${water.longestGapKm.drinking.fromKm} to ${water.longestGapKm.drinking.toKm}.`;
const waterTotals = water && {
  drinking: water.points.filter((p) => p.kind === "drinking").length,
  springs: water.points.filter((p) => p.kind === "spring").length,
};
// the stage(s) of the longest dry stretch, from the water points at either end of it
const gapStages = (() => {
  if (!water || stageless) return "";
  const g = drinkGap!;
  const at = (km: number) => [...water.stageStarts].reverse().find((st) => st.km <= km + 0.05)?.number;
  const [a, b] = [at(g.fromKm), at(Math.max(g.fromKm, g.toKm - 0.1))];
  return a && b ? (a === b ? `, stage ${a}` : `, stages ${a}–${b}`) : "";
})();

// water and shops along the main route (issues #96 and #97; of three previews, approach B): one
// chart, a lane each on the same kilometres, so the stretches where both thin out line up. Beds
// have their own lanes in Sleeping (issue #113)
const along = derived?.along;
const SHOP_LABEL: Record<string, string> = { supermarket: "Supermarket", convenience: "Convenience store", general: "General store", fuel: "Petrol station shop" };
const BED_LABEL: Record<string, string> = { hut: "Hut", campsite: "Campsite", hostel: "Hostel", guesthouse: "Guest house" };
// a tick: full height (drinking water, shops), short (springs) or dashed (refills at places to sleep);
// `link` where it points (issue #118): its OSM object, short ("n123" a node, "w456" a way), or the page
// of the record's own source for the record's water points
type LanePoint = { km: number; what: string; name: string | null; stage: string; minor: boolean; dashed?: boolean; link?: string };
const osmLink = (ref?: string) => (ref ? `${ref[0]}${ref.split("/")[1]}` : undefined);
const onMain = <P extends { km: number | null }>(ps: P[]) => ps.filter((p): p is P & { km: number } => p.km !== null);
const waterTicks = onRoute.map((p): LanePoint => ({
  km: p.km!,
  what: p.kind === "drinking" ? "Drinking water" : "Spring (treat it)",
  name: p.name,
  stage: p.stage,
  minor: p.kind === "spring",
  link: osmLink(p.osm) ?? (p.source !== "osm" ? sources[p.source]?.url : undefined),
}));
const promotedTicks = (tiers?.promoted ?? []).map((p): LanePoint => ({ km: p.km, what: `${BED_LABEL[p.kind] ?? "Place to sleep"}, drinking water`, name: p.name, stage: p.stage, minor: false, link: osmLink(p.osm) }));
const refillTicks = (tiers?.refills ?? []).map((p): LanePoint => ({ km: p.km, what: `${BED_LABEL[p.kind] ?? "Place to sleep"}, refill`, name: p.name, stage: p.stage, minor: false, dashed: true, link: osmLink(p.osm) }));
// the chart's rows (issue #119; of three previews, approach B, collapsible): with tiers, "Water and
// refills" (every kind, its gap the stretch without any) opens into public drinking water, springs
// and refills, each shaded with its own longest stretch without that kind; then shops. `sub` rows
// fold away (a script; without it every row shows). Every water tick looks the same: the lanes and
// the tooltip say which kind it is
const ownGap = (pts: LanePoint[]) => {
  const total = water?.routeKm ?? 0;
  const stops = [0, ...pts.map((p) => p.km).sort((a, b) => a - b), total];
  let g = { km: 0, fromKm: 0, toKm: 0 };
  for (let i = 1; i < stops.length; i++) if (stops[i] - stops[i - 1] > g.km) g = { km: stops[i] - stops[i - 1], fromKm: stops[i - 1], toKm: stops[i] };
  return { km: Math.round(g.km * 10) / 10, fromKm: g.fromKm, toKm: g.toKm };
};
type Row = { id: string; label: string; gap: { km: number; fromKm: number; toKm: number }; gapText?: string; points: LanePoint[]; sub?: boolean; group?: boolean; parent?: number };
// shops by kind, under "Shops" the same way (each with its own longest stretch without)
const shopTicks = along ? onMain(along.resupply.points).map((p): LanePoint & { kind: string } => ({ km: p.km, what: SHOP_LABEL[p.kind], name: p.name, stage: p.stage, minor: false, kind: p.kind, link: osmLink(p.osm) })) : [];
const SHOP_KINDS = [
  { label: "Supermarkets", kinds: ["supermarket"] },
  { label: "Convenience and general stores", kinds: ["convenience", "general"] },
  { label: "Petrol station shops", kinds: ["fuel"] },
].filter((k) => shopTicks.some((p) => k.kinds.includes(p.kind)));
const supplyLanes: Row[] = water
  ? [
      ...(tiers
        ? [
            { id: "water", label: "Water", gap: tiers.longestGapKm.refill, points: [...waterTicks, ...promotedTicks, ...refillTicks], group: true },
            { id: "water", label: "Public drinking water", gap: tiers.longestGapKm.drinking, points: [...waterTicks.filter((p) => !p.minor), ...promotedTicks], sub: true, parent: 0 },
            { id: "water", label: "Springs (treat before drinking)", gap: ownGap(waterTicks.filter((p) => p.minor)), points: waterTicks.filter((p) => p.minor), sub: true, parent: 0 },
            { id: "water", label: t.refillsUntreated ? "Refills at places to sleep (treat before drinking)" : "Refills at places to sleep", gap: ownGap(refillTicks), points: refillTicks, sub: true, parent: 0 },
          ]
        : [{ id: "water", label: "Drinking water", gap: water.longestGapKm.drinking, points: waterTicks }]),
      ...(along
        ? [
            { id: "shops", label: "Shops", gap: along.resupply.longestGapKm, points: shopTicks, group: SHOP_KINDS.length > 1 },
            ...(SHOP_KINDS.length > 1
              ? SHOP_KINDS.map((k) => {
                  const pts = shopTicks.filter((p) => k.kinds.includes(p.kind));
                  return { id: "shops", label: k.label, gap: ownGap(pts), points: pts, sub: true, parent: tiers ? 4 : 1 };
                })
              : []),
          ]
        : []),
    ]
  : [];
// lane geometry in the 1000-unit strip: a label row and a 26-unit band per lane, then the axis
// (issue #119: room above the first row for the groups' buttons, and GROUP_GAP more before each
// top-level row, so a group and its kinds read as a block apart from the next)
const LANE = { top: 42, step: 46, band: 26 };
const GROUP_GAP = 20;
const laneY = (i: number) => LANE.top + i * LANE.step + GROUP_GAP * supplyLanes.slice(1, i + 1).filter((r) => r.parent === undefined).length;
const supplyAxis = laneY(supplyLanes.length - 1) + LANE.step - 8;
// one kind of tick for every place: a lane's sub rows are slimmer (from `top` to `bottom` in its band)
const subRows = supplyLanes.filter((r) => r.sub).length;
// group rows that open into their kinds (Water, Shops), and how many rows each holds
const groupRows = supplyLanes.flatMap((r, i) => (r.group && supplyLanes.some((x) => x.parent === i) ? [i] : []));
const subsOf = (g: number) => supplyLanes.filter((r) => r.parent === g).length;
// the water chart's kilometres start right of the tree line its sub rows hang from (issue #119)
const WX0 = subRows > 0 ? CHART.x0 + 26 : CHART.x0;
// a lane's track reaches a little past both ends of the axis, so a tick at 0 km or at the end sits inside it
const TRACK_PAD = 6;
const wx = (km: number) => n1(WX0 + (Math.min(km, water?.routeKm ?? km) / (water?.routeKm || 1)) * (CHART.x1 - WX0));
// with many stages, every other stage is shaded inside each lane's track only (not across the chart)
const waterTicksAxis = water ? stageTicks(water.stageStarts, water.routeKm, wx) : [];
const tickPath = (pts: LanePoint[], y: number, top = 4, bottom = 22) => pts.map((p) => `M${wx(p.km)} ${y + top}V${y + bottom}`).join("");
const supplySummary =
  water &&
  (along
    ? `Water and shops along the main route, ${water.routeKm} km. Longest without ${tiers ? "clean water (drinking water or a refill at a place to sleep)" : "drinking water"} ${drinkGap!.km} km${tiers ? `, without any water ${tiers.longestGapKm.refill.km} km` : ""}, without a shop ${along.resupply.longestGapKm.km} km.`
    : chartSummary);
// beds along the main route (issue #113; of three previews, approach B): one slim lane per sleeping
// category under the Sleeping strip, labels and counts on the left like the Landscape lanes, the
// longest stretch without any bed one shaded column
const BED_GROUP: Record<string, string> = { hut: "huts", campsite: "camping", hostel: "hostels", guesthouse: "rooms" };
const BED_WORDS: Record<string, string> = { camping: "campsites", huts: "huts", hostels: "hostels", rooms: "guest houses" };
const bedRows = along
  ? SLEEPING_CATEGORIES.filter((c) => c.id !== "wild-camping").map((c) => ({
      id: c.id,
      label: c.label,
      count: along.beds.byGroup[c.id as keyof typeof along.beds.byGroup] ?? 0,
      points: onMain(along.beds.points)
        .filter((p) => BED_GROUP[p.kind] === c.id)
        .map((p): LanePoint => ({ km: p.km, what: BED_LABEL[p.kind], name: p.name, stage: p.stage, minor: false, link: osmLink(p.osm) })),
    }))
  : [];
const BEDS = { top: 28, step: 24 };
const bedsAxis = BEDS.top + bedRows.length * BEDS.step;
const bedX = (km: number) => n1(LANE_X0 + (Math.min(km, along?.routeKm ?? km) / (along?.routeKm || 1)) * (LANE_X1 - LANE_X0));
const bedGap = along?.beds.longestGapKm;
const bedSummary =
  along &&
  bedGap &&
  `Places to sleep along the main route, ${along.routeKm} km: ${bedRows.map((r) => `${r.count} ${BED_WORDS[r.id]}`).join(", ")}. The longest stretch without any is ${bedGap.km} km, from km ${bedGap.fromKm} to ${bedGap.toKm}.`;

// on-page navigation: only sections this trail has
const nav = [
  { id: "location", label: "Location", show: true },
  { id: "difficulty", label: "Difficulty", show: diff.dims.length > 0 },
  { id: "climate", label: "Climate", show: Boolean(climate) },
  { id: "stages", label: "Stages", show: Boolean(t.stages) && !stageless },
  { id: "terrain", label: "Terrain", show: Boolean(elevation && grad) },
  { id: "landscape", label: "Landscape", show: Boolean(landcover) },
  { id: "sleeping", label: "Sleeping", show: Boolean(t.sleeping || t.wildCamping) },
  { id: "water", label: along ? "Water & Supply" : "Water", show: Boolean(water) },
  // every trail (issue #206): a tumbleweed where nothing is listed
  { id: "animals", label: "Wildlife", show: true },
].filter((n) => n.show);

// structured data (review #17, the light option): the page is about the trail as a place, with its
// start, its countries and links to the official website and Wikidata; nothing that claims a rich
// result. Every value is on the page or in the record; "<" escaped so no name can close the script
const trailLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: new URL(`/trails/${trail.id}/`, Astro.site).href,
  name: pageTitle,
  about: {
    "@type": "TouristAttraction",
    name: t.name,
    ...(t.localName ? { alternateName: t.localName } : {}),
    description: pageDescription,
    geo: { "@type": "GeoCoordinates", latitude: t.termini.start.lat, longitude: t.termini.start.lon },
    containedInPlace: t.countries.map((c) => ({ "@type": "Country", name: countryName(c) })),
    sameAs: [t.website, ...(t.wikidata ? [`https://www.wikidata.org/wiki/${t.wikidata}`] : [])],
  },
}).replace(/</g, "\\u003c");
---

<Base
  title={pageTitle}
  description={pageDescription}
  image={{ path: `/og/${trail.id}.png`, alt: ogAlt(ogTrail(trail.id, t, derived)) }}
>
  <script type="application/ld+json" set:html={trailLd} />
  {
    skyline ? (
      <>
        <script is:inline set:html={skyScript} />
        <TrailSkyline slug={trail.id} name={t.name} localName={t.localName} points={derived!.elevation!.points} routeKm={derived!.elevation!.routeKm}>
          <Breadcrumbs slot="crumbs" trail={[{ label: "Trails", href: "/trails/" }]} current={t.name} />
        </TrailSkyline>
      </>
    ) : (
      <>
        <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current={t.name} />
        <h1>{t.name}</h1>
        {t.localName && <p class="subtitle muted">{t.localName}</p>}
      </>
    )
  }

  <nav class="onpage" aria-label="On this page">
    <ul>
      {nav.map((n) => (
        <li>
          <a href={`#${n.id}`}>{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <section id="figures" class="key">
    <h2 class="visually-hidden">Key figures</h2>
    <dl class="strip spec key-figs">
      {length && (
        <div>
          <dt>
            <Explain id="length-info" term="Length">
              <dl class="pop-facts">
                {length.measured ? (
                  <>
                    <dt>This trail</dt><dd>{length.exact.toLocaleString("en", { minimumFractionDigits: 1, maximumFractionDigits: 1 })} km</dd>
                    <dt>How</dt><dd>Measured on our OpenStreetMap map line{osmDate ? ` (data of ${osmDate})` : ""}: the main route{variants ? ", variants left out" : ""}{sideTrips ? ", side trips walked there and back counted twice" : ""}</dd>
                    {official && <><dt>Official</dt><dd>{official.approx ? "About " : ""}{fmt(official.value)} km, {officialHow} ({officialSrc})</dd></>}
                    {lengthOff && <><dt>Keep in mind</dt><dd>{officialSrc} measures the route differently</dd></>}
                  </>
                ) : (
                  <>
                    <dt>This trail</dt><dd>{length.approx ? "About " : ""}{fmt(length.value)} km</dd>
                    <dt>Source</dt><dd>{officialSrc}, {officialHow}</dd>
                    {cover !== null && <><dt>Why</dt><dd>Our map line covers only {Math.floor(cover * 100)} % of the route, so this is {officialSrc}'s figure</dd></>}
                  </>
                )}
              </dl>
            </Explain>
          </dt>
          <dd>
            {length.approx && <span class="unit before">about</span>}
            <span class="big">{fmt(length.value)}</span><span class="unit">km</span>
          </dd>
        </div>
      )}
      {climbTotal && (
        <div>
          <dt>
            <Explain id="climb-info" term="Ascent · descent">
              <dl class="pop-facts">
                {climb?.estimate ? (
                  <>
                    <dt>This trail</dt><dd>{fmt(climb.up)} m up, {fmt(climb.down)} m down, estimated</dd>
                    <dt>How</dt><dd>Estimated from the GEDTM30 terrain model along our OpenStreetMap line: {stageless ? "the route's" : "every main stage's"} climbs and drops along samples {sampleM} m apart, each counted once it reaches {CLIMB_THRESHOLD_M} m</dd>
                    {officialClimb && <><dt>Official</dt><dd>{fmt(officialClimb.up)} m up, {fmt(officialClimb.down)} m down, {officialClimbHow} ({officialClimbSrc})</dd></>}
                    {climbShort !== null ? (
                      <><dt>Keep in mind</dt><dd>Our map line covers only {Math.floor(climbShort * 100)} % of the route, and no source states the climbs</dd></>
                    ) : climbOff ? (
                      <><dt>Keep in mind</dt><dd>{climbCoarse ? `Samples ${sampleM} m apart on a trail this long miss short climbs that ${officialClimbSrc} counts` : `${officialClimbSrc} counts the climbs differently`}</dd></>
                    ) : !officialClimb && (
                      <><dt>Keep in mind</dt><dd>A 30 m terrain model: short climbs between the samples are missed</dd></>
                    )}
                  </>
                ) : climb && (
                  <>
                    <dt>This trail</dt><dd>{fmt(climb.up)} m up, {fmt(climb.down)} m down</dd>
                    <dt>Source</dt><dd>{officialClimbSrc}, {officialClimbHow}</dd>
                    <dt>Why</dt><dd>{climbShort !== null ? `Our map line covers only ${Math.floor(climbShort * 100)} % of the route` : "Our elevation profile doesn't cover the route"}, so this is {possessive(officialClimbSrc)} figure</dd>
                  </>
                )}
                {!climb?.estimate && climb?.how === "stated total" && totals?.ascentM && totals.descentM &&
                  (totals.ascentM.value !== climb.up || totals.descentM.value !== climb.down) && (
                  <>
                    <dt>Stage sums</dt><dd>{fmt(totals.ascentM.value)} m up, {fmt(totals.descentM.value)} m down ({mainView.length} main stages)</dd>
                  </>
                )}
              </dl>
            </Explain>
          </dt>
          <!-- both climbs in one tile: two small lines, as tall as the big numbers beside them -->
          <dd class="climbs">
            {climbTotal.est && <span class="sr-only">estimated: </span>}
            <span>{climbTotal.est && <span class="unit approx" aria-hidden="true">≈</span>}<span class="climb">{fmt(climbTotal.up)}</span><span class="unit">m ↑</span></span>
            <span>{climbTotal.est && <span class="unit approx" aria-hidden="true">≈</span>}<span class="climb">{fmt(climbTotal.down)}</span><span class="unit">m ↓</span></span>
          </dd>
        </div>
      )}
      {diff.dims.length > 0 && (
        <div>
          <dt>
            <Explain id="difficulty-info" term="Difficulty">
              <dl class="pop-facts">
                {DIFFICULTY_FACTS.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
              </dl>
              <ul class="diff-pop">
                {diff.dims.map((d) => (
                  <li>
                    <Meter level={d.level} />
                    <strong data-dim-text={d.id}>{d.label}: {levelText(d)}</strong>
                    <span>
                      {scaleLabel(d.by.id)}: {d.by.estimate && "≈ "}{d.by.text}{d.by.where && ` (${d.by.where})`}
                    </span>
                  </li>
                ))}
              </ul>
              <a slot="foot" href="#difficulty">All measures</a>
            </Explain>
          </dt>
          <dd class="diff-fig" data-rate={climateDim ? rateData(dimLevel("terrain"), dimLevel("effort"), diff.months.map((m) => m.level), diff.season) : undefined}>
            <span class="sr-only rate-sr">{diff.dims.map((d) => `${d.label}: ${levelText(d)}`).join("; ")}</span>
            <!-- one bar per dimension, as tall as its level; climate's harder season months lighter
                 above (months picked in the search re-rate it, src/lib/months.ts) -->
            <span class="diff-bars" aria-hidden="true">
              {diff.dims.map((d) => (
                <span class="diff-col" data-dim={d.id} title={`${d.label}: ${levelText(d)}`}>
                  <span class="diff-bar range" style={`height: ${(d.worst ?? d.level) * 25}%`}></span>
                  <span class="diff-bar lv" style={`height: ${d.level * 25}%`}></span>
                  <span class="diff-tag">{d.label[0]}</span>
                </span>
              ))}
            </span>
            <span class="big rate-word" aria-hidden="true">{LEVELS[diffTop - 1]}</span>
          </dd>
        </div>
      )}
      {days && (
        <div>
          <dt>
            <Explain id="days-info" term={days.basis === "stages" ? "Days" : "Suggested"}>
              <dl class="pop-facts">
                {stageless && <><dt>No stages</dt><dd>No official stages: hikers choose their own camps</dd></>}
                {days.basis === "stages" ? (
                  <>
                    <dt>This trail</dt><dd>{days.min} days, one per stage of {possessive(sourceShort(days.source))} stage list</dd>
                    <dt>Why</dt><dd>No source suggests days for the route as listed here</dd>
                  </>
                ) : (
                  <>
                    <dt>Source</dt><dd>{sourceShort(days.source)}</dd>
                    {days.basis === "secondary" && <><dt>Keep in mind</dt><dd>A second source: the operator suggests no number of days</dd></>}
                  </>
                )}
              </dl>
            </Explain>
          </dt>
          <dd><span class="big">{range(days.min, days.max)}</span><span class="unit">days</span></dd>
        </div>
      )}
      {dayAvg && (
        <div>
          <dt>
            <Explain id="per-day-info" term="Per day">
              <dl class="pop-facts">
                <dt>How</dt><dd>The length{dayAvg.ascentM ? " and the ascent" : ""} over the suggested {range(dayAvg.days.min, dayAvg.days.max)} days{dayAvg.days.min !== dayAvg.days.max ? ": from the most days to the fewest" : ""}</dd>
                {dayAvg.lengthSource === dayAvg.daysSource ? (
                  <><dt>Source</dt><dd>{sourceShort(dayAvg.daysSource)}</dd></>
                ) : (
                  <><dt>Length</dt><dd>{sourceShort(dayAvg.lengthSource)}</dd><dt>Days</dt><dd>{sourceShort(dayAvg.daysSource)}</dd></>
                )}
                {dayAvg.ascentM && <><dt>Ascent</dt><dd>{dayAvg.est ? "The terrain model's estimate (≈), as the key figure" : `${possessive(sourceShort(dayAvg.climbSource!))} figure, as the key figure`}</dd></>}
              </dl>
            </Explain>
          </dt>
          <dd>
            <span class="big">{range(dayAvg.km.min, dayAvg.km.max)}</span><span class="unit">km</span>
            {dayAvg.ascentM && (
              <span class="unit">
                · {dayAvg.est && <span aria-hidden="true">≈ </span>}{dayAvg.est && <span class="sr-only">about </span>}{dayAvg.ascentM.min === dayAvg.ascentM.max ? fmt(dayAvg.ascentM.min) : `${fmt(dayAvg.ascentM.min)}–${fmt(dayAvg.ascentM.max)}`} m ↑
              </span>
            )}
          </dd>
        </div>
      )}
      {daily && (
        <div>
          <dt>
            <Explain id="per-stage-info" term="Per stage">
              <dl class="pop-facts">
                <dt>How</dt><dd>The {daily.stages} main stages' totals over their number</dd>
                <dt>Source</dt><dd>{possessive(sourceShort(daily.source))} stage list</dd>
                {daily.ascentM && <><dt>Ascent</dt><dd>{daily.ascentM.est ? "The terrain model's estimate (≈), as the key figure" : `${possessive(sourceShort(daily.ascentM.source))} figure, as the key figure`}</dd></>}
              </dl>
            </Explain>
          </dt>
          <dd>
            <span class="big">{daily.km}</span><span class="unit">km</span>
            {daily.ascentM && (
              <span class="unit">
                · {daily.ascentM.est && <span aria-hidden="true">≈ </span>}{daily.ascentM.est && <span class="sr-only">about </span>}{fmt(daily.ascentM.value)} m ↑
              </span>
            )}
          </dd>
        </div>
      )}
      {t.season && (
        <div>
          <!-- the season, and a picker for your travel months (issue #211) -->
          <SeasonPick months={t.season.months} text={t.season.text} />
        </div>
      )}
      {landcover && landMain && (
        <div>
          <dt>
            <Explain id="landscape-info" term="Landscape">
              <dl class="pop-facts">
                <dt>Source</dt><dd>ESA WorldCover satellite land cover, along the main route</dd>
              </dl>
              <ul class="land-pop">
                {[...landRows].sort((a, b) => landcover.shares[b.id] - landcover.shares[a.id]).map((g) => (
                  <li><span class="swatch-key" style={`--c: var(--land-${g.id})`} aria-hidden="true"></span>{g.label}: {pct(landcover.shares[g.id])}</li>
                ))}
              </ul>
              <a slot="foot" href="#landscape">Landscape along the route</a>
            </Explain>
          </dt>
          <dd class="land-fig">
            <span>{landcover.shares[landMain.id] >= 0.5 ? "Mostly" : "Mainly"} <b>{landMain.short}</b></span>
            <!-- every group's share, in the Landscape section's colours and order -->
            <span class="land-bar" aria-hidden="true">
              {landRows.map((g) => (
                <span style={`flex: ${landcover.shares[g.id]}; --c: var(--land-${g.id})`} title={`${g.label}: ${pct(landcover.shares[g.id])}`}></span>
              ))}
            </span>
          </dd>
        </div>
      )}
    </dl>
  </section>

  {photos.length > 0 && <TrailPhotos photos={photos} trailName={t.name} />}

  <!-- location and map in one section (from 900 px side by side: the facts left, the map right
       and as tall as they are); #map still leads to the map -->
  <section id="location">
    <h2>Location</h2>
    <div class="loc-map">
    <dl class="loc">
      {LOC_FACTS.map((f) => (
        <div class:list={[{ wide: f.wide }]}>
          {f.key === "country" && (
            <>
              <dt>Country</dt>
              <dd>{t.countries.map(countryName).join(", ")}</dd>
            </>
          )}
          {f.key === "regions" && (
            <>
              <dt>Regions</dt>
              <dd>{t.regions.join(", ")}</dd>
            </>
          )}
          {f.key === "start" && (
            <>
              <dt>Start</dt>
              <dd>{t.termini.start.name}</dd>
            </>
          )}
          {f.key === "finish" && (
            <>
              <dt>Finish</dt>
              <dd>{t.termini.end.name}</dd>
            </>
          )}
          {f.key === "route" && (
            <>
              <dt>Route type</dt>
              <dd>{TRAIL_TYPES[t.trailType]}</dd>
            </>
          )}
          {f.key === "permit" && (
            <>
              <dt>Permit</dt>
              <dd>{[permit && (permit.required ? "Required" : "Not needed"), fees.length > 0 && "fee charged"].filter(Boolean).join(" · ").replace(/^f/, "F")}</dd>
            </>
          )}
          {f.key === "hubs" && (
            <>
              <dt>Travel hubs</dt>
              <dd>
                <ul class="hubs">
                  {hubs.map((h) => (
                    <li>
                      <span class="hub-kind">
                        <Icon
                          name={h.kind === "station" ? "train-front" : h.kind === "bus" ? "bus" : "plane"}
                          size={15}
                          label={h.kind === "station" ? "Train station" : h.kind === "bus" ? "Bus station" : "Airport"}
                        />
                      </span>
                      <span>
                        {h.name}
                        {h.roadKm !== undefined && derived?.access && (
                          <span class="hub-dist">
                            {h.roadKm} km by road{h.to ? ` to ${h.to}` : ""} · {h.driveMin} min{h.via ? `, then ${h.via.by}` : ""}
                          </span>
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          )}
          {f.key === "protected" && (
            <>
              <dt>Protected areas</dt>
              <dd>{t.protectedAreas.join("; ")}</dd>
            </>
          )}
          {f.key === "managed" && (
            <>
              <dt>Managed by</dt>
              <dd>
                {t.managedBy.map((m) => m.name).join(", ")}
                {/* the official GPX link already leads to the operator's site: then no second link (2026-11-05) */}
                {!(t.officialGpx && "url" in t.officialGpx) && <a class="site-link" href={t.website}>Official website</a>}
              </dd>
            </>
          )}
          {f.key === "gpx" && (
            <>
              <dt>GPX</dt>
              <dd>
                {t.officialGpx && "url" in t.officialGpx && (
                  <>
                    <a class="site-link" href={t.officialGpx.url}>Official GPX track</a>
                    <span class="gpx-note">Offered by {t.officialGpx.by}</span>
                  </>
                )}
                {own && (
                  <>
                    <a class="site-link" href={`/gpx/${trail.id}.gpx`} download>GPX track</a>
                    <span class="gpx-note">Our tracing from OpenStreetMap</span>
                  </>
                )}
              </dd>
            </>
          )}
          {f.key === "waymark" && t.waymarking && (
            <>
              <dt>Waymarking</dt>
              <dd class:list={{ marked: t.waymarking.symbol }}>
                {t.waymarking.symbol && (
                  <span class="marks">{[t.waymarking.symbol].flat().map((s) => <Waymark symbol={s} number={t.waymarking!.number} />)}</span>
                )}
                <span>{t.waymarking.text}</span>
              </dd>
            </>
          )}
        </div>
      ))}
    </dl>
    <div id="map" class="map-col">
      <TrailMap
        client:visible
        routeUrl={routeUrl}
        start={t.termini.start}
        end={t.termini.end}
        routeAttribution={routeAttribution}
        detours={detourModes}
        transfers={transferModes}
        stages={stageless ? 1 : mainView.length}
        noStages={stageless}
        loop={stageless && isLoop}
        others={[...new Set(stageView.filter((s) => s.kind !== "main").map((s) => s.kind as "approach" | "variant"))]}
        placesUrl={derived?.water ? `/places/${trail.id}.json` : null}
        placeCounts={{
          drinking: derived?.water?.points.filter((p) => p.kind === "drinking").length,
          springs: derived?.water?.points.filter((p) => p.kind === "spring").length,
          shops: derived?.along?.resupply.points.length,
          beds: derived?.along?.beds.points.length,
        }}
        fill
      >
        {routeUrl && <Fragment set:html={routePreviewSvg(trail.id, t.termini, `Route of the ${t.name}, from ${t.termini.start.name} to ${t.termini.end.name}`)} />}
      </TrailMap>
    </div>
    </div>
  </section>

  {diff.dims.length > 0 && (
    <section id="difficulty">
      <h2>Difficulty</h2>
      {climateDim && (
        <script is:inline type="application/json" id="climate-months" set:html={jsonBlock({ season: diff.season, months: climateMonths })} />
      )}
      <div class="strip diff-cards" style={`--cols: ${diff.dims.length}`}>
        {diff.dims.map((d) => (
          <div>
            <p class="diff-label">
              <Explain id={`about-${d.id}`} term={d.label}>
                <dl class="pop-facts">
                  <dt>Rates</dt><dd>{DIMENSION_TEXT[d.id].question}</dd>
                  <dt>How</dt><dd>{(stageless && d.id === "effort" ? EFFORT_NO_STAGES : DIMENSION_TEXT[d.id]).points.join(" ")}</dd>
                  <dt>Level</dt><dd>The hardest measure sets it</dd>
                  {d.measures.map((m) => (
                    <>
                      <dt>{scaleLabel(m.id)}</dt>
                      <dd>
                        <span class="pop-note">{scaleFrom(m.id)}</span>
                        <ol class="pop-scale">
                          {SCALES[m.id].bands.map((b, i) =>
                            b !== "–" && (
                              <li class:list={{ current: i + 1 === m.level }}>
                                <span>{LEVELS[i]}</span>
                                {b}
                              </li>
                            ),
                          )}
                        </ol>
                      </dd>
                    </>
                  ))}
                </dl>
              </Explain>
            </p>
            <p class="diff-level" data-dim-level={d.id}>
              <Meter level={d.level} size="m" />
              <span>{levelText(d)}</span>
            </p>
            {d.id === "climate" && (
              <p class="rate-warn" hidden>
                Outside the season ({monthsText(diff.season)}): facilities may be closed, and the weather is harder to plan for.
              </p>
            )}
            <ul class="measures">
              {d.measures.map((m) => (
                <li class:list={{ set: m === d.by }} data-measure={d.id === "climate" ? m.id : undefined}>
                  <Meter level={m.level} />
                  <span>
                    {m.id === "sac" ? (
                      <Explain id="sac-info" term="Path grade" title="SAC hiking scale">
                        <dl class="pop-facts pop-grades">
                          {sac && <><dt>This trail</dt><dd><strong>{sac.value}</strong>{sac.how !== "stated" && ` (${sac.how})`}</dd></>}
                          {sac?.basis && <><dt>Basis</dt><dd>{sac.basis}</dd></>}
                          {SAC_FACTS.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
                          {Object.entries(SAC_SCALE).map(([grade, g]) => (
                            <>
                              <dt class:list={[{ current: grade === sac?.value }]}>{grade} · {g.name}</dt>
                              <dd class:list={[{ current: grade === sac?.value }]}>{g.text}</dd>
                            </>
                          ))}
                        </dl>
                        <a slot="foot" href="https://www.sac-cas.ch/en/ausbildung-und-sicherheit/tourenplanung/grading-systems/">The scale at the Swiss Alpine Club</a>
                      </Explain>
                    ) : (
                      scaleLabel(m.id)
                    )}
                    {m.where && <span class="muted where"> · {m.where}</span>}
                  </span>
                  <span class="v">
                    {m.estimate && <span class="approx" aria-hidden="true">≈ </span>}
                    {m.estimate && <span class="sr-only">estimated </span>}
                    {m.text}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {climate && tRange && (
    <section id="climate">
      <h2>Climate</h2>
      <dl class="strip spec cols" style="--cols: 4">
        <div>
          <dt>Days {seasonMonths.length ? "in season" : ""} · lowest point</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.low.tmax), "")}</span><span class="unit">°C</span></dd>
        </div>
        <div>
          <dt>Nights {seasonMonths.length ? "in season" : ""} · highest point</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.high.tmin), "")}</span><span class="unit">°C</span></dd>
        </div>
        <div>
          <dt>Wet days a month</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.high.wetDays), "")}</span></dd>
        </div>
        <div>
          <dt>Daylight</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.daylightH), "", 1)}</span><span class="unit">h</span></dd>
        </div>
      </dl>

      <figure class="chart climate">
        <script is:inline type="application/json" class="chart-data" set:html={jsonBlock(climate.months)} />
        <ul class="legend" aria-hidden="true">
          <li><span class="swatch-key" style="--c: var(--clim-low)"></span>Lowest point</li>
          <li><span class="swatch-key" style="--c: var(--clim-high)"></span>Highest point</li>
          <li><span class="swatch-key" style="--c: var(--wet)"></span>Wet days</li>
          <li><span class="swatch-key" style="--c: var(--snow)"></span>of which snow</li>
          {seasonRuns.length > 0 && <li><span class="swatch-key season-key"></span>Season</li>}
        </ul>
        <div class="chart-scroll">
        <svg
          viewBox={`0 0 ${CHART.width} ${CLIM.height}`}
          role="img"
          aria-label={`Climate by month, ${climate.years[0]}–${climate.years[1]} average: day highs and night lows at the lowest and highest point, wet days, and daylight. A table follows.`}
        >
          {seasonRuns.map((run) => (
            <g>
              <rect class="season" x={colX(run[0])} y="0" width={colW * run.length} height={CLIM.months + 6} rx="6" />
              <text class="season-label" x={colX(run[0]) + (colW * run.length) / 2} y="16" text-anchor="middle">Season</text>
            </g>
          ))}

          <g class="panel-label-chip"><rect x="2" y={CLIM.tTop - 12 - 15} width={chipW("Day high and night low")} height="21" rx="4" /><text class="panel-label" x="8" y={CLIM.tTop - 12}>Day high and night low</text></g>
          {tempGrid.map((c) => (
            <g>
              <line class={c === 0 ? "zero" : "grid"} x1={CLIM.x0} x2={CLIM.x1} y1={yTemp(c)} y2={yTemp(c)} />
              <text class="grid-label" x={CLIM.x0 - 8} y={yTemp(c) + 4} text-anchor="end">{signed(c)} °C</text>
            </g>
          ))}
          {climate.months.map((m) => (
            <g>
              <rect class="temp low" x={colX(m.month) + colW / 2 - 13} y={yTemp(m.low.tmax)} width="11" height={yTemp(m.low.tmin) - yTemp(m.low.tmax)} rx="4" />
              <rect class="temp high" x={colX(m.month) + colW / 2 + 2} y={yTemp(m.high.tmax)} width="11" height={yTemp(m.high.tmin) - yTemp(m.high.tmax)} rx="4" />
            </g>
          ))}

          <g class="panel-label-chip"><rect x="2" y={CLIM.wTop - 12 - 15} width={chipW("Wet days, at the highest point")} height="21" rx="4" /><text class="panel-label" x="8" y={CLIM.wTop - 12}>Wet days, at the highest point</text></g>
          {Array.from({ length: wetMax / 5 + 1 }, (_, i) => i * 5).map((d) => (
            <g>
              <line class={d === 0 ? "base" : "grid"} x1={CLIM.x0} x2={CLIM.x1} y1={yWet(d)} y2={yWet(d)} />
              {d > 0 && <text class="grid-label" x={CLIM.x0 - 8} y={yWet(d) + 4} text-anchor="end">{d}</text>}
            </g>
          ))}
          {climate.months.map((m) => (
            <g>
              <rect class="wet" x={colX(m.month) + colW / 2 - 12} y={yWet(m.high.wetDays)} width="24" height={Math.max(yWet(m.high.snowDays) - yWet(m.high.wetDays) - (m.high.snowDays >= 0.5 ? 2 : 0), 0)} rx="3" />
              {m.high.snowDays >= 0.5 && (
                <rect class="snow" x={colX(m.month) + colW / 2 - 12} y={yWet(m.high.snowDays)} width="24" height={CLIM.wBottom - yWet(m.high.snowDays)} />
              )}
            </g>
          ))}

          <g class="panel-label-chip"><rect x="2" y={CLIM.dTop - 12 - 15} width={chipW("Daylight")} height="21" rx="4" /><text class="panel-label" x="8" y={CLIM.dTop - 12}>Daylight</text></g>
          {climate.months.map((m) => (
            <g>
              <rect class="day-track" x={colX(m.month) + 8} y={CLIM.dTop + 8} width={colW - 16} height="8" rx="4" />
              <rect class="day-fill" x={colX(m.month) + colW / 2 - ((colW - 16) * m.daylightH) / 48} y={CLIM.dTop + 8} width={((colW - 16) * m.daylightH) / 24} height="8" rx="4" />
              <text class="day-value" x={colX(m.month) + colW / 2} y={CLIM.dTop + 34} text-anchor="middle">{m.daylightH.toFixed(1)} h</text>
            </g>
          ))}

          {climate.months.map((m) => (
            <g>
              <text class="month" x={colX(m.month) + colW / 2} y={CLIM.months} text-anchor="middle">{MONTHS[m.month - 1]}</text>
              <rect class="col-hit" data-month={m.month} x={colX(m.month)} y="0" width={colW} height={CLIM.height} />
            </g>
          ))}
        </svg>
        </div>
        <div class="tip" role="status" hidden><strong></strong><span></span></div>
        <!-- a table ignores the 1 px width of .sr-only and would widen the page: hide its wrapper, pinned left so
             it doesn't sit beyond the edge after the wide chart -->
        <div class="sr-only" style="top: 0; left: 0">
        <table>
          <caption>Climate by month, {climate.years[0]}–{climate.years[1]} average</caption>
          <thead>
            <tr>
              <th scope="col">Month</th>
              <th scope="col">Lowest point, day high / night low (°C)</th>
              <th scope="col">Highest point, day high / night low (°C)</th>
              <th scope="col">Wet days</th>
              <th scope="col">Snow days</th>
              <th scope="col">Frost nights at the highest point</th>
              <th scope="col">Daylight (h)</th>
            </tr>
          </thead>
          <tbody>
            {climate.months.map((m) => (
              <tr>
                <th scope="row">{MONTH_NAMES[m.month - 1]}</th>
                <td>{m.low.tmax} / {m.low.tmin}</td>
                <td>{m.high.tmax} / {m.high.tmin}</td>
                <td>{m.high.wetDays}</td>
                <td>{m.high.snowDays}</td>
                <td>{m.high.frostNights}</td>
                <td>{m.daylightH}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <figcaption class="chart-info">
          <Explain id="about-climate-chart" term="About this chart" title="Climate by month" icon>
            <dl class="pop-facts">
              <dt>Source</dt><dd>ERA5 reanalysis via Open-Meteo, averages for {climate.years[0]}–{climate.years[1]}</dd>
              <dt>Places</dt><dd>The trail's lowest and highest point, adjusted to their height</dd>
              <dt>Bars</dt><dd>From the mean night low to the mean day high</dd>
              <dt>Wet days</dt><dd>At least 1 mm of rain; snow days at least 1 cm of snow</dd>
              <dt>Daylight</dt><dd>Sunrise to sunset in the middle of the month</dd>
              <dt>Shading</dt><dd>The trail's season</dd>
            </dl>
          </Explain>
        </figcaption>
      </figure>
    </section>
  )}

  {t.stages && !stageless && (
    <section id="stages">
      <h2>Stages</h2>
      <!-- a compact table with bars for distance and ascent (issue #25, for every trail since
           2026-10-30); with more than STAGES_SHOWN main stages, the first STAGES_SHOWN rows show and a
           script folds the rest and the variants behind "Show all" (without it all show) -->
      <div class="stage-table" data-shown={STAGES_SHOWN}>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Stage</span></th>
                <th scope="col">Route</th>
                <th scope="col">Distance</th>
                <th scope="col">Ascent</th>
                <th scope="col">Descent</th>
                {stageEle && <th scope="col">Elevation</th>}
                {stageTime && <th scope="col">Time</th>}
              </tr>
            </thead>
            {[stageView.filter((s) => s.kind === "main"), stageView.filter((s) => s.kind !== "main")].map((rows, part) =>
              rows.length > 0 && (
                <tbody class={part ? "others" : undefined}>
                  {part === 1 && (
                    <tr class:list={["group", { extra: foldStages }]}>
                      <th scope="rowgroup" colspan={5 + (stageEle ? 1 : 0) + (stageTime ? 1 : 0)}>
                        {rows.every((s) => s.kind === "variant") ? "Variants" : "Approaches and variants"}
                      </th>
                    </tr>
                  )}
                  {rows.map((s, i) => (
                    <tr class:list={[s.kind, { extra: foldStages && (part === 1 || i >= STAGES_SHOWN) }]}>
                      <th scope="row" class="n">{s.number}</th>
                      <td class="route">
                        {s.from} <span class="arrow" aria-hidden="true">→</span> {s.to}
                        {s.kind !== "main" && <span class="visually-hidden"> ({s.kind})</span>}
                      </td>
                      <td class="bar">
                        <span class="fill" style={`--w: ${Math.min(s.km / maxStageKm, 1)}`} aria-hidden="true"></span>
                        {s.km.toFixed(1)} km
                      </td>
                      <td class:list={["bar up", { est: s.climb?.est }]}>
                        {s.climb && (
                          <>
                            <span class="fill" style={`--w: ${Math.min(s.climb.up / maxStageUp, 1)}`} aria-hidden="true"></span>
                            {s.climb.est && <span class="visually-hidden">estimated </span>}
                            {s.climb.est && <span aria-hidden="true">≈ </span>}{fmt(s.climb.up)} m ↑
                          </>
                        )}
                      </td>
                      <td class:list={[{ est: s.climb?.est }]}>
                        {s.climb?.down !== undefined && (
                          <>
                            {s.climb.est && <span class="visually-hidden">estimated </span>}
                            {s.climb.est && <span aria-hidden="true">≈ </span>}{fmt(s.climb.down)} m ↓
                          </>
                        )}
                      </td>
                      {stageEle && (
                        <td class:list={[{ est: s.ele?.est }]}>
                          {s.ele && (
                            <>
                              {s.ele.est && <span class="visually-hidden">estimated </span>}
                              {s.ele.est && <span aria-hidden="true">≈ </span>}{fmt(s.ele.from)} → {fmt(s.ele.to)} m
                            </>
                          )}
                        </td>
                      )}
                      {stageTime && (
                        <td class:list={[{ est: s.time?.est }]}>
                          {s.time && (
                            <>
                              {s.time.est && <span class="visually-hidden">estimated </span>}
                              {s.time.est && <span aria-hidden="true">≈ </span>}{timeText(s.time.min, s.time.max)}
                            </>
                          )}
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              ),
            )}
          </table>
        </div>
        <button type="button" class="show-all" aria-expanded="false" hidden>
          Show all {mainView.length} stages{stageView.length > mainView.length && ` and ${stageView.length - mainView.length} ${stageView.every((s) => s.kind !== "approach") ? (stageView.length - mainView.length === 1 ? "variant" : "variants") : "approaches and variants"}`}
        </button>
      </div>
      <p class="note muted">
        Totals and averages count the main stages only.
        {closedStages.map(closedText)}
        {transfers.map(transferText)}
        {/* no source publishes the distances (docs/scope.md, 2026-11-02): ours, from the map line */}
        {t.stages.source === "huckepack-measured" && " Distances are ours, measured on the OpenStreetMap map line between the stage ends: no source publishes them."}
        {t.stages.timesSource && ` Walking times from ${sourceShort(t.stages.timesSource)}.`}
        {t.stages.list
          .filter((s) => s.source)
          .map((s) => ` Stage ${s.number}${s.kind !== "main" ? ` (${s.kind})` : ""} from ${sourceShort(s.source!)}.`)}
        {(estEle || estClimb || estTime) && " ≈ marks our estimates where the source gives no figure: "}
        {(estEle || estClimb) &&
          `${[estClimb && "ascent and descent", estEle && "heights"].filter(Boolean).join(" and ")} from the terrain model (GEDTM30, 30 m grid, sampled every ${sampleM} m; climbs and drops counted once they reach ${CLIMB_THRESHOLD_M} m), to the nearest 10 m`}
        {(estEle || estClimb) && estTime && "; "}
        {estTime && "walking times from each stage's distance, ascent and descent by the German hiking standard DIN 33466 (4 km/h, 300 m/h up, 500 m/h down), without breaks"}
        {(estEle || estClimb || estTime) && "."}
      </p>
    </section>
  )}

  {elevation && grad && eleRange && (
    <section id="terrain" class="terrain">
      <h2>Terrain</h2>
      <!-- key figures in pairs (issue #28): high and low, steepest up and down, steep km, the surfaces -->
      <dl class:list={["strip terrain-row", { "has-ground": surface }]}>
        <div>
          <dt>Highest · lowest point</dt>
          <dd class="climbs">
            <span><span class="climb">{fmt(elevation.highest.m)}</span><span class="unit">m high</span></span>
            <span><span class="climb">{fmt(elevation.lowest.m)}</span><span class="unit">m low</span></span>
          </dd>
        </div>
        <div>
          <dt>
              <Explain id="grade-info" term="Steepest climb · descent" title="Gradient">
                <dl class="pop-facts">
                  <dt>Steepest climb</dt><dd>{grad.climb.grade}{"\u00a0"}% ({degrees(grad.climb.grade)}°), {grad.climb.changeM} m up over 500 m{onStage(grad.climb.stage)}</dd>
                  <dt>Steepest descent</dt><dd>{signed(grad.descent.grade)}{"\u00a0"}% ({degrees(grad.descent.grade)}°), {Math.abs(grad.descent.changeM)} m down over 500 m{onStage(grad.descent.stage)}</dd>
                  <dt>Gradient</dt><dd>Height per distance: 20 % is 20 m up per 100 m forward; 100 % is 45°, not 90°</dd>
                  <dt>Keep in mind</dt><dd>Averages over 500 m from a 30 m terrain model: steps and ladders within them are steeper</dd>
                </dl>
                <table>
                  <thead><tr><th>Gradient</th><th>Angle</th><th>Feels like</th></tr></thead>
                  <tbody>
                    <tr><td>10 %</td><td>6°</td><td>Noticeable on a road</td></tr>
                    <tr><td>20 %</td><td>11°</td><td>A steep path, slow going</td></tr>
                    <tr><td>30 %</td><td>17°</td><td>Very steep, often steps</td></tr>
                    <tr><td>100 %</td><td>45°</td><td>Scrambling</td></tr>
                  </tbody>
                </table>
              </Explain>
          </dt>
          <dd class="climbs">
            <span><span class="climb">{grad.climb.grade}</span><span class="unit">% ↑</span></span>
            <span><span class="climb">{signed(grad.descent.grade)}</span><span class="unit">% ↓</span></span>
          </dd>
        </div>
        <div>
          <dt>
              <Explain id="steep-info" term={`Steep ≥ ${STEEP_PERCENT} %`} title="Steep stretches">
                <dl class="pop-facts">
                  <dt>This trail</dt><dd>{grad.steepUpKm} km up, {grad.steepDownKm} km down: the darkest parts of the profile</dd>
                  <dt>Steep</dt><dd>{STEEP_PERCENT} % or more ({degrees(STEEP_PERCENT)}°, 15 m of height per 100 m), in {barM} m stretches</dd>
                  <dt>Why it matters</dt><dd>Slow going uphill, hard on the knees downhill</dd>
                </dl>
              </Explain>
          </dt>
          <dd><span class="big">{Math.round((grad.steepUpKm + grad.steepDownKm) * 10) / 10}</span><span class="unit">km</span></dd>
        </div>
        {surface && (
          <div class="ground-fig">
            <dt>
              <Explain id="about-surfaces" term="Surfaces" title="Surfaces">
                <ul class="surface-pop">
                  {surfaceRows.map((c) => (
                    <li>
                      <span class="swatch-key" style={`--c: var(--surface-${c.id})`} aria-hidden="true"></span>
                      <span><b>{c.label}</b>: {pct(surface.totals[c.id].share)}, {surface.totals[c.id].km.toFixed(1)} km. {c.hint}</span>
                    </li>
                  ))}
                </ul>
              </Explain>
            </dt>
            <dd class="shares">
              {surfaceRows.filter((c) => c.id !== "unknown").map((c) => (
                <span>
                  <span class="swatch-key" style={`--c: var(--surface-${c.id})`} aria-hidden="true"></span>
                  <span class="climb">{surface.totals[c.id].share < 0.005 ? "<1%" : pct(surface.totals[c.id].share)}</span>{" "}
                  {c.id === "natural" ? "natural" : c.label.toLowerCase()}
                </span>
              ))}
            </dd>
          </div>
        )}
      </dl>

      <div class="terrain-body">
        <figure
          class="chart terrain-chart"
        >
          <script is:inline type="application/json" class="chart-data" set:html={terrainMeta} />
          <script is:inline type="application/json" class="chart-heavy" set:html={terrainData} />
          <div class="chart-scroll">
          <svg
            viewBox={`0 0 ${CHART.width} ${surface ? 236 : 222}`}
            role="img"
            aria-label={`Elevation along the main route, ${elevation.routeKm} km: highest ${fmt(elevation.highest.m)} m at km ${elevation.highest.km.toFixed(1)}, lowest ${fmt(elevation.lowest.m)} m. Steepest climb ${grad.climb.grade} %${stageless ? "" : ` on stage ${grad.climb.stage}`}, steepest descent ${grad.descent.grade} %${stageless ? "" : ` on stage ${grad.descent.stage}`}; ${grad.steepUpKm} km climb and ${grad.steepDownKm} km descend at ${STEEP_PERCENT} % or more.${treeLineText ? ` The route climbs above the tree line, ${treeLineText.replace("≈ ", "about ")}.` : ""}${surface ? ` Ground: ${surfaceRows.map((c) => `${c.label.toLowerCase()} ${pct(surface.totals[c.id].share)}`).join(", ")}.` : ""}`}
          >
            {stageTicks(elevation.stageStarts, elevation.routeKm).map(
              (tk) => tk.band && <rect class="stage-band" x={tk.x} y={TERRAIN.top - 8} width={n1(tk.end - tk.x)} height={TERRAIN.bottom - TERRAIN.top + 8} />,
            )}
            {eleGrid.map((m) => <line class="grid" x1={CHART.x0} x2={CHART.x1} y1={yAt(m)} y2={yAt(m)} />)}
            <defs><path id="terrain-outline" d={profileArea} /></defs>
            <clipPath id="terrain-area"><use href="#terrain-outline" /></clipPath>
            <clipPath id="terrain-top"><rect x={profileBox?.x} y="0" width={profileBox?.width} height={TERRAIN.bottom} /></clipPath>
            <g clip-path="url(#terrain-area)">{slicePaths.map((sl) => <path class={`slice ${sl.dir}`} d={sl.d} style={sl.style} />)}</g>
            <use class="line" href="#terrain-outline" clip-path="url(#terrain-top)" />
            <!-- height labels over the profile (with a halo), so a steep start doesn't hide them; one
                 that would meet the peak label at the left edge gives way -->
            {eleGrid
              .filter((m) => !(peak.left && Math.abs(yAt(m) - 4 - (yAt(elevation.highest.m) - 9)) < 14))
              .map((m) => <text class="grid-label halo" x={CHART.x0 + 2} y={yAt(m) - 4}>{fmt(m)} m</text>)}
            {treeLine && (
              <g class="tree-line">
                {treeLine.fromM && (
                  <rect x={CHART.x0} width={CHART.x1 - CHART.x0} y={yAt(treeLine.m)} height={yAt(treeLine.fromM) - yAt(treeLine.m)} />
                )}
                <line x1={CHART.x0} x2={CHART.x1} y1={yAt(treeLine.m)} y2={yAt(treeLine.m)} />
                <text x={CHART.x1 - 2} y={yAt(treeLine.m) - 5} text-anchor="end">Tree line {treeLineText}</text>
              </g>
            )}
            <line class="base" x1={CHART.x0} x2={CHART.x1} y1={TERRAIN.bottom} y2={TERRAIN.bottom} />
            {surface &&
              stripPaths(surface.runs, (km) => xAt(km, surface.routeKm), TERRAIN.bottom + 4, GROUND_H).map((p) => (
                <path class="ground" d={p.d} style={`fill: var(--surface-${p.category})`} />
              ))}
            <circle class="peak" cx={xAt(elevation.highest.km, elevation.routeKm)} cy={yAt(elevation.highest.m)} r="4" />
            <text class="peak-label" x={peak.x} y={yAt(elevation.highest.m) - 9} text-anchor={peak.anchor}>{fmt(elevation.highest.m)} m</text>
            {stageTicks(elevation.stageStarts, elevation.routeKm).map((tk) => (
              <g>
                <line class="tick" x1={tk.x} x2={tk.x} y1={TERRAIN.bottom + groundOff} y2={TERRAIN.bottom + groundOff + (tk.label ? 8 : 4)} />
                {tk.label && <text class="tick-label" x={tk.mid} y={TERRAIN.bottom + groundOff + 22} text-anchor="middle">{tk.label}</text>}
              </g>
            ))}
            <line class="tick" x1={CHART.x1} x2={CHART.x1} y1={TERRAIN.bottom + groundOff} y2={TERRAIN.bottom + groundOff + 8} />
            <text class="tick-label end" x={CHART.x0} y={TERRAIN.bottom + groundOff + 40}>0 km</text>
            <text class="tick-label end" x={CHART.x1} y={TERRAIN.bottom + groundOff + 40} text-anchor="end">{elevation.routeKm} km</text>
            <line class="cursor" x1="0" x2="0" y1={TERRAIN.top - 8} y2={TERRAIN.bottom} visibility="hidden" />
            <circle class="cursor-dot" cx="0" cy="0" r="4.5" visibility="hidden" />
          </svg>
          </div>
          <div class="tip" role="status" hidden><strong></strong><span></span></div>
          <div class="terrain-keys">
            <div class="legend ramp-key" aria-hidden="true">
              <span>Descent</span>
              <span class="ramp-bar"></span>
              <span>Climb</span>
              <span class="ramp-ticks"><span>−{RAMP_MAX} %</span><span>0</span><span>+{RAMP_MAX} %</span></span>
            </div>
            {surface && (
              <ul class="legend" aria-hidden="true">
                {surfaceRows.map((c) => <li><span class="swatch-key" style={`--c: var(--surface-${c.id})`}></span>{c.label}</li>)}
              </ul>
            )}
          </div>
          <figcaption class="chart-info">
            <Explain id="about-terrain-chart" term="About this chart" title="Terrain along the route" icon>
              <dl class="pop-facts">
                <dt>Heights</dt><dd>GEDTM30 terrain model (OpenGeoHub, from Copernicus and other elevation data), 30 m grid, the bare ground under the trees, every {sampleM} m along the main route</dd>
                <dt>Colours</dt><dd>Each {barM} m by its gradient in walking direction: climbs warm, descents violet, darker when steeper (to ±{RAMP_MAX} %)</dd>
                {surface && <><dt>Ground</dt><dd>The strip below, from OpenStreetMap; the {pct(surface.inferredShare)} without a surface tag is read from the way type (footpaths natural, tracks gravel)</dd></>}
                {treeLine && (
                  <>
                    <dt>Tree line</dt>
                    <dd>{treeLine.fromM ? `${fmt(treeLine.fromM)}–${fmt(treeLine.m)} m, depending on the slope` : `About ${fmt(treeLine.m)} m`} ({sourceShort(treeLine.source)}): above it, open ground without trees. Pasture and clearing can keep the forest lower</dd>
                  </>
                )}
              </dl>
            </Explain>
          </figcaption>
        </figure>
      </div>
    </section>
  )}

  {landcover && (
    <section id="landscape">
      <h2>Landscape</h2>
      <figure class="chart lanes">
        <div class="chart-scroll">
          <svg
            viewBox={`0 0 ${CHART.width} ${landRows.length * 26 + 44}`}
            role="img"
            aria-label={`Landscape along the main route, ${landcover.routeKm} km: ${landSummary}`}
          >
            {stageTicks(landcover.stageStarts, landcover.routeKm, laneX).map(
              (tk) => tk.band && <rect class="stage-band" x={tk.x} y="0" width={n1(tk.end - tk.x)} height={landRows.length * 26 + 4} />,
            )}
            {landRows.map((g, i) => (
              <g>
                <text class="lane-label" x={CHART.x0} y={i * 26 + 18}>{g.label}</text>
                <line class="lane-track" x1={LANE_X0} x2={LANE_X1} y1={i * 26 + 13} y2={i * 26 + 13} />
                {stripPaths(
                  landcover.runs.filter((r) => r.group === g.id).map((r) => ({ ...r, category: g.id })),
                  laneX,
                  i * 26 + 5,
                  16,
                  0.8,
                ).map((strip) => (
                  <path d={strip.d} style={`fill: var(--land-${g.id})`} />
                ))}
                <text class="lane-share" x={CHART.x1} y={i * 26 + 18} text-anchor="end">{pct(landcover.shares[g.id])}</text>
              </g>
            ))}
            {stageTicks(landcover.stageStarts, landcover.routeKm, laneX).map((tk) => {
              const y = landRows.length * 26 + 4;
              return (
                <g>
                  <line class="tick" x1={tk.x} x2={tk.x} y1={y} y2={y + (tk.label ? 8 : 4)} />
                  {tk.label && <text class="tick-label" x={tk.mid} y={y + 20} text-anchor="middle">{tk.label}</text>}
                </g>
              );
            })}
            <text class="tick-label end" x={LANE_X0} y={landRows.length * 26 + 38}>0 km</text>
            <text class="tick-label end" x={LANE_X1} y={landRows.length * 26 + 38} text-anchor="end">{landcover.routeKm} km</text>
            <line class="cursor" x1="0" x2="0" y1="0" y2={landRows.length * 26 + 4} visibility="hidden" />
          </svg>
        </div>
        <div class="tip" role="status" hidden><strong></strong><span></span></div>
        <script
          is:inline
          type="application/json"
          class="chart-data"
          set:html={jsonBlock({
            total: landcover.routeKm,
            x0: LANE_X0,
            x1: LANE_X1,
            lanes: landRows.map((g) => g.label),
            stages: stageless ? [] : landcover.stageStarts.map((st) => [st.number, st.km]),
          })}
        />
        <script
          is:inline
          type="application/json"
          class="chart-heavy"
          set:html={jsonBlock({ runs: landcover.runs.map((r) => [r.fromKm, r.toKm, landRows.findIndex((g) => g.id === r.group)]) })}
        />
        <figcaption class="chart-info">
          <Explain id="about-landscape-chart" term="About this chart" title="Landscape along the route" icon>
            <dl class="pop-facts">
              <dt>Source</dt><dd>ESA WorldCover 2021, a 10 m satellite map</dd>
              <dt>Points</dt><dd>Every {sampleM} m along the main route; each takes the most common class within 30 m, so the path itself doesn't count as bare ground</dd>
              <dt>Groups</dt><dd>Its eleven classes, folded into the six shown</dd>
              <dt>Keep in mind</dt><dd>What the landscape looks like, not which plants grow there</dd>
            </dl>
          </Explain>
        </figcaption>
      </figure>
    </section>
