<script>
  // Months picked in the search (the URL's `months`, issues #114 and #128) re-rate the Difficulty
  // section's climate card in place: its level, each measure's hardest month among the months
  // picked, and a note for months outside the season. Without a pick the page stays as built
  // (the best run of season months); the key figure is re-rated by Base.astro (data-rate).
  import { climateFor, monthsText, readPick } from "../../lib/months";

  const block = document.getElementById("climate-months");
  const WORDS = ["Easy", "Moderate", "Demanding", "Hard"];
  const MONTH = (m: number) => new Date(2000, m - 1, 1).toLocaleString("en", { month: "long" });
  const meter = (el: Element | null, level: number) => {
    if (!el) return;
    el.querySelectorAll("i").forEach((i, n) => i.classList.toggle("on", n < level));
    el.setAttribute("aria-label", `${WORDS[level - 1]}, ${level} of 4`);
  };
  const recl = (pick: number[]) => {
    if (!block) return;
    const { season, months } = JSON.parse(block.textContent!) as { season: number[]; months: [number, string][][] };
    const levels = months.map((ms) => Math.max(...ms.map((x) => x[0])));
    const c = climateFor(levels, season, pick);
    const text = `${WORDS[c.level - 1]} ${c.picked ? "for" : "in"} ${monthsText(c.months)}`;
    const card = document.querySelector('[data-dim-level="climate"]');
    meter(card?.querySelector(".meter") ?? null, c.level);
    const word = card?.querySelector("span:not(.meter)");
    if (word) word.textContent = text;
    const pop = document.querySelector('[data-dim-text="climate"]');
    if (pop) {
      pop.textContent = `Climate: ${text}`;
      meter(pop.parentElement!.querySelector(".meter"), c.level);
    }
    const warn = card?.parentElement?.querySelector<HTMLElement>(".rate-warn");
    if (warn) warn.hidden = c.out.length === 0;
    // each measure: its hardest month among the months rated
    const rows = [...document.querySelectorAll<HTMLElement>("[data-measure]")];
    const worst = rows.map((_, j) => c.months.reduce((a, m) => (months[m - 1][j][0] > months[a - 1][j][0] ? m : a), c.months[0]));
    const top = Math.max(...worst.map((m, j) => months[m - 1][j][0]));
    rows.forEach((row, j) => {
      const [level, value] = months[worst[j] - 1][j];
      meter(row.querySelector(".meter"), level);
      const where = row.querySelector(".where");
      if (where) where.textContent = ` · ${MONTH(worst[j])}`;
      const v = row.querySelector(".v");
      if (v) v.lastChild!.textContent = value;
      row.classList.toggle("set", level === top && rows.findIndex((_, k) => months[worst[k] - 1][k][0] === top) === j);
    });
  };
  const pick = readPick(location.search);
  if (pick.length) recl(pick);
  document.addEventListener("monthpick", (e) => recl((e as CustomEvent<number[]>).detail));
</script>

<script>
  // On-page navigation: marks the link of the section in view. The section counts as in view
  // once its top passes just below where a link click puts it (its scroll-margin-top); the last
  // one that did wins.
  {
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".onpage a")];
    const sections = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el) => el !== null);
    const bar = document.querySelector<HTMLElement>(".onpage")!;
    let current: HTMLAnchorElement | undefined;
    const update = () => {
      const line = Math.max(bar.getBoundingClientRect().bottom, parseFloat(getComputedStyle(sections[0]).scrollMarginTop)) + 8;
      const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const passed = sections.filter((el) => el.getBoundingClientRect().top <= line);
      const section = atEnd ? sections.at(-1) : passed.at(-1);
      const link = links.find((a) => a.hash === `#${section?.id}`);
      if (link === current) return;
      current?.removeAttribute("aria-current");
      current = link;
      if (!link) return;
      link.setAttribute("aria-current", "location");
      // keep it visible in the row that scrolls sideways on phones, without moving the page
      const row = link.closest("ul")!;
      const { left, right } = link.getBoundingClientRect();
      const box = row.getBoundingClientRect();
      if (left < box.left || right > box.right) row.scrollBy({ left: left < box.left ? left - box.left - 16 : right - box.right + 16 });
    };
    let queued = false;
    addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    }, { passive: true });
    addEventListener("resize", update);
    update();

    // Sections below the first screen are drawn only once near it, held at an estimated height until
    // then (issue #95), so a jump to one can end a little off when the sections around it are drawn:
    // once the jump has settled, the page moves to the section again, at once, until it stays put
    const land = (el: HTMLElement | null, now = false) => {
      if (!el) return;
      let tries = 0;
      const fix = () => {
        const off = el.getBoundingClientRect().top - parseFloat(getComputedStyle(el).scrollMarginTop);
        if (Math.abs(off) < 2 || ++tries > 4) return;
        scrollBy({ top: off, behavior: "instant" });
        requestAnimationFrame(() => requestAnimationFrame(fix));
      };
      if (now) return requestAnimationFrame(() => requestAnimationFrame(fix));
      // after the smooth scroll ends (a timer where the browser has no scrollend event)
      let done = false;
      const once = () => {
        if (done) return;
        done = true;
        requestAnimationFrame(() => requestAnimationFrame(fix));
      };
      addEventListener("scrollend", once, { once: true });
      setTimeout(once, 1200);
    };
    const target = () => (location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null);
    if (location.hash) addEventListener("load", () => land(target(), true), { once: true });
    addEventListener("hashchange", () => land(target()));
    // a click on the link of the section already in the address bar fires no hashchange
    document.addEventListener("click", (e) => {
      const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="#"]');
      if (a && a.hash === location.hash) land(document.getElementById(a.hash.slice(1)));
    });
  }

  // Chart data too large for the page (the terrain profile's samples, every place in the lanes) sits
  // in a "chart-heavy" block, which the build empties into the trail's charts.json
  // (src/integrations/chart-files.mjs): fetched once, on the first approach to any such chart; in
  // dev the block still holds it
  const chartFiles = new Map<string, Promise<unknown[]>>();
  function heavyData<T>(figure: HTMLElement): () => Promise<T> {
    const el = figure.querySelector<HTMLElement>(".chart-heavy")!;
    let data: Promise<T> | undefined;
    return () => {
      const src = el.dataset.src;
      if (!src) return (data ??= Promise.resolve(JSON.parse(el.textContent!) as T));
      if (!chartFiles.has(src)) chartFiles.set(src, fetch(src).then((r) => r.json()));
      return (data ??= chartFiles.get(src)!.then((all) => all[Number(el.dataset.i)] as T));
    };
  }
  // start loading as the pointer, a finger or the focus comes near the chart
  const loadOnApproach = (el: HTMLElement, load: () => Promise<unknown>) => {
    for (const type of ["pointerenter", "touchstart", "focusin"]) el.addEventListener(type, () => void load(), { once: true, passive: true });
  };

  // Water, food and beds: one tooltip at the pointer, the nearest place in the lane under it (from
  // the chart's data, not an element per place: long trails have hundreds of beds).
  for (const figure of document.querySelectorAll<HTMLElement>(".waterline")) {
    const svg = figure.querySelector<SVGSVGElement>("svg[role=img]")!; // not the legend's marks
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const cursor = figure.querySelector<SVGLineElement>(".cursor")!;
    const data: {
      total: number;
      top: number;
      step: number;
      height: number;
      mid?: number; // a lane's middle below its top (13, the supply bands; 8, the slim beds lanes)
      x0?: number;
      x1?: number;
      sizes: number[]; // places per row (the places themselves load with the chart-heavy block)
      labels?: string[]; // each row's label
      parent?: number[]; // the group row each row folds into, -1 for none (issue #119)
      gap?: number; // more room before each top-level row (issue #119)
    } = JSON.parse(figure.querySelector(".chart-data")!.textContent!);
    const X0 = data.x0 ?? 8;
    const X1 = data.x1 ?? 992;
    const mid = data.mid ?? 13;
    // issue #118 (of three previews, approach A): every place links to its OSM object, or to its own
    // source's page: in the tooltip, which stays open while the pointer moves into it and is pinned by
    // a click or tap; for the keyboard and screen readers, a list of every place under the chart
    type Place = [number, string, string, string, string]; // km, what, name, stage, link (issue #118)
    const load = heavyData<{ lanes: Place[][] }>(figure);
    let lanes: Place[][] | null = null;
    const ready = () => load().then((h) => (lanes = h.lanes));
    loadOnApproach(figure, ready);
    const KINDS: Record<string, string> = { n: "node", w: "way", r: "relation" };
    const href = (v: string) => (v.startsWith("http") ? v : `https://www.openstreetmap.org/${KINDS[v[0]]}/${v.slice(1)}`);
    const linkText = (v: string) => (v.startsWith("http") ? "View its source ↗" : "View on OpenStreetMap ↗");
    // a link to another website, opening in a new tab (the build sets only links in the HTML); one
    // per place, so nofollow (the user's decision of 2026-11-07, docs/scope.md)
    const outLink = (p: Place, text = linkText(p[4])) => {
      const a = Object.assign(document.createElement("a"), { href: href(p[4]), textContent: text, className: "osm-link", target: "_blank", rel: "noopener nofollow" });
      a.insertAdjacentHTML("beforeend", '<span class="sr-only"> (opens in a new tab)</span>');
      return a;
    };
    let current: { p: Place; x: number } | null = null;
    // groups (Water, Shops) fold their kinds away (shut on load; without this script every row
    // shows): the visible rows move up, the axis follows and the drawing gets shorter
    const parents = data.parent ?? data.sizes.map(() => -1);
    const toggles = [...figure.querySelectorAll<HTMLButtonElement>(".tier-toggle")];
    const open = new Set<number>();
    let height = data.height;
    let visible = data.sizes.map((_, i) => i);
    // a visible row's top: one step per row above it, plus the group gap before each top-level row
    const rowTop = (rows: number[], k: number) => data.top + k * data.step + (data.gap ?? 0) * rows.slice(1, k + 1).filter((i) => parents[i] < 0).length;
    const all = data.sizes.map((_, i) => i);
    const layout = () => {
      visible = all.filter((i) => parents[i] < 0 || open.has(parents[i]));
      for (const g of svg.querySelectorAll<SVGGElement>("g.row")) {
        const i = Number(g.dataset.row);
        const k = visible.indexOf(i);
        g.style.display = k < 0 ? "none" : "";
        g.style.transform = k < 0 ? "" : `translateY(${rowTop(visible, k) - rowTop(all, i)}px)`;
        g.classList.toggle("open", open.has(i));
      }
      const shift = rowTop(visible, visible.length - 1) - rowTop(all, all.length - 1);
      svg.querySelector<SVGGElement>("g.axis")!.style.transform = `translateY(${shift}px)`;
      height = data.height + shift;
      svg.setAttribute("viewBox", `0 0 1000 ${height}`);
      for (const r of svg.querySelectorAll<SVGRectElement>(".stage-band")) r.setAttribute("height", String(height - 40 - data.top + 18));
      cursor.setAttribute("y2", String(height - 40));
      for (const t of toggles) {
        const g = Number(t.dataset.group);
        t.style.top = `${((rowTop(visible, visible.indexOf(g)) - 34) / height) * 100}%`;
        t.setAttribute("aria-expanded", String(open.has(g)));
      }
    };
    if (toggles.length) {
      figure.classList.add("tiered");
      for (const t of toggles) {
        t.hidden = false;
        t.addEventListener("click", () => {
          const g = Number(t.dataset.group);
          if (open.has(g)) open.delete(g);
          else open.add(g);
          layout();
        });
      }
      layout();
    }
    // the rows on screen, top to bottom
    const shown = () => visible;
    const show = (clientX: number, clientY: number) => {
      if (!lanes) return void ready();
      const box = svg.getBoundingClientRect();
      const vx = ((clientX - box.left) / box.width) * 1000;
      const vy = ((clientY - box.top) / box.height) * height;
      const rows = shown();
      const top = (k: number) => (data.parent ? rowTop(rows, k) : data.top + k * data.step);
      const row = rows.reduce((best, _, k) => (Math.abs(top(k) + mid - vy) < Math.abs(top(best) + mid - vy) ? k : best), 0);
      const lane = rows[row];
      // with groups (Water, Shops), the line runs only through the hovered group and its open kinds
      if (data.parent) {
        const g = parents[lane] >= 0 ? parents[lane] : lane;
        const ks = rows.map((r, k) => (r === g || parents[r] === g ? k : -1)).filter((k) => k >= 0);
        cursor.setAttribute("y1", String(top(ks[0]) - 4));
        cursor.setAttribute("y2", String(top(ks[ks.length - 1]) + (parents[rows[ks[ks.length - 1]]] >= 0 ? 21 : 26) + 4));
      }
      const km = ((vx - X0) / (X1 - X0)) * data.total;
      // the nearest place within about 12 units (1.2 % of the route)
      const near = lanes[lane].reduce<Place | null>(
        (best, p) => (Math.abs(p[0] - km) < (best ? Math.abs(best[0] - km) : (12 / (X1 - X0)) * data.total) ? p : best),
        null,
      );
      if (!near) return hide();
      const x = X0 + (near[0] / data.total) * (X1 - X0);
      cursor.setAttribute("x1", String(x));
      cursor.setAttribute("x2", String(x));
      cursor.setAttribute("visibility", "visible");
      tip.querySelector("strong")!.textContent = near[1];
      tip.querySelector("span")!.textContent = `${near[2] ? `${near[2]} · ` : ""}km ${near[0]}${near[3] ? ` · stage ${near[3]}` : ""}`;
      current = { p: near, x };
      tip.querySelector(".osm-link")?.remove();
      if (near[4]) tip.append(outLink(near));
      tip.hidden = false;
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const px = box.left - fbox.left + (x / 1000) * box.width;
      tip.style.left = `${Math.min(Math.max(px, half), fbox.width - half)}px`;
      tip.style.top = `${box.top - fbox.top + (top(row) / height) * box.height - 8}px`;
    };
    // the tooltip stays while the pointer moves into it (to reach its link), and a click or tap pins it
    let pinned = false;
    let leaving: ReturnType<typeof setTimeout> | undefined;
    function hide() {
      if (pinned) return;
      tip.hidden = true;
      cursor.setAttribute("visibility", "hidden");
    }
    svg.addEventListener("pointermove", (e) => !pinned && show(e.clientX, e.clientY));
    svg.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse" || pinned) return;
      leaving = setTimeout(hide, 350);
    });
    tip.addEventListener("pointerenter", () => clearTimeout(leaving));
    tip.addEventListener("pointerleave", () => !pinned && hide());
    svg.addEventListener("click", async (e) => {
      e.stopPropagation();
      await ready();
      pinned = false;
      show(e.clientX, e.clientY);
      if (current && !tip.hidden) pinned = true;
    });
    document.addEventListener("click", (e) => {
      if (tip.contains(e.target as Node) || list.contains(e.target as Node)) return;
      pinned = false;
      hide();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      pinned = false;
      hide();
    });

    // the keyboard's and screen readers' way to the links: every place in a list under the chart, by
    // row (the rows that hold places themselves, not the groups), each with its km, stage and link; its
    // button shows when focused, and the list is built when first opened (some trails have hundreds of
    // places); pointing at a row marks its place on the chart
    const leaves = data.sizes.map((_, i) => i).filter((i) => !parents.includes(i) && data.sizes[i]);
    const count = leaves.reduce((n, i) => n + data.sizes[i], 0);
    const list = Object.assign(document.createElement("div"), { className: "place-list" });
    const listToggle = Object.assign(document.createElement("button"), { type: "button", className: "pl-toggle", textContent: `List all ${count} places` });
    listToggle.setAttribute("aria-expanded", "false");
    const listBody = Object.assign(document.createElement("div"), { className: "pl-body", hidden: true });
    listToggle.addEventListener("click", async () => {
      if (!listBody.childElementCount) fill(await ready());
      listBody.hidden = !listBody.hidden;
      listToggle.setAttribute("aria-expanded", String(!listBody.hidden));
    });
    const fill = (lanes: Place[][]) => {
      for (const i of leaves) {
        const h = Object.assign(document.createElement("p"), { className: "pl-lane", textContent: `${data.labels?.[i] ?? ""} · ${lanes[i].length}` });
        const ol = Object.assign(document.createElement("ol"), { className: "pl-rows" });
        for (const p of lanes[i]) {
          const li = document.createElement("li");
          const cell = (cls: string, text: string) => Object.assign(document.createElement("span"), { className: cls, textContent: text });
          li.append(cell("pl-km", `km ${p[0]}`), cell("pl-what", p[2] ? `${p[1]}: ${p[2]}` : p[1]), cell("pl-stage", p[3] ? `stage ${p[3]}` : ""));
          if (p[4]) li.append(outLink(p, p[4].startsWith("http") ? "Source ↗" : "OpenStreetMap ↗"));
          li.addEventListener("pointerenter", () => {
            const x = X0 + (p[0] / data.total) * (X1 - X0);
            cursor.setAttribute("x1", String(x));
            cursor.setAttribute("x2", String(x));
            cursor.setAttribute("y1", String(data.top - 6));
            cursor.setAttribute("y2", String(height - 40));
            cursor.setAttribute("visibility", "visible");
          });
          li.addEventListener("pointerleave", () => cursor.setAttribute("visibility", "hidden"));
          ol.append(li);
        }
        listBody.append(h, ol);
      }
    };
    list.append(listToggle, listBody);
    figure.append(list);
  }

  // Long stage tables (issue #25): the rows after the first few fold behind "Show all"; without
  // this script every row shows
  for (const box of document.querySelectorAll<HTMLElement>(".stage-table")) {
    const button = box.querySelector<HTMLButtonElement>(".show-all")!;
    if (!box.querySelector(".extra")) continue;
    const more = button.textContent!.trim();
    box.classList.add("folded");
    button.hidden = false;
    button.addEventListener("click", () => {
      const open = !box.classList.toggle("folded");
      button.setAttribute("aria-expanded", String(open));
      button.textContent = open ? "Show fewer" : more;
      // folding up from far below: bring the table's top back into view
      if (!open && box.getBoundingClientRect().top < 0) box.scrollIntoView({ block: "start" });
    });
  }

  // Terrain: a crosshair with everything at the pointer's kilometre: height, the 200 m gradient,
  // the ground, the stage.
  for (const section of document.querySelectorAll<HTMLElement>(".terrain")) {
    const figure = section.querySelector<HTMLElement>(".terrain-chart")!;
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const cursor = figure.querySelector<SVGLineElement>(".cursor")!;
    const dot = figure.querySelector<SVGCircleElement>(".cursor-dot")!;
    const { total, ey }: { total: number; ey: [number, number, number, number] } = JSON.parse(figure.querySelector(".chart-data")!.textContent!);
    // the plotted height (the page's yAt): the elevation range min to max on the chart's top to bottom
    const yOf = (m: number) => ey[3] - ((m - ey[0]) / (ey[1] - ey[0])) * (ey[3] - ey[2]);
    type Heavy = {
      points: [number, number][];
      bars: [number, number, number, string][]; // fromKm, toKm, grade, stage
      runs: [number, number, string][]; // fromKm, toKm, category
    };
    const load = heavyData<Heavy>(figure);
    let points: Heavy["points"] = [];
    let bars: { fromKm: number; toKm: number; grade: number; stage: string }[] = [];
    let runs: { fromKm: number; toKm: number; category: string }[] = [];
    let loaded = false;
    const ready = () =>
      load().then((h) => {
        if (loaded) return;
        points = h.points;
        bars = h.bars.map(([fromKm, toKm, grade, stage]) => ({ fromKm, toKm, grade, stage }));
        runs = h.runs.map(([fromKm, toKm, category]) => ({ fromKm, toKm, category }));
        loaded = true;
      });
    loadOnApproach(figure, ready);
    const GROUND: Record<string, string> = { natural: "natural ground", gravel: "gravel", paved: "paved", unknown: "unknown surface" };
    const X0 = 8;
    const X1 = 992;
    const show = (clientX: number) => {
      if (!loaded) return void ready();
      const box = svg.getBoundingClientRect();
      const vx = Math.min(Math.max(((clientX - box.left) / box.width) * 1000, X0), X1);
      const km = ((vx - X0) / (X1 - X0)) * total;
      const idx = points.reduce((best, p, i) => (Math.abs(p[0] - km) < Math.abs(points[best][0] - km) ? i : best), 0);
      const [pkm, m] = points[idx];
      const y = yOf(m);
      const bar = bars.find((b) => pkm >= b.fromKm && pkm <= b.toKm);
      const run = runs.find((r) => pkm >= r.fromKm && pkm <= r.toKm);
      cursor.setAttribute("x1", String(vx));
      cursor.setAttribute("x2", String(vx));
      cursor.setAttribute("visibility", "visible");
      dot.setAttribute("cx", String(vx));
      dot.setAttribute("cy", String(y));
      dot.setAttribute("visibility", "visible");
      tip.querySelector("strong")!.textContent = `${m.toLocaleString("en")} m${bar ? ` · ${bar.grade > 0 ? "+" : bar.grade < 0 ? "−" : ""}${Math.abs(Math.round(bar.grade))} %` : ""}`;
      tip.querySelector("span")!.textContent = `km ${pkm.toFixed(1)}${bar?.stage ? ` · stage ${bar.stage}` : ""}${run ? ` · ${GROUND[run.category] ?? run.category}` : ""}`;
      tip.hidden = false;
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const px = box.left - fbox.left + (vx / 1000) * box.width;
      tip.style.left = `${Math.min(Math.max(px, half), fbox.width - half)}px`;
      tip.style.top = `${box.top - fbox.top + (y / 222) * box.height - 10}px`;
    };
    const hide = () => {
      tip.hidden = true;
      cursor.setAttribute("visibility", "hidden");
      dot.setAttribute("visibility", "hidden");
    };
    svg.addEventListener("pointermove", (e) => show(e.clientX));
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    svg.addEventListener("click", async (e) => {
      e.stopPropagation();
      await ready();
      show(e.clientX);
    });
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }

  // Landscape: one tooltip at the pointer (the lane's landscape, km and stage there), from the
  // chart's data, instead of a title on every run.
  for (const figure of document.querySelectorAll<HTMLElement>(".lanes")) {
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const cursor = figure.querySelector<SVGLineElement>(".cursor")!;
    const data: {
      total: number;
      x0: number;
      x1: number;
      lanes: string[];
      stages: [string, number][]; // number, start km
    } = JSON.parse(figure.querySelector(".chart-data")!.textContent!);
    const load = heavyData<{ runs: [number, number, number][] }>(figure); // fromKm, toKm, lane
    let runs: [number, number, number][] | null = null;
    const ready = () => load().then((h) => (runs = h.runs));
    loadOnApproach(figure, ready);
    const height = svg.viewBox.baseVal.height;
    const show = (clientX: number) => {
      if (!runs) return void ready();
      const box = svg.getBoundingClientRect();
      const vx = Math.min(Math.max(((clientX - box.left) / box.width) * 1000, data.x0), data.x1);
      const km = ((vx - data.x0) / (data.x1 - data.x0)) * data.total;
      const run = runs.find(([from, to]) => km >= from && km <= to);
      if (!run) return;
      const stage = data.stages.filter(([, start]) => start <= km).at(-1)?.[0];
      cursor.setAttribute("x1", String(vx));
      cursor.setAttribute("x2", String(vx));
      cursor.setAttribute("visibility", "visible");
      tip.querySelector("strong")!.textContent = data.lanes[run[2]];
      tip.querySelector("span")!.textContent = `km ${km.toFixed(1)}${stage ? ` · stage ${stage}` : ""}`;
      tip.hidden = false;
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const px = box.left - fbox.left + (vx / 1000) * box.width;
      tip.style.left = `${Math.min(Math.max(px, half), fbox.width - half)}px`;
      tip.style.top = `${box.top - fbox.top + ((run[2] * 26 + 3) / height) * box.height}px`;
    };
    const hide = () => {
      tip.hidden = true;
      cursor.setAttribute("visibility", "hidden");
    };
    svg.addEventListener("pointermove", (e) => show(e.clientX));
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    svg.addEventListener("click", async (e) => {
      e.stopPropagation();
      await ready();
      show(e.clientX);
    });
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }

  // Climate tooltip: everything about the month under the pointer.
  const MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  type Place = { tmax: number; tmin: number; wetDays: number; snowDays: number; frostNights: number };
  for (const figure of document.querySelectorAll<HTMLElement>(".climate")) {
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const months: { month: number; low: Place; high: Place; daylightH: number }[] = JSON.parse(
      figure.querySelector(".chart-data")!.textContent!,
    );
    // round first, so −0.3 °C reads 0, not −0
    const c = (v: number) => {
      const r = Math.round(v);
      return `${r < 0 ? "−" : ""}${Math.abs(r)}`;
    };
    let active: SVGRectElement | null = null;
    const show = (hit: SVGRectElement) => {
      active?.classList.remove("active");
      active = hit;
      hit.classList.add("active");
      const m = months.find((x) => x.month === Number(hit.dataset.month))!;
      tip.querySelector("strong")!.textContent = MONTH_NAMES[m.month - 1];
      tip.querySelector("span")!.textContent = [
        // by day and by night first, each with both points (as the chart's "Day high and night low")
        `Day high: ${c(m.low.tmax)} °C at the lowest point, ${c(m.high.tmax)} °C at the highest`,
        `Night low: ${c(m.low.tmin)} °C at the lowest point, ${c(m.high.tmin)} °C at the highest`,
        `Highest point: ${Math.round(m.high.wetDays)} wet days, ${Math.round(m.high.snowDays)} with snow, ${Math.round(m.high.frostNights)} frost nights`,
        `${m.daylightH.toFixed(1)} h of daylight`,
      ].join("\n");
      tip.hidden = false;
      tip.style.maxWidth = `${figure.getBoundingClientRect().width}px`;
      const box = hit.getBoundingClientRect();
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      tip.style.left = `${Math.min(Math.max(box.left + box.width / 2 - fbox.left, half), fbox.width - half)}px`;
      tip.style.top = `${svg.getBoundingClientRect().top - fbox.top + 24}px`;
    };
    const hide = () => {
      tip.hidden = true;
      active?.classList.remove("active");
      active = null;
    };
    for (const hit of figure.querySelectorAll<SVGRectElement>(".col-hit")) {
      hit.addEventListener("pointerenter", () => show(hit));
      hit.addEventListener("click", (e) => {
        e.stopPropagation();
        show(hit);
      });
    }
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* title and local name get room above and below, set apart from breadcrumbs and navigation */
  h1 {
    margin: 32px 0 10px;
    text-align: center;
  }
  .subtitle {
    margin: 0 0 16px;
    font-style: italic;
    text-align: center;
  }
  /* stacked links ("Official website", "Official GPX track"): each a 24px-tall tap target, only as
     wide as its words (WCAG target size) */
  .site-link {
    display: block;
    width: fit-content;
    min-height: 24px;
    line-height: 24px;
    font-size: 0.8rem;
  }
  /* where the GPX link's track comes from: the provider's site, or our own tracing */
  .gpx-note {
    display: block;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--muted);
  }

  /* the bar: wall to wall like the skyline band (issue #208), its links in the page column, joined to
     the band above and the key figures below without a gap */
  .onpage {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 16px calc(50% - 50vw) 0;
    padding: 0 max(16px, calc(50vw - 600px));
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  :global(.skyline) + .onpage {
    margin-top: 0;
  }
  .onpage + .key {
    margin-top: 0;
  }
  .onpage ul {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  /* the underline's space is reserved by a transparent border, so marking a link shifts nothing */
  .onpage a {
    display: block;
    padding: 12px 0 10px;
    border-bottom: 2px solid transparent;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  /* centred with auto margins rather than justify-content: when the links overflow on a phone,
     the row still scrolls from its first link instead of cutting it off on the left */
  .onpage li:first-child {
    margin-left: auto;
  }
  .onpage li:last-child {
    margin-right: auto;
  }
  .onpage a:hover,
  .onpage a:focus-visible {
    border-bottom-color: var(--muted);
  }
  /* the section in view, set by the script below */
  .onpage a[aria-current] {
    border-bottom-color: var(--accent);
  }

  section {
    margin-top: 36px;
    scroll-margin-top: 64px;
  }
  /* the sections below the first screen: the browser skips their layout and painting until they come
     near the screen (issue #95), holding an estimated height for each until then and its real height
     once it has been drawn (auto) */
  section:not(#figures, #location) {
    content-visibility: auto;
    contain-intrinsic-size: auto var(--est, 640px);
  }
  /* the estimates: each section's usual height (measured on the Alpe-Adria Trail and the West Highland
     Way, 2026-11-04), so the scrollbar barely moves as sections are drawn */
  #difficulty { --est: 230px; }
  #climate { --est: 550px; }
  #stages { --est: 400px; }
  #terrain { --est: 430px; }
  #landscape { --est: 230px; }
  #sleeping { --est: 400px; }
  #water { --est: 330px; }
  @media (max-width: 719px) {
    #difficulty { --est: 600px; }
    #climate { --est: 615px; }
    #stages { --est: 680px; }
    #terrain { --est: 600px; }
    #landscape { --est: 220px; }
    #sleeping { --est: 700px; }
    #water { --est: 420px; }
  }
  /* wide screens: section headings move into a margin column, like a printed guidebook, and
     every section's content starts at the same indent beside its title. Separates the sections
     and saves the heading rows. From 1080 px only: the content column stays at least 820 px wide,
     which the stage table and the five sleeping columns need. Key figures and the
     map (hidden headings) keep the full width. */
  @media (min-width: 1080px) {
    section:has(> h2:not(.visually-hidden)) {
      display: flow-root;
    }
    section > h2:not(.visually-hidden) {
      float: left;
      width: 136px;
      margin: 0;
      padding-top: 10px;
      font-size: 1.15rem;
      line-height: 1.25;
    }
    section:has(> h2:not(.visually-hidden)) > :global(:not(h2)) {
      margin-left: 160px;
    }
  }
  .key {
    margin-top: 20px;
  }
  /* desktop: every card in one row, however many the trail has */
  @media (min-width: 900px) {
    .figures {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      grid-template-columns: none;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts dd {
      margin-bottom: 8px;
    }
  }
  .note {
    font-size: 0.8rem;
  }
  /* desktop: each section's cards in one row, headlines on one line */
  @media (min-width: 900px) {
    .cards {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      grid-template-columns: none;
    }
    .card-name > span {
      white-space: nowrap;
    }
  }
  /* icons sit on the first line of their label, however many lines it wraps to */
  .figures dt :global(.icon) {
    flex: none;
    margin-top: 1px;
  }
  .hubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hubs li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .hub-kind {
    flex: none;
    display: grid;
    place-items: center;
    height: 1.5em;
    color: var(--muted);
    align-self: flex-start;
  }
  .hubs li {
    align-items: flex-start;
  }
  .hub-dist {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .hubs li:last-child {
    margin-bottom: 0;
  }
  .arrow {
    color: var(--muted);
    font-weight: 400;
  }
  /* stages (issue #25, every trail): a compact table, one line per stage, with small bars under the
     distance and the ascent so long and hard days stand out; rows after the first few fold away */
  /* the section's opening rule in text colour, like every other section's first block */
  .stage-table {
    border-top: 1px solid var(--text);
    padding-top: 12px;
  }
  .stage-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .stage-table thead th {
    padding: 0 12px 6px 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
    text-align: left;
  }
  .stage-table td,
  .stage-table tbody th {
    height: 30px;
    padding: 0 12px 0 0;
    border-top: 1px solid var(--line);
    font-weight: 400;
    text-align: left;
    white-space: nowrap;
  }
  .stage-table .n {
    width: 2.2rem;
    color: var(--accent-text);
    font-weight: 600;
  }
  .stage-table .route {
    width: 100%;
    font-family: var(--serif);
    font-size: 0.95rem;
    font-weight: 600;
    white-space: normal;
  }
  .stage-table .variant .n,
  .stage-table .approach .n,
  .stage-table .variant .route,
  .stage-table .approach .route {
    color: var(--muted);
  }
  .stage-table .group th {
    padding-top: 16px;
    border-top: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .stage-table .bar {
    position: relative;
    min-width: 6.5rem;
  }
  .stage-table .fill {
    position: absolute;
    bottom: 4px;
    left: 0;
    width: calc(var(--w) * 5.5rem);
    height: 3px;
    border-radius: 2px;
    background: var(--muted);
    opacity: 0.45;
  }
  .stage-table .bar.up .fill {
    background: var(--grade-up-steep);
    opacity: 0.8;
  }
  .stage-table .est {
    color: var(--muted);
  }
  .stage-table.folded .extra {
    display: none;
  }
  /* relative: the hidden screen-reader words in the cells are placed absolutely and must not
     escape the scroll box (they widened the page on phones) */
  .table-scroll {
    position: relative;
    overflow-x: auto;
  }
  .show-all {
    margin-top: 10px;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--accent-text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .show-all:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* many stages: every other stage shaded behind the strip charts */
  .stage-band {
    fill: var(--line);
    opacity: 0.55;
  }
  /* location and map: stacked, the map beneath; from 900 px side by side, the facts in two columns
     on the left and the map filling their height on the right */
  .loc-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .map-col {
    display: flex;
    flex-direction: column;
    scroll-margin-top: 64px;
  }
  @media (min-width: 900px) {
    .loc-map {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 28px;
      align-items: stretch;
    }
    .loc-map .loc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: start;
    }
  }
  /* location: one grid of label-over-value items, so rows align whatever the content */
  .loc {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    border-top: 1px solid var(--text);
  }
  @media (min-width: 820px) {
    .loc {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .loc > div {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .loc > .wide {
    grid-column: span 2;
  }
  .loc dt {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .loc dd {
    margin: 2px 0 0;
    line-height: 1.45;
  }
  /* waymarking with its mark redrawn small, first line beside the mark */
  .loc dd.marked {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .loc dd.marked .marks {
    display: flex;
    flex: none;
    gap: 4px;
    margin-top: 3px;
  }
  /* difficulty key figure: one bar per dimension (initial beneath), as tall as its level; the
     hardest level as a word beside it. As tall as the big numbers, so the labels line up */
  .diff-fig {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }
  .diff-bars {
    display: flex;
    gap: 3px;
    height: 2rem;
    padding-bottom: 0.15rem;
  }
  .diff-col {
    position: relative;
    width: 9px;
    height: calc(100% - 11px);
    background: var(--line);
    border-radius: 2px 2px 0 0;
  }
  .diff-bar {
    position: absolute;
    inset: auto 0 0;
    background: var(--text);
    border-radius: 2px 2px 0 0;
  }
  .diff-bar.range {
    opacity: 0.4;
  }
  .diff-tag {
    position: absolute;
    inset: auto 0 -12px;
    font-size: 0.6rem;
    line-height: 1;
    text-align: center;
    color: var(--muted);
  }
  .diff-pop {
    display: grid;
    gap: 8px;
    margin: 10px 0;
    padding: 0;
    list-style: none;
  }
  .diff-pop li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 10px;
  }
  .diff-pop li > :global(.meter) {
    grid-row: span 2;
    margin-top: 0.35em;
  }
  .diff-pop span {
    color: var(--muted);
  }

  /* difficulty section: one card per dimension in a strip; its level, then every measure, the one
     that set the level in bold */
  .diff-cards {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .diff-cards {
      grid-template-columns: repeat(var(--cols), 1fr);
    }
  }
  @media (max-width: 639px) {
    .diff-fig .big {
      font-size: 1.25rem;
    }
    .strip.diff-cards > * + * {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  .diff-cards p {
    margin: 0;
  }
  .diff-label {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .diff-level {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 10px !important;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .measures {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
  }
  .measures li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px;
    align-items: baseline;
    color: var(--muted);
  }
  .measures li.set {
    color: var(--text);
    font-weight: 600;
  }
  .measures li .muted {
    font-weight: 400;
  }
  .measures .v {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .sources {
    margin-top: 72px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
    scroll-margin-top: 64px;
  }
  /* a short rule, like a printed footnote's */
  .sources::before {
    content: "";
    display: block;
    width: 120px;
    margin-bottom: 12px;
    border-top: 1px solid var(--line);
  }
  .sources h2 {
    margin: 0 0 6px;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sources ol {
    margin: 0;
    padding-left: 1.6em;
  }
  .sources li {
    margin-bottom: 2px;
  }
  .sources a {
    color: inherit;
  }
  .sources li:target {
    color: var(--text);
    background: var(--accent-soft);
  }

  /* strips: the shared language of key figures, sleeping and water. A rule on top,
     hairlines between items, no filled boxes; numbers first, labels small beneath. */
  .strip {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--line);
  }
  /* the key figures follow the section nav's own rule: no second, dark one on top */
  .strip.key-figs {
    border-top: 0;
  }
  .strip > * {
    padding: 14px 16px 14px 0;
  }
  .strip > * + * {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }

  /* key figures and water figures: 2 columns on phones, 4 on tablets, one row on desktop (key
     figures stay in rows of four: .key-figs) */
  .spec {
    grid-template-columns: repeat(2, 1fr);
  }
  .spec.three {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (min-width: 640px) {
    .spec {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 980px) {
    .spec {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: auto;
    }
    .spec.three {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row;
    }
  }
  @media (max-width: 979px) {
    .spec:not(.three) > :nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 639px) {
    .spec:not(.three) > :nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .spec:not(.three) > :nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  /* key figures: one row from 1200 px (each column as wide as its figure, the spare width shared
     out), rows of four from 640 px with a hairline between, two shrinkable columns on phones */
  @media (max-width: 639px) {
    .spec.key-figs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 640px) and (max-width: 1199px) {
    .spec.key-figs {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-flow: row;
    }
    .spec.key-figs > :nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .spec.key-figs > :nth-child(n + 5) {
      border-top: 1px solid var(--line);
    }
  }
  @media (min-width: 1200px) {
    .spec.key-figs {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(max-content, 1fr);
    }
    .spec.key-figs > * + * {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  /* ascent and descent: two lines in a smaller serif, together as tall as one big number */
  .climbs {
    display: grid;
    align-content: end;
    min-height: 1.95rem;
    line-height: 1.05;
  }
  .climb {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .climbs .unit {
    font-size: 0.78rem;
  }
  /* landscape key figure: the main landscape in words over a bar of every group's share; as tall
     as the big numbers beside it */
  .land-fig {
    display: grid;
    align-content: end;
    gap: 6px;
    min-height: 1.95rem;
    font-size: 0.9rem;
  }
  .land-fig b {
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  .land-bar {
    display: flex;
    gap: 2px;
    width: 9rem;
    max-width: 100%;
    height: 10px;
  }
  .land-bar span {
    min-width: 3px;
    border-radius: 2px;
    background: var(--c);
  }
  .land-pop {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .land-pop .swatch-key {
    display: inline-block;
  }
  /* label first in the markup (dt before dd), value first on screen */
  .spec div {
    display: flex;
    flex-direction: column;
  }
  .spec dd {
    order: 1;
  }
  .spec dt {
    order: 2;
  }
  .spec dd {
    margin: 0;
    white-space: nowrap;
  }
  .big {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.15;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .word {
    display: block;
    padding-top: 6px;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: normal;
  }
  /* a word before the number ("about 285 km") */
  .unit.before {
    margin: 0 4px 0 0;
  }
  /* "≈" before an estimated key figure */
  .unit.approx {
    margin: 0 3px 0 0;
  }
  .unit {
    margin-left: 4px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .spec dt {
    display: flex;
    align-items: center;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* season key figure: twelve month cells in two rows, season months filled (as on the search cards) */
  /* two 14 px rows: as tall as the big numbers beside it, so the labels beneath line up */
  /* sleeping: availability per category */
  .avail {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .avail {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  /* phones: wild camping across the top, the four kinds of beds in two columns beneath */
  @media (max-width: 639px) {
    .avail {
      grid-template-columns: repeat(2, 1fr);
    }
    .avail > :first-child {
      grid-column: 1 / -1;
    }
    .avail > * + * {
      border-top: 1px solid var(--line);
    }
    .avail > :nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
    .avail > :nth-child(odd):not(:first-child) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  .avail p {
    margin: 0;
  }
  .avail-name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px !important;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .status.inline {
    display: inline-flex;
    margin: 0 0 0 10px !important;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 500;
    vertical-align: 4px;
  }
  .detail {
    margin-top: 2px !important;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .off .status {
    color: var(--muted);
    font-weight: 400;
  }

  /* status marks: the shape carries the meaning (full, half, crossed, empty), colour supports it */
  .mark {
    flex: none;
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 2px solid var(--mark);
    border-radius: 50%;
  }
  .tone-good {
    --mark: var(--good);
  }
  .tone-fair {
    --mark: var(--fair);
  }
  .tone-poor {
    --mark: var(--poor);
  }
  .tone-none {
    --mark: var(--muted);
  }
  .mark.full {
    background: var(--mark);
  }
  .mark.half {
    background: linear-gradient(90deg, var(--mark) 50%, transparent 50%);
  }
  .mark.blocked {
    background: linear-gradient(135deg, transparent 43%, var(--mark) 43%, var(--mark) 57%, transparent 57%);
  }
  .aside {
    display: flex;
    gap: 10px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .aside .mark {
    margin-top: 4px;
  }
  .aside strong {
    color: var(--text);
    font-weight: 600;
  }

  /* water along the route: a strip chart on the map line's kilometres */
  .waterline {
    margin: 20px 0 0;
  }
  .run {
    shape-rendering: crispEdges;
  }
  .cursor {
    stroke: var(--text);
    stroke-width: 1.5;
  }
  /* equal columns from 640 px; phones keep the strips' two columns (four would overflow) */
  @media (min-width: 640px) {
    .spec.cols {
