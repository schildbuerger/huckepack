---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrailMap from "../../components/TrailMap.svelte";
import Icon from "../../components/Icon.astro";
import Explain from "../../components/Explain.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Meter from "../../components/Meter.astro";
import Waymark from "../../components/Waymark.astro";
import { difficulty, levelText, DIFFICULTY_NOTE, DIMENSION_TEXT, LEVELS, SCALES, type Level } from "../../lib/difficulty";
import { existsSync } from "node:fs";
import {
  countryName,
  monthName,
  perDay,
  sacGrade,
  stageEstimates,
  stageTotals,
  SAC_NOTE,
  SAC_SCALE,
  SLEEPING_CATEGORIES,
  SLEEPING_LABELS,
  STEEP_PERCENT,
  gradients,
  WILD_CAMPING_LABELS,
  waterLevel,
} from "../../lib/trails";

export async function getStaticPaths() {
  const trails = await getCollection("trails");
  return trails.map((trail) => ({ params: { slug: trail.id }, props: { trail } }));
}

const { trail } = Astro.props as { trail: CollectionEntry<"trails"> };
const t = trail.data;
const derived = (await getEntry("derived", trail.id))?.data;
const water = derived?.water;
// sources of water points besides OSM (the record's waterPoints), by their titles' first part
const waterExtra = (water?.extraSources ?? []).map((id) => t.sources.find((x) => x.id === id)?.title.split(":")[0] ?? id);
// travel hubs with their distance to the start (pipeline/access.py), stations first
const hubs = t.access.map((h) => ({ ...h, ...derived?.access?.hubs.find((d) => d.name === h.name) }));
// sleeping: each category with the types this trail has in it; camping also carries wild camping
const sleeping = SLEEPING_CATEGORIES.map((c) => ({
  ...c,
  present: c.types.filter((x) => t.sleeping?.types.includes(x)),
}));
const sources = Object.fromEntries(t.sources.map((s, i) => [s.id, { ...s, n: i + 1 }]));
const totals = stageTotals(t);
// one length: the sum of the main stages where there are stages, else the first stated total
const length = totals
  ? { ...totals.km, approx: false }
  : t.length[0]
    ? { value: t.length[0].km, source: t.length[0].source, how: "stated total", approx: t.length[0].approx }
    : null;
const daily = perDay(t);
const sac = sacGrade(t);
// difficulty in three dimensions (src/lib/difficulty.ts); the key figure names the hardest level
const diff = difficulty(t, derived);
const diffTop = Math.max(1, ...diff.dims.map((d) => d.level)) as Level;
// stage heights and times: the published figure, else our estimate (marked ≈ on the page)
const estimates = stageEstimates(t, derived);
const stageView = (t.stages?.list ?? []).map((s) => {
  const est = estimates.get(s.number);
  const ele =
    s.startEleM !== undefined && s.endEleM !== undefined
      ? { from: s.startEleM, to: s.endEleM, est: false }
      : est?.startEleM !== undefined && est.endEleM !== undefined
        ? { from: est.startEleM, to: est.endEleM, est: true }
        : null;
  const time = s.minutes
    ? { min: s.minutes, max: s.maxMinutes, est: false }
    : est?.minutes
      ? { min: est.minutes, max: undefined, est: true }
      : null;
  const climb =
    s.ascentM !== undefined && s.descentM !== undefined
      ? { up: s.ascentM, down: s.descentM, est: false }
      : est?.ascentM !== undefined && est.descentM !== undefined
        ? { up: est.ascentM, down: est.descentM, est: true }
        : null;
  return { ...s, ele, time, climb };
});
// total ascent and descent: the stated stage sums, else the sum of the terrain model's estimates
// for every main stage (marked ≈)
const mainView = stageView.filter((s) => s.kind === "main");
const climbTotal =
  totals?.ascentM && totals.descentM
    ? { up: totals.ascentM.value, down: totals.descentM.value, est: false }
    : mainView.length && mainView.every((s) => s.climb)
      ? { up: mainView.reduce((a, s) => a + s.climb!.up, 0), down: mainView.reduce((a, s) => a + s.climb!.down, 0), est: true }
      : null;
const estClimb = stageView.some((s) => s.climb?.est);
// stage columns: only those some stage has a figure for; a stage without one keeps an empty cell,
// so the columns stay under their header
const stageEle = stageView.some((s) => s.ele);
const stageTime = stageView.some((s) => s.time);
const estEle = stageView.some((s) => s.ele?.est);
const estTime = stageView.some((s) => s.time?.est);
const fmt = (n: number) => n.toLocaleString("en");
// a source by the first part of its title ("Tourismusverband Sächsische Schweiz"), for inline mentions
const sourceShort = (id: string) => t.sources.find((s) => s.id === id)?.title.split(":")[0] ?? id;
const hours = (min: number) => `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, "0")}`;
// a walking time, or a range of whole hours as "4–5 h"
const timeText = (min: number, max?: number) =>
  max === undefined ? hours(min) : min % 60 === 0 && max % 60 === 0 ? `${min / 60}–${max / 60} h` : `${hours(min)}–${hours(max)}`;
const TRAIL_TYPES = { "point-to-point": "Point to point", loop: "Loop", network: "Network" };
const range = (min: number, max: number) => (min === max ? `${min}` : `${min}–${max}`);
// the map line, built by pipeline/routes.py; without it the map shows only the termini
const routeFile = `routes/${trail.id}.geojson`;
const routeUrl = t.route && existsSync(`public/${routeFile}`) ? `/${routeFile}` : null;
// attribution names the route's source: its title up to the first colon
const routeAttribution = routeUrl && t.route ? sources[t.route.source].title.split(":")[0] : null;

const level = water && waterLevel(water.longestGapKm.drinking.km);
// status as a shape plus a word; colour (--good/--fair/--poor) only fills the shape
type Status = { shape: "full" | "half" | "blocked" | "empty"; tone: string; word: string };
const STATUS: Record<string, Status> = {
  available: { shape: "full", tone: "good", word: "Available" },
  allowed: { shape: "full", tone: "good", word: "Allowed" },
  restricted: { shape: "half", tone: "fair", word: "Restricted" },
  prohibited: { shape: "blocked", tone: "poor", word: "Prohibited" },
  none: { shape: "empty", tone: "none", word: "None listed" },
  unknown: { shape: "empty", tone: "none", word: "Not known" },
};
const sleepingRows = sleeping.map((c) =>
  c.id === "wild-camping"
    ? { ...c, status: STATUS[t.wildCamping?.status ?? "unknown"], detail: "" }
    : {
        ...c,
        status: STATUS[c.present.length > 0 ? "available" : "none"],
        detail: c.present.map((x) => SLEEPING_LABELS[x]).join(", "),
      },
);
const WATER_STATUS = { frequent: "available", regular: "restricted", scarce: "prohibited" } as const;
const waterStatus = level && { ...STATUS[WATER_STATUS[level.id]], word: level.label };

// strip charts (water, surfaces, elevation) share one geometry: a 1000-unit wide viewBox, km across
const CHART = { width: 1000, x0: 8, x1: 992, axis: 92, lanes: { drinking: 46, spring: 70 } };
// landscape lanes: labels on the left, the route's km across the rest
const LANE_X0 = 220;
const LANE_X1 = 940;
const laneX = (km: number) => LANE_X0 + (km / (derived?.landcover?.routeKm || 1)) * (LANE_X1 - LANE_X0);
const xAt = (km: number, total = water?.routeKm || 1) => CHART.x0 + (km / total) * (CHART.x1 - CHART.x0);

// surfaces along the main route (pipeline/surface.py), in a fixed order, soft to hard
const surface = derived?.surface;
const SURFACES = [
  {
    id: "natural",
    label: "Natural ground",
    hint: "Earth, grass, rock and roots: footpaths and forest trails. Can be muddy after rain.",
  },
  { id: "gravel", label: "Gravel", hint: "Gravel, compacted and stony surfaces: mostly forest roads and farm tracks." },
  { id: "paved", label: "Paved", hint: "Asphalt, concrete and cobbles: roads and village streets." },
  { id: "unknown", label: "Unknown", hint: "Stretches whose surface OpenStreetMap doesn't record." },
] as const;
const surfaceRows = surface ? SURFACES.filter((c) => surface.totals[c.id]?.km > 0) : [];
const pct = (share: number) => `${Math.round(share * 100)}%`;

// landscape (pipeline/landcover.py): ESA WorldCover groups along the main route, on the elevation
// profile's kilometres; colours --land-* in this fixed order
const landcover = derived?.landcover;
const elevationTop = derived?.elevation?.highest.m;
const LAND = [
  { id: "forest", label: "Forest", short: "Forest" },
  { id: "open", label: "Grassland and shrubs", short: "Grassland" },
  { id: "moss", label: "Moss and lichen", short: "Moss" },
  { id: "bare", label: "Bare rock and sand", short: "Rock" },
  { id: "water", label: "Water, snow and ice", short: "Water" },
  { id: "farm", label: "Farmland and villages", short: "Farmland" },
];
const landRows = landcover ? LAND.filter((g) => (landcover.shares[g.id] ?? 0) > 0) : [];
// the key figure: the main landscape by its short name, and every group's share as a bar
const landMain = landcover ? [...landRows].sort((a, b) => landcover.shares[b.id] - landcover.shares[a.id])[0] : undefined;
// one sentence: the main landscape, then the rest from 2 % up, smaller ones as "patches of"
const landSummary = (() => {
  if (!landcover) return "";
  const rows = [...landRows].sort((a, b) => landcover.shares[b.id] - landcover.shares[a.id]);
  const say = (g: (typeof LAND)[number]) => `${g.label.toLowerCase()} (${pct(landcover.shares[g.id])})`;
  const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);
  const [first, ...rest] = rows;
  const more = rest.filter((g) => landcover.shares[g.id] >= 0.02);
  const bits = rest.filter((g) => landcover.shares[g.id] < 0.02).map((g) => g.label.toLowerCase());
  const head = landcover.shares[first.id] >= 0.5 ? `Mostly ${say(first)}` : `A mix of ${say(first)}`;
  return `${head}${more.length ? `, with ${list(more.map(say))}` : ""}${bits.length ? `${more.length ? "; " : ", "}patches of ${list(bits)}` : ""}.`;
})();
// how high the forest goes: up to the top, or only low down
const forestLine = (() => {
  const top = landcover?.highestForest;
  if (!landcover || !elevationTop) return null;
  if (!top) return "No forest along the main route.";
  return top.m >= elevationTop - 20 ? `Forest up to the highest point (${fmt(top.m)} m).` : `No forest above ${fmt(Math.ceil(top.m / 10) * 10)} m.`;
})();

// terrain (issue #15): one elevation profile (pipeline/elevation.py) on the same kilometres as the
// other charts, coloured by its gradient (gradients() in src/lib/trails.ts) or by the ground under
// it (pipeline/surface.py); a toggle switches the view and its figures
const elevation = derived?.elevation;
const grad = elevation && gradients(elevation.points, elevation.stageStarts);
const TERRAIN = { top: 26, bottom: 170 };
const eleRange = elevation && {
  min: Math.floor((elevation.lowest.m - 50) / 200) * 200,
  max: Math.ceil((elevation.highest.m + 50) / 200) * 200,
};
const yAt = (m: number) =>
  eleRange ? TERRAIN.bottom - ((m - eleRange.min) / (eleRange.max - eleRange.min)) * (TERRAIN.bottom - TERRAIN.top) : 0;
const eleGrid = eleRange
  ? Array.from({ length: 10 }, (_, i) => eleRange.min + i * (eleRange.max - eleRange.min > 1000 ? 400 : 200)).filter(
      (m) => m > eleRange.min && m < eleRange.max,
    )
  : [];
const profileLine =
  elevation?.points.map(([km, m], i) => `${i ? "L" : "M"}${xAt(km, elevation.routeKm).toFixed(1)},${yAt(m).toFixed(1)}`).join("") ?? "";
// the area under the profile in the gradient bars' 200 m slices, each with two fills: its gradient
// on a smooth diverging ramp (the profile's tint at 0 %, the steep colour at ±RAMP_MAX %; climbs
// warm, descents violet) and the ground at its middle
const RAMP_MAX = 30;
const rampFill = (g: number) =>
  `color-mix(in oklab, var(${g >= 0 ? "--grade-up-steep" : "--grade-down-steep"}) ${Math.round((Math.min(Math.abs(g), RAMP_MAX) / RAMP_MAX) * 100)}%, var(--terrain-tint))`;
const terrainSlices =
  elevation && grad
    ? grad.bars.map((b) => {
        const top = elevation.points
          .filter(([km]) => km >= b.fromKm && km <= b.toKm)
          .map(([km, m]) => `${xAt(km, elevation.routeKm).toFixed(1)},${yAt(m).toFixed(1)}`)
          .join(" ");
        const mid = (b.fromKm + b.toKm) / 2;
        const ground = surface?.runs.find((r) => mid >= r.fromKm && mid <= r.toKm)?.category ?? "unknown";
        return {
          points: `${xAt(b.fromKm, elevation.routeKm).toFixed(1)},${TERRAIN.bottom} ${top} ${xAt(b.toKm, elevation.routeKm).toFixed(1)},${TERRAIN.bottom}`,
          style: `--g: ${rampFill(b.grade)}; --s: var(--surface-${ground})`,
        };
      })
    : [];
const degrees = (g: number) => Math.round((Math.atan(Math.abs(g) / 100) * 180) / Math.PI);

// climate (pipeline/climate.py): twelve month columns; the season from the record is shaded
const climate = derived?.climate;
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const CLIM = { x0: 52, x1: 992, tTop: 30, tBottom: 210, wTop: 252, wBottom: 312, dTop: 348, months: 398, height: 406 };
const colW = (CLIM.x1 - CLIM.x0) / 12;
const colX = (m: number) => CLIM.x0 + (m - 1) * colW;
const tRange = climate && {
  min: Math.floor((Math.min(...climate.months.map((m) => m.high.tmin)) - 2) / 10) * 10,
  max: Math.ceil((Math.max(...climate.months.map((m) => m.low.tmax)) + 2) / 10) * 10,
};
const yTemp = (c: number) =>
  tRange ? CLIM.tBottom - ((c - tRange.min) / (tRange.max - tRange.min)) * (CLIM.tBottom - CLIM.tTop) : 0;
const tempGrid = tRange ? Array.from({ length: (tRange.max - tRange.min) / 10 + 1 }, (_, i) => tRange.min + i * 10) : [];
const wetMax = climate ? Math.ceil(Math.max(...climate.months.map((m) => m.high.wetDays)) / 5) * 5 : 15;
const yWet = (d: number) => CLIM.wBottom - (d / wetMax) * (CLIM.wBottom - CLIM.wTop);
const seasonMonths = t.season?.months ?? [];
// contiguous runs of season months, each shaded as one band
const seasonRuns = seasonMonths
  .slice()
  .sort((a, b) => a - b)
  .reduce<number[][]>((runs, m) => {
    const last = runs.at(-1);
    if (last && m === last.at(-1)! + 1) last.push(m);
    else runs.push([m]);
    return runs;
  }, []);
const signed = (c: number) => `${c < 0 ? "−" : ""}${Math.abs(Math.round(c))}`;
const between = (values: number[], unit: string, digits = 0) => {
  const [lo, hi] = [Math.min(...values), Math.max(...values)];
  const f = (v: number) => (digits ? v.toFixed(digits) : signed(v));
  return `${f(lo)}${lo < 0 ? " to " : "–"}${f(hi)}${unit ? ` ${unit}` : ""}`;
};
const inSeason = climate ? climate.months.filter((m) => seasonMonths.length === 0 || seasonMonths.includes(m.month)) : [];

// stage ticks for the strip charts: a tick at each stage start, the label centred on its stretch
const stageTicks = (starts: { number: string; km: number }[], total: number) =>
  starts.map((st, i) => {
    const end = starts[i + 1]?.km ?? total;
    return {
      x: xAt(st.km, total),
      mid: (xAt(st.km, total) + xAt(end, total)) / 2,
      label: xAt(end, total) - xAt(st.km, total) > 70 ? `Stage ${st.number}` : st.number,
    };
  });

// water strip chart: the main route on the map line's kilometres
const onRoute = water?.points.filter((p) => p.km !== null) ?? [];
const chartSummary =
  water &&
  `Water along the main route, ${water.routeKm} km: ${onRoute.filter((p) => p.kind === "drinking").length} drinking water points and ${onRoute.filter((p) => p.kind === "spring").length} springs. The longest stretch without drinking water is ${water.longestGapKm.drinking.km} km, from km ${water.longestGapKm.drinking.fromKm} to ${water.longestGapKm.drinking.toKm}.`;
const waterTotals = water && {
  drinking: water.points.filter((p) => p.kind === "drinking").length,
  springs: water.points.filter((p) => p.kind === "spring").length,
};
// the stage(s) of the longest dry stretch, from the water points at either end of it
const gapStages = (() => {
  if (!water) return "";
  const g = water.longestGapKm.drinking;
  const at = (km: number) => water.points.find((p) => p.km !== null && Math.abs(p.km - km) < 0.05)?.stage;
  const [a, b] = [at(g.fromKm), at(g.toKm)];
  return a && b ? (a === b ? `, stage ${a}` : `, stages ${a}–${b}`) : "";
})();

// on-page navigation: only sections this trail has
const nav = [
  { id: "location", label: "Location", show: true },
  { id: "map", label: "Map", show: true },
  { id: "difficulty", label: "Difficulty", show: diff.dims.length > 0 },
  { id: "climate", label: "Climate", show: Boolean(climate) },
  { id: "stages", label: "Stages", show: Boolean(t.stages) },
  { id: "terrain", label: "Terrain", show: Boolean(elevation && grad) },
  { id: "landscape", label: "Landscape", show: Boolean(landcover) },
  { id: "sleeping", label: "Sleeping", show: Boolean(t.sleeping || t.wildCamping) },
  { id: "water", label: "Water", show: Boolean(water) },
].filter((n) => n.show);
---

<Base
  title={`${t.name} · huckepack`}
  description={`${t.name}${t.localName ? ` (${t.localName})` : ""}: stages, length, ascent, difficulty, where to sleep, water and a map.`}
>
  <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current={t.name} />
  <h1>
    {t.name}
  </h1>
  {t.localName && <p class="subtitle muted">{t.localName}</p>}

  <nav class="onpage" aria-label="On this page">
    <ul>
      {nav.map((n) => (
        <li>
          <a href={`#${n.id}`}>{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <section id="figures" class="key">
    <h2 class="visually-hidden">Key figures</h2>
    <dl class="strip spec key-figs">
      {length && (
        <div>
          <dt>Length</dt>
          <dd>
            {length.approx && <span class="unit">about</span>}
            <span class="big">{fmt(length.value)}</span><span class="unit">km</span>
          </dd>
        </div>
      )}
      {climbTotal && (
        <div>
          <dt>Ascent{climbTotal.est && " (estimate)"}</dt>
          <dd>
            {climbTotal.est && <span class="unit approx" aria-hidden="true">≈</span>}
            <span class="big">{fmt(climbTotal.up)}</span><span class="unit">m ↑</span>
          </dd>
        </div>
      )}
      {climbTotal && (
        <div>
          <dt>Descent{climbTotal.est && " (estimate)"}</dt>
          <dd>
            {climbTotal.est && <span class="unit approx" aria-hidden="true">≈</span>}
            <span class="big">{fmt(climbTotal.down)}</span><span class="unit">m ↓</span>
          </dd>
        </div>
      )}
      {diff.dims.length > 0 && (
        <div>
          <dt>
            <Explain id="difficulty-info" term="Difficulty">
              <p>{DIFFICULTY_NOTE}</p>
              <ul class="diff-pop">
                {diff.dims.map((d) => (
                  <li>
                    <Meter level={d.level} low={d.low} />
                    <strong>{d.label}: {levelText(d)}</strong>
                    <span>
                      {SCALES[d.by.id].label}: {d.by.estimate && "≈ "}{d.by.text}{d.by.where && ` (${d.by.where})`}
                    </span>
                  </li>
                ))}
              </ul>
              <a slot="foot" href="#difficulty">All measures</a>
            </Explain>
          </dt>
          <dd class="diff-fig">
            <span class="sr-only">{diff.dims.map((d) => `${d.label}: ${levelText(d)}`).join("; ")}</span>
            <!-- one bar per dimension, as tall as its level; climate's season range lighter above -->
            <span class="diff-bars" aria-hidden="true">
              {diff.dims.map((d) => (
                <span class="diff-col" title={`${d.label}: ${levelText(d)}`}>
                  <span class="diff-bar range" style={`height: ${d.level * 25}%`}></span>
                  <span class="diff-bar" style={`height: ${(d.low ?? d.level) * 25}%`}></span>
                  <span class="diff-tag">{d.label[0]}</span>
                </span>
              ))}
            </span>
            <span class="big" aria-hidden="true">{LEVELS[diffTop - 1]}</span>
          </dd>
        </div>
      )}
      {t.days && (
        <div>
          <dt>Suggested</dt>
          <dd><span class="big">{range(t.days.min, t.days.max)}</span><span class="unit">days</span></dd>
        </div>
      )}
      {daily && (
        <div>
          <dt>Per day</dt>
          <dd><span class="big">{daily.km.value}</span><span class="unit">km{daily.ascentM && ` · ${fmt(daily.ascentM.value)} m ↑`}</span></dd>
        </div>
      )}
      {t.season && (
        <div>
          <dt>Season</dt>
          <dd>
            <span class="visually-hidden">{t.season.text ?? t.season.months.map(monthName).join(", ")}</span>
            <!-- the search cards' month strip, in two rows of six -->
            <span class="season-grid" aria-hidden="true">
              {MONTHS.map((m, i) => (
                <span class:list={["month", { in: t.season!.months.includes(i + 1) }]} title={monthName(i + 1)}>{m[0]}</span>
              ))}
            </span>
          </dd>
        </div>
      )}
      {landcover && landMain && (
        <div>
          <dt>
            <Explain id="landscape-info" term="Landscape">
              <p>Land cover along the main route, from ESA WorldCover satellite data:</p>
              <ul class="land-pop">
                {[...landRows].sort((a, b) => landcover.shares[b.id] - landcover.shares[a.id]).map((g) => (
                  <li><span class="swatch-key" style={`--c: var(--land-${g.id})`} aria-hidden="true"></span>{g.label}: {pct(landcover.shares[g.id])}</li>
                ))}
              </ul>
              <a slot="foot" href="#landscape">Landscape along the route</a>
            </Explain>
          </dt>
          <dd class="land-fig">
            <span>{landcover.shares[landMain.id] >= 0.5 ? "Mostly" : "Mainly"} <b>{landMain.short}</b></span>
            <!-- every group's share, in the Landscape section's colours and order -->
            <span class="land-bar" aria-hidden="true">
              {landRows.map((g) => (
                <span style={`flex: ${landcover.shares[g.id]}; --c: var(--land-${g.id})`} title={`${g.label}: ${pct(landcover.shares[g.id])}`}></span>
              ))}
            </span>
          </dd>
        </div>
      )}
    </dl>
  </section>

  <section id="location">
    <h2>Location</h2>
    <dl class="loc">
      <div>
        <dt>Start</dt>
        <dd>{t.termini.start.name}</dd>
      </div>
      <div>
        <dt>Finish</dt>
        <dd>{t.termini.end.name}</dd>
      </div>
      {hubs.length > 0 && (
        <div class="wide">
          <dt>Travel hubs</dt>
          <dd>
            <ul class="hubs">
              {hubs.map((h) => (
                <li>
                  <span class="hub-kind">
                    <Icon
                      name={h.kind === "station" ? "train-front" : h.kind === "bus" ? "bus" : "plane"}
                      size={15}
                      label={h.kind === "station" ? "Train station" : h.kind === "bus" ? "Bus station" : "Airport"}
                    />
                  </span>
                  <span>
                    {h.name}
                    {h.roadKm !== undefined && derived?.access && (
                      <span class="hub-dist">{h.roadKm} km by road · {h.driveMin} min</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )}
      <div>
        <dt>Country</dt>
        <dd>{t.countries.map(countryName).join(", ")}</dd>
      </div>
      {t.regions.length > 0 && (
        <div>
          <dt>Regions</dt>
          <dd>{t.regions.join(", ")}</dd>
        </div>
      )}
      {t.protectedAreas.length > 0 && (
        <div class="wide">
          <dt>Protected areas</dt>
          <dd>{t.protectedAreas.join("; ")}</dd>
        </div>
      )}
      {t.waymarking && (
        <div>
          <dt>Waymarking</dt>
          <dd class:list={{ marked: t.waymarking.symbol }}>
            {t.waymarking.symbol && <Waymark symbol={t.waymarking.symbol} />}
            <span>{t.waymarking.text}</span>
          </dd>
        </div>
      )}
      <div>
        <dt>Route type</dt>
        <dd>{TRAIL_TYPES[t.trailType]}</dd>
      </div>
      <div class:list={[{ wide: t.managedBy.map((m) => m.name).join(", ").length > 40 }]}>
        <dt>Managed by</dt>
        <dd>
          {t.managedBy.map((m) => m.name).join(", ")}
          <a class="site-link" href={t.website}>Official website</a>
        </dd>
      </div>
    </dl>
  </section>

  <section id="map">
    <h2 class="visually-hidden">Map</h2>
    <TrailMap
      client:visible
      routeUrl={routeUrl}
      start={t.termini.start}
      end={t.termini.end}
      routeAttribution={routeAttribution}
    />
  </section>

  {diff.dims.length > 0 && (
    <section id="difficulty">
      <h2>Difficulty</h2>
      <div class="strip diff-cards" style={`--cols: ${diff.dims.length}`}>
        {diff.dims.map((d) => (
          <div>
            <p class="diff-label">
              <Explain id={`about-${d.id}`} term={d.label}>
                <p>{DIMENSION_TEXT[d.id].question} {DIMENSION_TEXT[d.id].how} The rating takes its hardest measure.</p>
                {d.measures.map((m) => (
                  <div class="bands">
                    <p><strong>{SCALES[m.id].label}</strong>: {SCALES[m.id].from}.</p>
                    <ol>
                      {SCALES[m.id].bands.map((b, i) =>
                        b !== "–" && (
                          <li class:list={{ current: i + 1 === m.level }}>
                            <span>{LEVELS[i]}</span>
                            {b}
                          </li>
                        ),
                      )}
                    </ol>
                  </div>
                ))}
              </Explain>
            </p>
            <p class="diff-level">
              <Meter level={d.level} low={d.low} size="m" />
              <span>{levelText(d)}</span>
            </p>
            <ul class="measures">
              {d.measures.map((m) => (
                <li class:list={{ set: m === d.by }}>
                  <Meter level={m.level} />
                  <span>
                    {m.id === "sac" ? (
                      <Explain id="sac-info" term="Path grade" title="SAC hiking scale">
                        <p>{SAC_NOTE}</p>
                        {sac && (
                          <p>
                            This trail: <strong>{sac.value}</strong>{sac.how !== "stated" && ` (${sac.how})`}.{sac.basis && ` ${sac.basis}`}
                          </p>
                        )}
                        <ol class="sac-scale">
                          {Object.entries(SAC_SCALE).map(([grade, g]) => (
                            <li class:list={[{ current: grade === sac?.value }]}>
                              <strong>{grade} · {g.name}</strong>
                              <span>{g.text}</span>
                            </li>
                          ))}
                        </ol>
                        <a slot="foot" href="https://www.sac-cas.ch/en/ausbildung-und-sicherheit/tourenplanung/grading-systems/">The scale at the Swiss Alpine Club</a>
                      </Explain>
                    ) : (
                      SCALES[m.id].label
                    )}
                    {m.where && <span class="muted"> · {m.where}</span>}
                  </span>
                  <span class="v">
                    {m.estimate && <span class="approx" aria-hidden="true">≈ </span>}
                    {m.estimate && <span class="sr-only">estimated </span>}
                    {m.text}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="note muted">Our rating from this page's figures: the stages, OpenStreetMap, the terrain model and 30 years of ERA5 weather.</p>
    </section>
  )}

  {climate && tRange && (
    <section id="climate">
      <h2>Climate</h2>
      <dl class="strip spec cols" style="--cols: 4">
        <div>
          <dt>Days {seasonMonths.length ? "in season" : ""} · lowest point</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.low.tmax), "")}</span><span class="unit">°C</span></dd>
        </div>
        <div>
          <dt>Nights {seasonMonths.length ? "in season" : ""} · highest point</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.high.tmin), "")}</span><span class="unit">°C</span></dd>
        </div>
        <div>
          <dt>Wet days a month</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.high.wetDays), "")}</span></dd>
        </div>
        <div>
          <dt>Daylight</dt>
          <dd><span class="big">{between(inSeason.map((m) => m.daylightH), "", 1)}</span><span class="unit">h</span></dd>
        </div>
      </dl>

      <figure class="chart climate" data-months={JSON.stringify(climate.months)}>
        <ul class="legend" aria-hidden="true">
          <li><span class="swatch-key" style="--c: var(--clim-low)"></span>Lowest point</li>
          <li><span class="swatch-key" style="--c: var(--clim-high)"></span>Highest point</li>
          <li><span class="swatch-key" style="--c: var(--wet)"></span>Wet days</li>
          <li><span class="swatch-key" style="--c: var(--snow)"></span>of which snow</li>
          {seasonRuns.length > 0 && <li><span class="swatch-key season-key"></span>Season</li>}
        </ul>
        <div class="chart-scroll">
        <svg
          viewBox={`0 0 ${CHART.width} ${CLIM.height}`}
          role="img"
          aria-label={`Climate by month, ${climate.years[0]}–${climate.years[1]} average: day highs and night lows at the lowest and highest point, wet days, and daylight. A table follows.`}
        >
          {seasonRuns.map((run) => (
            <g>
              <rect class="season" x={colX(run[0])} y="0" width={colW * run.length} height={CLIM.months + 6} rx="6" />
              <text class="season-label" x={colX(run[0]) + (colW * run.length) / 2} y="16" text-anchor="middle">Season</text>
            </g>
          ))}

          <text class="panel-label" x="8" y={CLIM.tTop - 12}>Day high and night low</text>
          {tempGrid.map((c) => (
            <g>
              <line class={c === 0 ? "zero" : "grid"} x1={CLIM.x0} x2={CLIM.x1} y1={yTemp(c)} y2={yTemp(c)} />
              <text class="grid-label" x={CLIM.x0 - 8} y={yTemp(c) + 4} text-anchor="end">{signed(c)} °C</text>
            </g>
          ))}
          {climate.months.map((m) => (
            <g>
              <rect class="temp low" x={colX(m.month) + colW / 2 - 13} y={yTemp(m.low.tmax)} width="11" height={yTemp(m.low.tmin) - yTemp(m.low.tmax)} rx="4" />
              <rect class="temp high" x={colX(m.month) + colW / 2 + 2} y={yTemp(m.high.tmax)} width="11" height={yTemp(m.high.tmin) - yTemp(m.high.tmax)} rx="4" />
            </g>
          ))}

          <text class="panel-label" x="8" y={CLIM.wTop - 12}>Wet days, at the highest point</text>
          {Array.from({ length: wetMax / 5 + 1 }, (_, i) => i * 5).map((d) => (
            <g>
              <line class={d === 0 ? "base" : "grid"} x1={CLIM.x0} x2={CLIM.x1} y1={yWet(d)} y2={yWet(d)} />
              {d > 0 && <text class="grid-label" x={CLIM.x0 - 8} y={yWet(d) + 4} text-anchor="end">{d}</text>}
            </g>
          ))}
          {climate.months.map((m) => (
            <g>
              <rect class="wet" x={colX(m.month) + colW / 2 - 12} y={yWet(m.high.wetDays)} width="24" height={Math.max(yWet(m.high.snowDays) - yWet(m.high.wetDays) - (m.high.snowDays >= 0.5 ? 2 : 0), 0)} rx="3" />
              {m.high.snowDays >= 0.5 && (
                <rect class="snow" x={colX(m.month) + colW / 2 - 12} y={yWet(m.high.snowDays)} width="24" height={CLIM.wBottom - yWet(m.high.snowDays)} />
              )}
            </g>
          ))}

          <text class="panel-label" x="8" y={CLIM.dTop - 12}>Daylight</text>
          {climate.months.map((m) => (
            <g>
              <rect class="day-track" x={colX(m.month) + 8} y={CLIM.dTop + 8} width={colW - 16} height="8" rx="4" />
              <rect class="day-fill" x={colX(m.month) + colW / 2 - ((colW - 16) * m.daylightH) / 48} y={CLIM.dTop + 8} width={((colW - 16) * m.daylightH) / 24} height="8" rx="4" />
              <text class="day-value" x={colX(m.month) + colW / 2} y={CLIM.dTop + 34} text-anchor="middle">{m.daylightH.toFixed(1)} h</text>
            </g>
          ))}

          {climate.months.map((m) => (
            <g>
              <text class="month" x={colX(m.month) + colW / 2} y={CLIM.months} text-anchor="middle">{MONTHS[m.month - 1]}</text>
              <rect class="col-hit" data-month={m.month} x={colX(m.month)} y="0" width={colW} height={CLIM.height} />
            </g>
          ))}
        </svg>
        </div>
        <div class="tip" role="status" hidden><strong></strong><span></span></div>
        <!-- a table ignores the 1 px width of .sr-only and would widen the page: hide its wrapper, pinned left so
             it doesn't sit beyond the edge after the wide chart -->
        <div class="sr-only" style="top: 0; left: 0">
        <table>
          <caption>Climate by month, {climate.years[0]}–{climate.years[1]} average</caption>
          <thead>
            <tr>
              <th scope="col">Month</th>
              <th scope="col">Lowest point, day high / night low (°C)</th>
              <th scope="col">Highest point, day high / night low (°C)</th>
              <th scope="col">Wet days</th>
              <th scope="col">Snow days</th>
              <th scope="col">Frost nights at the highest point</th>
              <th scope="col">Daylight (h)</th>
            </tr>
          </thead>
          <tbody>
            {climate.months.map((m) => (
              <tr>
                <th scope="row">{MONTH_NAMES[m.month - 1]}</th>
                <td>{m.low.tmax} / {m.low.tmin}</td>
                <td>{m.high.tmax} / {m.high.tmin}</td>
                <td>{m.high.wetDays}</td>
                <td>{m.high.snowDays}</td>
                <td>{m.high.frostNights}</td>
                <td>{m.daylightH}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <figcaption class="muted">
          Averages for {climate.years[0]}–{climate.years[1]} from ERA5 reanalysis via Open-Meteo, adjusted to each point's
          elevation; daylight from sunrise to sunset mid-month.
        </figcaption>
      </figure>
    </section>
  )}

  {t.stages && (
    <section id="stages">
      <h2>Stages</h2>
      <ol class="timeline">
        <li class="stage-head" aria-hidden="true">
          <span></span>
          <div class="stage-body">
            <span></span>
            <ul class="stage-stats">
              <li>Distance</li>
              <li>Ascent</li>
              <li>Descent</li>
              {stageEle && <li class="wide">Elevation</li>}
              {stageTime && <li>Time</li>}
            </ul>
          </div>
        </li>
        {stageView.map((s) => (
          <li class={`stage ${s.kind}`}>
            <span class="stage-no" aria-hidden="true">{s.number}</span>
            <div class="stage-body">
              <p class="stage-route">
                <span class="visually-hidden">Stage {s.number}{s.kind !== "main" && ` (${s.kind})`}: </span>
                {s.from} <span class="arrow" aria-hidden="true">→</span> {s.to}
                {s.kind !== "main" && <span class="stage-kind">{s.kind === "approach" ? "Approach" : "Variant"}</span>}
              </p>
              <ul class="stage-stats">
                <li title="Distance"><span class="visually-hidden">Distance </span>{s.km.toFixed(1)} km</li>
                {s.climb ? (
                  <>
                    <li title={s.climb.est ? "Ascent, from the terrain model" : "Ascent"} class:list={[{ est: s.climb.est }]}>
                      <span class="visually-hidden">{s.climb.est ? "Estimated ascent " : "Ascent "}</span>
                      {s.climb.est && <span aria-hidden="true">≈ </span>}{fmt(s.climb.up)} m ↑
                    </li>
                    <li title={s.climb.est ? "Descent, from the terrain model" : "Descent"} class:list={[{ est: s.climb.est }]}>
                      <span class="visually-hidden">{s.climb.est ? "Estimated descent " : "Descent "}</span>
                      {s.climb.est && <span aria-hidden="true">≈ </span>}{fmt(s.climb.down)} m ↓
                    </li>
                  </>
                ) : (
                  <>
                    <li aria-hidden="true"></li>
                    <li aria-hidden="true"></li>
                  </>
                )}
                {stageEle &&
                  (s.ele ? (
                    <li
                      title={s.ele.est ? "Elevation at start and end, from the terrain model" : "Elevation at start and end"}
                      class:list={["wide", { est: s.ele.est }]}
                    >
                      <span class="visually-hidden">{s.ele.est ? "Estimated elevation " : "Elevation "}</span>
                      {s.ele.est && <span aria-hidden="true">≈ </span>}{fmt(s.ele.from)} → {fmt(s.ele.to)} m
                    </li>
                  ) : (
                    <li class="wide" aria-hidden="true"></li>
                  ))}
                {stageTime &&
                  (s.time ? (
                    <li title={s.time.est ? "Estimated walking time (DIN 33466)" : "Walking time"} class:list={[{ est: s.time.est }]}>
                      <span class="visually-hidden">{s.time.est ? "Estimated walking time " : "Walking time "}</span>
                      {s.time.est && <span aria-hidden="true">≈ </span>}{timeText(s.time.min, s.time.max)}
                    </li>
                  ) : (
                    <li aria-hidden="true"></li>
                  ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <p class="note muted">
        Totals and averages count the main stages only.
        {t.stages.timesSource && ` Walking times from ${sourceShort(t.stages.timesSource)}.`}
        {(estEle || estClimb || estTime) && " ≈ marks our estimates where the source gives no figure: "}
        {(estEle || estClimb) &&
          `${[estClimb && "ascent and descent", estEle && "heights"].filter(Boolean).join(" and ")} from the terrain model (Copernicus DEM, 30 m grid, sampled every 100 m), to the nearest 10 m`}
        {(estEle || estClimb) && estTime && "; "}
        {estTime && "walking times from each stage's distance, ascent and descent by the German hiking standard DIN 33466 (4 km/h, 300 m/h up, 500 m/h down), without breaks"}
        {(estEle || estClimb || estTime) && "."}
      </p>
    </section>
  )}

  {elevation && grad && eleRange && (
    <section id="terrain" class="terrain" data-view="steep">
      <h2>Terrain</h2>
      <!-- the key figures of both views share one grid cell, so toggling moves nothing -->
      <div class="terrain-figs">
        <dl class="strip terrain-row view-steep">
          <div>
            <dt>Highest point</dt>
            <dd><span class="big">{fmt(elevation.highest.m)}</span><span class="unit">m</span></dd>
          </div>
          <div>
            <dt>Lowest point</dt>
            <dd><span class="big">{fmt(elevation.lowest.m)}</span><span class="unit">m</span></dd>
          </div>
          <div>
            <dt>
              <Explain id="grade-info" term="Steepest climb" title="Gradient">
                <p>
                  The steepest 500 m of the trail in walking direction, uphill and downhill. On this trail the steepest
                  climb is {grad.climb.grade}{"\u00a0"}% ({degrees(grad.climb.grade)}°, {grad.climb.changeM} m up over 500 m) on
                  stage {grad.climb.stage}, the steepest descent {signed(grad.descent.grade)}{"\u00a0"}% ({degrees(grad.descent.grade)}°,{" "}
                  {Math.abs(grad.descent.changeM)} m down) on stage {grad.descent.stage}.
                </p>
                <p>
                  A gradient is height per distance: 20 % means 20 m up for every 100 m forward. Percent and degrees don't
                  grow alike: 100 % is 45°, not 90°.
                </p>
                <table>
                  <thead><tr><th>Gradient</th><th>Angle</th><th>Feels like</th></tr></thead>
                  <tbody>
                    <tr><td>10 %</td><td>6°</td><td>Noticeable on a road</td></tr>
                    <tr><td>20 %</td><td>11°</td><td>A steep path, slow going</td></tr>
                    <tr><td>30 %</td><td>17°</td><td>Very steep, often steps</td></tr>
                    <tr><td>100 %</td><td>45°</td><td>Scrambling</td></tr>
                  </tbody>
                </table>
                <p>
                  Averages over 500 m from a 30 m terrain model: short pitches within them, such as steps and ladders, are
                  steeper.
                </p>
              </Explain>
            </dt>
            <dd><span class="big">{grad.climb.grade}</span><span class="unit">%</span></dd>
          </div>
          <div>
            <dt><Explain id="grade-info" term="Steepest descent" shared /></dt>
            <dd><span class="big">{signed(grad.descent.grade)}</span><span class="unit">%</span></dd>
          </div>
          <div>
            <dt>
              <Explain id="steep-info" term={`Steeper than ${STEEP_PERCENT} %`} title="Steep stretches">
                <p>
                  How many kilometres of the main route climb or descend at {STEEP_PERCENT} % or more ({degrees(STEEP_PERCENT)}°,
                  15 m of height per 100 m), measured in 200 m stretches: on this trail {grad.steepUpKm} km up and{" "}
                  {grad.steepDownKm} km down, the darkest parts of the profile. Such stretches are slow going uphill and hard
                  on the knees downhill.
                </p>
              </Explain>
            </dt>
            <dd><span class="big">{Math.round((grad.steepUpKm + grad.steepDownKm) * 10) / 10}</span><span class="unit">km</span></dd>
          </div>
        </dl>
        {surface && (
          <dl class="strip terrain-row view-ground">
            {surfaceRows.map((c) => (
              <div>
                <dt>
                  <span class="swatch-key" style={`--c: var(--surface-${c.id})`} aria-hidden="true"></span>
                  <Explain id={`about-surface-${c.id}`} term={c.label}><p>{c.hint}</p></Explain>
                </dt>
                <dd>
                  <span class="big">{pct(surface.totals[c.id].share)}</span><span class="unit">{surface.totals[c.id].km.toFixed(1)} km</span>
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="terrain-body">
        <!-- a two-way toggle: the knob sits at the end of the view it shows -->
        {surface && (
          <button type="button" class="toggle" role="switch" aria-checked="false" aria-label="Show the surfaces instead of the elevation">
            <span class="track" aria-hidden="true"><span class="knob"></span></span>
            <span class="toggle-labels" aria-hidden="true">
              <span class="toggle-a">Elevation</span>
              <span class="toggle-b">Surfaces</span>
            </span>
          </button>
        )}
        <figure
          class="chart terrain-chart"
          data-points={JSON.stringify(elevation.points)}
          data-bars={JSON.stringify(grad.bars)}
          data-runs={JSON.stringify(surface?.runs ?? [])}
          data-total={elevation.routeKm}
        >
          <div class="chart-scroll">
          <svg
            viewBox={`0 0 ${CHART.width} 222`}
            role="img"
            aria-label={`Elevation along the main route, ${elevation.routeKm} km: highest ${fmt(elevation.highest.m)} m at km ${elevation.highest.km.toFixed(1)}, lowest ${fmt(elevation.lowest.m)} m. Steepest climb ${grad.climb.grade} % on stage ${grad.climb.stage}, steepest descent ${grad.descent.grade} % on stage ${grad.descent.stage}; ${grad.steepUpKm} km climb and ${grad.steepDownKm} km descend at ${STEEP_PERCENT} % or more.${surface ? ` Ground: ${surfaceRows.map((c) => `${c.label.toLowerCase()} ${pct(surface.totals[c.id].share)}`).join(", ")}.` : ""}`}
          >
            {eleGrid.map((m) => (
              <g class="view-steep">
                <line class="grid" x1={CHART.x0} x2={CHART.x1} y1={yAt(m)} y2={yAt(m)} />
                <text class="grid-label" x={CHART.x0 + 2} y={yAt(m) - 4}>{fmt(m)} m</text>
              </g>
            ))}
            {terrainSlices.map((sl) => <polygon class="slice" points={sl.points} style={sl.style} />)}
            <path class="line" d={profileLine} />
            <line class="base" x1={CHART.x0} x2={CHART.x1} y1={TERRAIN.bottom} y2={TERRAIN.bottom} />
            <circle class="peak" cx={xAt(elevation.highest.km, elevation.routeKm)} cy={yAt(elevation.highest.m)} r="4" />
            <text class="peak-label" x={xAt(elevation.highest.km, elevation.routeKm)} y={yAt(elevation.highest.m) - 9} text-anchor="middle">{fmt(elevation.highest.m)} m</text>
            {stageTicks(elevation.stageStarts, elevation.routeKm).map((tk) => (
              <g>
                <line class="tick" x1={tk.x} x2={tk.x} y1={TERRAIN.bottom} y2={TERRAIN.bottom + 8} />
                <text class="tick-label" x={tk.mid} y={TERRAIN.bottom + 22} text-anchor="middle">{tk.label}</text>
              </g>
            ))}
            <line class="tick" x1={CHART.x1} x2={CHART.x1} y1={TERRAIN.bottom} y2={TERRAIN.bottom + 8} />
            <text class="tick-label end" x={CHART.x0} y={TERRAIN.bottom + 40}>0 km</text>
            <text class="tick-label end" x={CHART.x1} y={TERRAIN.bottom + 40} text-anchor="end">{elevation.routeKm} km</text>
            <line class="cursor" x1="0" x2="0" y1={TERRAIN.top - 8} y2={TERRAIN.bottom} visibility="hidden" />
            <circle class="cursor-dot" cx="0" cy="0" r="4.5" visibility="hidden" />
          </svg>
          </div>
          <div class="tip" role="status" hidden><strong></strong><span></span></div>
          <!-- both keys share one grid cell too -->
          <div class="terrain-keys">
            <div class="legend ramp-key view-steep" aria-hidden="true">
              <span>Descent</span>
              <span class="ramp-bar"></span>
              <span>Climb</span>
              <span class="ramp-ticks"><span>−{RAMP_MAX} %</span><span>0</span><span>+{RAMP_MAX} %</span></span>
            </div>
            {surface && (
              <ul class="legend view-ground" aria-hidden="true">
                {surfaceRows.map((c) => <li><span class="swatch-key" style={`--c: var(--surface-${c.id})`}></span>{c.label}</li>)}
              </ul>
            )}
          </div>
          <figcaption class="muted">
            Copernicus terrain model (30 m grid; it measures the treetops in forests), gradients per 200 m in walking
            direction{surface && `; ground from OpenStreetMap, where the ${pct(surface.inferredShare)} without a surface tag take the type of way`}.
          </figcaption>
        </figure>
      </div>
    </section>
  )}

  {landcover && (
    <section id="landscape">
      <h2>Landscape</h2>
      <p class="land-lead">{landSummary} {forestLine}</p>
      <figure class="chart lanes">
        <div class="chart-scroll">
          <svg
            viewBox={`0 0 ${CHART.width} ${landRows.length * 26 + 44}`}
            role="img"
            aria-label={`Landscape along the main route, ${landcover.routeKm} km: ${landSummary}`}
          >
            {landRows.map((g, i) => (
              <g>
                <text class="lane-label" x={CHART.x0} y={i * 26 + 18}>{g.label}</text>
                <line class="lane-track" x1={LANE_X0} x2={LANE_X1} y1={i * 26 + 13} y2={i * 26 + 13} />
                {landcover.runs.filter((r) => r.group === g.id).map((r) => (
                  <rect
                    x={laneX(r.fromKm)}
                    y={i * 26 + 5}
                    width={Math.max(laneX(r.toKm) - laneX(r.fromKm), 0.8)}
                    height="16"
                    rx="2"
                    style={`fill: var(--land-${g.id})`}
                  >
                    <title>{g.label}, km {r.fromKm.toFixed(1)}–{r.toKm.toFixed(1)}</title>
                  </rect>
                ))}
                <text class="lane-share" x={CHART.x1} y={i * 26 + 18} text-anchor="end">{pct(landcover.shares[g.id])}</text>
              </g>
            ))}
            {landcover.stageStarts.map((st, i) => {
              const end = landcover.stageStarts[i + 1]?.km ?? landcover.routeKm;
              const y = landRows.length * 26 + 4;
              return (
                <g>
                  <line class="tick" x1={laneX(st.km)} x2={laneX(st.km)} y1={y} y2={y + 8} />
                  <text class="tick-label" x={(laneX(st.km) + laneX(end)) / 2} y={y + 20} text-anchor="middle">Stage {st.number}</text>
                </g>
              );
            })}
            <text class="tick-label end" x={LANE_X0} y={landRows.length * 26 + 38}>0 km</text>
            <text class="tick-label end" x={LANE_X1} y={landRows.length * 26 + 38} text-anchor="end">{landcover.routeKm} km</text>
          </svg>
        </div>
        <figcaption class="muted">ESA WorldCover (10 m satellite land cover, 2021), every 100 m along the route.</figcaption>
      </figure>
    </section>
  )}

  {(t.sleeping || t.wildCamping) && (
    <section id="sleeping">
      <h2>Sleeping</h2>
      <ul class="strip avail">
        {sleepingRows.map((c) => (
          <li class:list={[{ off: c.status.tone === "none" }]}>
            <p class="avail-name">
              <Explain id={`about-${c.id}`} term={c.label}><p>{c.hint}</p></Explain>
            </p>
            <p class="status">
              <span class={`mark ${c.status.shape} tone-${c.status.tone}`} aria-hidden="true"></span>
              {c.status.word}
            </p>
            {c.detail && <p class="detail">{c.detail}</p>}
          </li>
        ))}
      </ul>
      {t.wildCamping && (
        <p class="aside">
          <span class={`mark ${STATUS[t.wildCamping.status].shape} tone-${STATUS[t.wildCamping.status].tone}`} aria-hidden="true"></span>
          <span><strong>Wild camping is {WILD_CAMPING_LABELS[t.wildCamping.status].toLowerCase()}.</strong> {t.wildCamping.rule}</span>
        </p>
      )}
    </section>
  )}

  {water && waterTotals && waterStatus && (
    <section id="water">
      <h2>Water</h2>
      <dl class="strip spec three">
        <div>
          <dt>
            <Explain id="about-drinking-water" term="Drinking water">
              <p>
                Fountains, taps and springs marked as drinkable in OpenStreetMap, within {water.withinM} m of the trail{
                  waterExtra.length > 0 && `, and the taps the trail's managers list (${waterExtra.join(", ")})`
                }.
              </p>
              <p>The counts include the approach and variant; the chart shows the main route.</p>
            </Explain>
          </dt>
          <dd><span class="big">{waterTotals.drinking}</span><span class="unit">points</span></dd>
        </div>
        <div>
          <dt>
            <Explain id="about-springs" term="Drinkability unknown" title="Springs">
              <p>
                Other springs within {water.withinM} m of the trail. Whether they are drinkable is unknown: treat the water,
                and expect some to run dry in late summer.
              </p>
            </Explain>
          </dt>
          <dd><span class="big">{waterTotals.springs}</span><span class="unit">springs</span></dd>
        </div>
        <div>
          <dt>
            <Explain id="about-dry-stretch" term="Longest dry stretch" title="Water availability">
              <p>
                Rated by the longest stretch of the main route without drinking water: frequent up to 10 km, regular up to 20
                km, scarce beyond. Here: from km {water.longestGapKm.drinking.fromKm} to {water.longestGapKm.drinking.toKm}{gapStages}.
              </p>
            </Explain>
          </dt>
          <dd>
            <span class="big">{water.longestGapKm.drinking.km}</span><span class="unit">km</span>
            <span class="status inline">
              <span class={`mark ${waterStatus.shape} tone-${waterStatus.tone}`} aria-hidden="true"></span>
              {waterStatus.word}
            </span>
          </dd>
        </div>
      </dl>

      {water.stageStarts.length > 0 && (
        <figure class="waterline">
          <ul class="legend" aria-hidden="true">
            <li><svg width="12" height="12"><circle cx="6" cy="6" r="4.5" class="dot drinking" /></svg>Drinking water</li>
            <li><svg width="12" height="12"><circle cx="6" cy="6" r="4" class="dot spring" /></svg>Spring</li>
            <li><span class="swatch"></span>Longest dry stretch</li>
          </ul>
          <div class="chart-scroll">
          <svg viewBox={`0 0 ${CHART.width} 132`} role="img" aria-label={chartSummary}>
            <rect
              class="gap"
              x={xAt(water.longestGapKm.drinking.fromKm)}
              y="28"
              width={xAt(water.longestGapKm.drinking.toKm) - xAt(water.longestGapKm.drinking.fromKm)}
              height={CHART.axis - 28}
              rx="4"
            />
            <text
              class="gap-label"
              x={(xAt(water.longestGapKm.drinking.fromKm) + xAt(water.longestGapKm.drinking.toKm)) / 2}
              y="20"
              text-anchor="middle">{water.longestGapKm.drinking.km} km without</text>
            <line class="route" x1={CHART.x0} x2={CHART.x1} y1={CHART.axis} y2={CHART.axis} />
            {stageTicks(water.stageStarts, water.routeKm).map((tk) => (
              <g>
                <line class="tick" x1={tk.x} x2={tk.x} y1={CHART.axis - 5} y2={CHART.axis + 5} />
                <text class="tick-label" x={tk.mid} y={CHART.axis + 18} text-anchor="middle">{tk.label}</text>
              </g>
            ))}
            <line class="tick" x1={CHART.x1} x2={CHART.x1} y1={CHART.axis - 5} y2={CHART.axis + 5} />
            <text class="tick-label end" x={CHART.x0} y={CHART.axis + 36}>0 km</text>
            <text class="tick-label end" x={CHART.x1} y={CHART.axis + 36} text-anchor="end">{water.routeKm} km</text>
            {onRoute.map((pt) => (
              <g
                class="pt"
                data-tip-title={pt.kind === "drinking" ? "Drinking water" : "Spring"}
                data-tip-text={`${pt.name ? `${pt.name} · ` : ""}km ${pt.km} · stage ${pt.stage}`}
              >
                <circle cx={xAt(pt.km!)} cy={CHART.lanes[pt.kind]} r="10" class="hit" />
                <circle cx={xAt(pt.km!)} cy={CHART.lanes[pt.kind]} r={pt.kind === "drinking" ? 4.5 : 4} class={`dot ${pt.kind}`} />
              </g>
            ))}
          </svg>
          </div>
          <div class="tip" role="status" hidden><strong></strong><span></span></div>
          <figcaption class="muted">
            From OpenStreetMap{waterExtra.length > 0 && ` and ${waterExtra.join(", ")}`}, within {water.withinM} m of the main
            route; may be incomplete.
          </figcaption>
        </figure>
      )}
    </section>
  )}

  <!-- the sources as a footnote: below a short rule, small and muted, not in the navigation -->
  <footer id="sources" class="sources">
    <h2>Sources</h2>
    <ol>
      {t.sources.filter((s) => !s.checkOnly).map((s, i) => (
        <li id={`source-${i + 1}`}>
          <a href={s.url}>{s.title}</a> · {s.licence}
          {!s.retrieved && <span> · not yet verified</span>}
          {s.note && <span> · {s.note}</span>}
        </li>
      ))}
    </ol>
  </footer>
</Base>

<script>
  // On-page navigation: marks the link of the section in view. The section counts as in view
  // once its top passes just below where a link click puts it (its scroll-margin-top); the last
  // one that did wins.
  {
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".onpage a")];
    const sections = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el) => el !== null);
    const bar = document.querySelector<HTMLElement>(".onpage")!;
    let current: HTMLAnchorElement | undefined;
    const update = () => {
      const line = Math.max(bar.getBoundingClientRect().bottom, parseFloat(getComputedStyle(sections[0]).scrollMarginTop)) + 8;
      const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const passed = sections.filter((el) => el.getBoundingClientRect().top <= line);
      const section = atEnd ? sections.at(-1) : passed.at(-1);
      const link = links.find((a) => a.hash === `#${section?.id}`);
      if (link === current) return;
      current?.removeAttribute("aria-current");
      current = link;
      if (!link) return;
      link.setAttribute("aria-current", "location");
      // keep it visible in the row that scrolls sideways on phones, without moving the page
      const row = link.closest("ul")!;
      const { left, right } = link.getBoundingClientRect();
      const box = row.getBoundingClientRect();
      if (left < box.left || right > box.right) row.scrollBy({ left: left < box.left ? left - box.left - 16 : right - box.right + 16 });
    };
    let queued = false;
    addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    }, { passive: true });
    addEventListener("resize", update);
    update();
  }

  // Water chart tooltip: one element per chart, filled from the hovered (or tapped) dot.
  for (const figure of document.querySelectorAll<HTMLElement>(".waterline")) {
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    let active: SVGGElement | null = null;
    const show = (pt: SVGGElement) => {
      active?.classList.remove("active");
      active = pt;
      pt.classList.add("active");
      tip.querySelector("strong")!.textContent = pt.dataset.tipTitle ?? "";
      tip.querySelector("span")!.textContent = pt.dataset.tipText ?? "";
      tip.hidden = false;
      const dot = pt.querySelector(".dot")!.getBoundingClientRect();
      const box = figure.getBoundingClientRect();
      const x = dot.left + dot.width / 2 - box.left;
      const half = tip.offsetWidth / 2;
      tip.style.left = `${Math.min(Math.max(x, half), box.width - half)}px`;
      tip.style.top = `${dot.top - box.top - 8}px`;
    };
    const hide = () => {
      active?.classList.remove("active");
      active = null;
      tip.hidden = true;
    };
    for (const pt of figure.querySelectorAll<SVGGElement>(".pt")) {
      pt.addEventListener("pointerenter", () => show(pt));
      pt.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
      pt.addEventListener("click", (e) => {
        e.stopPropagation();
        show(pt);
      });
    }
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }

  // Terrain: the toggle between elevation and steepness, and the ground; then a crosshair with
  // everything at the pointer's kilometre: height, the 200 m gradient, the ground, the stage.
  for (const section of document.querySelectorAll<HTMLElement>(".terrain")) {
    const toggle = section.querySelector<HTMLButtonElement>(".toggle");
    toggle?.addEventListener("click", () => {
      const ground = toggle.getAttribute("aria-checked") !== "true";
      toggle.setAttribute("aria-checked", String(ground));
      section.dataset.view = ground ? "ground" : "steep";
    });

    const figure = section.querySelector<HTMLElement>(".terrain-chart")!;
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const cursor = figure.querySelector<SVGLineElement>(".cursor")!;
    const dot = figure.querySelector<SVGCircleElement>(".cursor-dot")!;
    const line = figure.querySelector<SVGPathElement>(".line")!;
    const points: [number, number][] = JSON.parse(figure.dataset.points!);
    const bars: { fromKm: number; toKm: number; grade: number; stage: string }[] = JSON.parse(figure.dataset.bars!);
    const runs: { category: string; fromKm: number; toKm: number }[] = JSON.parse(figure.dataset.runs!);
    const total = Number(figure.dataset.total);
    const GROUND: Record<string, string> = { natural: "natural ground", gravel: "gravel", paved: "paved", unknown: "unknown surface" };
    const X0 = 8;
    const X1 = 992;
    const show = (clientX: number) => {
      const box = svg.getBoundingClientRect();
      const vx = Math.min(Math.max(((clientX - box.left) / box.width) * 1000, X0), X1);
      const km = ((vx - X0) / (X1 - X0)) * total;
      const idx = points.reduce((best, p, i) => (Math.abs(p[0] - km) < Math.abs(points[best][0] - km) ? i : best), 0);
      const [pkm, m] = points[idx];
      // y of the plotted point: read it off the path at the same index
      const y = Number(line.getAttribute("d")!.split(/[ML]/).filter(Boolean)[idx].split(",")[1]);
      const bar = bars.find((b) => pkm >= b.fromKm && pkm <= b.toKm);
      const run = runs.find((r) => pkm >= r.fromKm && pkm <= r.toKm);
      cursor.setAttribute("x1", String(vx));
      cursor.setAttribute("x2", String(vx));
      cursor.setAttribute("visibility", "visible");
      dot.setAttribute("cx", String(vx));
      dot.setAttribute("cy", String(y));
      dot.setAttribute("visibility", "visible");
      tip.querySelector("strong")!.textContent = `${m.toLocaleString("en")} m${bar ? ` · ${bar.grade > 0 ? "+" : bar.grade < 0 ? "−" : ""}${Math.abs(Math.round(bar.grade))} %` : ""}`;
      tip.querySelector("span")!.textContent = `km ${pkm.toFixed(1)}${bar ? ` · stage ${bar.stage}` : ""}${run ? ` · ${GROUND[run.category] ?? run.category}` : ""}`;
      tip.hidden = false;
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const px = box.left - fbox.left + (vx / 1000) * box.width;
      tip.style.left = `${Math.min(Math.max(px, half), fbox.width - half)}px`;
      tip.style.top = `${box.top - fbox.top + (y / 222) * box.height - 10}px`;
    };
    const hide = () => {
      tip.hidden = true;
      cursor.setAttribute("visibility", "hidden");
      dot.setAttribute("visibility", "hidden");
    };
    svg.addEventListener("pointermove", (e) => show(e.clientX));
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    svg.addEventListener("click", (e) => {
      e.stopPropagation();
      show(e.clientX);
    });
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }

  // Climate tooltip: everything about the month under the pointer.
  const MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  type Place = { tmax: number; tmin: number; wetDays: number; snowDays: number; frostNights: number };
  for (const figure of document.querySelectorAll<HTMLElement>(".climate")) {
    const svg = figure.querySelector("svg")!;
    const tip = figure.querySelector<HTMLElement>(".tip")!;
    const months: { month: number; low: Place; high: Place; daylightH: number }[] = JSON.parse(figure.dataset.months!);
    // round first, so −0.3 °C reads 0, not −0
    const c = (v: number) => {
      const r = Math.round(v);
      return `${r < 0 ? "−" : ""}${Math.abs(r)}`;
    };
    let active: SVGRectElement | null = null;
    const show = (hit: SVGRectElement) => {
      active?.classList.remove("active");
      active = hit;
      hit.classList.add("active");
      const m = months.find((x) => x.month === Number(hit.dataset.month))!;
      tip.querySelector("strong")!.textContent = MONTH_NAMES[m.month - 1];
      tip.querySelector("span")!.textContent = [
        `Lowest point: ${c(m.low.tmax)} °C by day, ${c(m.low.tmin)} °C at night`,
        `Highest point: ${c(m.high.tmax)} °C by day, ${c(m.high.tmin)} °C at night`,
        `Highest point: ${Math.round(m.high.wetDays)} wet days, ${Math.round(m.high.snowDays)} with snow, ${Math.round(m.high.frostNights)} frost nights`,
        `${m.daylightH.toFixed(1)} h of daylight`,
      ].join("\n");
      tip.hidden = false;
      tip.style.maxWidth = `${figure.getBoundingClientRect().width}px`;
      const box = hit.getBoundingClientRect();
      const fbox = figure.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      tip.style.left = `${Math.min(Math.max(box.left + box.width / 2 - fbox.left, half), fbox.width - half)}px`;
      tip.style.top = `${svg.getBoundingClientRect().top - fbox.top + 24}px`;
    };
    const hide = () => {
      tip.hidden = true;
      active?.classList.remove("active");
      active = null;
    };
    for (const hit of figure.querySelectorAll<SVGRectElement>(".col-hit")) {
      hit.addEventListener("pointerenter", () => show(hit));
      hit.addEventListener("click", (e) => {
        e.stopPropagation();
        show(hit);
      });
    }
    svg.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    document.addEventListener("click", hide);
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* title and local name get room above and below, set apart from breadcrumbs and navigation */
  h1 {
    margin: 32px 0 10px;
    text-align: center;
  }
  .subtitle {
    margin: 0 0 16px;
    font-style: italic;
    text-align: center;
  }
  .site-link {
    display: block;
    margin-top: 2px;
    font-size: 0.8rem;
  }

  .onpage {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 16px -16px 0;
    padding: 0 16px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .onpage ul {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  /* the underline's space is reserved by a transparent border, so marking a link shifts nothing */
  .onpage a {
    display: block;
    padding: 12px 0 10px;
    border-bottom: 2px solid transparent;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  /* centred with auto margins rather than justify-content: when the links overflow on a phone,
     the row still scrolls from its first link instead of cutting it off on the left */
  .onpage li:first-child {
    margin-left: auto;
  }
  .onpage li:last-child {
    margin-right: auto;
  }
  .onpage a:hover,
  .onpage a:focus-visible {
    border-bottom-color: var(--muted);
  }
  /* the section in view, set by the script below */
  .onpage a[aria-current] {
    border-bottom-color: var(--accent);
  }

  section {
    margin-top: 36px;
    scroll-margin-top: 64px;
  }
  /* wide screens: section headings move into a margin column, like a printed guidebook, and
     every section's content starts at the same indent beside its title. Separates the sections
     and saves the heading rows. From 1080 px only: the content column stays at least 820 px wide,
     which the one-line stage timeline and the five sleeping columns need. Key figures and the
     map (hidden headings) keep the full width. */
  @media (min-width: 1080px) {
    section:has(> h2:not(.visually-hidden)) {
      display: flow-root;
    }
    section > h2:not(.visually-hidden) {
      float: left;
      width: 136px;
      margin: 0;
      padding-top: 10px;
      font-size: 1.15rem;
      line-height: 1.25;
    }
    section:has(> h2:not(.visually-hidden)) > :global(:not(h2)) {
      margin-left: 160px;
    }
  }
  .key {
    margin-top: 20px;
  }
  /* desktop: every card in one row, however many the trail has */
  @media (min-width: 900px) {
    .figures {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      grid-template-columns: none;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts dd {
      margin-bottom: 8px;
    }
  }
  .note {
    font-size: 0.8rem;
  }
  /* desktop: each section's cards in one row, headlines on one line */
  @media (min-width: 900px) {
    .cards {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      grid-template-columns: none;
    }
    .card-name > span {
      white-space: nowrap;
    }
  }
  /* icons sit on the first line of their label, however many lines it wraps to */
  .figures dt :global(.icon) {
    flex: none;
    margin-top: 1px;
  }
  .hubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hubs li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .hub-kind {
    flex: none;
    display: grid;
    place-items: center;
    height: 1.5em;
    color: var(--muted);
    align-self: flex-start;
  }
  .hubs li {
    align-items: flex-start;
  }
  .hub-dist {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .hubs li:last-child {
    margin-bottom: 0;
  }
  /* stages: a timeline, numbered dots on a line; figures in fixed columns so they compare */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
    padding-top: 12px;
  }
  /* column header: only where the figures line up in columns; elsewhere units and arrows carry it */
  .stage-head {
    display: none;
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
    padding-bottom: 10px;
  }
  .stage::before {
    content: "";
    position: absolute;
    top: 32px;
    bottom: 0;
    left: 15px;
    border-left: 2px solid var(--line);
  }
  .stage:last-child::before {
    display: none;
  }
  .stage-no {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .stage.approach .stage-no,
  .stage.variant .stage-no {
    border: 2px dashed var(--accent);
    background: var(--bg);
    color: var(--accent);
  }
  .stage-body {
    padding-top: 4px;
  }
  .stage-route {
    margin: 0;
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .stage.approach .stage-route,
  .stage.variant .stage-route {
    color: var(--muted);
  }
  .arrow {
    color: var(--muted);
    font-weight: 400;
  }
  .stage-kind {
    display: inline-block;
    margin-left: 8px;
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font: 500 0.7rem/1.7 var(--sans);
    vertical-align: 2px;
  }
  .stage-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  /* rem, not em: the column header is set smaller than the figures and must line up with them */
  .stage-stats li {
    min-width: 5.2rem;
  }
  .stage-stats li.wide {
    min-width: 7.4rem;
  }
  .stage-stats li.est {
    color: var(--muted);
  }
  @media (min-width: 820px) {
    .stage-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 24px;
      align-items: baseline;
      padding-top: 6px;
    }
    .stage-stats {
      flex-wrap: nowrap;
      margin: 0;
      font-size: 0.85rem;
    }
    .stage-head {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: 14px;
      padding-bottom: 6px;
      color: var(--muted);
      font-size: 0.75rem;
    }
    .stage-head .stage-stats {
      font-size: inherit;
    }
    .stage-head .stage-body {
      padding-top: 0;
    }
  }
  /* location: one grid of label-over-value items, so rows align whatever the content */
  .loc {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    border-top: 1px solid var(--text);
  }
  @media (min-width: 820px) {
    .loc {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .loc > div {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .loc > .wide {
    grid-column: span 2;
  }
  .loc dt {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .loc dd {
    margin: 2px 0 0;
    line-height: 1.45;
  }
  /* waymarking with its mark redrawn small, first line beside the mark */
  .loc dd.marked {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .loc dd.marked :global(.waymark) {
    margin-top: 3px;
  }
  /* difficulty key figure: one bar per dimension (initial beneath), as tall as its level; the
     hardest level as a word beside it. As tall as the big numbers, so the labels line up */
  .diff-fig {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }
  .diff-bars {
    display: flex;
    gap: 3px;
    height: 2rem;
    padding-bottom: 0.15rem;
  }
  .diff-col {
    position: relative;
    width: 9px;
    height: calc(100% - 11px);
    background: var(--line);
    border-radius: 2px 2px 0 0;
  }
  .diff-bar {
    position: absolute;
    inset: auto 0 0;
    background: var(--text);
    border-radius: 2px 2px 0 0;
  }
  .diff-bar.range {
    opacity: 0.4;
  }
  .diff-tag {
    position: absolute;
    inset: auto 0 -12px;
    font-size: 0.6rem;
    line-height: 1;
    text-align: center;
    color: var(--muted);
  }
  .diff-pop {
    display: grid;
    gap: 8px;
    margin: 10px 0;
    padding: 0;
    list-style: none;
  }
  .diff-pop li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 10px;
  }
  .diff-pop li > :global(.meter) {
    grid-row: span 2;
    margin-top: 0.35em;
  }
  .diff-pop span {
    color: var(--muted);
  }

  /* difficulty section: one card per dimension in a strip; its level, then every measure, the one
     that set the level in bold */
  .diff-cards {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .diff-cards {
      grid-template-columns: repeat(var(--cols), 1fr);
    }
  }
  @media (max-width: 639px) {
    .diff-fig .big {
      font-size: 1.25rem;
    }
    .strip.diff-cards > * + * {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  .diff-cards p {
    margin: 0;
  }
  .diff-label {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .diff-level {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 10px !important;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .measures {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
  }
  .measures li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px;
    align-items: baseline;
    color: var(--muted);
  }
  .measures li.set {
    color: var(--text);
    font-weight: 600;
  }
  .measures li .muted {
    font-weight: 400;
  }
  .measures .v {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* a measure's four bands in its popover, the trail's band marked */
  .bands p {
    margin: 10px 0 4px;
  }
  .bands ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85em;
  }
  .bands li {
    padding: 4px 6px;
    border-radius: 6px;
    color: var(--muted);
  }
  .bands li span {
    display: block;
    color: var(--text);
    font-weight: 600;
  }
  .bands li.current {
    background: var(--accent-soft);
    color: var(--text);
  }
  .sac-scale {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  .sac-scale {
    margin-bottom: 0;
  }
  .sac-scale li {
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--muted);
  }
  .sac-scale li.current {
    background: var(--accent-soft);
    color: var(--text);
  }
  .sac-scale strong {
    display: block;
    color: var(--text);
  }
  .sources {
    margin-top: 72px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
    scroll-margin-top: 64px;
  }
  /* a short rule, like a printed footnote's */
  .sources::before {
    content: "";
    display: block;
    width: 120px;
    margin-bottom: 12px;
    border-top: 1px solid var(--line);
  }
  .sources h2 {
    margin: 0 0 6px;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sources ol {
    margin: 0;
    padding-left: 1.6em;
  }
  .sources li {
    margin-bottom: 2px;
  }
  .sources a {
    color: inherit;
  }
  .sources li:target {
    color: var(--text);
    background: var(--accent-soft);
  }

  /* strips: the shared language of key figures, sleeping and water. A rule on top,
     hairlines between items, no filled boxes; numbers first, labels small beneath. */
  .strip {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--line);
  }
  .strip > * {
    padding: 14px 16px 14px 0;
  }
  .strip > * + * {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }

  /* key figures and water figures: 2 columns on phones, 4 on tablets, one row on desktop (key
     figures stay in rows of four: .key-figs) */
  .spec {
    grid-template-columns: repeat(2, 1fr);
  }
  .spec.three {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (min-width: 640px) {
    .spec {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 980px) {
    .spec {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: auto;
    }
    .spec.three {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row;
    }
  }
  @media (max-width: 979px) {
    .spec:not(.three) > :nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 639px) {
    .spec:not(.three) > :nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .spec:not(.three) > :nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  /* key figures: two rows of four from 640 px (eight don't fit in one row), a hairline between */
  @media (min-width: 640px) {
    .spec.key-figs {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-flow: row;
    }
    .spec.key-figs > :nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .spec.key-figs > :nth-child(n + 5) {
      border-top: 1px solid var(--line);
    }
  }
  /* landscape key figure: the main landscape in words over a bar of every group's share; as tall
     as the big numbers beside it */
  .land-fig {
    display: grid;
    align-content: end;
    gap: 6px;
    min-height: 1.95rem;
    font-size: 0.9rem;
  }
  .land-fig b {
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  .land-bar {
    display: flex;
    gap: 2px;
    width: 9rem;
    max-width: 100%;
    height: 10px;
  }
  .land-bar span {
    min-width: 3px;
    border-radius: 2px;
    background: var(--c);
  }
  .land-pop {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .land-pop .swatch-key {
    display: inline-block;
  }
  /* label first in the markup (dt before dd), value first on screen */
  .spec div {
    display: flex;
    flex-direction: column;
  }
  .spec dd {
    order: 1;
  }
  .spec dt {
    order: 2;
  }
  .spec dd {
    margin: 0;
    white-space: nowrap;
  }
  .big {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.15;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .word {
    display: block;
    padding-top: 6px;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: normal;
  }
  /* "≈" before an estimated key figure */
  .unit.approx {
    margin: 0 3px 0 0;
  }
  .unit {
    margin-left: 4px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .spec dt {
    display: flex;
    align-items: center;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* season key figure: twelve month cells in two rows, season months filled (as on the search cards) */
  /* two 14 px rows: as tall as the big numbers beside it, so the labels beneath line up */
  .season-grid {
    display: grid;
    grid-template-columns: repeat(6, 1.25rem);
    grid-auto-rows: 14px;
    gap: 3px;
  }
  .season-grid .month {
    border-radius: 3px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 600;
    line-height: 14px;
    text-align: center;
  }
  .season-grid .month.in {
    background: color-mix(in srgb, var(--text) 72%, var(--bg));
    color: var(--bg);
  }

  /* sleeping: availability per category */
  .avail {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .avail {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  /* phones: wild camping across the top, the four kinds of beds in two columns beneath */
  @media (max-width: 639px) {
    .avail {
      grid-template-columns: repeat(2, 1fr);
    }
    .avail > :first-child {
      grid-column: 1 / -1;
    }
    .avail > * + * {
      border-top: 1px solid var(--line);
    }
    .avail > :nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
    .avail > :nth-child(odd):not(:first-child) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  .avail p {
    margin: 0;
  }
  .avail-name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px !important;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .status.inline {
    display: inline-flex;
    margin: 0 0 0 10px !important;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 500;
    vertical-align: 4px;
  }
  .detail {
    margin-top: 2px !important;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .off .status {
    color: var(--muted);
    font-weight: 400;
  }

  /* status marks: the shape carries the meaning (full, half, crossed, empty), colour supports it */
  .mark {
    flex: none;
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 2px solid var(--mark);
    border-radius: 50%;
  }
  .tone-good {
    --mark: var(--good);
  }
  .tone-fair {
    --mark: var(--fair);
  }
  .tone-poor {
    --mark: var(--poor);
  }
  .tone-none {
    --mark: var(--muted);
  }
  .mark.full {
    background: var(--mark);
  }
  .mark.half {
    background: linear-gradient(90deg, var(--mark) 50%, transparent 50%);
  }
  .mark.blocked {
    background: linear-gradient(135deg, transparent 43%, var(--mark) 43%, var(--mark) 57%, transparent 57%);
  }
  .aside {
    display: flex;
    gap: 10px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .aside .mark {
    margin-top: 4px;
  }
  .aside strong {
    color: var(--text);
    font-weight: 600;
  }

  /* water along the route: a strip chart on the map line's kilometres */
  .waterline {
    margin: 20px 0 0;
  }
  .run {
    shape-rendering: crispEdges;
  }
  .cursor {
    stroke: var(--text);
    stroke-width: 1.5;
  }
  /* equal columns from 640 px; phones keep the strips' two columns (four would overflow) */
  @media (min-width: 640px) {
    .spec.cols {
      grid-template-columns: repeat(var(--cols), 1fr) !important;
      grid-auto-flow: row !important;
    }
    .spec.cols > * {
      padding-left: 16px !important;
      border-left: 1px solid var(--line) !important;
    }
    .spec.cols > :first-child {
      padding-left: 0 !important;
      border-left: 0 !important;
    }
  }
  /* landscape: the summary as a lead sentence, then one lane per group along the route */
  .land-lead {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.45;
  }
  .lanes {
    margin: 4px 0 0;
  }
  /* 15 units in a 1000-unit chart: about 13 px at the content column's width */
  .lanes .lane-label {
    fill: var(--text);
    font: 15px var(--sans);
  }
  .lanes .lane-share {
    fill: var(--muted);
    font: 15px var(--sans);
  }
  .lanes .lane-track {
    stroke: var(--line);
    stroke-width: 1;
  }
  /* colour key in the surface figures (not .key: that is the key figures section) */
  .swatch-key {
    flex: none;
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 2px;
    background: var(--c);
  }
  .waterline svg[role="img"] {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0 0 4px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .swatch {
    width: 16px;
    height: 10px;
    border-radius: 2px;
    background: var(--fair-soft);
    outline: 1px solid var(--fair);
  }
  .dot {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .dot.drinking {
    fill: var(--water);
  }
  .dot.spring {
    fill: var(--bg);
    stroke: var(--water);
  }
  .hit {
    fill: transparent;
    cursor: help;
  }
  .dot {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.12s ease;
  }
  .pt:hover .dot,
  .pt.active .dot {
    transform: scale(1.5);
  }
  .waterline,
  .terrain-chart {
    position: relative;
  }
  /* terrain: the key figures and the keys of both views share one grid cell each, so the toggle
     moves nothing; from 1080 px the toggle sits in the margin column left of the chart */
  .terrain {
    --terrain-tint: color-mix(in srgb, var(--accent) 18%, var(--bg));
  }
  .terrain-figs,
  .terrain-keys {
    display: grid;
  }
  .terrain-figs > *,
  .terrain-keys > * {
    grid-area: 1 / 1;
    align-self: start;
  }
  .terrain[data-view="steep"] .view-ground,
  .terrain[data-view="ground"] :is(.terrain-figs, .terrain-keys) > .view-steep {
    visibility: hidden;
  }
  .terrain[data-view="ground"] svg .view-steep {
    display: none;
  }
  /* key figures in one row: five columns from 640 px (ground uses the first three or four) */
  .terrain-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 640px) {
    .terrain-row {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .terrain-row > :nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }
  .terrain-row div {
    display: flex;
    flex-direction: column;
  }
  .terrain-row dd {
    order: 1;
    margin: 0;
    white-space: nowrap;
  }
  .terrain-row dt {
    display: flex;
    align-items: center;
    order: 2;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .terrain-body {
    position: relative;
  }
  .terrain-chart {
    margin: 16px 0 0;
  }
  .terrain-chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    cursor: crosshair;
  }
  /* the profile: 200 m slices filled by gradient (--g) or ground (--s); an edge in their own colour
     closes the hairline seams between them */
  .slice {
    fill: var(--g);
    stroke: var(--g);
    stroke-width: 0.8;
  }
  .terrain[data-view="ground"] .slice {
    fill: var(--s);
    stroke: var(--s);
  }
  .terrain-chart .line {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .terrain-chart .grid {
    stroke: var(--line);
