---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrailMap from "../../components/TrailMap.svelte";
import Ref from "../../components/Ref.astro";
import { existsSync } from "node:fs";
import {
  countryName,
  monthName,
  perDay,
  sacGrade,
  stageTotals,
  SLEEPING_LABELS,
  WILD_CAMPING_LABELS,
} from "../../lib/trails";

export async function getStaticPaths() {
  const trails = await getCollection("trails");
  return trails.map((trail) => ({ params: { slug: trail.id }, props: { trail } }));
}

const { trail } = Astro.props as { trail: CollectionEntry<"trails"> };
const t = trail.data;
const derived = (await getEntry("derived", trail.id))?.data;
const water = derived?.water;
const sources = Object.fromEntries(t.sources.map((s, i) => [s.id, { ...s, n: i + 1 }]));
const ref = (id: string) => sources[id]?.n; // footnote number of a source
const totals = stageTotals(t);
// one length: the sum of the main stages where there are stages, else the first stated total
const length = totals
  ? { ...totals.km, approx: false }
  : t.length[0]
    ? { value: t.length[0].km, source: t.length[0].source, how: "stated total", approx: t.length[0].approx }
    : null;
const daily = perDay(t);
const sac = sacGrade(t);
const fmt = (n: number) => n.toLocaleString("en");
const hours = (min: number) => `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, "0")}`;
const range = (min: number, max: number) => (min === max ? `${min}` : `${min}–${max}`);
// the map line, built by pipeline/routes.py; without it the map shows only the termini
const routeFile = `routes/${trail.id}.geojson`;
const routeUrl = t.route && existsSync(`public/${routeFile}`) ? `/${routeFile}` : null;
// attribution names the route's source: its title up to the first colon
const routeAttribution = routeUrl && t.route ? sources[t.route.source].title.split(":")[0] : null;

const waterTotals = water && {
  drinking: water.points.filter((p) => p.kind === "drinking").length,
  springs: water.points.filter((p) => p.kind === "spring").length,
};
// the stage(s) of the longest dry stretch, from the water points at either end of it
const gapStages = (() => {
  if (!water) return "";
  const g = water.longestGapKm.drinking;
  const at = (km: number) => water.points.find((p) => p.km !== null && Math.abs(p.km - km) < 0.05)?.stage;
  const [a, b] = [at(g.fromKm), at(g.toKm)];
  return a && b ? (a === b ? ` (stage ${a})` : ` (stages ${a}–${b})`) : "";
})();

// on-page navigation: only sections this trail has
const nav = [
  { id: "figures", label: "Key figures", show: true },
  { id: "map", label: "Map", show: true },
  { id: "where", label: "Where", show: true },
  { id: "sleeping", label: "Sleeping", show: Boolean(t.sleeping || t.wildCamping) },
  { id: "water", label: "Water", show: Boolean(water) },
  { id: "stages", label: "Stages", show: Boolean(t.stages) },
  { id: "sources", label: "Sources", show: true },
].filter((n) => n.show);
---

<Base
  title={`${t.name} · huckepack`}
  description={`${t.name}${t.localName ? ` (${t.localName})` : ""}: stages, length, ascent, difficulty, where to sleep, water and a map.`}
  section="trails"
>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/trails/">Trails</a> / {t.countries.map(countryName).join(", ")}</nav>
  <h1>
    {t.name}
    {t.status === "draft" && <span class="badge">draft</span>}
  </h1>
  <p class="subtitle muted">
    {t.localName && <span>{t.localName} · </span>}
    <a href={t.website}>Official website</a>
  </p>

  <nav class="onpage" aria-label="On this page">
    <ul>
      {nav.map((n) => (
        <li>
          <a href={`#${n.id}`}>{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <section id="figures" class="key">
    <h2 class="visually-hidden">Key figures</h2>
    <dl class="figures">
      {length && (
        <div>
          <dt>Length</dt>
          <dd>
            {length.approx && "about "}
            {fmt(length.value)} km<Ref n={ref(length.source)} />
            <small>{length.how}</small>
          </dd>
        </div>
      )}
      {totals && (
        <div>
          <dt>Total ascent</dt>
          <dd>
            {fmt(totals.ascentM.value)} m<Ref n={ref(totals.ascentM.source)} />
            <small>descent {fmt(totals.descentM.value)} m</small>
          </dd>
        </div>
      )}
      {sac && (
        <div>
          <dt>Difficulty</dt>
          <dd>
            SAC {sac.value}<Ref n={ref(sac.source)} />
            {t.difficulty?.cai && sac.how !== "stated" && <small>converted from CAI {t.difficulty.cai.grade}</small>}
            {t.difficulty?.cai && sac.how === "stated" && <small>CAI {t.difficulty.cai.grade}</small>}
          </dd>
        </div>
      )}
      {t.days && (
        <div>
          <dt>Suggested days</dt>
          <dd>
            {range(t.days.min, t.days.max)} days<Ref n={ref(t.days.source)} />
          </dd>
        </div>
      )}
      {daily && (
        <div>
          <dt>Per day</dt>
          <dd>
            {daily.km.value} km · {fmt(daily.ascentM.value)} m<Ref n={ref(daily.km.source)} />
            <small>average distance and ascent</small>
          </dd>
        </div>
      )}
      {t.season && (
        <div>
          <dt>Season</dt>
          <dd>
            {t.season.text ?? t.season.months.map(monthName).join(", ")}<Ref n={ref(t.season.source)} />
            {t.season.text && <small>{t.season.months.map(monthName).join(", ")}</small>}
          </dd>
        </div>
      )}
    </dl>
  </section>

  <section id="map">
    <h2 class="visually-hidden">Map</h2>
    <TrailMap
      client:visible
      routeUrl={routeUrl}
      start={t.termini.start}
      end={t.termini.end}
      routeAttribution={routeAttribution}
      water={water?.points.map((p) => ({ lat: p.lat, lon: p.lon, kind: p.kind })) ?? []}
    />
  </section>

  <section id="where">
    <h2>Where</h2>
    <dl class="facts">
      <dt>Country</dt>
      <dd>{t.countries.map(countryName).join(", ")} · {t.continents.join(", ")}</dd>
      {t.regions.length > 0 && (
        <>
          <dt>Regions</dt>
          <dd>{t.regions.join(", ")}</dd>
        </>
      )}
      {t.protectedAreas.length > 0 && (
        <>
          <dt>Protected areas</dt>
          <dd>{t.protectedAreas.join("; ")}</dd>
        </>
      )}
      <dt>From</dt>
      <dd>{t.termini.start.name}<Ref n={ref(t.termini.source)} /></dd>
      <dt>To</dt>
      <dd>{t.termini.end.name}</dd>
      <dt>Type</dt>
      <dd>{t.trailType}</dd>
      <dt>Managed by</dt>
      <dd>{t.managedBy.map((m) => m.name).join(", ")}</dd>
      {t.waymarking && (
        <>
          <dt>Waymarking</dt>
          <dd>{t.waymarking.text}<Ref n={ref(t.waymarking.source)} /></dd>
        </>
      )}
    </dl>
  </section>

  {(t.sleeping || t.wildCamping) && (
    <section id="sleeping">
      <h2>Sleeping</h2>
      <dl class="facts">
        {t.sleeping && (
          <>
            <dt>Along the trail</dt>
            <dd>
              {t.sleeping.types.map((s) => SLEEPING_LABELS[s]).join(", ")}<Ref n={ref(t.sleeping.source)} />
            </dd>
          </>
        )}
        {t.wildCamping && (
          <>
            <dt>Wild camping</dt>
            <dd>
              <strong>{WILD_CAMPING_LABELS[t.wildCamping.status]}.</strong> {t.wildCamping.rule}<Ref n={ref(t.wildCamping.source)} />
            </dd>
          </>
        )}
      </dl>
    </section>
  )}

  {water && waterTotals && (
    <section id="water">
      <h2>Water</h2>
      <dl class="facts">
        <dt>Drinking water</dt>
        <dd>
          {waterTotals.drinking} points within {water.withinM} m of the trail<Ref n={ref(water.source)} />
        </dd>
        <dt>Springs</dt>
        <dd>
          {waterTotals.springs} more, drinkability unknown<Ref n={ref(water.source)} />
        </dd>
        <dt>Longest stretch</dt>
        <dd>
          <strong>{water.longestGapKm.drinking.km} km</strong> without drinking water,{" "}
          {`from km ${water.longestGapKm.drinking.fromKm} to ${water.longestGapKm.drinking.toKm}${gapStages}`}<Ref n={ref(water.source)} />
          {water.longestGapKm.any.km < water.longestGapKm.drinking.km && (
            <span class="muted"> · {water.longestGapKm.any.km} km counting springs</span>
          )}
        </dd>
      </dl>
      <div class="scroll">
        <table class="compact">
          <thead>
            <tr>
              <th>Stage</th>
              <th class="num">Drinking water</th>
              <th class="num">Springs</th>
            </tr>
          </thead>
          <tbody>
            {water.stages.map((s) => (
              <tr class={s.kind}>
                <td>
                  {s.number}
                  {s.kind !== "main" && <small> {s.kind}</small>}
                </td>
                <td class="num">{s.drinking}</td>
                <td class="num">{s.springs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note muted">
        From OpenStreetMap, which may miss sources or list ones that have gone. Kilometres are measured along the map
        line ({water.routeKm} km for the main stages). Springs can run dry in late summer; treat water from springs and
        streams.
      </p>
    </section>
  )}

  {t.stages && (
    <section id="stages">
      <h2>Stages<Ref n={ref(t.stages.source)} /></h2>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Stage</th>
              <th>Route</th>
              <th class="num">km</th>
              <th class="num">Ascent</th>
              <th class="num">Descent</th>
              <th class="num">Time</th>
              <th class="num">Start → end</th>
            </tr>
          </thead>
          <tbody>
            {t.stages.list.map((s) => (
              <tr class={s.kind}>
                <td>
                  {s.number}
                  {s.kind !== "main" && <small> {s.kind}</small>}
                </td>
                <td>
                  {s.from} – {s.to}
                </td>
                <td class="num">{s.km.toFixed(1)}</td>
                <td class="num">{fmt(s.ascentM)} m</td>
                <td class="num">{fmt(s.descentM)} m</td>
                <td class="num">{s.minutes ? hours(s.minutes) : "–"}</td>
                <td class="num">
                  {s.startEleM !== undefined && s.endEleM !== undefined
                    ? `${fmt(s.startEleM)} → ${fmt(s.endEleM)} m`
                    : "–"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note muted">Totals and averages use the main stages only, not the approach or variants.</p>
    </section>
  )}

  <section id="sources" class="sources">
    <h2>Sources</h2>
    <ol>
      {t.sources.map((s, i) => (
        <li id={`source-${i + 1}`}>
          <a href={s.url}>{s.title}</a> · {s.licence} ·{" "}
          {s.retrieved ? `retrieved ${s.retrieved.toISOString().slice(0, 10)}` : "not yet verified"}
          {s.note && <span> · {s.note}</span>}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .crumbs {
    margin-top: 32px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted);
  }
  h1 {
    margin-top: 8px;
  }
  .subtitle {
    margin: 0;
  }

  .onpage {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 24px -16px 0;
    padding: 0 16px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .onpage ul {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .onpage a {
    display: block;
    padding: 12px 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .onpage a:hover {
    color: var(--text);
  }

  section {
    margin-top: 48px;
    scroll-margin-top: 64px;
  }
  .key {
    margin-top: 32px;
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    margin: 0;
  }
  .figures div {
    padding: 16px;
    border-radius: 12px;
    background: var(--surface);
  }
  .figures dt {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .figures dd {
    margin: 4px 0 0;
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .figures small {
    display: block;
    font-family: var(--sans);
    font-size: 0.75em;
    font-weight: 400;
    color: var(--muted);
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts dd {
      margin-bottom: 8px;
    }
  }
  .note {
    font-size: 0.8rem;
  }
  .sources {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .sources h2 {
    font-size: 1.1rem;
    color: var(--text);
  }
  .sources ol {
    padding-left: 1.4em;
  }
  .sources li {
    margin-bottom: 4px;
  }
  .sources li:target {
    color: var(--text);
    background: var(--accent-soft);
  }
  .scroll {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95em;
  }
  table.compact {
    width: auto;
    min-width: 320px;
    margin-top: 16px;
  }
  th,
  td {
    padding: 10px 8px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }
  th {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  tr.approach,
  tr.variant {
    color: var(--muted);
  }
</style>
