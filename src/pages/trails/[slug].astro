---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrailMap from "../../components/TrailMap.svelte";
import Icon from "../../components/Icon.astro";
import { existsSync } from "node:fs";
import {
  countryName,
  monthName,
  perDay,
  sacGrade,
  stageTotals,
  SAC_SCALE,
  SLEEPING_CATEGORIES,
  SLEEPING_LABELS,
  WILD_CAMPING_LABELS,
  waterLevel,
} from "../../lib/trails";

export async function getStaticPaths() {
  const trails = await getCollection("trails");
  return trails.map((trail) => ({ params: { slug: trail.id }, props: { trail } }));
}

const { trail } = Astro.props as { trail: CollectionEntry<"trails"> };
const t = trail.data;
const derived = (await getEntry("derived", trail.id))?.data;
const water = derived?.water;
// travel hubs with their distance to the start (pipeline/access.py), stations first
const hubs = t.access.map((h) => ({ ...h, ...derived?.access?.hubs.find((d) => d.name === h.name) }));
// sleeping: each category with the types this trail has in it; camping also carries wild camping
const sleeping = SLEEPING_CATEGORIES.map((c) => ({
  ...c,
  present: c.types.filter((x) => t.sleeping?.types.includes(x)),
}));
const sources = Object.fromEntries(t.sources.map((s, i) => [s.id, { ...s, n: i + 1 }]));
const totals = stageTotals(t);
// one length: the sum of the main stages where there are stages, else the first stated total
const length = totals
  ? { ...totals.km, approx: false }
  : t.length[0]
    ? { value: t.length[0].km, source: t.length[0].source, how: "stated total", approx: t.length[0].approx }
    : null;
const daily = perDay(t);
const sac = sacGrade(t);
const fmt = (n: number) => n.toLocaleString("en");
const hours = (min: number) => `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, "0")}`;
const TRAIL_TYPES = { "point-to-point": "Point to point", loop: "Loop", network: "Network" };
const range = (min: number, max: number) => (min === max ? `${min}` : `${min}–${max}`);
// the map line, built by pipeline/routes.py; without it the map shows only the termini
const routeFile = `routes/${trail.id}.geojson`;
const routeUrl = t.route && existsSync(`public/${routeFile}`) ? `/${routeFile}` : null;
// attribution names the route's source: its title up to the first colon
const routeAttribution = routeUrl && t.route ? sources[t.route.source].title.split(":")[0] : null;

const level = water && waterLevel(water.longestGapKm.drinking.km);
// status colours on cards (see --good/--fair/--poor in Base.astro); the text always says it too
const WILD_TONE = { allowed: "good", restricted: "fair", prohibited: "poor" } as const;
const WATER_TONE = { frequent: "good", regular: "fair", scarce: "poor" } as const;
const SLEEPING_ICONS = {
  "wild-camping": "tent",
  camping: "tent-tree",
  huts: "house",
  hostels: "bed-single",
  rooms: "bed-double",
} as const;
const TYPE_ICONS = { "point-to-point": "move-right", loop: "repeat", network: "network" } as const;
const waterTotals = water && {
  drinking: water.points.filter((p) => p.kind === "drinking").length,
  springs: water.points.filter((p) => p.kind === "spring").length,
};
// the stage(s) of the longest dry stretch, from the water points at either end of it
const gapStages = (() => {
  if (!water) return "";
  const g = water.longestGapKm.drinking;
  const at = (km: number) => water.points.find((p) => p.km !== null && Math.abs(p.km - km) < 0.05)?.stage;
  const [a, b] = [at(g.fromKm), at(g.toKm)];
  return a && b ? (a === b ? `, stage ${a}` : `, stages ${a}–${b}`) : "";
})();

// on-page navigation: only sections this trail has
const nav = [
  { id: "figures", label: "Key figures", show: true },
  { id: "location", label: "Location", show: true },
  { id: "map", label: "Map", show: true },
  { id: "stages", label: "Stages", show: Boolean(t.stages) },
  { id: "sleeping", label: "Sleeping", show: Boolean(t.sleeping || t.wildCamping) },
  { id: "water", label: "Water", show: Boolean(water) },
  { id: "sources", label: "Sources", show: true },
].filter((n) => n.show);
---

<Base
  title={`${t.name} · huckepack`}
  description={`${t.name}${t.localName ? ` (${t.localName})` : ""}: stages, length, ascent, difficulty, where to sleep, water and a map.`}
  section="trails"
>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/trails/">Trails</a> / {t.countries.map(countryName).join(", ")}</nav>
  <h1>
    {t.name}
    {t.status === "draft" && <span class="badge">draft</span>}
  </h1>
  <p class="subtitle muted">
    {t.localName && <span>{t.localName} · </span>}
    <a href={t.website}>Official website</a>
  </p>

  <nav class="onpage" aria-label="On this page">
    <ul>
      {nav.map((n) => (
        <li>
          <a href={`#${n.id}`}>{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  {sac && (
    <div id="sac-info" class="sac-info" popover>
      <p class="sac-title">SAC hiking scale</p>
      <p class="sac-lead">
        The Swiss Alpine Club grades hiking routes from T1 (easy) to T6 (very hard). This trail is <strong>{sac.value}</strong>
        {sac.how !== "stated" && ` (${sac.how})`}.
      </p>
      <ol class="sac-scale">
        {Object.entries(SAC_SCALE).map(([grade, g]) => (
          <li class:list={[{ current: grade === sac.value }]}>
            <strong>{grade} · {g.name}</strong>
            <span>{g.text}</span>
          </li>
        ))}
      </ol>
      <p class="sac-foot">
        <a href="https://www.sac-cas.ch/en/ausbildung-und-sicherheit/tourenplanung/grading-systems/">The scale at the Swiss Alpine Club</a>
        <button type="button" popovertarget="sac-info" popovertargetaction="hide">Close</button>
      </p>
    </div>
  )}

  <section id="figures" class="key">
    <h2 class="visually-hidden">Key figures</h2>
    <dl class="figures">
      {length && (
        <div>
          <dt><Icon name="route" size={14} />Length</dt>
          <dd>
            {length.approx && "about "}
            {fmt(length.value)} km
          </dd>
        </div>
      )}
      {totals && (
        <div>
          <dt><Icon name="trending-up" size={14} />Ascent</dt>
          <dd>
            {fmt(totals.ascentM.value)} m
          </dd>
        </div>
      )}
      {totals && (
        <div>
          <dt><Icon name="trending-down" size={14} />Descent</dt>
          <dd>
            {fmt(totals.descentM.value)} m
          </dd>
        </div>
      )}
      {sac && (
        <div>
          <dt>
            <Icon name="mountain" size={14} />Difficulty
            <button class="info" type="button" popovertarget="sac-info" aria-label={`What does SAC ${sac.value} mean?`}>?</button>
          </dt>
          <dd>
            SAC {sac.value}
            {t.difficulty?.cai && sac.how !== "stated" && <small>from CAI {t.difficulty.cai.grade}</small>}
            {t.difficulty?.cai && sac.how === "stated" && <small>CAI {t.difficulty.cai.grade}</small>}
          </dd>
        </div>
      )}
      {t.days && (
        <div>
          <dt><Icon name="calendar-days" size={14} />Suggested days</dt>
          <dd>
            {range(t.days.min, t.days.max)} days
          </dd>
        </div>
      )}
      {daily && (
        <div>
          <dt><Icon name="footprints" size={14} />Per day</dt>
          <dd>
            {daily.km.value} km · {fmt(daily.ascentM.value)} m
            <small>average</small>
          </dd>
        </div>
      )}
      {t.season && (
        <div>
          <dt><Icon name="sun" size={14} />Season</dt>
          <dd>
            {t.season.text ?? t.season.months.map(monthName).join(", ")}
          </dd>
        </div>
      )}
      <div>
        <dt><Icon name={TYPE_ICONS[t.trailType]} size={14} />Type</dt>
        <dd>{TRAIL_TYPES[t.trailType]}</dd>
      </div>
    </dl>
  </section>

  <section id="location">
    <h2>Location</h2>
    <dl class="facts">
      <dt>Country</dt>
      <dd>{t.countries.map(countryName).join(", ")} · {t.continents.join(", ")}</dd>
      {t.regions.length > 0 && (
        <>
          <dt>Regions</dt>
          <dd>{t.regions.join(", ")}</dd>
        </>
      )}
      {t.protectedAreas.length > 0 && (
        <>
          <dt>Protected areas</dt>
          <dd>{t.protectedAreas.join("; ")}</dd>
        </>
      )}
      <dt>From</dt>
      <dd>{t.termini.start.name}</dd>
      <dt>To</dt>
      <dd>{t.termini.end.name}</dd>
      {hubs.length > 0 && (
        <>
          <dt>Travel hubs</dt>
          <dd>
            <ul class="hubs">
              {hubs.map((h) => (
                <li>
                  <span class="hub-kind">
                    <Icon name={h.kind === "station" ? "train-front" : "plane"} size={16} label={h.kind === "station" ? "Train station" : "Airport"} />
                  </span>
                  <span>
                    {h.name}
                    {h.roadKm !== undefined && derived?.access && (
                      <span class="hub-dist">
                        {h.roadKm} km by road to the start, {h.driveMin} min
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </dd>
        </>
      )}
      <dt>Managed by</dt>
      <dd>{t.managedBy.map((m) => m.name).join(", ")}</dd>
      {t.waymarking && (
        <>
          <dt>Waymarking</dt>
          <dd>{t.waymarking.text}</dd>
        </>
      )}
    </dl>
  </section>

  <section id="map">
    <h2 class="visually-hidden">Map</h2>
    <TrailMap
      client:visible
      routeUrl={routeUrl}
      start={t.termini.start}
      end={t.termini.end}
      routeAttribution={routeAttribution}
      water={water?.points.map((p) => ({ lat: p.lat, lon: p.lon, kind: p.kind })) ?? []}
    />
  </section>

  {t.stages && (
    <section id="stages">
      <h2>Stages</h2>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Stage</th>
              <th>Route</th>
              <th class="num">km</th>
              <th class="num">Ascent</th>
              <th class="num">Descent</th>
              <th class="num">Elevation</th>
              <th class="num">Time</th>
            </tr>
          </thead>
          <tbody>
            {t.stages.list.map((s) => (
              <tr class={s.kind}>
                <td>
                  {s.number}
                  {s.kind !== "main" && <small> {s.kind}</small>}
                </td>
                <td>
                  {s.from} – {s.to}
                </td>
                <td class="num">{s.km.toFixed(1)}</td>
                <td class="num">{fmt(s.ascentM)} m</td>
                <td class="num">{fmt(s.descentM)} m</td>
                <td class="num">
                  {s.startEleM !== undefined && s.endEleM !== undefined
                    ? `${fmt(s.startEleM)} → ${fmt(s.endEleM)} m`
                    : "–"}
                </td>
                <td class="num">{s.minutes ? hours(s.minutes) : "–"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note muted">
        Elevation is the height at the start and end of each stage. Totals and averages use the main stages only, not the
        approach or variants.
      </p>
    </section>
  )}

  {(t.sleeping || t.wildCamping) && (
    <section id="sleeping">
      <h2>Sleeping</h2>
      <ul class="cards">
        {sleeping.map((c) =>
          c.id === "wild-camping" ? (
            <li class:list={[t.wildCamping ? `tone-${WILD_TONE[t.wildCamping.status]}` : "absent"]}>
              <p class="card-name"><Icon name={SLEEPING_ICONS[c.id]} />{c.label}</p>
              <p class="card-hint">{c.hint}</p>
              {t.wildCamping ? (
                <p class="card-value">
                  {WILD_CAMPING_LABELS[t.wildCamping.status]}
                </p>
              ) : (
                <p class="card-value muted">Not known</p>
              )}
            </li>
          ) : (
            <li class:list={[c.present.length > 0 ? "tone-good" : "absent"]}>
              <p class="card-name"><Icon name={SLEEPING_ICONS[c.id]} />{c.label}</p>
              <p class="card-hint">{c.hint}</p>
              {c.present.length > 0 ? (
                <p class="card-value">
                  {c.present.map((x) => SLEEPING_LABELS[x]).join(", ")}
                </p>
              ) : (
                <p class="card-value muted">None listed</p>
              )}
            </li>
          ),
        )}
      </ul>
      {t.wildCamping && (
        <p class="rule">
          <strong>Wild camping rule.</strong> {t.wildCamping.rule}
        </p>
      )}
    </section>
  )}

  {water && waterTotals && (
    <section id="water">
      <h2>Water</h2>
      <ul class="cards">
        <li>
          <p class="card-name"><Icon name="droplet" />Drinking water</p>
          <p class="card-hint">Fountains, taps, drinkable springs</p>
          <p class="card-value">{waterTotals.drinking} points</p>
        </li>
        <li>
          <p class="card-name"><Icon name="droplets" />Springs</p>
          <p class="card-hint">Drinkability unknown; treat the water</p>
          <p class="card-value">{waterTotals.springs} more</p>
        </li>
        <li class={`tone-${WATER_TONE[level!.id]}`}>
          <p class="card-name"><Icon name="gauge" />Availability</p>
          <p class="card-hint">{level!.hint}</p>
          <p class="card-value">{level!.label}</p>
        </li>
        <li class={`tone-${WATER_TONE[level!.id]}`}>
          <p class="card-name"><Icon name="ruler" />Longest dry stretch</p>
          <p class="card-hint">
            {`km ${water.longestGapKm.drinking.fromKm}–${water.longestGapKm.drinking.toKm}${gapStages}`}
          </p>
          <p class="card-value">{water.longestGapKm.drinking.km} km</p>
        </li>
      </ul>
      <p class="note muted">
        Water points within {water.withinM} m of the trail, from OpenStreetMap, which may miss some or list ones that have
        gone. Availability is rated by the longest stretch without drinking water: frequent up to 10 km, regular up to 20
        km, scarce beyond. Kilometres are measured along the map line ({water.routeKm} km for the main stages). Springs can
        run dry in late summer.
      </p>
    </section>
  )}

  <section id="sources" class="sources">
    <h2>Sources</h2>
    <ol>
      {t.sources.map((s, i) => (
        <li id={`source-${i + 1}`}>
          <a href={s.url}>{s.title}</a> · {s.licence} ·{" "}
          {s.retrieved ? `retrieved ${s.retrieved.toISOString().slice(0, 10)}` : "not yet verified"}
          {s.note && <span> · {s.note}</span>}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .crumbs {
    margin-top: 32px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted);
  }
  h1 {
    margin-top: 8px;
  }
  .subtitle {
    margin: 0;
  }

  .onpage {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 24px -16px 0;
    padding: 0 16px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .onpage ul {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .onpage a {
    display: block;
    padding: 12px 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .onpage a:hover {
    color: var(--text);
  }

  section {
    margin-top: 48px;
    scroll-margin-top: 64px;
  }
  .key {
    margin-top: 32px;
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 8px;
    margin: 0;
  }
  /* desktop: every card in one row, however many the trail has */
  @media (min-width: 900px) {
    .figures {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      grid-template-columns: none;
    }
  }
  .figures div {
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--surface);
  }
  .figures dt {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .figures dd {
    margin: 2px 0 0;
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .figures small {
    display: block;
    font-family: var(--sans);
    font-size: 0.75em;
    font-weight: 400;
    color: var(--muted);
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts dd {
      margin-bottom: 8px;
    }
  }
  .note {
    font-size: 0.8rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cards li {
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--surface);
  }
  .cards li.tone-good {
    --tone: var(--good);
    background: var(--good-soft);
  }
  .cards li.tone-fair {
    --tone: var(--fair);
    background: var(--fair-soft);
  }
  .cards li.tone-poor {
    --tone: var(--poor);
    background: var(--poor-soft);
  }
  .cards li[class*="tone-"] .card-value {
    color: var(--tone);
    font-weight: 600;
  }
  .cards li[class*="tone-"] .card-value::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--tone);
    vertical-align: 1px;
  }
  .cards li.absent {
    background: none;
    border: 1px dashed var(--line);
  }
  .cards p {
    margin: 0;
  }
  .card-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .card-hint {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }
  .card-value {
    margin-top: 8px !important;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .hubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hubs li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .hub-kind {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent);
    align-self: flex-start;
  }
  .hubs li {
    align-items: flex-start;
  }
  .card-name :global(.icon) {
    flex: none;
    color: var(--tone, var(--accent));
  }
  .hub-dist {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .rule {
    max-width: 70ch;
    margin-top: 16px;
    font-size: 0.9rem;
  }
  .info {
    width: 16px;
    height: 16px;
    margin-left: 4px;
    padding: 0;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    font: 600 0.65rem/1 var(--sans);
    vertical-align: 1px;
    cursor: pointer;
  }
  .info:hover,
  .info:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .sac-info {
    width: min(480px, calc(100vw - 32px));
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.18);
    font-size: 0.9rem;
  }
  .sac-info::backdrop {
    background: rgb(0 0 0 / 0.25);
  }
  .sac-info p {
    margin: 0 0 12px;
  }
  .sac-title {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
  }
  .sac-scale {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  .sac-scale li {
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--muted);
  }
  .sac-scale li.current {
    background: var(--accent-soft);
    color: var(--text);
  }
  .sac-scale strong {
    display: block;
    color: var(--text);
  }
  .sac-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 !important;
    font-size: 0.8rem;
  }
  .sac-foot button {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .sources {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .sources h2 {
    font-size: 1.1rem;
    color: var(--text);
  }
  .sources ol {
    padding-left: 1.4em;
