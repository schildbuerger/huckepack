          </div>
        )}
      </dl>

      <div class="terrain-body">
        <figure
          class="chart terrain-chart"
        >
          <script is:inline type="application/json" class="chart-data" set:html={terrainData} />
          <div class="chart-scroll">
          <svg
            viewBox={`0 0 ${CHART.width} ${surface ? 236 : 222}`}
            role="img"
            aria-label={`Elevation along the main route, ${elevation.routeKm} km: highest ${fmt(elevation.highest.m)} m at km ${elevation.highest.km.toFixed(1)}, lowest ${fmt(elevation.lowest.m)} m. Steepest climb ${grad.climb.grade} % on stage ${grad.climb.stage}, steepest descent ${grad.descent.grade} % on stage ${grad.descent.stage}; ${grad.steepUpKm} km climb and ${grad.steepDownKm} km descend at ${STEEP_PERCENT} % or more.${treeLineText ? ` The route climbs above the tree line, ${treeLineText.replace("≈ ", "about ")}.` : ""}${surface ? ` Ground: ${surfaceRows.map((c) => `${c.label.toLowerCase()} ${pct(surface.totals[c.id].share)}`).join(", ")}.` : ""}`}
          >
