---
// The season planner (2026-11-05; of five previews of the search's redesign, approach D, kept as its own
// page): every trail as a row of the twelve months, its season filled, each month coloured by the trail's
// climate rating for it (src/lib/difficulty.ts; the same as the trail page's climate card), with its
// length and days. The month headings pick months: rows out of season in all of them fold away, the pick
// goes into the URL (`months`, as the search and the trail map write it, so a trail opened from here
// keeps it, Base.astro) and into a link to the search with the same months. Rows are plain HTML; the
// script only hides rows and keeps the URL. Linked from the footer.
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { allSearchTrails } from "../../../lib/search-all";
import { MONTHS, LEVEL_WORDS } from "../../../lib/filters";

const trails = (await allSearchTrails()).sort((a, b) => a.name.localeCompare(b.name, "en"));
const fmt = (n: number) => Math.round(n).toLocaleString("en");
const dayText = (d: [number, number] | null) => (d ? (d[0] === d[1] ? `${d[0]}` : `${d[0]}–${d[1]}`) : null);
const MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const maxKm = Math.max(...trails.map((t) => t.compareKm ?? t.lengthKm ?? 0));
---

<Base
  title="Season planner: when to walk which long-distance trail · huckepack"
  description={`The season of ${trails.length} official long-distance trails month by month, each month rated for its climate, to plan when to go.`}
>
  <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current="Season planner" />
  <h1>Season planner</h1>
  <p class="lede">
    Every trail's season, month by month, each month coloured by how hard its climate makes the walk. Pick the months you
    can go: trails out of season in all of them fold away.
  </p>
  <p class="key" aria-hidden="true">
    <span class="sw" data-l="1"></span>Easy <span class="sw" data-l="2"></span>Moderate <span class="sw" data-l="3"></span>Demanding
    <span class="sw" data-l="4"></span>Hard <span class="sw" data-l="0"></span>In season, not rated <span class="sw out"></span>Out of season
  </p>

  <div class="bar">
    <p class="count" role="status"><strong data-count>{trails.length}</strong> of {trails.length} trails</p>
    <a class="to-search" href="/trails/" data-to-search>Open these in the trail search →</a>
    <button type="button" class="clear" data-clear hidden>Clear months</button>
  </div>

  <div class="plan" data-plan>
    <div class="head">
      <span class="h-name">Trail</span>
      {MONTHS.map((m, i) => (
        <button type="button" class="m" data-m={i + 1} aria-pressed="false" title={MONTH_NAMES[i]}>{m}</button>
      ))}
      <span class="h-len">Length · days</span>
    </div>
    <ol class="rows">
      {trails.map((t) => (
        <li data-season={(t.season ?? []).join(",")}>
          <a class="row" href={`/trails/${t.slug}/`}>
            <span class="name"><strong>{t.name}</strong><span class="sub">{t.countries.join(" · ")}</span></span>
            {MONTHS.map((_, i) => {
              const inSeason = t.season?.includes(i + 1) ?? false;
              const l = t.climateByMonth[i] ?? 0;
              return (
                <span
                  class:list={["c", { in: inSeason }]}
                  data-l={inSeason ? l : undefined}
                  title={`${MONTH_NAMES[i]}: ${inSeason ? (l ? `in season, climate ${LEVEL_WORDS[l - 1].toLowerCase()}` : "in season") : "out of season"}`}
                ></span>
              );
            })}
            <span class="len">
              <span class="len-bar" style={`width: ${(((t.compareKm ?? t.lengthKm ?? 0) / maxKm) * 100).toFixed(1)}%`}></span>
              {t.lengthKm !== null && `${fmt(t.lengthKm)} km`}{dayText(t.days) && ` · ${dayText(t.days)} days`}
            </span>
          </a>
        </li>
      ))}
    </ol>
    {trails.some((t) => !t.season) && <p class="note">Trails whose managers state no season show no months.</p>}
  </div>
</Base>

<script>
  // the month pick: from the URL, toggled by the headings; rows out of season in every picked month hide
  const plan = document.querySelector<HTMLElement>("[data-plan]")!;
  const heads = [...plan.querySelectorAll<HTMLButtonElement>(".m")];
  const rows = [...plan.querySelectorAll<HTMLElement>(".rows li")];
  const count = document.querySelector("[data-count]")!;
  const toSearch = document.querySelector<HTMLAnchorElement>("[data-to-search]")!;
  const clear = document.querySelector<HTMLButtonElement>("[data-clear]")!;
  let pick = (new URLSearchParams(location.search).get("months") ?? "")
    .split(",")
    .map(Number)
    .filter((m) => m >= 1 && m <= 12);

  const apply = () => {
    pick.sort((a, b) => a - b);
    let n = 0;
    for (const li of rows) {
      const season = (li.dataset.season ?? "").split(",").filter(Boolean).map(Number);
      const keep = !pick.length || pick.some((m) => season.includes(m));
      li.hidden = !keep;
      if (keep) n++;
    }
    for (const b of heads) b.setAttribute("aria-pressed", String(pick.includes(Number(b.dataset.m))));
    plan.dataset.picked = pick.join(",");
    for (const m of heads.map((b) => Number(b.dataset.m))) plan.classList.toggle(`p${m}`, pick.includes(m));
    count.textContent = String(n);
    clear.hidden = !pick.length;
    const q = pick.length ? `?months=${pick.join(",")}` : "";
    toSearch.href = `/trails/${q}`;
    history.replaceState(null, "", q || location.pathname);
  };
  for (const b of heads)
    b.addEventListener("click", () => {
      const m = Number(b.dataset.m);
      pick = pick.includes(m) ? pick.filter((x) => x !== m) : [...pick, m];
      apply();
    });
  clear.addEventListener("click", () => {
    pick = [];
    apply();
  });
  apply();
</script>

<style>
  h1 {
    margin: 8px 0 8px;
  }
  .lede {
    max-width: 62ch;
    margin: 0 0 12px;
    color: var(--muted);
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .sw {
    display: inline-block;
    width: 14px;
    height: 10px;
    margin-left: 8px;
    border-radius: 2px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin-bottom: 8px;
  }
  .count {
    margin: 0;
    color: var(--muted);
  }
  .count strong {
    color: var(--text);
  }
  .to-search {
    font-size: 0.9rem;
  }
  .clear {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-text);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  /* the planner: the trail, twelve months, length and days */
  .head,
  .row {
    display: grid;
    grid-template-columns: minmax(150px, 1.5fr) repeat(12, minmax(16px, 1fr)) minmax(136px, 1fr);
    gap: 2px;
    align-items: center;
  }
  .head {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 6px 0;
    border-bottom: 2px solid var(--text);
    background: var(--bg);
  }
  .h-name,
  .h-len {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .h-len {
    padding-left: 10px;
  }
  .m {
    min-height: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    font: 600 0.72rem var(--sans);
    cursor: pointer;
  }
  .m:hover {
    border-color: var(--line);
    color: var(--text);
  }
  .m[aria-pressed="true"] {
    background: var(--accent);
    color: var(--bg);
  }
  .m:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li[hidden] {
    display: none;
  }
  .row {
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }
  .row:hover {
    background: var(--surface);
  }
  .row:hover strong {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .name {
    display: grid;
    min-width: 0;
    padding-right: 8px;
    font-size: 0.88rem;
  }
  .sub {
    color: var(--muted);
    font-size: 0.74rem;
  }
  .c {
    height: 22px;
    border-radius: 3px;
  }
  /* out of season, in season (by its climate rating), not rated */
  .c,
  .sw.out {
    background: var(--surface);
  }
  .c.in,
  .sw[data-l="0"] {
    background: #b9cf8e;
  }
  .c.in[data-l="1"],
  .sw[data-l="1"] {
    background: #a7c070;
  }
  .c.in[data-l="2"],
  .sw[data-l="2"] {
    background: #7f9a54;
  }
  .c.in[data-l="3"],
  .sw[data-l="3"] {
    background: #d9b45e;
  }
  .c.in[data-l="4"],
  .sw[data-l="4"] {
    background: #c97a5e;
  }
  /* the picked months' columns outlined */
  .plan.p1 .c:nth-of-type(2), .plan.p2 .c:nth-of-type(3), .plan.p3 .c:nth-of-type(4), .plan.p4 .c:nth-of-type(5),
  .plan.p5 .c:nth-of-type(6), .plan.p6 .c:nth-of-type(7), .plan.p7 .c:nth-of-type(8), .plan.p8 .c:nth-of-type(9),
  .plan.p9 .c:nth-of-type(10), .plan.p10 .c:nth-of-type(11), .plan.p11 .c:nth-of-type(12), .plan.p12 .c:nth-of-type(13) {
    box-shadow: inset 0 0 0 2px var(--text);
  }
  .len {
    padding-left: 10px;
    color: var(--muted);
    font-size: 0.74rem;
    white-space: nowrap;
  }
  .len-bar {
    display: block;
    height: 4px;
    margin-bottom: 3px;
    border-radius: 2px;
    background: var(--accent);
  }
  .note {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  /* phones: the length column folds under the name, the months narrower */
  @media (max-width: 640px) {
    .head,
    .row {
      grid-template-columns: minmax(96px, 1.2fr) repeat(12, minmax(12px, 1fr));
    }
    .h-len,
    .len {
      display: none;
    }
    .m {
      font-size: 0.6rem;
    }
    .name {
      font-size: 0.8rem;
    }
  }
</style>
