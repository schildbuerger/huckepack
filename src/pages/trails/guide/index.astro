---
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import TrailGuide from "../../../components/TrailGuide.svelte";
import { searchSummary } from "../../../lib/search";

const trails = await Promise.all(
  (await getCollection("trails")).map(async ({ id, data }) => searchSummary(id, data, (await getEntry("derived", id))?.data)),
);
---

<Base
  title="Help me choose · huckepack"
  description="Eleven short questions about your hike (when, where, how long, how hard, the weather, the landscape, the ground underfoot, sleeping and water) lead to the trails that fit."
>
  <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current="Help me choose" />
  <h1>Help me choose</h1>
  <TrailGuide client:load trails={trails} />
</Base>

<style>
  /* smaller than other pages' titles, so every question fits a laptop screen beneath it */
  h1 {
    margin: 0 0 12px;
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    text-align: center;
  }
</style>
