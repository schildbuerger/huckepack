---
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import TrailGuide from "../../../components/TrailGuide.svelte";
import { summarize } from "../../../lib/trails";

const trails = await Promise.all(
  (await getCollection("trails")).map(async ({ id, data }) => summarize(id, data, (await getEntry("derived", id))?.data)),
);
---

<Base
  title="Help me choose · huckepack"
  description="Eight short questions about your hike (when, how long, how hard, where, sleeping, water and ground underfoot) lead to the trails that fit."
>
  <Breadcrumbs trail={[{ label: "Trails", href: "/trails/" }]} current="Help me choose" />
  <h1>Help me choose</h1>
  <p class="lede muted">
    Eight short questions, one at a time. Skip any that don't matter to you; at the end you'll see the trails that fit.
  </p>
  <TrailGuide client:load trails={trails} />
</Base>

<style>
  h1 {
    margin-top: 8px;
    text-align: center;
  }
  .lede {
    max-width: 52ch;
    margin: 0 auto 32px;
    text-align: center;
  }
</style>
