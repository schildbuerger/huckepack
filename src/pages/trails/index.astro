---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TrailList from "../../components/TrailList.svelte";
import TrailCards from "../../components/TrailCards.astro";
import { searchSummary } from "../../lib/search";

const trails = (
  await Promise.all(
    (await getCollection("trails")).map(async ({ id, data }) => searchSummary(id, data, (await getEntry("derived", id))?.data)),
  )
).sort((a, b) => a.name.localeCompare(b.name));

// one height scale for every card's elevation profile, so the profiles compare honestly
const lows = trails.flatMap((t) => (t.lowestM === null ? [] : [t.lowestM]));
const highs = trails.flatMap((t) => (t.highestM === null ? [] : [t.highestM]));
const eleRange: [number, number] = lows.length
  ? [Math.max(0, Math.floor((Math.min(...lows) - 100) / 100) * 100), Math.ceil((Math.max(...highs) + 100) / 100) * 100]
  : [0, 1000];
---

<Base
  title="Find a long-distance hiking trail · huckepack"
  description={`${trails.length} official long-distance hiking trails, to filter by month, region, walking days, difficulty, landscape, ground underfoot, where to sleep and water on the way.`}
>
  <Breadcrumbs current="Trails" />
  <h1>Trails</h1>
  <p class="lede muted">
    Narrow the list down by when you can go, how long and how hard, and how you want to sleep. Every card shows the
    season, the elevation profile on one scale for all trails, and the ground underfoot.
  </p>
  <TrailList client:load trails={trails}>
    <TrailCards trails={trails} eleRange={eleRange} />
  </TrailList>
</Base>

<style>
  h1 {
    margin-top: 8px;
    text-align: center;
  }
  .lede {
    max-width: 62ch;
    margin: 0 auto 32px;
    text-align: center;
  }
</style>
