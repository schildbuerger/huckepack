---
// Design proposal: key figures, sleeping and water redrawn from scratch, with the real data of
// one trail. Not linked from the site; delete it or adopt it into the trail page.
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Explain from "../../components/Explain.astro";
import Icon from "../../components/Icon.astro";
import {
  perDay,
  sacGrade,
  stageTotals,
  SAC_SCALE,
  SLEEPING_CATEGORIES,
  SLEEPING_LABELS,
  WILD_CAMPING_LABELS,
  waterLevel,
} from "../../lib/trails";

const trail = (await getEntry("trails", "sacred-forests-trail"))!;
const t = trail.data;
const water = (await getEntry("derived", trail.id))?.data.water!;
const totals = stageTotals(t)!;
const daily = perDay(t)!;
const sac = sacGrade(t)!;
const fmt = (n: number) => n.toLocaleString("en");
const level = waterLevel(water.longestGapKm.drinking.km);
const gap = water.longestGapKm.drinking;

// status as shape + word; colour only on the shape (good / fair / poor / none)
type Status = { shape: "full" | "half" | "blocked" | "empty"; tone: string; word: string };
const STATUS: Record<string, Status> = {
  available: { shape: "full", tone: "good", word: "Available" },
  allowed: { shape: "full", tone: "good", word: "Allowed" },
  restricted: { shape: "half", tone: "fair", word: "Restricted" },
  prohibited: { shape: "blocked", tone: "poor", word: "Prohibited" },
  none: { shape: "empty", tone: "none", word: "None listed" },
  unknown: { shape: "empty", tone: "none", word: "Not known" },
};
const ICONS = { "wild-camping": "tent", camping: "tent-tree", huts: "house", hostels: "bed-single", rooms: "bed-double" } as const;
const sleeping = SLEEPING_CATEGORIES.map((c) => {
  if (c.id === "wild-camping") {
    return { ...c, status: STATUS[t.wildCamping?.status ?? "unknown"], detail: "" };
  }
  const present = c.types.filter((x) => t.sleeping?.types.includes(x));
  return {
    ...c,
    status: STATUS[present.length > 0 ? "available" : "none"],
    detail: present.map((x) => SLEEPING_LABELS[x]).join(", "),
  };
});
const WATER_STATUS = { frequent: STATUS.available, regular: STATUS.restricted, scarce: STATUS.prohibited };
const waterStatus = { ...WATER_STATUS[level.id], word: level.label };

// strip chart of water along the main route (km on the map line)
const W = 1000;
const X0 = 8;
const X1 = 992;
const x = (km: number) => X0 + (km / water.routeKm) * (X1 - X0);
const LANE = { drinking: 46, spring: 70 };
const AXIS = 92;
const onRoute = water.points.filter((p) => p.km !== null);
const counts = {
  drinking: water.points.filter((p) => p.kind === "drinking").length,
  springs: water.points.filter((p) => p.kind === "spring").length,
};
const chartSummary = `Water along the main route, ${water.routeKm} km: ${onRoute.filter((p) => p.kind === "drinking").length} drinking water points and ${onRoute.filter((p) => p.kind === "spring").length} springs. The longest stretch without drinking water is ${gap.km} km, from km ${gap.fromKm} to ${gap.toKm}.`;
---

<Base title="Card redesign · huckepack" description="Design proposal for the trail page cards." section="trails">
  <p class="eyebrow">Design proposal · {t.name}</p>
  <h1>Key figures, sleeping and water, redrawn</h1>
  <p class="lede muted">
    One visual language for all three: hairline-ruled strips instead of filled cards, numbers first, labels small
    beneath. Status is a shape plus a word; colour only marks the shape.
  </p>

  <!-- 1. Key figures: a spec strip -->
  <section>
    <h2>Key figures</h2>
    <dl class="strip spec">
      <div>
        <dd><span class="big">{fmt(totals.km.value)}</span><span class="unit">km</span></dd>
        <dt>Length</dt>
      </div>
      <div>
        <dd><span class="big">{fmt(totals.ascentM.value)}</span><span class="unit">m ↑</span></dd>
        <dt>Ascent</dt>
      </div>
      <div>
        <dd><span class="big">{fmt(totals.descentM.value)}</span><span class="unit">m ↓</span></dd>
        <dt>Descent</dt>
      </div>
      <div>
        <dd><span class="big">{sac.value}</span><span class="unit">SAC</span></dd>
        <dt>
          Difficulty
          <Explain id="p-sac" title="SAC hiking scale" label={`What does SAC ${sac.value} mean?`}>
            <p>
              From T1 (easy) to T6 (very hard). This trail is <strong>{sac.value}</strong>: {SAC_SCALE[sac.value].name.toLowerCase()}.
              {SAC_SCALE[sac.value].text}
            </p>
          </Explain>
        </dt>
      </div>
      <div>
        <dd><span class="big">{t.days!.min}</span><span class="unit">days</span></dd>
        <dt>Suggested</dt>
      </div>
      <div>
        <dd><span class="big">{daily.km.value}</span><span class="unit">km</span></dd>
        <dt>Per day · {fmt(daily.ascentM.value)} m ↑</dt>
      </div>
      <div>
        <dd><span class="word">Spring, autumn</span></dd>
        <dt>Season</dt>
      </div>
      <div>
        <dd><span class="word">Point to point</span></dd>
        <dt>Route type</dt>
      </div>
    </dl>
  </section>

  <!-- 2. Sleeping: an availability strip -->
  <section>
    <h2>Sleeping</h2>
    <ul class="strip avail">
      {sleeping.map((c) => (
        <li class:list={[{ off: c.status.tone === "none" }]}>
          <p class="avail-name">
            <Icon name={ICONS[c.id]} size={15} />
            {c.label}
            <Explain id={`p-${c.id}`} title={c.label}><p>{c.hint}</p></Explain>
          </p>
          <p class="status">
            <span class={`mark ${c.status.shape} tone-${c.status.tone}`} aria-hidden="true"></span>
            {c.status.word}
          </p>
          {c.detail && <p class="detail">{c.detail}</p>}
        </li>
      ))}
    </ul>
    {t.wildCamping && (
      <p class="aside">
        <span class={`mark ${STATUS[t.wildCamping.status].shape} tone-${STATUS[t.wildCamping.status].tone}`} aria-hidden="true"></span>
        <span><strong>Wild camping is {WILD_CAMPING_LABELS[t.wildCamping.status].toLowerCase()}.</strong> {t.wildCamping.rule}</span>
      </p>
    )}
  </section>

  <!-- 3. Water: three figures and the water along the route -->
  <section>
    <h2>Water</h2>
    <dl class="strip spec three">
      <div>
        <dd><span class="big">{counts.drinking}</span><span class="unit">points</span></dd>
        <dt>
          Drinking water
          <Explain id="p-drinking" title="Drinking water">
            <p>Fountains, taps and springs marked as drinkable in OpenStreetMap, within {water.withinM} m of the trail.</p>
          </Explain>
        </dt>
      </div>
      <div>
        <dd><span class="big">{counts.springs}</span><span class="unit">springs</span></dd>
        <dt>
          Drinkability unknown
          <Explain id="p-springs" title="Springs">
            <p>Other springs within {water.withinM} m. Treat the water; some run dry in late summer.</p>
          </Explain>
        </dt>
      </div>
      <div>
        <dd>
          <span class="big">{gap.km}</span><span class="unit">km</span>
          <span class="status inline">
            <span class={`mark ${waterStatus.shape} tone-${waterStatus.tone}`} aria-hidden="true"></span>
            {waterStatus.word}
          </span>
        </dd>
        <dt>
          Longest dry stretch
          <Explain id="p-gap" title="Water availability">
            <p>
              Rated by the longest stretch without drinking water: frequent up to 10 km, regular up to 20 km, scarce beyond.
            </p>
          </Explain>
        </dt>
      </div>
    </dl>

    <figure class="waterline">
      <ul class="legend" aria-hidden="true">
        <li><svg width="12" height="12"><circle cx="6" cy="6" r="4.5" class="dot drinking" /></svg>Drinking water</li>
        <li><svg width="12" height="12"><circle cx="6" cy="6" r="4" class="dot spring" /></svg>Spring</li>
        <li><span class="swatch"></span>Longest dry stretch</li>
      </ul>
      <svg viewBox={`0 0 ${W} 112`} role="img" aria-label={chartSummary}>
        <rect class="gap" x={x(gap.fromKm)} y="28" width={x(gap.toKm) - x(gap.fromKm)} height={AXIS - 28} rx="4" />
        <text class="gap-label" x={(x(gap.fromKm) + x(gap.toKm)) / 2} y="20" text-anchor="middle">{gap.km} km without</text>
        <line class="route" x1={X0} x2={X1} y1={AXIS} y2={AXIS} />
        {water.stageStarts.map((s) => (
          <g>
            <line class="tick" x1={x(s.km)} x2={x(s.km)} y1={AXIS - 5} y2={AXIS + 5} />
            <text class="tick-label" x={x(s.km) + 4} y={AXIS + 18}>Stage {s.number}</text>
          </g>
        ))}
        <text class="tick-label" x={X1} y={AXIS + 18} text-anchor="end">{water.routeKm} km</text>
        {onRoute.map((p) => (
          <g class="pt">
            <title>{`${p.kind === "drinking" ? "Drinking water" : "Spring"}${p.name ? `: ${p.name}` : ""} · km ${p.km} · stage ${p.stage}`}</title>
            <circle cx={x(p.km!)} cy={LANE[p.kind]} r="10" class="hit" />
            <circle cx={x(p.km!)} cy={LANE[p.kind]} r={p.kind === "drinking" ? 4.5 : 4} class={`dot ${p.kind}`} />
          </g>
        ))}
      </svg>
      <figcaption class="muted">
        Water within {water.withinM} m of the main route, from OpenStreetMap; hover a dot for details. Distances along the
        map line.
      </figcaption>
    </figure>
  </section>
</Base>

<style>
  :root {
    --water: #2f6690;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --water: #86b6db;
    }
  }
  .eyebrow {
    margin: 32px 0 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 6px;
  }
  .lede {
    max-width: 62ch;
  }
  section {
    margin-top: 36px;
  }

  /* the shared language: a strip ruled top and bottom, items split by hairlines */
  .strip {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--line);
  }
  .strip > * {
    padding: 14px 16px 14px 0;
  }
  .strip > * + * {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }

  /* key figures and water figures */
  .spec {
    grid-template-columns: repeat(2, 1fr);
  }
  .spec.three {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (min-width: 640px) {
    .spec {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 980px) {
    .spec {
      grid-template-columns: repeat(8, auto);
    }
    .spec.three {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 979px) {
    .spec:not(.three) > :nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 639px) {
    .spec:not(.three) > :nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .spec:not(.three) > :nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }
  .spec div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .spec dd {
    margin: 0;
    white-space: nowrap;
  }
  .big {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.15;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .word {
    display: block;
    padding-top: 6px;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: normal;
  }
  .unit {
    margin-left: 4px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .spec dt {
    display: flex;
    align-items: center;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* sleeping: availability per category */
  .avail {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .avail {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  @media (max-width: 639px) {
    .avail > * + * {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  .avail p {
    margin: 0;
  }
  .avail-name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .avail-name :global(.icon) {
    flex: none;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px !important;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .status.inline {
    display: inline-flex;
    margin: 0 0 0 10px !important;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 500;
    vertical-align: 4px;
  }
  .detail {
    margin-top: 2px !important;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .off .status {
    color: var(--muted);
    font-weight: 400;
  }

  /* status marks: the shape carries the meaning, the colour supports it */
  .mark {
    flex: none;
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 2px solid var(--mark);
    border-radius: 50%;
  }
  .tone-good {
    --mark: var(--good);
  }
  .tone-fair {
    --mark: var(--fair);
  }
  .tone-poor {
    --mark: var(--poor);
  }
  .tone-none {
    --mark: var(--muted);
  }
  .mark.full {
    background: var(--mark);
  }
  .mark.half {
    background: linear-gradient(90deg, var(--mark) 50%, transparent 50%);
  }
  .mark.blocked {
    background: linear-gradient(135deg, transparent 43%, var(--mark) 43%, var(--mark) 57%, transparent 57%);
  }
  .aside {
    display: flex;
    gap: 10px;
    max-width: 78ch;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .aside .mark {
    margin-top: 4px;
  }
  .aside strong {
    color: var(--text);
    font-weight: 600;
  }

  /* water along the route */
  .waterline {
    margin: 20px 0 0;
  }
  .waterline svg[role="img"] {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0 0 4px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .swatch {
    width: 16px;
    height: 10px;
    border-radius: 2px;
    background: var(--fair-soft);
    outline: 1px solid var(--fair);
  }
  .dot {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .dot.drinking {
    fill: var(--water);
  }
  .dot.spring {
    fill: var(--bg);
    stroke: var(--water);
    stroke-width: 2;
  }
  .hit {
    fill: transparent;
    cursor: help;
  }
  .pt:hover .dot {
    r: 6px;
  }
  .gap {
    fill: var(--fair-soft);
  }
  .gap-label {
    fill: var(--text);
    font: 600 13px var(--sans);
  }
  .route {
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .tick {
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .tick-label {
    fill: var(--muted);
    font: 12px var(--sans);
  }
  figcaption {
    margin-top: 10px;
    font-size: 0.8rem;
  }
</style>
