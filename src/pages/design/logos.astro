---
// Logo proposals (design/logos/*.svg, made by design/logos/make.py), shown at several sizes on
// light and dark backgrounds and with the wordmark. Not linked from the site.
import Base from "../../layouts/Base.astro";
import a1 from "../../../design/logos/a1-cairn.svg?raw";
import a2 from "../../../design/logos/a2-cairn-two-tone.svg?raw";
import a3 from "../../../design/logos/a3-cairn-organic.svg?raw";
import a4 from "../../../design/logos/a4-cairn-stencil.svg?raw";
import a5 from "../../../design/logos/a5-cairn-badge.svg?raw";
import a6 from "../../../design/logos/a6-cairn-micro.svg?raw";

const logos = [
  { id: "1", name: "Original", svg: a1, note: "Pixel art, 12 × 12, one colour: four flat stones with one-pixel gaps, set off-centre in turn." },
  { id: "2", name: "Two-tone", svg: a2, note: "Pixel art, 16 × 16: rounder stones alternating terracotta and ink, the heaviest at the bottom." },
  { id: "3", name: "Organic", svg: a3, note: "Pixel art, 16 × 16: irregular stones that touch, soft, terracotta and ink, standing on a ground line." },
  { id: "4", name: "Stencil pebbles", svg: a4, note: "Stencil: four rounded pebbles, each tilted a little, apart by stencil gaps. The clearest cairn." },
  { id: "5", name: "Badge", svg: a5, note: "Stencil: a terracotta circle with the cairn cut out. Compact for favicon and app icon." },
  { id: "6", name: "Micro", svg: a6, note: "Pixel art, 8 × 8, for 16 px favicons. At this size the stones turn into bars." },
];
// inline SVGs share the page: give each copy its own mask id
let copy = 0;
const inline = (svg: string) => {
  copy += 1;
  return svg.replaceAll("hp-cairn", `hp-cairn-${copy}`).replace("<svg ", '<svg width="100%" height="100%" ');
};
---

<Base title="Logo proposals · huckepack" description="Logo proposals for huckepack." section="home">
  <p class="eyebrow">Design proposal</p>
  <h1>Logo: cairn variations</h1>
  <p class="lede muted">
    Six versions of the cairn, in pixel art and stencil style: each stone carried huckepack by the one below. Each is
    one scalable SVG; colours follow the site's theme (terracotta and ink) and fall back to them on their own.
  </p>

  <div class="logos">
    {logos.map((l) => (
      <section class="logo">
        <h2><span class="id">{l.id}</span> {l.name}</h2>
        <p class="muted note">{l.note}</p>
        <div class="row">
          <div class="tile light">
            <div class="big" set:html={inline(l.svg)} />
          </div>
          <div class="tile dark">
            <div class="big" set:html={inline(l.svg)} />
          </div>
          <div class="sizes light">
            <div style="width:64px;height:64px" set:html={inline(l.svg)} />
            <div style="width:32px;height:32px" set:html={inline(l.svg)} />
            <div style="width:16px;height:16px" set:html={inline(l.svg)} />
          </div>
          <div class="sizes dark">
            <div style="width:64px;height:64px" set:html={inline(l.svg)} />
            <div style="width:32px;height:32px" set:html={inline(l.svg)} />
            <div style="width:16px;height:16px" set:html={inline(l.svg)} />
          </div>
        </div>
        <div class="row lockups">
          <div class="lockup light"><span style="width:28px;height:28px" set:html={inline(l.svg)} />huckepack</div>
          <div class="lockup dark"><span style="width:28px;height:28px" set:html={inline(l.svg)} />huckepack</div>
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .eyebrow {
    margin: 32px 0 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 6px;
  }
  .lede {
    max-width: 62ch;
  }
  .logos {
    display: grid;
    gap: 40px;
    margin-top: 32px;
  }
  .logo {
    padding-top: 16px;
    border-top: 1px solid var(--text);
  }
  .logo h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .id {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    font: 600 0.85rem var(--sans);
    vertical-align: 3px;
  }
  .note {
    max-width: 70ch;
    margin: 4px 0 16px;
    font-size: 0.9rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* fixed light and dark backgrounds, whatever the page theme */
  .light {
    --logo-ink: #2a221d;
    --logo-accent: #b0502a;
    --logo-soft: #e8b79c;
    background: #fbf7f1;
    color: #2a221d;
  }
  .dark {
    --logo-ink: #efe6da;
    --logo-accent: #e3916a;
    --logo-soft: #7a4a33;
    background: #1b1714;
    color: #efe6da;
  }
  .tile,
  .sizes,
  .lockup {
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 160px;
    height: 160px;
  }
  .big {
    width: 112px;
    height: 112px;
  }
  .sizes {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 24px;
    height: 160px;
  }
  .lockups {
    margin-top: 12px;
  }
  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    font: 600 1.35rem var(--serif);
  }
  .lockup span {
    display: block;
  }
</style>
