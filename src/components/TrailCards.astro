---
// The search page's results as rows of a compare table (2026-11-05; of five previews, approach C "Compare
// table", picked), plain HTML (issue #86: rendering them in the Svelte island cost 0.3–0.5 s of start-up
// on slow devices). TrailList.svelte gets them as its children, draws the column headers (which sort)
// above them on the same grid (--cols, set there), and only hides the rows the filters leave out and
// moves the rest into the sorted order (by `data-slug`). Each row: the trail (name, countries, ends,
// landscape, water, wild camping, sleeping), length, days, ascent, difficulty (re-rated in the browser
// for a month pick, Base.astro), the season, and the elevation profile on one scale for every trail with
// the ground underfoot. A trail that stands out gets a stamp beside its name, and a dot walks its profile
// while the row is pointed at. On phones a row folds into a compact card.
import type { SearchTrail } from "../lib/search";
import { SLEEPING_CATEGORIES, WATER_LEVELS } from "../lib/trails";
import { LANDSCAPES, LEVEL_WORDS, MONTHS, dimSay, ratedDims } from "../lib/filters";
import { rateData } from "../lib/months";
import { allSearchTrails } from "../lib/search-all";

interface Props {
  trails: SearchTrail[];
  eleRange: [number, number]; // one height scale for every row's profile
}
const { trails, eleRange } = Astro.props;

const fmt = (n: number) => n.toLocaleString("en");
const dayText = (d: [number, number]) => (d[0] === d[1] ? `${d[0]}` : `${d[0]}–${d[1]}`);
const seasonText = (ms: number[]) => {
  const s = [...ms].sort((a, b) => a - b);
  return s.length === 12 ? "All year" : s.map((m) => MONTHS[m - 1]).join(", ");
};
const W = 160;
const H = 34;
const sparkPath = (profile: [number, number][]) => {
  const total = profile.at(-1)![0] || 1;
  const [lo, hi] = eleRange;
  const pts = profile.map(([km, m]) => `${((km / total) * W).toFixed(1)},${(H - ((m - lo) / (hi - lo)) * (H - 2)).toFixed(1)}`);
  return `M0,${H}L${pts.join("L")}L${W},${H}Z`;
};
const sleepText = (t: SearchTrail) =>
  SLEEPING_CATEGORIES.filter((c) => c.id !== "wild-camping" && t.sleeping.includes(c.id))
    .map((c) => c.label)
    .join(" · ");
const WILD = { allowed: "Wild camping allowed", restricted: "Wild camping restricted", prohibited: "No wild camping" };
const WATER_WORD = Object.fromEntries(WATER_LEVELS.map((l) => [l.id, l.label]));
const topLevel = (t: SearchTrail) => ratedDims(t).overall;
const landText = (t: SearchTrail) => {
  const top = Object.entries(t.landscape ?? {}).sort((a, b) => b[1] - a[1])[0];
  const label = top && LANDSCAPES.find((l) => l.id === top[0])?.label;
  return label ? `${top[1] >= 0.5 ? "Mostly" : "Mainly"} ${label}` : null;
};
// passport stamps (2026-11-06, of ten playful previews, H): one per row for a fact that stands out
// among all the trails (these cards may be only some of them, /trails/cards.html the rest): the highest
// point, the shortest and the longest, the least climbing per km, and the five added last ("New")
const everyTrail = await allSearchTrails();
const ranked = (f: (t: SearchTrail) => number | null) => everyTrail.filter((t) => f(t) !== null).sort((a, b) => f(a)! - f(b)!);
const stamps = new Map<string, { word: string; tone: "moss" | "rust" }>();
const stamp = (slug: string | undefined, word: string, tone: "moss" | "rust") => slug && !stamps.has(slug) && stamps.set(slug, { word, tone });
stamp(ranked((t) => t.highestM).at(-1)?.slug, "Highest", "rust");
stamp(ranked((t) => t.compareKm)[0]?.slug, "Shortest", "moss");
stamp(ranked((t) => t.compareKm).at(-1)?.slug, "Longest", "rust");
stamp(ranked((t) => (t.climb && t.compareKm ? t.climb.m / t.compareKm : null))[0]?.slug, "Flattest", "moss");
for (const t of ranked((t) => -Date.parse(t.added)).slice(0, 5)) stamp(t.slug, "New", "moss");
// the profile's top line, which the walker follows (2026-11-06, of ten playful previews, E)
const sparkLine = (profile: [number, number][]) => {
  const total = profile.at(-1)![0] || 1;
  const [lo, hi] = eleRange;
  return `M${profile.map(([km, m]) => `${((km / total) * W).toFixed(1)},${(H - ((m - lo) / (hi - lo)) * (H - 2)).toFixed(1)}`).join("L")}`;
};
const SHAPE = { frequent: "full", regular: "half", scarce: "blocked", allowed: "full", restricted: "half", prohibited: "blocked" } as const;
const TONE = { frequent: "good", regular: "fair", scarce: "poor", allowed: "good", restricted: "fair", prohibited: "poor" } as const;
---

<div class="cards-wrap">
  <h2 class="sr-only">Matching trails</h2>
  <ol class="cards">
    {trails.map((t) => (
      <li data-slug={t.slug}>
        <a class="card" href={`/trails/${t.slug}/`}>
          <span class="c-trail">
            <span class="name">
              {t.name}
              {stamps.get(t.slug) && <span class={`stamp ${stamps.get(t.slug)!.tone}`}><span class="sr-only">, </span>{stamps.get(t.slug)!.word}</span>}
            </span>
            <span class="where">{t.countries.join(" · ")} · {t.start} → {t.end}</span>
            <span class="facts">
              {landText(t) && <span>{landText(t)}</span>}
              {t.water && (
                <span><i class={`mark ${SHAPE[t.water.level]} tone-${TONE[t.water.level]}`} aria-hidden="true"></i>{WATER_WORD[t.water.level]} water</span>
              )}
              {t.wildCamping && (
                <span><i class={`mark ${SHAPE[t.wildCamping]} tone-${TONE[t.wildCamping]}`} aria-hidden="true"></i>{WILD[t.wildCamping]}</span>
              )}
              {sleepText(t) && <span>{sleepText(t)}</span>}
            </span>
          </span>
          <span class="c-num c-len"><span class="lbl">Length</span>{t.lengthKm !== null ? <>{fmt(Math.round(t.lengthKm))}<small>km</small></> : "–"}</span>
          <span class="c-num c-days"><span class="lbl">Days</span>{t.days ? dayText(t.days) : "–"}</span>
          <span class="c-num c-up">
            <span class="lbl">{t.climb?.est ? "Ascent, estimated" : "Ascent"}</span>
            {t.climb ? <>{t.climb.est && <span aria-hidden="true">≈</span>}{fmt(t.climb.m)}<small>m</small></> : "–"}
          </span>
          <span class="c-diff">
            <span class="lbl">Difficulty</span>
            {topLevel(t) && (
              <span class="diff" data-rate={rateData(t.terrainLevel, t.effortLevel, t.climateByMonth, t.season)}>
                <span class="sr-only rate-sr">{ratedDims(t).dims.map((d) => `${d.label}: ${dimSay(d)}`).join("; ")}. Overall: </span>
                <span class="diff-bars" aria-hidden="true">
                  {ratedDims(t).dims.map((d) => (
                    <span class="diff-col" data-dim={d.id} title={`${d.label}: ${dimSay(d)}`}>
                      <span class="diff-bar range" style={`height: ${d.top * 25}%`}></span>
                      <span class="diff-bar lv" style={`height: ${d.level * 25}%`}></span>
                    </span>
                  ))}
                </span>
                <span class="rate-word">{LEVEL_WORDS[topLevel(t)! - 1]}</span>
              </span>
            )}
          </span>
          <span class="c-season">
            <span class="lbl">Season</span>
            {t.season ? (
              <span class="season" aria-label={`Season: ${seasonText(t.season)}`}>
                {MONTHS.map((m, i) => <span class:list={["month", { in: t.season!.includes(i + 1) }]} title={m}></span>)}
              </span>
            ) : (
              <span class="none">Not stated</span>
            )}
          </span>
          <span class="c-prof">
            <span class="lbl">Profile and ground</span>
            {t.profile && (
              <span class="profile" title={`${fmt(t.lowestM!)}–${fmt(t.highestM!)} m`}>
                <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                  <path d={sparkPath(t.profile)} />
                  <circle class="walker" r="3.6" style={`offset-path: path('${sparkLine(t.profile)}')`} />
                </svg>
                {t.surface && (
                  <span class="surface" aria-hidden="true">
                    <span style={`flex: ${t.surface.natural}; background: var(--surface-natural)`}></span>
                    <span style={`flex: ${t.surface.gravel}; background: var(--surface-gravel)`}></span>
                    <span style={`flex: ${t.surface.paved}; background: var(--surface-paved)`}></span>
                  </span>
                )}
                <span class="prof-cap">{fmt(t.lowestM!)}–{fmt(t.highestM!)} m{t.surface && ` · ${Math.round(t.surface.natural * 100)} % natural`}</span>
              </span>
            )}
          </span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  /* rows the filters leave out (TrailList.svelte sets hidden) */
  .cards li[hidden],
  .cards-wrap[hidden] {
    display: none;
  }
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* a row: the table's columns (--cols, TrailList.svelte), a rule beneath */
  .card {
    display: grid;
    grid-template-columns: var(--cols);
    column-gap: var(--col-gap);
    align-items: center;
    padding: 12px 8px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }
  .card:hover {
    background: var(--surface);
  }
  .card:hover .name {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .c-trail {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .name {
    font: 600 1.02rem var(--serif);
  }
  .where,
  .facts {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
  }
  .facts span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  /* status: a shape plus a word, as on the trail pages; colour only fills the shape */
  .mark {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--tone);
  }
  .mark.full {
    background: var(--tone);
  }
  .mark.half {
    background: linear-gradient(90deg, var(--tone) 50%, transparent 50%);
  }
  .mark.blocked {
    background: linear-gradient(135deg, transparent 43%, var(--tone) 43% 57%, transparent 57%);
  }
  .tone-good {
    --tone: var(--good);
  }
  .tone-fair {
    --tone: var(--fair);
  }
  .tone-poor {
    --tone: var(--poor);
  }
  /* the cells' labels: for screen readers and the phone layout only (the header row names them) */
  .lbl {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .c-num {
    font: 600 1rem var(--serif);
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .c-num small {
    margin-left: 2px;
    color: var(--muted);
    font: 400 0.7rem var(--sans);
  }
  /* difficulty: the trail page's key figure, small: one bar per dimension and the hardest as a word */
  .diff {
    display: inline-flex;
    align-items: flex-end;
    gap: 6px;
  }
  .diff-bars {
    display: flex;
    gap: 2px;
    height: 18px;
  }
  .diff-col {
    position: relative;
    width: 6px;
    height: 100%;
    background: var(--line);
    border-radius: 1px 1px 0 0;
  }
  .diff-bar {
    position: absolute;
    inset: auto 0 0;
    background: var(--text);
    border-radius: 1px 1px 0 0;
  }
  .diff-bar.range {
    opacity: 0.4;
  }
  .rate-word {
    font-size: 0.82rem;
    line-height: 1;
  }
  .season {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1px;
  }
  .month {
    height: 14px;
    border-radius: 1px;
    background: var(--surface);
  }
  .card:hover .month:not(.in) {
    background: var(--line);
  }
  .month.in {
    background: color-mix(in srgb, var(--text) 70%, var(--bg));
  }
  .none {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .profile {
    display: grid;
    gap: 2px;
  }
  .profile svg {
    display: block;
    width: 100%;
    height: 30px;
  }
  .profile path {
    fill: var(--accent);
    opacity: 0.5;
  }
  .surface {
    display: flex;
    gap: 1px;
    height: 4px;
  }
  .surface span {
    border-radius: 1px;
  }
  .prof-cap {
    color: var(--muted);
    font-size: 0.7rem;
  }

  /* where the results column is narrower than the table (about 790 px: phones, tablets, and the
     sidebar layout below 1100 px), each row folds into a compact card, the figures labelled; a
     container query on .results (TrailList.svelte), so the table never runs past the page */
  @container results (max-width: 799px) {
    .card {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas:
        "trail trail trail trail"
        "len days up diff"
        "season season prof prof";
      gap: 10px 12px;
      padding: 14px 4px;
    }
    .c-trail {
      grid-area: trail;
    }
    .c-len {
      grid-area: len;
    }
    .c-days {
      grid-area: days;
    }
    .c-up {
      grid-area: up;
    }
    .c-diff {
      grid-area: diff;
      container-type: inline-size;
    }
    /* a narrow column (phones): the word goes under the bars, and "Demanding" fits its column */
    .diff {
      flex-wrap: wrap;
      row-gap: 4px;
    }
    .rate-word {
      font-size: min(0.82rem, 100cqi / 5);
    }
    .c-season {
      grid-area: season;
    }
    .c-prof {
      grid-area: prof;
    }
    .lbl {
      position: static;
      display: block;
      width: auto;
      height: auto;
      clip-path: none;
      color: var(--muted);
      font: 400 0.7rem var(--sans);
      white-space: normal;
    }
    .c-num {
      text-align: left;
    }
    .name {
      font-size: 1.1rem;
    }
  }

  /* passport stamps: one fact per row beside the name, slightly askew */
  .stamp {
    display: inline-block;
    margin-left: 10px;
    padding: 1px 7px;
    border: 1.5px solid currentColor;
    border-radius: 4px;
    font: 700 10px/1.5 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: 3px;
    transform: rotate(-4deg);
  }
  .stamp.moss {
    color: var(--accent-text);
  }
  .stamp.rust {
    color: var(--poor);
  }
  /* the walker: a dot that walks the trail's profile while its row is pointed at or focused */
  .walker {
    fill: var(--poor);
    stroke: var(--bg);
    stroke-width: 1.5;
    offset-distance: 0%;
    offset-rotate: 0deg;
    opacity: 0;
    transition: opacity 0.2s;
    animation: walk 4s linear infinite paused;
  }
  .card:hover .walker,
  .card:focus-visible .walker {
    opacity: 1;
    animation-play-state: running;
  }
  @keyframes walk {
    to {
      offset-distance: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .walker {
      animation: none;
    }
  }
</style>
