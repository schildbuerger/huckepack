---
// A trail page's head on its own skyline in miniature (issue #142; of three previews, approach B, the
// postcard): a band wall to wall from the header down, its sky following the visitor's clock like the
// home page's hero (src/lib/sky.ts), the breadcrumb and the name on the left in clear sky, and at the
// lower right the mountains the trail is known for, drawn by hand (src/lib/skylines.ts) and seen from far
// away, with the trail's own elevation profile as the nearest ridge. The drawing has no cut edges: the
// massif slopes down and the ridge tapers into the ground, which runs across the band's foot. Flat colours
// and shapes only, shaded and detailed (src/lib/skyline-detail.ts); the drawing is decorative (aria-hidden), the name is the page's h1.
import { SKYLINES, SKY_W, SKY_H, SKY_TOP, profileRidge } from "../lib/skylines";
// the drawing's detail: shadow faces, shaded snow, tree crowns, glints (src/lib/skyline-detail.ts)
import { withDetail } from "../lib/skyline-detail";

interface Props {
  slug: string;
  name: string;
  localName?: string;
  points: [number, number][]; // the elevation profile, [km, metres]
  routeKm: number;
}
const { slug, name, localName, points, routeKm } = Astro.props;
const sky = SKYLINES[slug];

// the drawing's box (SKY_W × SKY_H), shown from just above the highest summit (SKY_TOP) to the ground;
// the trail's own profile as the nearest ridge (profileRidge, shared with the link-preview image)
const ridge = profileRidge(points, routeKm);
---

{
  sky && (
    <div class="skyline" style={`--ground: ${sky.ground}`}>
      <div class="sk-crumbs">
        <slot name="crumbs" />
      </div>
      <div class="sk-title">
        <h1>{name}</h1>
        {localName && <p class="sk-local">{localName}</p>}
      </div>
      <div class="sk-scene" aria-hidden="true">
        <span class="sk-sun" data-theme-sun />
        <svg class="sk-svg" viewBox={`0 ${SKY_TOP} ${SKY_W} ${SKY_H - SKY_TOP}`} preserveAspectRatio="xMidYMax meet">
          {withDetail(sky, ridge).map((s) => (
            <path class="sk-shape" d={s.d} style={`--c: ${s.c}`} />
          ))}
        </svg>
      </div>
    </div>
  )
}

<style>
  /* the band: wall to wall from the header down; the breadcrumb and the name in the page's column on the
     left, the miniature at the lower right standing on the ground that runs across the band's foot */
  .skyline {
    --ground-h: 14px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: 32px;
    /* the section navigation follows right below it (issue #208) */
    margin: 0 calc(50% - 50vw);
    padding: 0 max(16px, calc(50vw - 600px)) var(--ground-h);
    overflow-x: clip;
    background: #d9e8e1;
    /* the sky fades over when the theme switches (Base.astro) */
    transition: background-color 0.5s;
  }
  :global(html[data-sky="dawn"]) .skyline {
    background: #f2d8c2;
  }
  :global(html[data-sky="dusk"]) .skyline {
    background: #e7c0a2;
  }
  :global(html[data-sky="night"]) .skyline {
    background: #1d2733;
  }
  :global(body) {
    overflow-x: clip;
  }
  /* the ground: a strip of meadow along the band's foot, wall to wall */
  .skyline::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--ground-h);
    background: var(--ground);
    transition: background-color 0.5s;
  }
  :global(html[data-sky="night"]) .skyline::after {
    background: color-mix(in srgb, var(--ground) 35%, #1d2733);
  }

  /* the breadcrumb and the name, in the sky's colours: dark by day, light at night, whatever the theme */
  .sk-title :is(h1, .sk-local),
  .sk-crumbs :global(.crumbs :is(a, li, [aria-current="page"])) {
    transition: color 0.5s;
  }
  .sk-crumbs {
    grid-column: 1;
    grid-row: 1;
  }
  .sk-crumbs :global(.crumbs) {
    margin-top: 16px;
  }
  .sk-crumbs :global(.crumbs :is(a, li, [aria-current="page"])),
  .sk-crumbs :global(.crumbs li + li::before) {
    color: #3c3d30;
  }
  :global(html[data-sky="night"]) .sk-crumbs :global(.crumbs :is(a, li, [aria-current="page"])),
  :global(html[data-sky="night"]) .sk-crumbs :global(.crumbs li + li::before) {
    color: #c3c2b0;
  }
  .sk-title {
    position: relative;
    z-index: 2;
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    padding: 18px 0 26px;
  }
  .sk-title h1 {
    margin: 0;
    color: #25261c;
  }
  .sk-local {
    margin: 4px 0 0;
    color: #4a4b3b;
    font-style: italic;
  }
  :global(html[data-sky="night"]) .sk-title h1 {
    color: #ecebdb;
  }
  :global(html[data-sky="night"]) .sk-local {
    color: #c3c2b0;
  }

  /* the miniature: over both rows at the lower right, the sun (or the moon) just above it, behind its
     mountains */
  .sk-scene {
    position: relative;
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    width: min(46vw, 640px);
    margin-top: 12px;
  }
  .sk-svg {
    position: relative;
    z-index: 1;
    /* clicks pass through the drawing to the sun behind it (the easter egg, issue #155) */
    pointer-events: none;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 264;
  }
  .sk-sun {
    position: absolute;
    z-index: 0;
    left: var(--sun-x, 70%);
    top: calc(var(--sun-y, 20%) * 0.6);
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    background: #f6c453;
  }
  :global(html[data-sky="night"]) .sk-sun {
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    background: #ecebdb;
    box-shadow: inset -6px -2px 0 0 #1d2733;
  }
  /* phones: the name over the miniature, which keeps to the right */
  @media (max-width: 719px) {
    .skyline {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }
    .sk-title {
      padding-bottom: 8px;
    }
    .sk-scene {
      grid-column: 1;
      grid-row: 3;
      justify-self: end;
      width: min(100%, 420px);
      margin-top: 0;
    }
  }

  /* every shape in its own flat colour (src/lib/skylines.ts); at night the same colours sunk into the
     night sky, so the landscape keeps its shapes and tones but goes dark */
  .sk-shape {
    fill: var(--c);
    transition: fill 0.5s;
  }
  :global(html[data-sky="night"]) .sk-shape {
    fill: color-mix(in srgb, var(--c) 35%, #1d2733);
  }
</style>
