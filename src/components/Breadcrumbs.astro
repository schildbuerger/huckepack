---
// Breadcrumb for every page except the home page: Start › … › the current page. Pass the
// pages above the current one as `trail` ({ label, href }); "Start" is always first.
interface Props {
  trail?: { label: string; href: string }[];
  current: string;
}
const { trail = [], current } = Astro.props;
const links = [{ label: "Start", href: "/" }, ...trail];
// the same path for search engines (schema.org BreadcrumbList, shown in results as the page's
// path); "<" escaped so no name can close the script
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [...links, { label: current, href: Astro.url.pathname }].map((l, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: l.label,
    item: new URL(l.href.replace(/\/?$/, "/"), Astro.site).href,
  })),
}).replace(/</g, "\\u003c");
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {links.map((l) => (
      <li>
        <a href={l.href}>{l.label}</a>
      </li>
    ))}
    <li aria-current="page">{current}</li>
  </ol>
</nav>
<script type="application/ld+json" set:html={ld} />

<style>
  .crumbs {
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .crumbs li + li::before {
    content: "›";
    margin: 0 8px;
  }
  .crumbs a {
    color: var(--muted);
  }
  .crumbs [aria-current="page"] {
    color: var(--text);
  }
</style>
