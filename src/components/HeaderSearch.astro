---
// The header's search on every page (issue #154; of three previews, approach A): a magnifier button
// that opens the trail search (TrailSearch: places, filters and trails with suggestions) in the header
// row, left of the button, and puts the focus in the field. Open, the magnifier is the search button
// (the Baymard review of 2026-11-07: one role per control): it goes where Enter goes. The field's ×
// clears it, or closes the search when it is empty; Esc (after the suggestions) or a click outside
// closes it too. The button's hit area is 44 px (7 mm) round its 34 px circle.
import TrailSearch from "./TrailSearch.astro";
import Icon from "./Icon.astro";
---

<div class="hsearch" data-hsearch>
  <button type="button" class="hs-toggle" aria-expanded="false" aria-controls="hs-panel" aria-label="Open the search" title="Search trails">
    <Icon name="search" size={17} />
  </button>
  <div class="hs-panel" id="hs-panel" hidden>
    <div class="hs-inner">
      <TrailSearch id="search-header" size="compact" placeholder="Trail, country or region" />
    </div>
  </div>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-hsearch]")) {
    const toggle = box.querySelector<HTMLButtonElement>(".hs-toggle")!;
    const panel = box.querySelector<HTMLElement>(".hs-panel")!;
    const search = panel.querySelector<HTMLElement>("[data-search]")!;
    const input = panel.querySelector<HTMLInputElement>("input")!;
    const set = (open: boolean) => {
      panel.hidden = !open;
      // closed: a disclosure that opens the field; open: the search's submit button
      if (open) {
        toggle.removeAttribute("aria-expanded");
        toggle.setAttribute("aria-label", "Search");
        toggle.title = "Search";
      } else {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open the search");
        toggle.title = "Search trails";
      }
      box.classList.toggle("open", open);
      document.documentElement.classList.toggle("hsearch-open", open);
      if (open) input.focus();
    };
    toggle.addEventListener("click", () => {
      if (panel.hidden) return set(true);
      if (input.value.trim()) search.dispatchEvent(new CustomEvent("searchgo"));
      else input.focus();
    });
    search.addEventListener("searchclose", () => {
      set(false);
      toggle.focus();
    });
    box.addEventListener("keydown", (e) => {
      // the field's own Escape closes its suggestions first (TrailSearch); a second one closes the search
      if (e.key === "Escape" && !panel.hidden && input.getAttribute("aria-expanded") !== "true") {
        set(false);
        toggle.focus();
      }
    });
    document.addEventListener("pointerdown", (e) => {
      if (!panel.hidden && !box.contains(e.target as Node)) set(false);
    });
  }
</script>

<style>
  .hsearch {
    display: flex;
    align-items: center;
  }
  .hs-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
  }
  /* 44 px to tap, the look unchanged */
  .hs-toggle::before {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
  }
  .hs-toggle:hover,
  .open .hs-toggle {
    background: var(--surface);
  }
  .hs-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* the field opens in the header row, left of the button */
  .hsearch {
    position: relative;
  }
  .hs-panel {
    position: absolute;
    top: 50%;
    right: 42px;
    z-index: 50;
    width: 280px;
    transform: translateY(-50%);
  }
  /* phones: over the logo, across the header bar (the header is the anchor, so the field stays with it
     when the page scrolls), stopping short of the button, which searches; the suggestions hang from
     the field across the screen */
  @media (max-width: 559px) {
    .hsearch {
      position: static;
    }
    .hs-panel {
      top: 12px;
      /* clear of the button: the page margin (16) + the button (34) + 8 */
      right: 58px;
      left: 16px;
      width: auto;
      transform: none;
    }
    .hs-panel :global(.compact .results) {
      position: absolute;
      inset: calc(100% + 6px) -42px auto 0;
      width: auto;
    }
  }
</style>
