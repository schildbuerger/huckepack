---
// Animals and plants that can be dangerous to hikers on the trail (issue #156): a band wall to wall, like
// the page head, with the trail's own skyline behind (src/lib/animal-art.ts) and the animals and plants
// as silhouettes (PhyloPic) standing in front, each named above it like a panorama board's (the name,
// and low, moderate or high as a three-step meter and the word in the status colour, so the level never
// rests on colour alone, joined to its body by a leader line; the name underlined as a link). The
// section's heading and the (i) sit in the band's sky, in line with the page's content. A click or tap
// on one opens a dialog in the middle of the screen with why the level, and what to do and not to do in
// the official source's words; Esc, Close or a click beside it closes it. On phones the band scrolls
// sideways. Where a trail lists none (issue #206), the section still shows: the empty band with a
// tumbleweed blowing through, which opens a note saying whether the official source names no dangers
// or no official source was found.
import Explain from "./Explain.astro";
import { backdrop, SCENE_W, SCENE_H, BLEED, TOP, place, silhouette, credit, type AnimalKind } from "../lib/animal-art";

type Danger = {
  kind: AnimalKind;
  name: string;
  level: "low" | "moderate" | "high";
  basis: string;
  do: string[];
  dont: string[];
  source: string;
};
interface Props {
  animals: Danger[];
  plants: Danger[];
  none?: { text: string; source: string };
  sourceName: (id: string) => string;
  slug: string;
}
const { animals, plants, none, sourceName, slug } = Astro.props;

const LEVELS = { low: { word: "Low", n: 1 }, moderate: { word: "Moderate", n: 2 }, high: { word: "High", n: 3 } } as const;
const ORDER = ["high", "moderate", "low"] as const;
const sorted = [...animals.map((a) => ({ ...a, plant: false })), ...plants.map((a) => ({ ...a, plant: true }))].sort(
  (a, b) => ORDER.indexOf(a.level) - ORDER.indexOf(b.level),
);
const sources = [...new Set(sorted.map((a) => a.source))].map(sourceName);
const meter = (n: number) => [1, 2, 3].map((i) => i <= n);
const spots = place(sorted.map((a) => a.kind));
// the labels, like a panorama board's: one line in the sky above the mountains, each joined to its
// animal by a leader; the name without its list of species ("Snakes (Cape cobra, …)" reads "Snakes")
const LABEL_Y = 30;
const shortName = (name: string) => name.replace(/\s*\(.*\)\s*$/, "");
const what = plants.length ? (animals.length ? "Animals and plants" : "Plants") : "Animals";

// Nothing listed (issue #206): the section still shows, with a tumbleweed rolling through; a click on it
// opens the note, which says whether the official source names no dangers or none was found
const empty = sorted.length === 0;
const note = none
  ? { title: "No known dangers", text: none.text, src: `Source: ${sourceName(none.source)}.` }
  : {
      title: "Nothing found",
      text: "We found no official source on dangerous animals or plants along this trail, so none is listed. That doesn't mean there are none: ask locally before you go.",
      src: "Only official sources count here; none covered this trail's wildlife when we checked.",
    };
// the tumbleweed: loops of dry stems round its middle, a few twigs sticking out, drawn once at the
// origin with radius TW_R (fixed seed, so every build draws the same one)
const TW_R = 17;
const seed = (() => {
  let v = 11;
  return () => (v = (v * 16807) % 2147483647) / 2147483647;
})();
const loop = () =>
  `<ellipse cx="${((seed() - 0.5) * TW_R * 0.5).toFixed(1)}" cy="${((seed() - 0.5) * TW_R * 0.5).toFixed(1)}" rx="${(TW_R * (0.5 + seed() * 0.45)).toFixed(1)}" ry="${(TW_R * (0.25 + seed() * 0.45)).toFixed(1)}" transform="rotate(${(seed() * 180).toFixed(0)})"/>`;
const twig = () => {
  const a = seed() * Math.PI * 2;
  const [r0, r1] = [TW_R * 0.7, TW_R * (1.05 + seed() * 0.25)];
  return `M${(Math.cos(a) * r0).toFixed(1)} ${(Math.sin(a) * r0).toFixed(1)}L${(Math.cos(a) * r1).toFixed(1)} ${(Math.sin(a) * r1).toFixed(1)}`;
};
const weed = [
  `<circle class="tw-body" r="${TW_R * 0.82}"/>`,
  `<g class="tw-back">${Array.from({ length: 8 }, loop).join("")}</g>`,
  `<g class="tw-front">${Array.from({ length: 7 }, loop).join("")}<path d="${Array.from({ length: 9 }, twig).join("")}"/></g>`,
].join("");
const TW_GROUND = 262; // where it rolls in the band, in front of where large animals would stand
---

{
  empty && (
    <section id="animals" class="band tw-empty" data-tw>
      <div class="band-head">
        <h2>Wildlife</h2>
      </div>
      <figure class="wild tw-band">
        <div class="scroll">
          <svg class="scene" viewBox={`${-BLEED} ${-TOP} ${SCENE_W + 2 * BLEED} ${SCENE_H + TOP}`} preserveAspectRatio="xMidYMax slice">
            <g aria-hidden="true" set:html={backdrop(slug)} />
            <ellipse class="tw-shadow" cx="450" cy={TW_GROUND + 1} rx={TW_R} ry="3.5" />
            <g class="tw-puffs" aria-hidden="true" />
            <g class="tw-weed" data-ground={TW_GROUND} data-r={TW_R} role="button" tabindex="0" aria-haspopup="dialog" aria-label={`Wildlife: ${note.title}. What this means`}>
              <circle class="hit" r={TW_R + 12} />
              <g class="tw-spin" set:html={weed} />
            </g>
          </svg>
        </div>
      </figure>
      <dialog class="an-dialog tw-dialog" aria-labelledby="tw-d-title">
        <div class="d-head">
          <svg class="d-art" viewBox={`${-TW_R * 1.4} ${-TW_R * 1.4} ${TW_R * 2.8} ${TW_R * 2.8}`} aria-hidden="true" set:html={weed} />
          <div>
            <h3 id="tw-d-title">{note.title}</h3>
            <p class="an-level">No dangerous animals or plants listed</p>
          </div>
          <button type="button" class="d-close" aria-label="Close">✕</button>
        </div>
        <div class="d-body">
          <p class="d-basis">{note.text}</p>
          <p class="d-src">{note.src} Tumbleweed: drawn by us.</p>
        </div>
      </dialog>
    </section>
  )
}
{
  !empty && (
    <section id="animals" class="band">
      <div class="band-head">
        <h2>Wildlife</h2>
        {sorted.length > 0 && (
          <div class="chart-info">
            <Explain id="animals-info" icon term="About this chart" title="Wildlife">
              <dl class="pop-facts">
                <dt>Shows</dt><dd>{what} that can be dangerous to hikers on this trail: large animals, venomous snakes, scorpions and spiders, ticks, and plants that harm on touch</dd>
                <dt>Level</dt><dd>Ours, read from the official source</dd>
                <dt>High</dt><dd>A bite of a species it calls common can be life-threatening within hours</dd>
                <dt>Moderate</dt><dd>It warns of attacks or serious harm, or places the trail in a risk area for tick-borne encephalitis</dd>
                <dt>Low</dt><dd>The harm is mostly minor or treatable, or avoidable by how you behave</dd>
                <dt>What to do</dt><dd>From the official source{sources.length > 1 ? "s" : ""}: {sources.join("; ")}</dd>
                <dt>Pictures</dt><dd>Silhouettes from PhyloPic, not to scale, each maker named with its advice; the landscape is the trail's own, drawn by us</dd>
              </dl>
            </Explain>
          </div>
        )}
      </div>

      {sorted.length > 0 && (
        <figure class="wild" data-wild>
          <div class="scroll">
            <svg
              class="scene"
              viewBox={`${-BLEED} ${-TOP} ${SCENE_W + 2 * BLEED} ${SCENE_H + TOP}`}
              preserveAspectRatio="xMidYMax slice"
              role="group"
              aria-label={`The trail's ${what.toLowerCase()}`}
            >
              <g aria-hidden="true" set:html={backdrop(slug)} />
              {spots.map((p, i) => {
                const a = sorted[i];
                const word = LEVELS[a.level].word;
                const lw = 22 + word.length * 8;
                return (
                  <g
                    class={`pick lv-${a.level}`}
                    tabindex="0"
                    role="button"
                    aria-haspopup="dialog"
                    aria-label={`${shortName(a.name)} ${word} danger: ${shortName(a.name) === a.name ? "" : `${a.name}, `}what to do`}
                    data-pick={i}
                  >
                    <rect class="hit" x={p.x - 6} y={p.y - 8} width={p.w + 12} height={p.h + 14} rx="10" />
                    <rect class="hit" x={p.hx - 70} y={LABEL_Y - 18} width="140" height="44" rx="8" />
                    <ellipse class="shadow" cx={p.cx} cy={p.base + 1} rx={p.w * 0.42} ry="4" />
                    <path class="leader" d={`M${p.hx} ${LABEL_Y + 24} V${p.hy - 6}`} />
                    <circle class="leader-dot" cx={p.hx} cy={p.hy - 6} r="2.4" />
                    <image class="animal" href={silhouette(p.kind).url} x={p.x} y={p.y} width={p.w} height={p.h} preserveAspectRatio="xMidYMax meet" />
                    <!-- the name begins with these words (the name, then the level), so a space ends this one -->
                    <text class="label-name" x={p.hx} y={LABEL_Y}>
                      {`${shortName(a.name)} `}
                    </text>
                    <g class="label-level" transform={`translate(${p.hx - lw / 2} ${LABEL_Y + 9})`}>
                      {meter(LEVELS[a.level].n).map((on, k) => (
                        <rect class:list={["pip", { on }]} x={k * 6} y="2" width="4.5" height="6" rx="1" />
                      ))}
                      <text x="22" y="8.4">
                        {word}
                      </text>
                    </g>
                  </g>
                );
              })}
            </svg>
          </div>

          {sorted.map((a, i) => (
            <dialog class={`an-dialog lv-${a.level}`} data-dialog={i} aria-labelledby={`an-d-${i}`}>
              <div class="d-head">
                <img class="d-art" src={silhouette(a.kind).url} alt="" />
                <div>
                  <h3 id={`an-d-${i}`}>{a.name}</h3>
                  <p class="an-level">
                    <span class="meter" aria-hidden="true">{meter(LEVELS[a.level].n).map((on) => <span class:list={{ on }} />)}</span>
                    {LEVELS[a.level].word} danger
                  </p>
                </div>
                <button type="button" class="d-close" aria-label="Close">
                  ✕
                </button>
              </div>
              <div class="d-body">
                <p class="d-basis">{a.basis}</p>
                <div class="d-cols">
                  <div>
                    <p class="an-sub">{a.plant ? "What to do" : "If you meet one"}</p>
                    <ul class="an-do">{a.do.map((d) => <li>{d}</li>)}</ul>
                  </div>
                  {a.dont.length > 0 && (
                    <div>
                      <p class="an-sub">Don't</p>
                      <ul class="an-dont">{a.dont.map((d) => <li>{d}</li>)}</ul>
                    </div>
                  )}
                </div>
                <p class="d-src">
                  Advice: {sourceName(a.source)}. Level: ours. Silhouette: {credit(a.kind)}.
                </p>
              </div>
            </dialog>
          ))}
        </figure>
      )}
    </section>
  )
}

<script>
  // The tumbleweed (issue #206): blown through the band in hops, in the scene's own units, one frame at
  // a time while the section is on screen: the wind gusts, it rolls and hops, bounces on landing with a
  // puff of dust, leaves the band and comes back a few seconds later. A click, tap, Enter or Space
  // makes it hop and opens the note; visitors who prefer reduced motion see it resting in the middle
  for (const sec of document.querySelectorAll<HTMLElement>("[data-tw]")) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const dialog = sec.querySelector<HTMLDialogElement>(".tw-dialog")!;
    const host = sec.querySelector<HTMLElement>(".tw-band")!;
    const svg = host.querySelector<SVGSVGElement>("svg")!;
    const weed = svg.querySelector<SVGGElement>(".tw-weed")!;
    const spin = weed.querySelector<SVGGElement>(".tw-spin")!;
    const shadow = svg.querySelector<SVGEllipseElement>(".tw-shadow")!;
    const puffs = svg.querySelector<SVGGElement>(".tw-puffs")!;
    const GROUND = Number(weed.dataset.ground);
    const R = Number(weed.dataset.r);
    const G = 760;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    // the part of the drawing on screen, in its own units (the band crops it at the sides)
    const bounds = () => {
      const r = host.querySelector(".scroll")!.getBoundingClientRect();
      const m = svg.getScreenCTM()!.inverse();
      return [new DOMPoint(r.left, r.top).matrixTransform(m).x, new DOMPoint(r.right, r.top).matrixTransform(m).x];
    };
    let [lo, hi] = bounds();
    let x = reduce ? (lo + hi) / 2 : lo - R * 3;
    let y = 0; // height above the ground
    let vx = 0;
    let vy = 0;
    let rot = 0;
    let wait = 0; // off screen until it comes back
    let still = rand(0.2, 0.8); // time on the ground before the next hop
    let t = 0;

    const puff = (strength: number) => {
      for (const side of [-1, 1]) {
        const c = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        c.setAttribute("class", "tw-puff");
        c.setAttribute("cx", String(x + side * R * 0.7));
        c.setAttribute("cy", String(GROUND - 2));
        c.setAttribute("r", "3");
        puffs.append(c);
        c.animate(
          [
            { transform: "translate(0, 0) scale(1)", opacity: 0.5 },
            { transform: `translate(${side * 10}px, -4px) scale(${1.6 + strength})`, opacity: 0 },
          ],
          { duration: 520, easing: "ease-out" },
        ).onfinish = () => c.remove();
      }
    };
    const hop = (v: number) => {
      vy = v;
      still = rand(0.15, 0.9);
    };
    const render = () => {
      weed.setAttribute("transform", `translate(${x.toFixed(1)} ${(GROUND - R - y).toFixed(1)})`);
      spin.setAttribute("transform", `rotate(${rot.toFixed(1)})`);
      const lift = Math.min(0.6, y / 160);
      shadow.setAttribute("cx", x.toFixed(1));
      shadow.setAttribute("rx", (R * 0.95 * (1 - lift)).toFixed(1));
      shadow.style.opacity = String(0.22 * (1 - lift));
    };
    const step = (dt: number) => {
      if (wait > 0) {
        if ((wait -= dt) <= 0) {
          [lo, hi] = bounds();
          x = lo - R * 3;
          y = vy = 0;
        }
        return;
      }
      const wind = 82 * (1 + 0.45 * Math.sin(t * 0.8) + 0.25 * Math.sin(t * 2.3 + 1));
      vx += (wind - vx) * Math.min(1, dt * 1.2);
      if (y === 0 && vy === 0 && (still -= dt) <= 0) hop(Math.random() < 0.12 ? rand(300, 360) : rand(90, 200));
      // in the air: gravity, a bounce on landing (with dust), then rolling until the next hop
      if (y > 0 || vy > 0) {
        vy -= G * dt;
        y += vy * dt;
        if (y <= 0) {
          y = 0;
          if (vy < -90) puff(Math.min(1, -vy / 400));
          vy = vy < -130 ? -vy * 0.42 : 0;
        }
      }
      x += vx * dt;
      rot += ((vx * dt) / R) * (180 / Math.PI);
      if (x > hi + R * 3) wait = rand(1.5, 4.5);
    };

    let raf = 0;
    let last = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      t += dt;
      step(dt);
      render();
      raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver(([en]) => {
      cancelAnimationFrame(raf);
      if (!en.isIntersecting || reduce) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }).observe(host);
    addEventListener("resize", () => {
      [lo, hi] = bounds();
      if (reduce) {
        x = (lo + hi) / 2;
        render();
      }
    });
    render();

    const open = () => {
      if (!reduce && y === 0) hop(260);
      dialog.showModal();
      dialog.addEventListener("close", () => weed.focus({ preventScroll: true }), { once: true });
    };
    weed.addEventListener("click", open);
    weed.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        open();
      }
    });
    dialog.querySelector(".d-close")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<script>
  // a click, tap, Enter or Space on an animal or plant opens its dialog; Esc, Close or a click on the
  // backdrop closes it, and the focus returns to it. On phones the band scrolls sideways; it starts
  // centred on the scene
  for (const box of document.querySelectorAll<HTMLElement>("[data-wild]")) {
    const scroll = box.querySelector<HTMLElement>(".scroll")!;
    scroll.scrollLeft = (scroll.scrollWidth - scroll.clientWidth) / 2;
    const dialogs = box.querySelectorAll<HTMLDialogElement>("[data-dialog]");
    for (const p of box.querySelectorAll<SVGGElement>("[data-pick]")) {
      const dialog = dialogs[Number(p.dataset.pick)];
      const open = () => {
        dialog.showModal();
        dialog.addEventListener("close", () => p.focus({ preventScroll: true }), { once: true });
      };
      p.addEventListener("click", open);
      p.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open();
        }
      });
    }
    for (const dialog of dialogs) {
      dialog.querySelector(".d-close")!.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  }
</script>

<style>
  /* the section 36 px from the one before, as the trail page's others */
  section {
    margin-top: 36px;
    scroll-margin-top: 64px;
    /* skipped until near the screen, like the trail page's other lower sections (issue #95) */
    content-visibility: auto;
    contain-intrinsic-size: auto 320px;
  }
  /* the band: wall to wall like the page head (TrailSkyline.astro), the heading and the (i) in its sky,
     in line with the page's content column */
  .band {
    position: relative;
    margin-inline: calc(50% - 50vw);
    overflow-x: clip;
    /* the day sky behind the drawing, should a screen ever be wider than it (night in dark mode) */
    background: #d9e8e1;
  }
  .band-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .band .band-head {
    position: absolute;
    z-index: 2;
    top: 10px;
    left: max(16px, calc(50vw - 600px));
    right: max(16px, calc(50vw - 600px));
    pointer-events: none;
  }
  .band .band-head > * {
    pointer-events: auto;
  }
  .band-head h2 {
    margin: 0;
  }
  @media (min-width: 1080px) {
    .band-head h2 {
      font-size: 1.15rem;
      line-height: 1.25;
    }
  }
  /* the heading in the scene's ink on its day sky, whatever the theme (the sky's colours are fixed) */
  .band .band-head h2 {
    color: #2b3026;
  }
  .band .chart-info :global(.term.icon) {
    color: #2b3026;
  }
  /* levels: the status colours (Base.astro), soft for fills */
  .lv-low {
    --lv: var(--good);
    --lv-soft: var(--good-soft);
  }
  .lv-moderate {
    --lv: var(--fair);
    --lv-soft: var(--fair-soft);
  }
  .lv-high {
    --lv: var(--poor);
    --lv-soft: var(--poor-soft);
  }

  .wild {
    margin: 0;
  }
  /* the scene fills the band's width and a fixed height, cropped at the sides on narrow screens (the
     scene's middle, where the animals stand, always shows); phones scroll it sideways */
  .scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .scene {
    display: block;
    width: 100%;
    height: clamp(320px, 25vw, 380px);
  }
  @media (max-width: 759px) {
    .scene {
      width: 1000px;
      height: 320px;
    }
  }
  /* fixed colours, like a picture (the skylines' rule); in dark mode the night (issue #209): the night
     sky, and every colour sunk into it as the skylines' are at night (35 %) */
  .scene :global(.sky) {
    --c: #dfe9ec;
  }
  .scene :global(.far) {
    --c: #bccad0;
  }
  .scene :global(.snow) {
    --c: #f4f6f5;
  }
  .scene :global(.hills) {
    --c: #a9c19c;
  }
  .scene :global(.trees) {
    --c: #6f9474;
  }
  .scene :global(.meadow) {
    --c: #9dbb78;
  }
  .scene :global(.rock) {
    --c: #a59c88;
  }
  .scene :global(.bush) {
    --c: #7f9f5c;
  }
  .scene :global(.ground) {
    --c: #8fae66;
  }
  .scene :global(:is(.bd, .sky, .far, .snow, .hills, .trees, .meadow, .rock, .bush, .ground)) {
    fill: var(--c);
  }
  :global(html[data-theme="dark"]) .scene :global(:is(.bd, .far, .snow, .hills, .trees, .meadow, .rock, .bush, .ground)) {
    fill: color-mix(in srgb, var(--c) 35%, #1d2733);
  }
  :global(html[data-theme="dark"]) .scene :global(:is(.bd-sky, .sky)) {
    fill: #1d2733;
  }
  :global(html[data-theme="dark"]) .band {
    background: #1d2733;
  }
  /* the night fades in when the theme switches (Base.astro) */
  .band {
    transition: background-color 0.5s;
  }
  .scene :global(:is(.bd, .bd-sky, .sky, .far, .snow, .hills, .trees, .meadow, .rock, .bush, .ground)) {
    transition: fill 0.5s;
  }
  /* at night the ink is light: the heading, the labels and their leaders, the levels in the dark
     theme's status colours; the silhouettes keep their dark ink, as by day, a little darker still so
     they stand out on the night ground */
  :global(html[data-theme="dark"]) .animal {
    filter: brightness(0.45);
  }
  :global(html[data-theme="dark"]) .pick:hover .animal {
    filter: brightness(0.15);
  }
  :global(html[data-theme="dark"]) .band .band-head h2,
  :global(html[data-theme="dark"]) .band .chart-info :global(.term.icon) {
    color: #ecebdb;
  }
  :global(html[data-theme="dark"]) :is(.label-name, .leader-dot) {
    fill: #ecebdb;
  }
  :global(html[data-theme="dark"]) .leader {
    stroke: #ecebdb;
  }
  :global(html[data-theme="dark"]) .pick .shadow {
    fill: #000;
    opacity: 0.35;
  }
  :global(html[data-theme="dark"]) .pick:focus-visible .hit,
  :global(html[data-theme="dark"]) .tw-weed:focus-visible .hit {
    stroke: #ecebdb;
  }
  :global(html[data-theme="dark"]) .lv-low {
    --lv-pill: var(--good);
  }
  :global(html[data-theme="dark"]) .lv-moderate {
    --lv-pill: var(--fair);
  }
  :global(html[data-theme="dark"]) .lv-high {
    --lv-pill: var(--poor);
  }
  .pick {
    cursor: pointer;
    outline: none;
  }
  .pick .hit {
    fill: transparent;
  }
  .pick .shadow {
    fill: #2b3026;
    opacity: 0.18;
