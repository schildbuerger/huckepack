---
// A trail's photos in a gallery (2026-11-05, with the mosaic, TrailPhotos.astro): a modal dialog with the
// photo as large as the window allows, its caption and credit (author, licence, Wikimedia Commons,
// linked to its file page), where it lies on the route, previous and next (buttons, arrow keys, a
// swipe), a strip of thumbnails, Esc, the close button or a click beside the photo to leave; focus
// returns to what opened it. Any element with data-photo="<index>" opens it at that photo.
import type { Photo } from "./TrailPhotos.astro";
interface Props {
  photos: Photo[];
  trailName: string;
}
const { photos, trailName } = Astro.props;
---

<dialog class="pg" aria-label={`Photos: ${trailName}`} data-pg>
  <div class="pg-top">
    <span class="pg-count" data-pg-count></span>
    <button type="button" class="pg-close" data-pg-close aria-label="Close the photos">×</button>
  </div>
  <div class="pg-stage" data-pg-stage>
    <button type="button" class="pg-nav pg-prev" data-pg-prev aria-label="Previous photo">‹</button>
    <img class="pg-img" data-pg-img alt="" />
    <button type="button" class="pg-nav pg-next" data-pg-next aria-label="Next photo">›</button>
  </div>
  <p class="pg-cap"><span class="pg-title" data-pg-title></span> <span class="pg-credit" data-pg-credit></span></p>
  <ol class="pg-thumbs">
    {photos.map((p, i) => (
      <li><button type="button" data-pg-go={i} aria-label={`Photo ${i + 1}: ${p.caption}`}><img src={p.thumb} alt="" loading="lazy" /></button></li>
    ))}
  </ol>
</dialog>
<script type="application/json" id="pg-data" set:html={JSON.stringify(photos).replaceAll("<", "\\u003c")} />

<script>
  type Photo = { src: string; caption: string; author: string; licence: string; page: string; km: number | null };
  const dlg = document.querySelector<HTMLDialogElement>("[data-pg]")!;
  const photos: Photo[] = JSON.parse(document.getElementById("pg-data")!.textContent!);
  const img = dlg.querySelector<HTMLImageElement>("[data-pg-img]")!;
  const title = dlg.querySelector<HTMLElement>("[data-pg-title]")!;
  const credit = dlg.querySelector<HTMLElement>("[data-pg-credit]")!;
  const count = dlg.querySelector<HTMLElement>("[data-pg-count]")!;
  const thumbs = [...dlg.querySelectorAll<HTMLButtonElement>("[data-pg-go]")];
  let at = 0;
  let opener: HTMLElement | null = null;
  const show = (i: number) => {
    at = (i + photos.length) % photos.length;
    const p = photos[at];
    img.src = p.src;
    img.alt = p.caption;
    title.textContent = p.caption;
    credit.innerHTML = "";
    const a = document.createElement("a");
    a.href = p.page;
    a.target = "_blank";
    a.rel = "noopener"; // a Commons file page, followed like the photo credits in the Sources
    a.textContent = `Photo: ${p.author}, ${p.licence}, Wikimedia Commons`;
    credit.append(a);
    count.textContent = `${at + 1} / ${photos.length}${p.km !== null ? ` · km ${Math.round(p.km)} of the route` : ""}`;
    thumbs.forEach((t, k) => t.setAttribute("aria-current", String(k === at)));
    thumbs[at].scrollIntoView({ block: "nearest", inline: "center" });
  };
  const open = (i: number, from: HTMLElement) => {
    opener = from;
    dlg.showModal();
    show(i);
  };
  document.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-photo]");
    if (el) {
      e.preventDefault();
      open(Number(el.dataset.photo), el);
    }
  });
  dlg.querySelector("[data-pg-prev]")!.addEventListener("click", () => show(at - 1));
  dlg.querySelector("[data-pg-next]")!.addEventListener("click", () => show(at + 1));
  dlg.querySelector("[data-pg-close]")!.addEventListener("click", () => dlg.close());
  thumbs.forEach((t, k) => t.addEventListener("click", () => show(k)));
  dlg.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(at - 1);
    if (e.key === "ArrowRight") show(at + 1);
  });
  // a click on the dark backdrop closes it
  dlg.addEventListener("click", (e) => {
    if (e.target === dlg) dlg.close();
  });
  dlg.addEventListener("close", () => opener?.focus());
  // swipe
  let sx: number | null = null;
  const stage = dlg.querySelector<HTMLElement>("[data-pg-stage]")!;
  stage.addEventListener("pointerdown", (e) => (sx = e.clientX));
  stage.addEventListener("pointerup", (e) => {
    if (sx !== null && Math.abs(e.clientX - sx) > 50) show(at + (e.clientX < sx ? 1 : -1));
    sx = null;
  });
</script>

<style>
  .pg {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 12px 16px 16px;
    border: 0;
    background: #141714;
    color: #ecebdb;
  }
  .pg[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    gap: 10px;
  }
  .pg::backdrop {
    background: rgba(20, 23, 20, 0.9);
  }
  .pg-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pg-count {
    font-size: 0.85rem;
    color: #b8b8a6;
  }
  .pg-close {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #2a2e2a;
    color: #ecebdb;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .pg-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    overflow: hidden;
    touch-action: pan-y;
  }
  .pg-img {
    max-width: 100%;
    max-height: calc(100dvh - 210px);
    object-fit: contain;
    border-radius: 4px;
    user-select: none;
  }
  .pg-nav {
    position: absolute;
    top: 50%;
    width: 48px;
    height: 48px;
    margin-top: -24px;
    border: 0;
    border-radius: 50%;
    background: rgba(42, 46, 42, 0.85);
    color: #ecebdb;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
  .pg-prev {
    left: 8px;
  }
  .pg-next {
    right: 8px;
  }
  .pg-close:focus-visible,
  .pg-nav:focus-visible,
  .pg-thumbs button:focus-visible {
    outline: 2px solid #b4cb76;
    outline-offset: 2px;
  }
  .pg-cap {
    margin: 0;
    text-align: center;
  }
  .pg-title {
    font: 600 1rem var(--serif);
  }
  .pg-credit a {
    margin-left: 8px;
    color: #b8b8a6;
    font-size: 0.8rem;
  }
  .pg-thumbs {
    display: flex;
    gap: 6px;
    justify-content: safe center;
    margin: 0;
    padding: 2px;
    overflow-x: auto;
    list-style: none;
  }
  .pg-thumbs button {
    padding: 0;
    border: 2px solid transparent;
    border-radius: 4px;
    background: none;
    cursor: pointer;
    opacity: 0.6;
  }
  .pg-thumbs button[aria-current="true"] {
    border-color: #ecebdb;
    opacity: 1;
  }
  .pg-thumbs img {
    display: block;
    width: 72px;
    height: 54px;
    object-fit: cover;
    border-radius: 2px;
  }
</style>
