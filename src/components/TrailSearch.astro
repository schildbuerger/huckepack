---
// Search with suggestions (issue #83; the Baymard review of 2026-11-07): type a trail's name (or its
// local or other names), a country, a continent, a region ("Alps", "Schwarzwald") or a topic ("hut").
// The matching is src/lib/search-match.ts, shared with the trip search's Where field: words at their
// start in any order, one typo allowed from four letters (ranked below exact matches), regions from
// src/lib/place-aliases.ts. Suggestions come in groups, places (to the trail search filtered to
// them, with how many trails), filters, then trails (to the trail page); at most 8 (6 on phones),
// then "Show all n"; the typed part of each in bold. Nothing matched: "Did you mean" with the nearest
// names. Enter takes the highlighted suggestion (the first, unless the arrows moved), or without any
// the search page, filtered to a place one of the words names. An ARIA combobox (arrow keys, Enter,
// Escape; the result count announced); the data come from /trails/search.json when the field is
// first used (issue #93). The × clears the field, or, when it is empty, closes the header's search
// (the "searchclose" event, HeaderSearch.astro).
interface Props {
  id: string;
  size?: "large" | "compact";
  placeholder?: string;
}
const { id, size = "large", placeholder = "Search a trail, country or region" } = Astro.props;
const listId = `${id}-list`;
---

<div class:list={["search", size]} data-search>
  <label for={id} class="sr-only">Search trails</label>
  <svg class="glass" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
  <input
    id={id}
    type="search"
    role="combobox"
    autocomplete="off"
    spellcheck="false"
    enterkeyhint="search"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls={listId}
    placeholder={placeholder}
  />
  <button type="button" class="clear" aria-label="Close search" title="Close search" data-clear>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
  <div class="results" id={listId} role="listbox" aria-label="Suggestions" hidden></div>
  <p class="sr-only" role="status" data-status></p>
</div>

<script>
  import { loadTrails } from "../lib/search-data";
  import {
    capped,
    fallbackHref,
    markHtml,
    nearest,
    placeCandidates,
    search,
    SUGGEST_MAX,
    SUGGEST_MAX_PHONE,
    trailCandidates,
    type Candidate,
  } from "../lib/search-match";

  const GROUPS: Record<string, string> = { place: "Places", topic: "Filters", trail: "Trails", near: "Did you mean" };
  const groupOf = (c: Candidate) => (c.kind === "trail" ? "trail" : c.kind === "topic" ? "topic" : "place");
  const phone = matchMedia("(max-width: 639px)");
  const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

  for (const box of document.querySelectorAll<HTMLElement>("[data-search]")) {
    const input = box.querySelector<HTMLInputElement>("input")!;
    const list = box.querySelector<HTMLElement>("[role=listbox]")!;
    const status = box.querySelector<HTMLElement>("[data-status]")!;
    const clear = box.querySelector<HTMLButtonElement>("[data-clear]")!;
    let places: Candidate[] = [];
    let all: Candidate[] = [];
    let building: Promise<void> | undefined;
    const build = () =>
      (building ??= loadTrails().then((trails) => {
        places = placeCandidates(trails, { topics: true });
        all = [...places, ...trailCandidates(trails)];
      }));

    // what is listed: the options in order (a link each, or "Show all"), the one highlighted
    let options: HTMLElement[] = [];
    let active = -1;
    let expanded = false; // "Show all" chosen for this query
    let shownFor = "";
    let say: ReturnType<typeof setTimeout> | undefined;

    function setActive(i: number) {
      active = i;
      options.forEach((o, j) => o.setAttribute("aria-selected", String(j === i)));
      if (i >= 0) {
        input.setAttribute("aria-activedescendant", options[i].id);
        options[i].scrollIntoView({ block: "nearest" });
      } else input.removeAttribute("aria-activedescendant");
    }
    const option = (c: Candidate, q: string) =>
      `<a role="option" class="opt" id="${input.id}-${esc(c.id.replace(/\W+/g, "-"))}" href="${esc(c.href)}" aria-selected="false">` +
      `<span class="name"><span aria-hidden="true">${markHtml(c.label, q)}</span><span class="sr-only">${esc(c.label)}</span></span>` +
      (c.note ? `<span class="muted">${esc(c.note)}</span>` : "") +
      `</a>`;
    const group = (key: string, body: string) =>
      `<div role="group" aria-labelledby="${input.id}-g-${key}"><p class="group" role="presentation" id="${input.id}-g-${key}">${GROUPS[key]}</p>${body}</div>`;

    function update() {
      const q = input.value.trim();
      clear.setAttribute("aria-label", q ? "Clear search" : "Close search");
      clear.title = clear.getAttribute("aria-label")!;
      if (!q) return close();
      if (q !== shownFor) expanded = false;
      shownFor = q;
      const hits = search(all, q);
      const max = phone.matches ? SUGGEST_MAX_PHONE : SUGGEST_MAX;
      const { shown, hidden } = expanded ? { shown: hits, hidden: 0 } : capped(hits, max);
      let html = "";
      let message = "";
      if (shown.length) {
        // groups in the order search() ranked them, each holding its suggestions
        const order: string[] = [];
        for (const h of shown) if (!order.includes(groupOf(h.c))) order.push(groupOf(h.c));
        html = order.map((g) => group(g, shown.filter((h) => groupOf(h.c) === g).map((h) => option(h.c, q)).join(""))).join("");
        if (hidden) html += `<div role="option" class="opt more" id="${input.id}-more" aria-selected="false">Show all ${hits.length} <span aria-hidden="true">→</span></div>`;
        message = hidden ? `${shown.length} of ${hits.length} suggestions` : `${hits.length} ${hits.length === 1 ? "suggestion" : "suggestions"}`;
      } else {
        const near = nearest(all, q);
        html = `<p class="none muted" role="presentation">No trail or place matches “${esc(q)}”. <a href="${esc(fallbackHref(places, q))}">Browse all trails</a></p>`;
        if (near.length) html += group("near", near.map((c) => option(c, "")).join(""));
        message = near.length ? `No match. Did you mean ${near.map((c) => c.label).join(", ")}?` : "No trail or place matches";
      }
      list.innerHTML = html;
      options = [...list.querySelectorAll<HTMLElement>("[role=option]")];
      const more = list.querySelector<HTMLElement>(".more");
      more?.addEventListener("click", () => showAll(max));
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
      setActive(options.length ? 0 : -1);
      clearTimeout(say);
      say = setTimeout(() => (status.textContent = message), 500);
    }
    // "Show all": every match, the highlight on the first one that was hidden
    function showAll(max: number) {
      expanded = true;
      update();
      setActive(Math.min(max, options.length - 1));
      input.focus();
    }
    function close() {
      list.hidden = true;
      list.innerHTML = "";
      options = [];
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      active = -1;
      status.textContent = "";
    }
    // Enter, or the header's magnifier once the search is open (the "searchgo" event)
    function go() {
      const q = input.value.trim();
      if (!q) return;
      const o = options[active];
      if (o?.classList.contains("more")) return showAll(phone.matches ? SUGGEST_MAX_PHONE : SUGGEST_MAX);
      if (o) return o.click();
      location.href = fallbackHref(places, q);
    }
    box.addEventListener("searchgo", () => build().then(() => (input.value.trim() && list.hidden ? (update(), go()) : go())));
    input.addEventListener("input", () => build().then(update));
    input.addEventListener("focus", () => build().then(() => input.value.trim() && update()));
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" && options.length) {
        e.preventDefault();
        setActive(Math.min(active + 1, options.length - 1));
      } else if (e.key === "ArrowDown" && input.value.trim() && list.hidden) {
        e.preventDefault();
        build().then(update);
      } else if (e.key === "ArrowUp" && options.length) {
        e.preventDefault();
        setActive(Math.max(active - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        build().then(go);
      } else if (e.key === "Escape") {
        close();
      }
    });
    clear.addEventListener("click", () => {
      if (input.value) {
        input.value = "";
        update();
        input.focus();
      } else box.dispatchEvent(new CustomEvent("searchclose", { bubbles: true }));
    });
    document.addEventListener("click", (e) => {
      if (!box.contains(e.target as Node)) close();
    });
  }
</script>

<style>
  .search {
    position: relative;
    width: 100%;
  }
  .glass {
    position: absolute;
    left: 16px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  input {
    width: 100%;
    padding: 14px 46px 14px 46px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
  }
  /* the browser's own clear button clashes with the site's colours; the × clears it */
  input::-webkit-search-cancel-button {
    appearance: none;
  }
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* the header's: the magnifier beside it is the search button, so no second one inside */
  .compact input {
    padding: 7px 38px 7px 14px;
    font-size: 0.9rem;
  }
  .compact .glass {
    display: none;
  }
  /* 16 px text on touch screens and phones: iOS Safari zooms into smaller fields */
  @media (pointer: coarse), (max-width: 639px) {
    .compact input {
      font-size: 16px;
    }
  }
  /* the ×: 26 px drawn, 44 px to tap */
  .clear {
    position: absolute;
    right: 6px;
    top: 50%;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transform: translateY(-50%);
  }
  .clear::before {
    content: "";
    position: absolute;
    inset: -9px;
  }
  .large .clear {
    right: 14px;
  }
  .clear svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .clear:hover {
    background: var(--surface);
    color: var(--text);
  }
  .clear:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .results {
    position: absolute;
    z-index: 60;
    inset: calc(100% + 6px) 0 auto;
    max-height: min(420px, 70vh);
    overflow-y: auto;
    padding: 6px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.14);
    text-align: left;
  }
  .compact .results {
    left: auto;
    width: min(380px, 90vw);
  }
  /* phones: the header's suggestions span the screen under the header */
  @media (max-width: 559px) {
    .compact .results {
      position: fixed;
      inset: 64px 16px auto;
      width: auto;
    }
  }
  .results[hidden] {
    display: none;
  }
  .results :global(.group) {
    margin: 6px 10px 4px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .results :global(.opt) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    padding: 9px 10px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    cursor: pointer;
  }
  /* the typed part bold */
  .results :global(.name b) {
    font-weight: 700;
  }
  .results :global(.opt .muted) {
    flex: none;
    max-width: 50%;
    font-size: 0.85rem;
    text-align: right;
  }
  .results :global(.opt[aria-selected="true"]),
  .results :global(.opt:hover) {
    background: var(--surface);
  }
  .results :global(.more) {
    justify-content: flex-start;
    gap: 6px;
    margin-top: 2px;
    color: var(--accent-text);
    font-weight: 600;
  }
  .results :global(.none) {
    margin: 8px 10px;
    font-size: 0.9rem;
  }
  @media (pointer: coarse) {
    .results :global(.opt) {
      min-height: 44px;
    }
  }
</style>
