---
// Search with suggestions (issue #83): type a trail's name (or its local or other names) or a
// country; suggestions are grouped into countries (first: to the trail search filtered to it, with
// how many trails) and trails (by name only, to the trail page). An ARIA combobox: arrow keys, Enter, Escape; a
// static page: the trails and countries come from /trails/search.json when the field is first used
// (issue #93), not in the markup of every page, and a script lists and filters them. `size`: large for
// the hero, compact for the header.
interface Props {
  id: string;
  size?: "large" | "compact";
  placeholder?: string;
}
const { id, size = "large", placeholder = "Search a trail or a country" } = Astro.props;
const listId = `${id}-list`;
---

<div class:list={["search", size]} data-search>
  <label for={id} class="sr-only">Search trails</label>
  <svg class="glass" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
  <input
    id={id}
    type="search"
    role="combobox"
    autocomplete="off"
    spellcheck="false"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls={listId}
    placeholder={placeholder}
  />
  <div class="results" id={listId} role="listbox" aria-label="Suggestions" hidden>
    <p class="group" role="presentation" data-group="countries">Countries</p>
    <p class="group" role="presentation" data-group="trails">Trails</p>
    <!-- one option as the template the script fills, so its options carry this component's styles -->
    <a role="option" data-option-template hidden href="/trails/"><span></span><span class="muted"></span></a>
    <p class="none muted" role="presentation" hidden>No trail or country matches. <a href="/trails/">Browse all trails</a></p>
  </div>
</div>

<script>
  import { loadTrails } from "../lib/search-data";
  // every search box on the page: filter the suggestions as one types; words match in any order and
  // at a word's start ("west" finds West Highland Way and Westweg, "germ" Germany)
  for (const box of document.querySelectorAll<HTMLElement>("[data-search]")) {
    const input = box.querySelector<HTMLInputElement>("input")!;
    const list = box.querySelector<HTMLElement>("[role=listbox]")!;
    const groups = [...list.querySelectorAll<HTMLElement>("[data-group]")];
    const template = list.querySelector<HTMLAnchorElement>("[data-option-template]")!;
    template.remove();
    // the options, built from /trails/search.json when the field is first used: countries (to the
    // trail search filtered to it, with how many trails) and trails (to the trail page)
    let options: HTMLAnchorElement[] = [];
    let building: Promise<void> | undefined;
    const option = (href: string, terms: string, kind: string, optionId: string, label: string, note: string) => {
      const o = template.cloneNode(true) as HTMLAnchorElement;
      o.removeAttribute("data-option-template");
      o.hidden = false;
      o.href = href;
      o.id = optionId;
      o.dataset.terms = terms;
      o.dataset.kind = kind;
      const [name, muted] = o.querySelectorAll("span");
      name.textContent = label;
      muted.textContent = note;
      return o;
    };
    const build = () =>
      (building ??= loadTrails().then((trails) => {
        const countries = [...new Set(trails.flatMap((t) => t.countries))].sort((a, b) => a.localeCompare(b));
        const slug = (v: string) => v.replace(/\W+/g, "-");
        const byCountry = countries.map((c) => {
          const n = trails.filter((t) => t.countries.includes(c)).length;
          return option(`/trails/?where=${encodeURIComponent(c)}`, c.toLowerCase(), "countries", `${input.id}-c-${slug(c)}`, c, `${n} ${n === 1 ? "trail" : "trails"}`);
        });
        const byTrail = trails.map((t) =>
          option(`/trails/${t.slug}/`, [t.name, t.localName, ...t.aliases].filter(Boolean).join(" ").toLowerCase(), "trails", `${input.id}-t-${t.slug}`, t.name, t.countries.join(", ")),
        );
        groups[0].after(...byCountry);
        groups[1].after(...byTrail);
        options = [...byCountry, ...byTrail];
      }));
    const none = list.querySelector<HTMLElement>(".none")!;
    let active = -1;
    const visible = () => options.filter((o) => !o.hidden);
    const matches = (o: HTMLElement, words: string[]) => {
      const terms = o.dataset.terms!.split(/[\s,/()-]+/);
      return words.every((w) => terms.some((t) => t.startsWith(w)));
    };
    function setActive(i: number) {
      const vis = visible();
      active = i;
      vis.forEach((o, j) => o.setAttribute("aria-selected", String(j === i)));
      if (i >= 0) {
        input.setAttribute("aria-activedescendant", vis[i].id);
        vis[i].scrollIntoView({ block: "nearest" });
      } else input.removeAttribute("aria-activedescendant");
    }
    function update() {
      const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      if (!words.length) return close();
      for (const o of options) o.hidden = !matches(o, words);
      for (const g of groups) g.hidden = !options.some((o) => !o.hidden && o.dataset.kind === g.dataset.group);
      none.hidden = visible().length > 0;
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
      setActive(visible().length ? 0 : -1);
    }
    function close() {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      active = -1;
    }
    input.addEventListener("input", () => build().then(update));
    input.addEventListener("focus", () => build().then(() => input.value.trim() && update()));
    input.addEventListener("keydown", (e) => {
      const vis = visible();
      if (e.key === "ArrowDown" && vis.length) {
        e.preventDefault();
        if (list.hidden) update();
        else setActive(Math.min(active + 1, vis.length - 1));
      } else if (e.key === "ArrowUp" && vis.length) {
        e.preventDefault();
        setActive(Math.max(active - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (!list.hidden && active >= 0) vis[active].click();
        else if (input.value.trim()) location.href = "/trails/";
      } else if (e.key === "Escape") {
        close();
      }
    });
    document.addEventListener("click", (e) => {
      if (!box.contains(e.target as Node)) close();
    });
  }
</script>

<style>
  .search {
    position: relative;
    width: 100%;
  }
  .glass {
    position: absolute;
    left: 16px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  input {
    width: 100%;
    padding: 14px 18px 14px 46px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
  }
  /* the browser's own clear button clashes with the site's colours; Escape and deleting clear it */
  input::-webkit-search-cancel-button {
    appearance: none;
  }
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .compact input {
    padding: 7px 12px 7px 36px;
    font-size: 0.9rem;
  }
  .compact .glass {
    left: 12px;
    width: 16px;
    height: 16px;
  }
  .results {
    position: absolute;
    z-index: 60;
    inset: calc(100% + 6px) 0 auto;
    max-height: 360px;
    overflow-y: auto;
    padding: 6px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.14);
    text-align: left;
  }
  .compact .results {
    left: auto;
    width: min(380px, 90vw);
  }
  /* phones: the header's suggestions span the screen under the header */
  @media (max-width: 559px) {
    .compact .results {
      position: fixed;
      inset: 64px 16px auto;
      width: auto;
    }
  }
  .results[hidden],
  [role="option"][hidden],
  .group[hidden],
  .none[hidden] {
    display: none;
  }
  .group {
    margin: 6px 10px 4px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  [role="option"] {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 10px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  [role="option"] .muted {
    font-size: 0.85rem;
    text-align: right;
  }
  [role="option"][aria-selected="true"],
  [role="option"]:hover {
    background: var(--surface);
  }
  .none {
    margin: 8px 10px;
    font-size: 0.9rem;
  }
</style>
