---
// The home page's trip search (issue #128; of three previews, approach A: a booking bar): When,
// Where and How long (one or more lengths, which make one range: the search's `days` is a range),
// each a field that opens a panel beneath it, and a search button with the
// number of trails the picks leave. Nothing is required; the button opens the search page with the
// picks as its own URL parameters (`months`, `where`, `days`), so the results are rated for the
// months picked. The count, the choices that would leave no trail
// (disabled) and the URL come from the search page's filters (src/lib/filters.ts), so they agree.
// Without JavaScript the panels don't open and the button opens the search page.
// Where matches as the header search does (src/lib/search-match.ts, the Baymard review of
// 2026-11-07): continents, countries and the regions the trails lie in (pipeline/regions.py, "Alps",
// "Bavaria") with their other names (src/lib/place-aliases.ts, "Bayern"), one typo allowed from four letters, the typed part bold; and after the
// places a group of trails by name (from /trails/search.json, at most 5), each an action straight to
// its page, not a pick.
import type { SearchTrail } from "../lib/search";
import { places, TRIP_LENGTHS } from "../lib/filters";
import { MONTH_ABBR } from "../lib/months";
import { PLACE_ALIASES } from "../lib/place-aliases";

interface Props {
  trails: SearchTrail[];
}
const { trails } = Astro.props;
const where = places(trails);
// the Where list: continents, then countries (with their continent), each matched by the words of
// its name; before anything is typed it suggests the continents and the countries with most trails
const TOP_COUNTRIES = 6;
const trailsIn = (c: string) => trails.filter((t) => t.countries.includes(c)).length;
// countries with most trails first (they are the suggestions), then the rest by name
const byTrails = where.flatMap((p) => p.countries).sort((a, b) => trailsIn(b) - trailsIn(a) || a.localeCompare(b));
const top = new Set(byTrails.slice(0, TOP_COUNTRIES));
const rank = (c: string) => (top.has(c) ? byTrails.indexOf(c) : TOP_COUNTRIES);
const countries = where
  .flatMap((p) => p.countries.map((c) => ({ name: c, continent: p.continent })))
  .sort((a, b) => rank(a.name) - rank(b.name) || a.name.localeCompare(b.name));
// the regions the trails lie in (pipeline/regions.py), by name, without a country's or continent's
// name; each with its other names for the matching
const placeNames = new Set([...where.map((p) => p.continent), ...where.flatMap((p) => p.countries)]);
const regions = [...new Set(trails.flatMap((t) => t.places))]
  .filter((name) => !placeNames.has(name))
  .map((name) => ({ name, n: trails.filter((t) => t.places.includes(name)).length }))
  .sort((a, b) => a.name.localeCompare(b.name));
const alsoOf = (name: string) => PLACE_ALIASES.find((p) => p.name === name)?.also ?? [];
const names = (name: string) => [name, ...alsoOf(name)].join("|");
const total = (test: (t: SearchTrail) => boolean) => trails.filter(test).length;
// only what the three questions ask of a trail
const json = JSON.stringify({
  trails: trails.map((t) => ({ season: t.season, days: t.days, continents: t.continents, countries: t.countries, places: t.places })),
  places: where,
}).replaceAll("<", "\\u003c");
---

<form class="trip" action="/trails/" data-trip>
  <div class="seg">
    <button type="button" class="field" aria-expanded="false" aria-controls="trip-when" data-open>
      <span class="flabel">When</span><span class="fval" data-val="when">Any month</span>
    </button>
    <div class="panel" id="trip-when" hidden>
      <p class="phint">Pick a month, or a second one for a run.</p>
      <div class="months" role="group" aria-label="Months">
        {MONTH_ABBR.map((m, i) => <button type="button" data-m={i + 1} aria-pressed="false">{m}</button>)}
      </div>
    </div>
  </div>
  <div class="seg">
    <button type="button" class="field" aria-expanded="false" aria-controls="trip-where" data-open>
      <span class="flabel">Where</span><span class="fval where-val"><span class="fname" data-val="where">Anywhere</span><span class="fmore" data-more></span></span>
    </button>
    <div class="panel wide" id="trip-where" hidden>
      {/* a destination search, as travel sites have it: type a country or continent; before typing,
           suggestions; several places at once, shown as removable chips under the list (above it,
           each pick would push the input and the list down) */}
      <label for="trip-where-input" class="sr-only">Country, region, continent or trail</label>
      <div class="where-input">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input
          id="trip-where-input"
          type="search"
          role="combobox"
          autocomplete="off"
          spellcheck="false"
          aria-autocomplete="list"
          aria-expanded="true"
          aria-controls="trip-where-list"
          placeholder="Country, region or trail"
        />
      </div>
      <div class="where-list" id="trip-where-list" role="listbox" aria-multiselectable="true" aria-label="Places and trails">
        <p class="group" role="presentation" data-group="continent">Continents</p>
        {where.map((p) => (
          <div role="option" id={`trip-w-${p.continent.replace(/\W+/g, "-")}`} class="opt" data-where={p.continent} data-kind="continent" data-names={names(p.continent)} data-total={total((t) => t.continents.includes(p.continent))} data-top aria-selected="false">
            <span class="check" aria-hidden="true"></span><span class="name"><span class="nm">{p.continent}</span></span><span class="n" data-n></span>
          </div>
        ))}
        <p class="group" role="presentation" data-group="country">Countries</p>
        {countries.map((c) => (
          <div role="option" id={`trip-w-${c.name.replace(/\W+/g, "-")}`} class="opt" data-where={c.name} data-in={c.continent} data-kind="country" data-names={names(c.name)} data-total={trailsIn(c.name)} data-top={top.has(c.name) ? "" : undefined} aria-selected="false">
            <span class="check" aria-hidden="true"></span><span class="name"><span class="nm">{c.name}</span> <span class="in">{c.continent}</span></span><span class="n" data-n></span>
          </div>
        ))}
        <p class="group" role="presentation" data-group="region" hidden>Regions</p>
        {regions.map((r) => (
          <div role="option" id={`trip-w-${r.name.replace(/\W+/g, "-")}`} class="opt" data-where={r.name} data-kind="region" data-names={names(r.name)} data-total={r.n} aria-selected="false" hidden>
            <span class="check" aria-hidden="true"></span><span class="name"><span class="nm">{r.name}</span></span><span class="n" data-n></span>
          </div>
        ))}
        {/* trails by name, filled from /trails/search.json once the field is used: going to the trail's page */}
        <p class="group" role="presentation" data-group="trail" hidden>Trails</p>
        <p class="none" role="presentation" hidden><span data-none-text>No place or trail matches.</span><span data-near></span></p>
      </div>
      <p class="sr-only" role="status" data-where-status></p>
      <div class="picked" data-picked></div>
    </div>
  </div>
  <div class="seg">
    <button type="button" class="field" aria-expanded="false" aria-controls="trip-days" data-open>
      <span class="flabel">How long</span><span class="fval" data-val="days">Any length</span>
    </button>
    <div class="panel end" id="trip-days" hidden>
      <p class="phint">Pick one or more; they make one range.</p>
      <div class="days" role="group" aria-label="Walking days">
        {TRIP_LENGTHS.map((d, i) => (
          <button type="button" data-day={i} aria-pressed="false"><strong>{d.label}</strong><span>{d.hint}</span></button>
        ))}
      </div>
    </div>
  </div>
  <button type="submit" class="go">
    <span class="go-label"
      ><span data-count>Find a trail</span><span class="sizer" aria-hidden="true">Show {trails.length} trails</span><span class="sizer" aria-hidden="true">Find a trail</span></span
    >
    <span aria-hidden="true">→</span>
  </button>
  <script type="application/json" class="trip-data" set:html={json} />
</form>

<script>
  import { DAYS, DAYS_ALL, matches, noFilters, toParams, toggleWhere, TRIP_LENGTHS, type Filters } from "../lib/filters";
  import { monthsText, runBetween } from "../lib/months";
  import type { SearchTrail } from "../lib/search";
  import { loadTrails } from "../lib/search-data";
  import { markHtml, nearest, search, trailCandidates, type Candidate, type Kind } from "../lib/search-match";

  const root = document.querySelector<HTMLFormElement>("[data-trip]");
  if (root) {
    const { trails, places } = JSON.parse(root.querySelector(".trip-data")!.textContent!) as {
      trails: SearchTrail[];
      places: { continent: string; countries: string[] }[];
    };
    const $ = <T extends HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    let months: number[] = [];
    let anchor: number | null = null;
    let where: string[] = [];
    // trip lengths as a range of TRIP_LENGTHS indexes, or none
    let days: [number, number] | null = null;
    const filters = (m = months, w = where, d = days): Filters => ({
      ...noFilters(),
      months: m,
      where: w,
      ...(d && { dayLo: TRIP_LENGTHS[d[0]].dayLo, dayHi: TRIP_LENGTHS[d[1]].dayHi }),
    });
    const count = (f: Filters) => trails.filter((t) => matches(t, f)).length;
    // a month: the first click picks it, a second makes the run to it, a click on the only one clears
    const monthsAfter = (m: number) => (anchor === null || months.length > 1 ? [m] : m === anchor ? [] : runBetween(anchor, m));
    // a length: one outside the range extends it, an end of it shrinks it, one inside picks only it
    const daysAfter = (i: number): [number, number] | null => {
      if (!days) return [i, i];
      const [lo, hi] = days;
      if (i < lo || i > hi) return [Math.min(lo, i), Math.max(hi, i)];
      if (lo === hi) return null;
      return i === lo ? [lo + 1, hi] : i === hi ? [lo, hi - 1] : [i, i];
    };
    // "4–14 days", "8+ days"
    const daysText = ([lo, hi]: [number, number]) =>
      `${DAYS[TRIP_LENGTHS[lo].dayLo]}${TRIP_LENGTHS[hi].dayHi === DAYS_ALL ? "+" : `–${DAYS[TRIP_LENGTHS[hi].dayHi]}`} days`;

    function draw() {
      // a choice that would leave no trail is disabled, unless it is on (so it can be undone)
      for (const b of $<HTMLButtonElement>("[data-m]")) {
        const on = months.includes(Number(b.dataset.m));
        b.setAttribute("aria-pressed", String(on));
        b.disabled = !on && count(filters(monthsAfter(Number(b.dataset.m)))) === 0;
      }
      // places and lengths combine (any of the places, one range of days), so each is judged on its
      // own: a place with no trail for the other picks stays disabled whatever else is picked
      for (const o of options) {
        const on = where.includes(o.dataset.where!);
        const n = count(filters(months, [o.dataset.where!]));
        o.setAttribute("aria-selected", String(on));
        // a country whose continent is picked is in the choice already
        o.classList.toggle("included", !on && where.includes(o.dataset.in ?? ""));
        o.querySelector("[data-n]")!.textContent = `${n} ${n === 1 ? "trail" : "trails"}`;
        o.setAttribute("aria-disabled", String(!on && n === 0));
      }
      picked.replaceChildren(
        ...where.map((w) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "chip";
          b.setAttribute("aria-label", `Remove ${w}`);
          b.innerHTML = '<span></span><span aria-hidden="true">×</span>';
          b.firstElementChild!.textContent = w;
          b.addEventListener("click", () => {
            where = where.filter((x) => x !== w);
            draw();
            input.focus();
          });
          return b;
        }),
      );
      for (const b of $<HTMLButtonElement>("[data-day]")) {
        const i = Number(b.dataset.day);
        const on = days !== null && i >= days[0] && i <= days[1];
        b.setAttribute("aria-pressed", String(on));
        b.disabled = !on && count(filters(months, where, [i, i])) === 0;
      }
      const values = {
        when: months.length ? monthsText(months) : "",
        where: where[0] ?? "",
        days: days ? daysText(days) : "",
      };
      const blank = { when: "Any month", where: "Anywhere", days: "Any length" };
      for (const el of $("[data-val]")) {
        const k = el.dataset.val as keyof typeof values;
        el.textContent = values[k] || blank[k];
        el.closest(".field")!.classList.toggle("set", Boolean(values[k]));
      }
      // "United Kingdom +1": the name may be cut short, never the number of further places
      root!.querySelector("[data-more]")!.textContent = where.length > 1 ? `+${where.length - 1}` : "";
      const n = count(filters());
      root!.querySelector("[data-count]")!.textContent =
        months.length || where.length || days ? `Show ${n} ${n === 1 ? "trail" : "trails"}` : "Find a trail";
    }

    for (const b of $<HTMLButtonElement>("[data-m]"))
      b.addEventListener("click", () => {
        const m = Number(b.dataset.m);
        months = monthsAfter(m);
        anchor = months.length === 1 ? m : months.length ? anchor : null;
        draw();
      });
    // Where: a combobox over the places, then trails (src/lib/search-match.ts: words at their start
    // in any order, other names, one typo from four letters); a place pick clears the text, so the
    // suggestions come back for the next one; a trail goes to its page
    const input = root.querySelector<HTMLInputElement>("#trip-where-input")!;
    const options = $<HTMLElement>("[role=option]"); // the places (picks)
    const original = [...options];
    const picked = root.querySelector<HTMLElement>("[data-picked]")!;
    const groups = $("[data-group]");
    const none = root.querySelector<HTMLElement>(".where-list .none")!;
    const near = none.querySelector<HTMLElement>("[data-near]")!;
    const status = root.querySelector<HTMLElement>("[data-where-status]")!;
    const placeCands: Candidate[] = options.map((o) => ({
      id: o.id,
      kind: o.dataset.kind as Kind,
      label: o.dataset.where!,
      names: o.dataset.names!.split("|"),
      count: Number(o.dataset.total),
      href: "",
    }));
    // the trails, from /trails/search.json once the field is used (the home page loads it anyway)
    let trailOpts: HTMLElement[] = [];
    let trailCands: Candidate[] = [];
    let loading: Promise<void> | undefined;
    const byId = new Map(options.map((o) => [o.id, o]));
    const heading = (k: string) => groups.find((g) => g.dataset.group === k)!;
    const after = (k: string) => (k === "continent" ? heading("country") : k === "country" ? heading("region") : k === "region" ? heading("trail") : none);
    const loadTrailOptions = () =>
      (loading ??= loadTrails().then((ts) => {
        trailCands = trailCandidates(ts).map((c) => ({ ...c, id: `trip-${c.id}` }));
        trailOpts = trailCands.map((c) => {
          const o = document.createElement("div");
          o.setAttribute("role", "option");
          o.id = c.id;
          o.className = "opt trail";
          o.dataset.kind = "trail";
          o.dataset.where = c.label;
          o.dataset.href = c.href;
          o.hidden = true;
          o.innerHTML = '<span class="arrow" aria-hidden="true">→</span><span class="name"><span class="nm"></span></span><span class="n"></span><span class="sr-only">, open the trail page</span>';
          o.querySelector(".nm")!.textContent = c.label;
          o.querySelector(".n")!.textContent = c.note ?? "";
          o.addEventListener("click", () => (location.href = c.href));
          byId.set(c.id, o);
          return o;
        });
        none.before(...trailOpts);
        if (input.value.trim()) list();
      }));
    const TRAILS_MAX = 5;
    let active = -1;
    const shown = () => [...options, ...trailOpts].filter((o) => !o.hidden).sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
    function setActive(i: number) {
      active = i;
      const vis = shown();
      vis.forEach((o, j) => o.classList.toggle("active", j === i));
      if (i >= 0) {
        input.setAttribute("aria-activedescendant", vis[i].id);
        vis[i].scrollIntoView({ block: "nearest" });
      } else input.removeAttribute("aria-activedescendant");
    }
    // a name with the typed part bold; screen readers read it plain
    const label = (o: HTMLElement, q: string) => {
      const nm = o.querySelector(".nm")!;
      const text = o.dataset.where!;
      if (!q) return void (nm.textContent = text);
      nm.innerHTML = `<span aria-hidden="true">${markHtml(text, q)}</span><span class="sr-only"></span>`;
      nm.lastElementChild!.textContent = text;
    };
    let say: ReturnType<typeof setTimeout> | undefined;
    function list() {
      const q = input.value.trim();
      const all = [...options, ...trailOpts];
      near.replaceChildren();
      let message = "";
      if (!q) {
        // before typing: the suggestions in their own order
        for (const o of original) after(o.dataset.kind!).before(o);
        for (const o of all) {
          o.hidden = !o.hasAttribute("data-top");
          label(o, "");
        }
      } else {
        const hits = search([...placeCands, ...trailCands], q);
        const placeHits = hits.filter((h) => h.c.kind !== "trail");
        const trailHits = hits.filter((h) => h.c.kind === "trail").slice(0, TRAILS_MAX);
        for (const o of all) o.hidden = true;
        // each group in ranked order
        for (const h of [...placeHits, ...trailHits]) {
          const o = byId.get(h.c.id)!;
          after(h.c.kind).before(o);
          o.hidden = false;
          label(o, q);
        }
        const p = placeHits.length;
        const t = trailHits.length;
        message = p || t ? [p && `${p} ${p === 1 ? "place" : "places"}`, t && `${t} ${t === 1 ? "trail" : "trails"}`].filter(Boolean).join(" and ") : "No place or trail matches";
        // nothing: the nearest names, a click away
        if (!p && !t) {
          const close = nearest([...placeCands, ...trailCands], q);
          if (close.length) {
            near.append(" Did you mean ");
            close.forEach((c, i) => {
              const b = document.createElement("button");
              b.type = "button";
              b.className = "near";
              b.textContent = c.label;
              b.addEventListener("click", () => {
                input.value = c.label;
                list();
                input.focus();
              });
              near.append(...(i ? [i === close.length - 1 ? " or " : ", "] : []), b);
            });
            near.append("?");
            message += `. Did you mean ${close.map((c) => c.label).join(", ")}?`;
          }
        }
      }
      for (const g of groups) g.hidden = !all.some((o) => !o.hidden && o.dataset.kind === g.dataset.group);
      heading("country").textContent = q ? "Countries" : "Most trails";
      none.hidden = shown().length > 0;
      setActive(q && shown().length ? 0 : -1);
      clearTimeout(say);
      say = setTimeout(() => (status.textContent = message), 500);
    }
    function pick(o: HTMLElement) {
      if (o.dataset.kind === "trail") return void (location.href = o.dataset.href!);
      if (o.getAttribute("aria-disabled") === "true") return;
      where = toggleWhere(where, o.dataset.where!, places);
      input.value = "";
      list();
      draw();
      input.focus();
    }
    for (const o of options) o.addEventListener("click", () => pick(o));
    input.addEventListener("focus", () => void loadTrailOptions());
    input.addEventListener("input", () => {
      list();
      loadTrailOptions();
    });
    input.addEventListener("keydown", (e) => {
      const vis = shown();
      if (e.key === "ArrowDown" && vis.length) {
        e.preventDefault();
        setActive(Math.min(active + 1, vis.length - 1));
      } else if (e.key === "ArrowUp" && vis.length) {
        e.preventDefault();
        setActive(Math.max(active - 1, 0));
      } else if (e.key === "Enter") {
        // Enter picks the active place (or opens the active trail), never submits the form from here
        e.preventDefault();
        if (active >= 0) pick(vis[active]);
      } else if (e.key === "Backspace" && !input.value && where.length) {
        where = where.slice(0, -1);
        draw();
      }
    });
    list();
    for (const b of $<HTMLButtonElement>("[data-day]"))
      b.addEventListener("click", () => {
        days = daysAfter(Number(b.dataset.day));
        draw();
      });

    // one panel open at a time; Esc (back to its field) or a click elsewhere closes it
    const fields = $<HTMLButtonElement>("[data-open]");
    const panel = (f: HTMLElement) => document.getElementById(f.getAttribute("aria-controls")!)!;
    const shut = () => {
      for (const f of fields) {
        f.setAttribute("aria-expanded", "false");
        panel(f).hidden = true;
      }
    };
    for (const f of fields)
      f.addEventListener("click", () => {
        const open = f.getAttribute("aria-expanded") === "true";
        shut();
        if (!open) {
          f.setAttribute("aria-expanded", "true");
          panel(f).hidden = false;
          panel(f).querySelector("input")?.focus();
        }
      });
    // by the click's path, not its target: a removed chip is no longer in the form once it's handled
    document.addEventListener("click", (e) => !e.composedPath().includes(root) && shut());
    root.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = fields.find((f) => f.getAttribute("aria-expanded") === "true");
      shut();
      open?.focus();
    });

    // the search page's own parameters (commas kept plain, as its links write them)
    root.addEventListener("submit", (e) => {
      e.preventDefault();
      const p = toParams(filters()).toString().replaceAll("%2C", ",");
      location.href = `/trails/${p ? `?${p}` : ""}`;
    });
    draw();
  }
</script>

<style>
  .trip {
    position: relative;
    display: flex;
    width: 100%;
    margin: clamp(40px, 6vw, 56px) auto 0;
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    box-shadow: 0 8px 28px -12px rgb(0 0 0 / 0.25);
    text-align: left;
  }
  .trip button {
    font: inherit;
    color: var(--text);
    cursor: pointer;
  }
  .trip button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .trip button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .seg {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
  }
  .seg + .seg {
    border-left: 1px solid var(--line);
  }
  .field {
    display: block;
    width: 100%;
    height: 100%;
    padding: 14px 28px;
    border: 0;
    border-radius: 0;
    background: none;
    text-align: left;
  }
  .seg:first-child .field {
    border-radius: 999px 0 0 999px;
  }
  .trip .field:focus-visible {
    outline-offset: -2px;
  }
  .field:hover,
  .field[aria-expanded="true"] {
    background: var(--surface);
  }
  .flabel {
    display: block;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .fval {
    display: block;
    overflow: hidden;
    color: var(--muted);
    font-size: 1rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .where-val {
    display: flex;
    gap: 4px;
  }
  .fname {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fmore {
    flex: none;
  }
