---
// Light / dark switch in the header: auto (the system setting, the default), light or dark.
// The choice is stored in localStorage ("theme") and applied as <html data-theme>; Base.astro
// applies a saved choice before the first paint, and its colour tokens follow data-theme.
import Icon from "./Icon.astro";

const options = [
  { value: "auto", label: "Automatic, as your system", icon: "monitor" },
  { value: "light", label: "Light", icon: "sun" },
  { value: "dark", label: "Dark", icon: "moon" },
] as const;
---

<div class="theme" role="group" aria-label="Colour theme">
  {options.map((o) => (
    <button type="button" data-theme-option={o.value} aria-pressed={o.value === "auto" ? "true" : "false"} title={o.label}>
      <Icon name={o.icon} size={15} label={o.label} />
    </button>
  ))}
</div>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-option]");
  const current = () => root.dataset.theme ?? "auto";
  const mark = () => buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeOption === current())));
  for (const button of buttons) {
    button.addEventListener("click", () => {
      const choice = button.dataset.themeOption!;
      if (choice === "auto") delete root.dataset.theme;
      else root.dataset.theme = choice;
      try {
        if (choice === "auto") localStorage.removeItem("theme");
        else localStorage.setItem("theme", choice);
      } catch {}
      mark();
    });
  }
  mark();
</script>

<style>
  .theme {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  button:hover {
    color: var(--text);
  }
  button[aria-pressed="true"] {
    background: var(--surface);
    color: var(--text);
  }
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
</style>
