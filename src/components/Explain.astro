---
// A "?" button that opens a short explanation (the popover attribute: no JavaScript, closes
// with Esc, a click outside or the Close button). Place it right after a label; the slot holds
// the explanation. The panel resets inherited text styles, since labels are often uppercase.
interface Props {
  id: string;
  title: string;
  label?: string; // accessible name of the button; defaults to "About <title>"
}
const { id, title, label } = Astro.props;
---

<button class="info" type="button" popovertarget={id} aria-label={label ?? `About ${title}`}>?</button>
<div id={id} class="pop" popover>
  <p class="pop-title">{title}</p>
  <div class="pop-text"><slot /></div>
  <p class="pop-foot">
    <slot name="foot" />
    <button type="button" popovertarget={id} popovertargetaction="hide">Close</button>
  </p>
</div>

<style>
  .info {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    margin-left: 4px;
    padding: 0;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    font: 600 0.65rem/1 var(--sans);
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }
  .info:hover,
  .info:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pop {
    width: min(440px, calc(100vw - 32px));
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.18);
    font: 400 0.9rem/1.55 var(--sans);
    letter-spacing: normal;
    text-align: left;
    text-transform: none;
  }
  .pop::backdrop {
    background: rgb(0 0 0 / 0.25);
  }
  .pop p {
    margin: 0 0 12px;
  }
  .pop-title {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .pop-text {
    margin-bottom: 16px;
  }
  .pop-text :global(p) {
    margin: 0 0 8px;
  }
  .pop-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 0 !important;
    font-size: 0.8rem;
  }
  .pop-foot button {
    margin-left: auto;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
</style>
