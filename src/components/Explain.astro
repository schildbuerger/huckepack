---
// A label that opens a short explanation: the term itself is the button, marked by a dotted
// underline (the popover attribute: no JavaScript, closes with Esc, a click outside or the
// Close button). The slot holds the explanation. The panel resets inherited text styles, since
// labels are often uppercase. With `shared`, it renders only the term, opening the popover of
// another Explain with that id (two labels, one explanation).
interface Props {
  id: string;
  term: string; // the visible label, e.g. "Difficulty"
  title?: string; // the panel's heading; defaults to the term
  shared?: boolean;
}
const { id, term, title = term, shared = false } = Astro.props;
---

<button class="term" type="button" popovertarget={id}>{term}</button>
{
  !shared && (
    <div id={id} class="pop" popover>
      <p class="pop-title">{title}</p>
      <div class="pop-text">
        <slot />
      </div>
      <p class="pop-foot">
        <slot name="foot" />
        <button type="button" popovertarget={id} popovertargetaction="hide">Close</button>
      </p>
    </div>
  )
}

<style>
  .term {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    text-transform: inherit;
    text-decoration: underline dotted;
    text-decoration-color: var(--muted);
    text-underline-offset: 3px;
    cursor: help;
  }
  .term:hover,
  .term:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .term:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .pop {
    width: min(440px, calc(100vw - 32px));
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.18);
    font: 400 0.9rem/1.55 var(--sans);
    letter-spacing: normal;
    text-align: left;
    text-transform: none;
  }
  .pop::backdrop {
    background: rgb(0 0 0 / 0.25);
  }
  .pop p {
    margin: 0 0 12px;
  }
  .pop-title {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .pop-text {
    margin-bottom: 16px;
  }
  .pop-text :global(p) {
    margin: 0 0 8px;
  }
  .pop-text :global(table) {
    margin: 4px 0 12px;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .pop-text :global(th),
  .pop-text :global(td) {
    padding: 3px 16px 3px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .pop-text :global(th) {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.8rem;
  }
  .pop-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 0 !important;
    font-size: 0.8rem;
  }
  .pop-foot button {
    margin-left: auto;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
</style>
