---
// A trail's waymark, redrawn small beside the Location's "Waymarking" text (issue #19). Only
// marks a source describes: the record's `waymarking.symbol` names one of WAYMARKS. Drawn in
// the marks' own colours (they are the real paint), decorative: the text beside it says the same.
// New marks: add an entry here and to the schema's enum.
interface Props {
  symbol: keyof typeof WAYMARKS;
}
const WAYMARKS = {
  // CAI (Club Alpino Italiano): the red-white-red flag, 15 × 8 cm, on rocks and trees
  cai: { w: 30, h: 16, svg: '<rect width="30" height="16" rx="1.5" fill="#d6362e"/><rect y="5.33" width="30" height="5.34" fill="#fff"/>' },
  // Forststeig (Sachsenforst): a vertical yellow brush stroke, painted straight onto the trees
  "yellow-vertical-stripe": {
    w: 16,
    h: 22,
    svg: '<rect width="16" height="22" rx="3" fill="#6f655c"/><path d="M6.2 3.2c1.4-.4 2.6-.3 3.7.1l.3 15.4c-1.3.5-2.5.5-3.9.1z" fill="#f4c20d"/>',
  },
} as const;
const { symbol } = Astro.props;
const m = WAYMARKS[symbol];
---

<svg class="waymark" viewBox={`0 0 ${m.w} ${m.h}`} width={m.w} height={m.h} aria-hidden="true" set:html={m.svg} />

<style>
  .waymark {
    flex: none;
    vertical-align: middle;
  }
</style>
