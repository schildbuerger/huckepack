---
// A trail's waymark, redrawn small beside the Location's "Waymarking" text (issues #19, #82). The
// rule: every simple painted mark a source describes gets drawn (the record's `waymarking.symbol`
// names one of WAYMARKS); a trail's logo is never copied, its text stands alone. Drawn in the marks'
// own colours (they are the real paint), decorative: the text beside it says the same. `number`: a
// path number painted in a flag's white band. New marks: add an entry here and to the schema's enum.
interface Props {
  symbol: keyof typeof WAYMARKS;
  number?: string;
}
const WAYMARKS = {
  // CAI (Club Alpino Italiano): the red-white-red flag, 15 × 8 cm, on rocks and trees
  cai: { w: 30, h: 16, svg: '<rect width="30" height="16" rx="1.5" fill="#d6362e"/><rect y="5.33" width="30" height="5.34" fill="#fff"/>' },
  // Westweg (Schwarzwaldverein): a red diamond on a white field
  "red-diamond": {
    w: 18,
    h: 18,
    svg: '<rect x=".5" y=".5" width="17" height="17" rx="2" fill="#fff" stroke="#c9c2b8"/><path d="M9 3.2 14.3 9 9 14.8 3.7 9z" fill="#d6362e"/>',
  },
  // Forststeig (Sachsenforst): a vertical yellow brush stroke, painted straight onto the trees
  // Hermannsweg (Hermannshöhen): a white H on black; on a dark page the field keeps a thin rim
  "white-h-on-black": {
    w: 20,
    h: 16,
    svg: '<rect x=".5" y=".5" width="19" height="15" rx="1.5" fill="#1a1a1a" stroke="#8a8178"/><path d="M5.6 3.6h2.5v3.3h3.8V3.6h2.5v8.8h-2.5V9.1H8.1v3.3H5.6z" fill="#fff"/>',
  },
  // Eggeweg (Hermannshöhen): a white lying cross, X, on black
  "white-x-on-black": {
    w: 20,
    h: 16,
    svg: '<rect x=".5" y=".5" width="19" height="15" rx="1.5" fill="#1a1a1a" stroke="#8a8178"/><path d="M5.8 3.6 14.2 12.4M14.2 3.6 5.8 12.4" stroke="#fff" stroke-width="2.4"/>',
  },
  "yellow-vertical-stripe": {
    w: 16,
    h: 22,
    svg: '<rect width="16" height="22" rx="3" fill="#6f655c"/><path d="M6.2 3.2c1.4-.4 2.6-.3 3.7.1l.3 15.4c-1.3.5-2.5.5-3.9.1z" fill="#f4c20d"/>',
  },
} as const;
const { symbol, number } = Astro.props;
const m = WAYMARKS[symbol];
// a number widens the CAI flag's white band (as South Tyrol paints its path numbers) and sits in it
const flag = symbol === "cai" && number;
const w = flag ? 34 : m.w;
const h = flag ? 20 : m.h;
const svg = flag
  ? `<rect width="34" height="20" rx="1.5" fill="#d6362e"/><rect y="4.5" width="34" height="11" fill="#fff"/><text x="17" y="13.4" text-anchor="middle" font-family="Arial, sans-serif" font-size="9" font-weight="700" fill="#1a1a1a">${number}</text>`
  : m.svg;
---

<svg class="waymark" viewBox={`0 0 ${w} ${h}`} width={w} height={h} aria-hidden="true" set:html={svg} />

<style>
  .waymark {
    flex: none;
    vertical-align: middle;
  }
</style>
